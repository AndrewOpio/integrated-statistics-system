@model IEnumerable<ISSService.Web.Models.Respondents.RespondentViewModel>

@{
    ViewData["Title"] = "Respondent Register";
    var respondents = Model.ToList();
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <h1 class="mb-1">Respondent Register</h1>
            <p class="text-muted mb-0">
                Manage institutions and other respondents participating
                in statistical data collection processes.
            </p>
        </div>

        <div>
            <a asp-controller="Respondents"
               asp-action="Create"
               class="btn btn-primary">
                Add Respondent
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h4 class="mb-1">Registered Respondents</h4>
                    <div class="text-muted">
                        Master register of institutions and respondents.
                    </div>
                </div>

                <span class="badge bg-secondary">
                    @respondents.Count respondent(s)
                </span>
            </div>
        </div>

        <div class="card-body p-0">

            @if (!respondents.Any())
            {
                <div class="text-center py-5 px-4">
                    <h4>No respondents registered</h4>

                    <p class="text-muted mb-4">
                        The respondent register is currently empty.
                        Add the first respondent to begin configuring
                        participation in reporting cycles.
                    </p>

                    <a asp-controller="Respondents"
                       asp-action="Create"
                       class="btn btn-primary">
                        Add Respondent
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Code</th>
                                <th>Respondent</th>
                                <th>Type</th>
                                <th>Location</th>
                                <th>Primary Contact</th>
                                <th class="text-center">Cases</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var respondent in respondents)
                            {
                                <tr>
                                    <td>
                                        <strong>@respondent.Code</strong>
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @respondent.Name
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(
                                            respondent.Address))
                                        {
                                            <small class="text-muted">
                                                @respondent.Address
                                            </small>
                                        }
                                    </td>

                                    <td>
                                        @respondent.RespondentType
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(
                                            respondent.District) ||
                                             !string.IsNullOrWhiteSpace(
                                            respondent.Region))
                                        {
                                            <div>
                                                @(respondent.District ?? "-")
                                            </div>

                                            <small class="text-muted">
                                                @(respondent.Region ?? "-")
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not set
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(
                                            respondent.PrimaryContactName))
                                        {
                                            <div>
                                                @respondent.PrimaryContactName
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(
                                                respondent.PrimaryContactEmail))
                                            {
                                                <small class="text-muted d-block">
                                                    @respondent.PrimaryContactEmail
                                                </small>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(
                                                respondent.PrimaryContactPhone))
                                            {
                                                <small class="text-muted d-block">
                                                    @respondent.PrimaryContactPhone
                                                </small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not set
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        @respondent.RespondentCaseCount
                                    </td>

                                    <td>
                                        @if (respondent.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end text-nowrap">
                                        <a asp-controller="Respondents"
                                           asp-action="Details"
                                           asp-route-id="@respondent.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            Details
                                        </a>

                                        <a asp-controller="Respondents"
                                           asp-action="Edit"
                                           asp-route-id="@respondent.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>
</div>