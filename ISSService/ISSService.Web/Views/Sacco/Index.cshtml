@model ISSService.Web.Models.Sacco.SaccoDashboardViewModel

@{
    ViewData["Title"] = "SACCO Reporting Dashboard";
}

<div class="container-fluid py-4">

    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">
        <div>
            <h2 class="mb-1">SACCO Reporting Dashboard</h2>
            <p class="text-muted mb-0">
                Collection, validation and operational data monitoring
            </p>
        </div>

        @if (Model.AvailableCycles.Any())
        {
            <form method="get"
                  asp-controller="Sacco"
                  asp-action="Index"
                  class="mt-3 mt-lg-0">

                <div class="input-group">
                    <label class="input-group-text"
                           for="cycleId">
                        Reporting Cycle
                    </label>

                    <select id="cycleId"
                            name="cycleId"
                            class="form-select"
                            onchange="this.form.submit()">

                        @foreach (var cycle in Model.AvailableCycles)
                        {
                            if (Model.SelectedCycleId == cycle.Id)
                            {
                                <option value="@cycle.Id" selected>
                                    @cycle.Name
                                </option>
                            }
                            else
                            {
                                <option value="@cycle.Id">
                                    @cycle.Name
                                </option>
                            }
                        }

                    </select>
                </div>

            </form>
        }
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger"
             role="alert">
            @TempData["Error"]
        </div>
    }

    @if (!Model.ProcessConfigured)
    {
        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h4 class="card-title">
                    SACCO process setup required
                </h4>

                <p class="text-muted mb-0">
                    The SACCO statistical process has not yet been
                    configured in the ISS development database. Once
                    configured, its reporting cycles and respondent
                    cases will appear here.
                </p>

            </div>
        </div>
    }
    else if (!Model.AvailableCycles.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h4 class="card-title">
                    No reporting cycles available
                </h4>

                <p class="text-muted mb-0">
                    @Model.ProcessName has been configured, but no
                    reporting cycle has yet been created.
                </p>

            </div>
        </div>
    }
    else if (Model.Cycle != null)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                    <div>
                        <h5 class="mb-1">
                            @Model.Cycle.Name
                        </h5>

                        <span class="text-muted small">
                            @Model.Cycle.Code
                        </span>
                    </div>

                    <span class="badge bg-primary mt-2 mt-md-0">
                        @Model.Cycle.Status
                    </span>
                </div>
            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-4">
                        <div class="text-muted small">
                            Reporting Period
                        </div>

                        <div class="fw-semibold">
                            @Model.Cycle.PeriodStartDate.ToString("dd MMM yyyy")
                            -
                            @Model.Cycle.PeriodEndDate.ToString("dd MMM yyyy")
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="text-muted small">
                            Collection Opens
                        </div>

                        <div class="fw-semibold">
                            @if (Model.Cycle.CollectionOpenDate.HasValue)
                            {
                                @Model.Cycle.CollectionOpenDate.Value.ToString("dd MMM yyyy")
                            }
                            else
                            {
                                <span>Not set</span>
                            }
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="text-muted small">
                            Submission Due
                        </div>

                        <div class="fw-semibold">
                            @if (Model.Cycle.SubmissionDueDate.HasValue)
                            {
                                @Model.Cycle.SubmissionDueDate.Value.ToString("dd MMM yyyy")
                            }
                            else
                            {
                                <span>Not set</span>
                            }
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="text-muted small">
                            Collection Closes
                        </div>

                        <div class="fw-semibold">
                            @if (Model.Cycle.CollectionCloseDate.HasValue)
                            {
                                @Model.Cycle.CollectionCloseDate.Value.ToString("dd MMM yyyy")
                            }
                            else
                            {
                                <span>Not set</span>
                            }
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="text-muted small">
                            Assigned Template
                        </div>

                        <div class="fw-semibold">
                            @if (!string.IsNullOrWhiteSpace(Model.Cycle.TemplateName))
                            {
                                @Model.Cycle.TemplateName
                            }
                            else
                            {
                                <span>No template assigned</span>
                            }
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="text-muted small">
                            Template Version
                        </div>

                        <div class="fw-semibold">
                            @if (!string.IsNullOrWhiteSpace(Model.Cycle.TemplateVersion))
                            {
                                @Model.Cycle.TemplateVersion
                            }
                            else
                            {
                                <span>Not available</span>
                            }
                        </div>
                    </div>

                </div>

            </div>
        </div>

        <div class="mb-2">
            <h5 class="mb-1">Collection Monitoring</h5>
            <p class="text-muted small mb-0">
                Current position of expected SACCO returns for the
                selected reporting cycle.
            </p>
        </div>

        <div class="row g-3 mb-3">

            <div class="col-sm-6 col-md-4 col-xl-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted small">
                            Expected Returns
                        </div>

                        <div class="fs-3 fw-bold">
                            @Model.Cycle.TotalCases
                        </div>

                        <div class="small text-muted">
                            Active respondent cases
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-md-4 col-xl-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted small">
                            Distributed
                        </div>

                        <div class="fs-3 fw-bold">
                            @Model.Cycle.DistributedCases
                        </div>

                        <div class="small text-muted">
                            Returns issued to respondents
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-md-4 col-xl-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted small">
                            Submitted
                        </div>

                        <div class="fs-3 fw-bold">
                            @Model.Cycle.CasesWithSubmissions
                        </div>

                        <div class="small text-muted">
                            @Model.Cycle.SubmissionRate.ToString("0.0")%
                            of expected returns
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-md-4 col-xl-3">
                <div class="card shadow-sm h-100 border-warning">
                    <div class="card-body">
                        <div class="text-muted small">
                            Outstanding
                        </div>

                        <div class="fs-3 fw-bold">
                            @Model.Cycle.OutstandingCases
                        </div>

                        <div class="small text-muted">
                            @Model.Cycle.OutstandingRate.ToString("0.0")%
                            of expected returns
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="row g-3 mb-4">

            <div class="col-sm-6 col-md-4 col-xl-3">
                <div class="card shadow-sm h-100 border-success">
                    <div class="card-body">
                        <div class="text-muted small">
                            Validated
                        </div>

                        <div class="fs-3 fw-bold">
                            @Model.Cycle.ValidatedCases
                        </div>

                        <div class="small text-muted">
                            @Model.Cycle.ValidationRate.ToString("0.0")%
                            of submitted returns
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-md-4 col-xl-3">
                <div class="card shadow-sm h-100 border-danger">
                    <div class="card-body">
                        <div class="text-muted small">
                            Validation Failed
                        </div>

                        <div class="fs-3 fw-bold">
                            @Model.Cycle.CasesWithValidationFailures
                        </div>

                        <div class="small text-muted">
                            Current returns requiring attention
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-md-4 col-xl-3">
                <div class="card shadow-sm h-100 border-info">
                    <div class="card-body">
                        <div class="text-muted small">
                            Extracted
                        </div>

                        <div class="fs-3 fw-bold">
                            @Model.Cycle.ExtractedCases
                        </div>

                        <div class="small text-muted">
                            @Model.Cycle.ExtractionRate.ToString("0.0")%
                            of validated returns
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-md-4 col-xl-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted small">
                            Accepted
                        </div>

                        <div class="fs-3 fw-bold">
                            @Model.Cycle.AcceptedCases
                        </div>

                        <div class="small text-muted">
                            @Model.Cycle.AcceptanceRate.ToString("0.0")%
                            of expected returns
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="alert alert-light border mb-4">
            <div class="small">
                <strong>Processing note:</strong>
                Validation confirms that a submitted return has passed
                the configured technical and business validation checks.
                Operational data extraction prepares validated data for
                downstream statistical processing. Neither validation nor
                extraction constitutes formal acceptance of the return.
            </div>
        </div>

        <div class="card shadow-sm">

            <div class="card-header bg-white py-3">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">

                    <div>
                        <h5 class="mb-0">
                            SACCO Respondent Monitoring
                        </h5>

                        <small class="text-muted">
                            Respondent-level collection and processing status
                        </small>
                    </div>

                    <span class="badge bg-secondary mt-2 mt-md-0">
                        @Model.RespondentCases.Count case(s)
                    </span>

                </div>
            </div>

            <div class="card-body p-0">

                @if (!Model.RespondentCases.Any())
                {
                    <div class="p-4 text-center">

                        <h5>No respondent cases</h5>

                        <p class="text-muted mb-0">
                            No SACCO respondents have yet been assigned
                            to this reporting cycle.
                        </p>

                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th>Case / Respondent</th>
                                    <th>Workflow</th>
                                    <th>Submission</th>
                                    <th>Validation</th>
                                    <th>Operational Data</th>
                                    <th>Last Submitted</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model.RespondentCases)
                                {
                                    <tr>

                                        <td>
                                            <div class="fw-semibold">
                                                @item.RespondentName
                                            </div>

                                            <div class="small text-muted">
                                                @item.RespondentCode
                                            </div>

                                            <div class="small mt-1">
                                                @item.CaseReference
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(item.District) ||
                                                 !string.IsNullOrWhiteSpace(item.Region))
                                            {
                                                <div class="small text-muted mt-1">
                                                    @if (!string.IsNullOrWhiteSpace(item.District))
                                                    {
                                                        <span>@item.District</span>
                                                    }

                                                    @if (!string.IsNullOrWhiteSpace(item.District) &&
                                                         !string.IsNullOrWhiteSpace(item.Region))
                                                    {
                                                        <span>, </span>
                                                    }

                                                    @if (!string.IsNullOrWhiteSpace(item.Region))
                                                    {
                                                        <span>@item.Region</span>
                                                    }
                                                </div>
                                            }
                                        </td>

                                        <td>
                                            @if (string.IsNullOrWhiteSpace(item.CurrentStatusName))
                                            {
                                                <span class="badge bg-secondary">
                                                    Not configured
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary">
                                                    @item.CurrentStatusName
                                                </span>
                                            }

                                            @if (item.AcceptedDate.HasValue)
                                            {
                                                <div class="small text-muted mt-1">
                                                    Accepted
                                                    @item.AcceptedDate.Value.ToString("dd MMM yyyy")
                                                </div>
                                            }
                                        </td>

                                        <td>
                                            @if (item.HasCurrentSubmission)
                                            {
                                                <div>
                                                    <span class="badge bg-secondary">
                                                        Submission #@item.CurrentSubmissionNumber
                                                    </span>
                                                </div>

                                                <div class="small mt-1">
                                                    @item.LatestSubmissionStatus
                                                </div>

                                                @if (item.SubmissionCount > 1)
                                                {
                                                    <div class="small text-muted">
                                                        @item.SubmissionCount total submissions
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    Outstanding
                                                </span>

                                                <div class="small text-muted mt-1">
                                                    No current submission
                                                </div>
                                            }
                                        </td>

                                        <td>
                                            @if (item.LatestValidationStatus.HasValue)
                                            {
                                                if (item.HasValidationFailure)
                                                {
                                                    <span class="badge bg-danger">
                                                        @item.LatestValidationStatus.Value
                                                    </span>
                                                }
                                                else if (item.IsValidated)
                                                {
                                                    <span class="badge bg-success">
                                                        @item.LatestValidationStatus.Value
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">
                                                        @item.LatestValidationStatus.Value
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Not run
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            @if (item.HasExtractedOperationalDataset)
                                            {
                                                <span class="badge bg-info text-dark">
                                                    Extracted
                                                </span>

                                                <div class="small text-muted mt-1">
                                                    @item.OperationalObservationCount
                                                    observation(s)
                                                </div>
                                            }
                                            else if (item.OperationalDatasetStatus.HasValue)
                                            {
                                                <span class="badge bg-secondary">
                                                    @item.OperationalDatasetStatus.Value
                                                </span>
                                            }
                                            else if (item.IsValidated)
                                            {
                                                <span class="text-muted">
                                                    Ready for extraction
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Not available
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            @if (item.LatestSubmissionDate.HasValue)
                                            {
                                                @item.LatestSubmissionDate.Value.ToString("dd MMM yyyy")

                                                <div class="small text-muted">
                                                    @item.LatestSubmissionDate.Value.ToString("HH:mm")
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    -
                                                </span>
                                            }
                                        </td>

                                        <td class="text-end">
                                            <div class="d-flex flex-column flex-xl-row gap-1 justify-content-end">

                                                <a asp-controller="Submissions"
                                                   asp-action="Index"
                                                   asp-route-respondentCaseId="@item.RespondentCaseId"
                                                   class="btn btn-sm btn-outline-primary">
                                                    Submission History
                                                </a>

                                                @if (item.HasExtractedOperationalDataset &&
                                                     item.OperationalDatasetId.HasValue)
                                                {
                                                    <a asp-controller="OperationalDatasets"
                                                       asp-action="Details"
                                                       asp-route-id="@item.OperationalDatasetId.Value"
                                                       class="btn btn-sm btn-outline-info">
                                                        View Dataset
                                                    </a>
                                                }

                                            </div>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>
    }

</div>