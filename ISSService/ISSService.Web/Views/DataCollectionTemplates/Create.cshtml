@model ISSService.Web.Models.DataCollectionTemplates.DataCollectionTemplateViewModel

@{
    ViewData["Title"] = "Add Data Collection Template";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-3">
        <a asp-controller="DataCollectionTemplates"
           asp-action="Index"
           asp-route-statisticalProcessId="@Model.StatisticalProcessId"
           class="text-decoration-none">
            &larr; Back to Data Collection Templates
        </a>
    </div>

    <div class="mb-4">

        <h1 class="mb-1">Add Data Collection Template</h1>

        <p class="text-muted mb-0">
            Define a collection instrument for
            <strong>@Model.StatisticalProcessName</strong>.
        </p>

    </div>

    <form asp-controller="DataCollectionTemplates"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="StatisticalProcessId"
               type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             role="alert">
        </div>

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-white py-3">
                <h4 class="mb-0">Template Definition</h4>
            </div>

            <div class="card-body">

                <div class="alert alert-light border mb-4">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <small class="text-muted d-block">
                                Statistical Process
                            </small>

                            <strong>
                                @Model.StatisticalProcessName
                            </strong>
                        </div>

                        <div class="col-md-3">
                            <small class="text-muted d-block">
                                Process Code
                            </small>

                            <strong>
                                @Model.StatisticalProcessCode
                            </strong>
                        </div>

                    </div>

                </div>

                <div class="row g-3">

                    <div class="col-md-4">

                        <label asp-for="Code"
                               class="form-label">
                        </label>

                        <input asp-for="Code"
                               class="form-control"
                               placeholder="e.g. SACCO-QTR" />

                        <span asp-validation-for="Code"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            Unique template code within this
                            statistical process.
                        </div>

                    </div>

                    <div class="col-md-8">

                        <label asp-for="Name"
                               class="form-label">
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="e.g. SACCO Quarterly Return Template" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="TemplateType"
                               class="form-label">
                        </label>

                        <select asp-for="TemplateType"
                                asp-items="Html.GetEnumSelectList<ISSService.Data.Entities.DataCollectionTemplateType>()"
                                class="form-select">
                        </select>

                        <span asp-validation-for="TemplateType"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-12">

                        <label asp-for="Description"
                               class="form-label">
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Describe the purpose and use of this collection template.">
                        </textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-12">
                        <hr class="my-2" />

                        <h5 class="mb-1">
                            Collection Behaviour
                        </h5>

                        <small class="text-muted">
                            Define how the template is prepared and
                            used during data collection.
                        </small>
                    </div>

                    <div class="col-md-6">

                        <div class="form-check">

                            <input asp-for="IsRespondentSpecific"
                                   class="form-check-input" />

                            <label asp-for="IsRespondentSpecific"
                                   class="form-check-label">
                            </label>

                        </div>

                        <div class="form-text">
                            Select this when the issued return can be
                            prepared specifically for an individual
                            respondent or institution.
                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="form-check">

                            <input asp-for="SupportsPreviousPeriodData"
                                   class="form-check-input" />

                            <label asp-for="SupportsPreviousPeriodData"
                                   class="form-check-label">
                            </label>

                        </div>

                        <div class="form-text">
                            Select this when previous-period values can
                            be carried into the respondent's next
                            reporting return.
                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="form-check">

                            <input asp-for="IsActive"
                                   class="form-check-input" />

                            <label asp-for="IsActive"
                                   class="form-check-label">
                            </label>

                        </div>

                        <div class="form-text">
                            Inactive templates remain in the catalogue
                            for history but should not be used for new
                            collection activity.
                        </div>

                    </div>

                </div>
            </div>

            <div class="card-footer bg-white">

                <div class="d-flex justify-content-end gap-2">

                    <a asp-controller="DataCollectionTemplates"
                       asp-action="Index"
                       asp-route-statisticalProcessId="@Model.StatisticalProcessId"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Data Collection Template
                    </button>

                </div>

            </div>

        </div>

    </form>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}