@model ISSService.Web.Models.ReportingCycles.ReportingCycleViewModel

@{
    ViewData["Title"] = "Add Reporting Cycle";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-3">
        <a asp-controller="ReportingCycles"
           asp-action="Index"
           asp-route-statisticalProcessId="@Model.StatisticalProcessId"
           class="text-decoration-none">
            &larr; Back to Reporting Cycles
        </a>
    </div>

    <div class="mb-4">
        <h1 class="mb-1">Add Reporting Cycle</h1>

        <p class="text-muted mb-0">
            Configure a reporting period and collection window for
            <strong>@Model.StatisticalProcessName</strong>.
        </p>
    </div>

    <form asp-controller="ReportingCycles"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="StatisticalProcessId" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             role="alert">
        </div>

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-white py-3">
                <h4 class="mb-0">Cycle Configuration</h4>
            </div>

            <div class="card-body">

                <div class="alert alert-light border mb-4">
                    <div class="row">
                        <div class="col-md-3">
                            <small class="text-muted d-block">
                                Statistical Process
                            </small>

                            <strong>
                                @Model.StatisticalProcessName
                            </strong>
                        </div>

                        <div class="col-md-3">
                            <small class="text-muted d-block">
                                Process Code
                            </small>

                            <strong>
                                @Model.StatisticalProcessCode
                            </strong>
                        </div>
                    </div>
                </div>

                <div class="row g-3">

                    <div class="col-md-4">
                        <label asp-for="Code"
                               class="form-label">
                        </label>

                        <input asp-for="Code"
                               class="form-control"
                               placeholder="e.g. 2026-Q3" />

                        <span asp-validation-for="Code"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            Unique cycle code within this statistical process.
                        </div>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="Name"
                               class="form-label">
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="e.g. SACCO Returns - Quarter 3 2026" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-12">
                        <hr class="my-2" />
                        <h5 class="mb-0">Reporting Period</h5>
                        <small class="text-muted">
                            Define the period to which the submitted data relates.
                        </small>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PeriodStartDate"
                               class="form-label">
                        </label>

                        <input asp-for="PeriodStartDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="PeriodStartDate"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PeriodEndDate"
                               class="form-label">
                        </label>

                        <input asp-for="PeriodEndDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="PeriodEndDate"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-12">
                        <hr class="my-2" />
                        <h5 class="mb-0">Collection Schedule</h5>
                        <small class="text-muted">
                            Define when respondents can submit their returns
                            and the applicable deadline.
                        </small>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="CollectionOpenDate"
                               class="form-label">
                        </label>

                        <input asp-for="CollectionOpenDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="CollectionOpenDate"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="SubmissionDueDate"
                               class="form-label">
                        </label>

                        <input asp-for="SubmissionDueDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="SubmissionDueDate"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="CollectionCloseDate"
                               class="form-label">
                        </label>

                        <input asp-for="CollectionCloseDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="CollectionCloseDate"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Status"
                               class="form-label">
                        </label>

                        <select asp-for="Status"
                                asp-items="Html.GetEnumSelectList<ISSService.Data.Entities.ReportingCycleStatus>()"
                                class="form-select">
                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            New cycles should normally begin as Draft.
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Notes"
                               class="form-label">
                        </label>

                        <textarea asp-for="Notes"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Optional notes about this reporting cycle.">
                        </textarea>

                        <span asp-validation-for="Notes"
                              class="text-danger">
                        </span>
                    </div>

                </div>
            </div>

            <div class="card-footer bg-white">
                <div class="d-flex justify-content-end gap-2">

                    <a asp-controller="ReportingCycles"
                       asp-action="Index"
                       asp-route-statisticalProcessId="@Model.StatisticalProcessId"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Reporting Cycle
                    </button>

                </div>
            </div>

        </div>
    </form>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}