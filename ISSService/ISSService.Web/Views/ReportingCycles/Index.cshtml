@model IEnumerable<ISSService.Web.Models.ReportingCycles.ReportingCycleViewModel>

@{
    ViewData["Title"] = "Reporting Cycles";

    var processId = (int)ViewBag.StatisticalProcessId;
    var processCode = ViewBag.StatisticalProcessCode as string ?? "";
    var processName = ViewBag.StatisticalProcessName as string ?? "";
    var cycles = Model.ToList();
}

<div class="container-fluid px-4 py-4">

    <div class="mb-3">
        <a asp-controller="StatisticalProcesses"
           asp-action="Index"
           class="text-decoration-none">
            &larr; Back to Statistical Process Catalogue
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <h1 class="mb-1">Reporting Cycles</h1>
            <p class="text-muted mb-0">
                Manage reporting periods and collection windows for
                <strong>@processName</strong>.
            </p>
        </div>

        <div>
            <a asp-controller="ReportingCycles"
               asp-action="Create"
               asp-route-statisticalProcessId="@processId"
               class="btn btn-primary">
                Add Reporting Cycle
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h4 class="mb-1">@processName</h4>
                    <div class="text-muted">
                        Process Code: <strong>@processCode</strong>
                    </div>
                </div>

                <span class="badge bg-secondary">
                    @cycles.Count cycle(s)
                </span>
            </div>
        </div>

        <div class="card-body p-0">

            @if (!cycles.Any())
            {
                <div class="text-center py-5 px-4">
                    <h4>No reporting cycles configured</h4>

                    <p class="text-muted mb-4">
                        No reporting cycle has yet been created for
                        @processName. Create the first cycle to define
                        the reporting period, collection window and
                        submission deadline.
                    </p>

                    <a asp-controller="ReportingCycles"
                       asp-action="Create"
                       asp-route-statisticalProcessId="@processId"
                       class="btn btn-primary">
                        Add Reporting Cycle
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Code</th>
                                <th>Reporting Cycle</th>
                                <th>Reporting Period</th>
                                <th>Collection Window</th>
                                <th>Submission Due</th>
                                <th>Status</th>
                                <th class="text-center">Respondent Cases</th>
                                <th class="text-center">Templates</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var cycle in cycles)
                            {
                                var statusClass = cycle.Status switch
                                {
                                    ISSService.Data.Entities.ReportingCycleStatus.Draft
                                        => "bg-secondary",

                                    ISSService.Data.Entities.ReportingCycleStatus.Scheduled
                                        => "bg-info text-dark",

                                    ISSService.Data.Entities.ReportingCycleStatus.Open
                                        => "bg-success",

                                    ISSService.Data.Entities.ReportingCycleStatus.Closed
                                        => "bg-dark",

                                    ISSService.Data.Entities.ReportingCycleStatus.Cancelled
                                        => "bg-danger",

                                    _ => "bg-secondary"
                                };

                                <tr>
                                    <td>
                                        <strong>@cycle.Code</strong>
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @cycle.Name
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(cycle.Notes))
                                        {
                                            <small class="text-muted">
                                                @cycle.Notes
                                            </small>
                                        }
                                    </td>

                                    <td>
                                        <div>
                                            @cycle.PeriodStartDate.ToString("dd MMM yyyy")
                                        </div>

                                        <small class="text-muted">
                                            to @cycle.PeriodEndDate.ToString("dd MMM yyyy")
                                        </small>
                                    </td>

                                    <td>
                                        @if (cycle.CollectionOpenDate.HasValue ||
                                             cycle.CollectionCloseDate.HasValue)
                                        {
                                            <div>
                                                @(cycle.CollectionOpenDate?.ToString("dd MMM yyyy")
                                                    ?? "Not set")
                                            </div>

                                            <small class="text-muted">
                                                to
                                                @(cycle.CollectionCloseDate?.ToString("dd MMM yyyy")
                                                    ?? "Not set")
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not set
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (cycle.SubmissionDueDate.HasValue)
                                        {
                                            @cycle.SubmissionDueDate.Value.ToString("dd MMM yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not set
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="badge @statusClass">
                                            @cycle.Status
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        @cycle.RespondentCaseCount
                                    </td>

                                    <td class="text-center">
                                        @cycle.TemplateAssignmentCount
                                    </td>

                                    <td class="text-end text-nowrap">
                                        <a asp-controller="ReportingCycles"
                                           asp-action="Details"
                                           asp-route-id="@cycle.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            Details
                                        </a>

                                        <a asp-controller="ReportingCycles"
                                           asp-action="Edit"
                                           asp-route-id="@cycle.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <a asp-controller="RespondentCases"
                                           asp-action="Index"
                                           asp-route-reportingCycleId="@cycle.Id"
                                           class="btn btn-sm btn-outline-info">
                                            Cases
                                        </a>

                                        <a asp-controller="CycleTemplateAssignments"
                                           asp-action="Index"
                                           asp-route-reportingCycleId="@cycle.Id"
                                           class="btn btn-sm btn-outline-success">
                                            Templates
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>
</div>