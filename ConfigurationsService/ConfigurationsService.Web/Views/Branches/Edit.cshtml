@model ConfigurationsService.Core.Models.Branches.BranchDto

@{
    ViewData["Title"] = "Edit Branch";
    Layout = "_Layout";
}

<div class="d-flex justify-content-end align-items-center mb-4 mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="row g-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h2>Edit Branch</h2>
                    <h6 class="card-subtitle my-1 text-body-secondary">
                        <span>Update branch details.</span>
                    </h6>
                </div>
            </div>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    
                    <div class="form-floating mb-3">
                        <input type="text" asp-for="Name" class="form-control" placeholder="Branch Name" required>
                        <label asp-for="Name">Branch Name</label>
                        <span asp-validation-for="Name" class="text-danger small d-block mt-1"></span>
                    </div>
                </div>

                <div class="card-footer d-flex justify-content-between">
                    <button type="submit" class="btn btn-success">
                        <i class="ti ti-check me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}