@model List<ConfigurationsService.Core.Models.Branches.BranchDto>

@{
    ViewData["Title"] = "Branches";
    Layout = "_Layout";
}

<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h3>Branches</h3>
            <h6 class="card-subtitle my-1 text-body-secondary">Manage bank branches in the system</h6>
        </div>
        <a asp-action="Create" class="btn btn-crimson btn-md">
            <i class="ti ti-plus ti-light"></i> Create Branch
        </a>
    </div>

    <div class="card-body">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="ti ti-circle-check me-2"></i>
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="ti ti-alert-circle me-2"></i>
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                <i class="ti ti-info-circle me-2"></i>
                No branches have been added yet. Use the "Create Branch" button to add the first branch.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle w-100">
                    <thead>
                        <tr>
                            <th>
                                <i class="ti ti-git-branch me-2"></i>Branch Name
                            </th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Name</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                                        <i class="ti ti-eye me-1"></i>Details
                                    </a> |
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                        <i class="ti ti-edit me-1"></i>Edit
                                    </a> |
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                        <i class="ti ti-trash me-1"></i>Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>