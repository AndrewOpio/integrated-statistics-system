@model List<ConfigurationsService.Core.Models.CommercialBankBranches.CommercialBankBranchViewModel>

@{
    ViewData["Title"] = "Commercial Bank Branches";
    Layout = "_Layout";
}

<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h3>Commercial Bank Branches</h3>
            <h6 class="card-subtitle my-1 text-body-secondary">Manage commercial bank branches in the system</h6>
        </div>
        <a asp-action="Create" class="btn btn-crimson btn-md">
            <i class="ti ti-plus ti-light"></i> Create Branch
        </a>
    </div>

    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="alert alert-info">
                <i class="ti ti-info-circle me-2"></i>
                No commercial bank branches have been added yet. Use the "Create Branch" button to add the first branch.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle w-100 datatable">
                    <thead>
                        <tr>
                            <th>
                                <i class="ti ti-git-branch me-2"></i>Branch Name
                            </th>
                            <th>Location</th>
                            <th>Commercial Bank</th>
                            <th>District</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Name</td>
                                <td>@item.Location</td>
                                <td>@item.CommercialBank?.Name</td>
                                <td>@item.District?.Name</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">
                                        <i class="ti ti-eye me-1"></i>Details
                                    </a> |
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">
                                        <i class="ti ti-edit me-1"></i>Edit
                                    </a> |
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="ti ti-trash me-1"></i>Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>