@model ConfigurationsService.Core.Models.CommercialBankBranches.CommercialBankBranchViewModel

@{
    ViewData["Title"] = "Create Commercial Bank Branch";
    Layout = "_Layout";
}

<div class="d-flex justify-content-end align-items-center mb-4 mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="row g-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h2>Create Commercial Bank Branch</h2>
                    <h6 class="card-subtitle my-1 text-body-secondary">
                        <span>Add a new commercial bank branch to the system.</span>
                    </h6>
                </div>
            </div>

            <form asp-action="Create" method="post">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    
                    <div class="form-floating mb-3">
                        <input type="text" asp-for="Name" class="form-control" placeholder="Branch Name" required>
                        <label asp-for="Name">Branch Name</label>
                        <span asp-validation-for="Name" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input type="text" asp-for="Location" class="form-control" placeholder="Location" required>
                        <label asp-for="Location">Location</label>
                        <span asp-validation-for="Location" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <select asp-for="CommercialBankId" class="form-select" asp-items="@(ViewData["CommercialBankId"] as SelectList)" required>
                            <option value="">Select a bank</option>
                        </select>
                        <label asp-for="CommercialBankId">Commercial Bank</label>
                        <span asp-validation-for="CommercialBankId" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <select asp-for="DistrictId" class="form-select" asp-items="@(ViewData["DistrictId"] as SelectList)" required>
                            <option value="">Select a district</option>
                        </select>
                        <label asp-for="DistrictId">District</label>
                        <span asp-validation-for="DistrictId" class="text-danger small d-block mt-1"></span>
                    </div>
                </div>

                <div class="card-footer d-flex justify-content-between">
                    <button type="submit" class="btn btn-success">
                        <i class="ti ti-check me-1"></i>Save Branch
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}