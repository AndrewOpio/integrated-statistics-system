@model ConfigurationsService.Core.Models.CommercialBankBranches.CommercialBankBranchViewModel

@{
    ViewData["Title"] = "Commercial Bank Branch Details";
    Layout = "_Layout";
}

<div class="d-flex justify-content-end align-items-center mb-4 mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="row g-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h2>Commercial Bank Branch Details</h2>
                    <h6 class="card-subtitle my-1 text-body-secondary">
                        <span>View commercial bank branch information.</span>
                    </h6>
                </div>
            </div>

            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">
                        <i class="ti ti-git-branch me-2"></i>
                        @Html.DisplayNameFor(model => model.Name)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.Name)
                    </dd>

                    <dt class="col-sm-3">
                        <i class="ti ti-map-pin me-2"></i>
                        @Html.DisplayNameFor(model => model.Location)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.Location)
                    </dd>

                    <dt class="col-sm-3">
                        <i class="ti ti-building me-2"></i>
                        Commercial Bank
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.CommercialBank.Name)
                    </dd>

                    <dt class="col-sm-3">
                        <i class="ti ti-map me-2"></i>
                        District
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.District.Name)
                    </dd>
                </dl>
            </div>

            <div class="card-footer d-flex justify-content-between">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="ti ti-edit me-1"></i>Edit
                </a> |
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>