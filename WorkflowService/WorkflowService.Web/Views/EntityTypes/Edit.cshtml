@model WorkflowService.Core.Models.EntityTypes.EntityTypeViewModel

@{
    ViewData["Title"] = "Edit Entity Type";
}

<div class="row">
    <div>
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <h2 class="fs-5 fw-bold mb-0">Edit Entity Type</h2>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert">
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>

                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id">

                    <div class="mb-3">
                        <label class="form-label" asp-for="Name">Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" asp-for="Name" placeholder="Enter entity type name" required>
                        <span asp-validation-for="Name" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="ApplicationId">Application <span class="text-danger">*</span></label>
                        <select asp-for="ApplicationId" asp-items="Model.ApplicationsList" class="form-select" required>
                            <option value="">-- Select Application --</option>
                        </select>
                        <span asp-validation-for="ApplicationId" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-check me-1"></i>Update
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="ti ti-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>