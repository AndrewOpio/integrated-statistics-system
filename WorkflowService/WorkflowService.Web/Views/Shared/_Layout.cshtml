@using Microsoft.Extensions.Configuration
@using System.Security.Claims
@inject IConfiguration Configuration

@{
    string logoutUrl = $"{Configuration["MicroServices:gatewayservice"]}/Login/Logout?username={User.FindFirstValue(ClaimTypes.Name)}";
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WorkflowService.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tabler-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dataTables.dataTables.css" asp-append-version="true" />
    <!-- Volt CSS -->
    <link type="text/css" href="../../css/volt.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WorkflowService.Web.styles.css" asp-append-version="true" />
    <!-- Apply saved theme immediately to prevent flash -->
    <script>
        (function () {
            const saved = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', saved);
        })();
    </script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg border-bottom box-shadow ps-4 pe-4">
            <img class="img-fluid me-2" src="/img/bou.png" alt="" width="30" height="30">
            <a class="navbar-brand fs-5" href="/">Aswam Workflows</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-flex justify-content-between" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item active">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item active">
                        <a class="nav-link" asp-controller="StatusTypes" asp-action="Index">Status Types</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="EntityTypes" asp-action="Index">Entity Types</a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <!-- Theme Toggle Button -->
                    <li class="nav-item d-flex align-items-center me-3">
                        <button id="themeToggleBtn" class="btn btn-sm btn-outline-secondary border-0" type="button" title="Toggle light/dark mode" aria-label="Toggle theme">
                            <i id="themeIcon" class="ti ti-sun fs-5"></i>
                        </button>
                    </li>
                    <li class="nav-item d-flex align-items-center">
                        <a class="btn btn-sm btn-outline-secondary me-4" href="@Configuration["MicroServices:gatewayservice"]">Go To Aswam Home</a>
                    </li>
                    @if (Context.Request.Cookies["AuthToken"] != null)
                    {
                        <li class="nav-item d-flex align-items-center">
                            <span class="navbar-text me-3">@Context.Request.Cookies["Username"]</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@logoutUrl">Logout</a>
                        </li>
                    }
                </ul>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <main role="main" class="p-4">
            <div class="d-flex align-items-center">
                @if (ViewBag.BreadcrumbItems != null)
                {
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            @foreach (var (text, url) in (List<(string, string)>)ViewBag.BreadcrumbItems)
                            {
                                <li class="breadcrumb-item">
                                    <a href="@url">@text</a>
                                </li>
                            }
                        </ol>
                    </nav>
                }
                else
                {
                    <breadcrumb></breadcrumb>
                    <!-- SmartBreadcrumbs default rendering -->
                    @* <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <!-- SmartBreadcrumbs will render here -->
                        </ol>
                    </nav> *@
                }
            </div>
            @if (TempData["Success"] != null)
            {
                <div class="container-fluid mt-3">
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="container-fluid mt-3">
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Bank of Uganda Aswam Workflow Service
        </div>
    </footer>
    <!-- Core -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Vanilla JS Datepicker -->
    <script src="../../vendor/vanillajs-datepicker/dist/js/datepicker.min.js"></script>
    <!-- Simplebar -->
    <script src="../../vendor/simplebar/dist/simplebar.min.js"></script>
    <script src="~/js/dataTables.js"></script>
    <!-- Volt JS -->
    <script src="../../js/volt.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- Theme Toggle Script -->
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
    @await Html.PartialAsync("_SessionTimeout")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
