@using WorkflowService.Core.Models.WorkflowTransitions
@model WorkflowTransitionViewModel
@{
    ViewData["Title"] = "Edit Workflow Transition";
    var applicationId = Context.Request.Query["applicationId"].ToString();
}

<div class="page-header d-print-none">
    <div class="row align-items-center">
        <div class="col">
            <h4 class="page-title">
                Edit Workflow Transition
            </h4>
        </div>
    </div>
</div>

<div class="row row-deck row-cards">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit" method="post" asp-route-applicationId="@applicationId" class="needs-validation" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert">
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        <span asp-validation-summary="All"></span>
                    </div>
                    <input asp-for="Id" type="hidden" />
                    <input asp-for="EntityTypeId" type="hidden" />
                    <input asp-for="EntityTypeName" type="hidden" />
                    <input asp-for="FromStatusId" type="hidden" />
                    <input asp-for="FromStatusName" type="hidden" />
                    <input asp-for="ToStatusId" type="hidden" />
                    <input asp-for="ToStatusName" type="hidden" />
                    <input asp-for="ActionName" type="hidden" />

                    <!-- Entity Type (Read-only) -->
                    <div class="mb-3">
                        <label class="form-label small text-muted text-uppercase m-0">Entity Type</label>
                        <div>
                            <span class="badge bg-tertiary">@Model.EntityTypeName</span>
                        </div>
                    </div>

                    <!-- From Status (Read-only) -->
                    <div class="mb-3">
                        <label class="form-label small text-muted text-uppercase m-0">From Status</label>
                        <div>
                            <span class="badge bg-info">@Model.FromStatusName</span>
                        </div>
                    </div>

                    <!-- To Status (Read-only) -->
                    <div class="mb-3">
                        <label class="form-label small text-muted text-uppercase m-0">To Status</label>
                        <div>
                            <span class="badge bg-success">@Model.ToStatusName</span>
                        </div>
                    </div>

                    <!-- Action Name (Read-only) -->
                    <div class="mb-3">
                        <label class="form-label small text-muted text-uppercase m-0">Action Name</label>
                        <div>
                            <div class="btn btn-gray-200">
                                @Model.ActionName
                            </div>
                        </div>
                    </div>

                    <!-- Display Label -->
                    <div class="mb-3">
                        <label class="form-label" for="DisplayLabel">Display Label <span class="text-danger">*</span></label>
                        <input asp-for="DisplayLabel" type="text" class="form-control" required />
                        <span asp-validation-for="DisplayLabel" class="invalid-feedback"></span>
                    </div>

                    <!-- Required Role -->
                    <div class="mb-3">
                        <label class="form-label" for="RequiredRole">Required Role <span class="text-danger">*</span></label>
                        <select asp-for="RequiredRole" id="RequiredRole" asp-items="Model.RequiredRoleList" class="form-select" required>
                            <option value="">-- Select Role --</option>
                        </select>
                        <span asp-validation-for="RequiredRole" class="invalid-feedback"></span>
                        <small class="form-hint">User role required to perform this transition</small>
                    </div>

                    <!-- Button Class -->
                    <div class="mb-3">
                        <label class="form-label" for="ButtonClass">Button Class <span class="text-danger">*</span></label>
                        <select asp-for="ButtonClass" class="form-select" required>
                            <option value="">-- Select Button Class --</option>
                            @foreach (var buttonClass in (List<string>)ViewBag.ButtonClasses)
                            {
                                <option value="@buttonClass">@buttonClass</option>
                            }
                        </select>
                        <span asp-validation-for="ButtonClass" class="invalid-feedback"></span>
                    </div>

                    <!-- Requires Comments -->
                    <div class="mb-3">
                        <div class="form-check">
                            <input asp-for="RequiresComments" type="checkbox" class="form-check-input" id="RequiresComments" />
                            <label class="form-check-label" for="RequiresComments">
                                Requires Comments/Remarks
                            </label>
                        </div>
                    </div>

                    <!-- Attachment Requirements Section -->
                    <h6 class="mb-3 mt-3"><i class="ti ti-paperclip me-1"></i>Attachment Requirements</h6>

                    <div class="mb-3">
                        <div class="form-check">
                            <input asp-for="RequiresAttachments" type="checkbox" class="form-check-input" id="RequiresAttachments" />
                            <label class="form-check-label" for="RequiresAttachments">
                                Require Attachment(s)
                            </label>
                        </div>
                        <small class="form-hint d-block mt-2">Check if users must provide attachments when performing this transition</small>
                    </div>

                    <div id="attachmentsConfigSection" class="d-none">
                        <div class="card border">
                            <div class="card-header bg-light">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0">Configure Required Attachments</h6>
                                    <button type="button" id="addAttachmentBtn" class="btn btn-sm btn-primary">
                                        <i class="ti ti-plus me-1"></i>Add Attachment
                                    </button>
                                </div>
                            </div>
                            <div class="card-body">
                                <div id="attachmentsList" class="space-y-3"></div>
                                <div id="noAttachmentsMessage" class="text-center text-muted py-4">
                                    <i class="ti ti-file-alert fs-2 mb-2"></i>
                                    <p class="mb-0">No attachments configured yet. Click "Add Attachment" to add one.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <input type="hidden" id="attachmentsJson" name="attachmentsJson" value="" />

                    <!-- Active Status -->
                    <div class="mb-3 mt-3">
                        <div class="form-check">
                            <input asp-for="IsActive" type="checkbox" class="form-check-input" id="IsActive" />
                            <label class="form-check-label" for="IsActive">
                                Active
                            </label>
                        </div>
                        <small class="form-hint d-block mt-2">Uncheck to disable this transition</small>
                    </div>

                    <hr />

                    <!-- Notification Settings -->
                    <h6 class="mb-3"><i class="ti ti-bell me-1"></i>Notification Settings</h6>

                    <!-- Send Notification -->
                    <div class="mb-3">
                        <div class="form-check">
                            <input asp-for="SendNotification" type="checkbox" class="form-check-input" id="SendNotification" />
                            <label class="form-check-label" for="SendNotification">
                                Send Email Notification
                            </label>
                        </div>
                        <small class="form-hint d-block mt-2">Check to send an email notification when this transition is performed</small>
                    </div>

                    <!-- Notification Recipients (shown when SendNotification is checked) -->
                    <div id="notificationRecipientsSection" class="d-none">
                        <!-- Notification Roles (Multi-select) -->
                        <div class="mb-3">
                            <label class="form-label">Notification Recipient Roles</label>
                            <select id="NotificationRoleIds" name="SelectedNotificationRoleIds" class="form-select" multiple size="4">
                                @foreach (var role in Model.RequiredRoleList)
                                {
                                    var isSelected = Model.SelectedNotificationRoleIds.Contains(int.Parse(role.Value));
                                    <option value="@role.Value" selected="@isSelected">@role.Text</option>
                                }
                            </select>
                            <small class="form-hint">Hold Ctrl/Cmd to select multiple roles that should receive the notification</small>
                        </div>

                        <!-- Notification Emails (Tag-style input) -->
                        <div class="mb-3">
                            <label class="form-label">Notification Email Addresses</label>
                            <div class="border rounded p-2" id="emailTagsContainer" style="min-height: 42px; cursor: text;">
                                <span id="emailTags"></span>
                                <input type="email" id="emailInput" class="border-0 outline-0 flex-grow-1" style="outline: none; min-width: 200px;" placeholder="Type an email and press Enter" />
                            </div>
                            <input type="hidden" id="NotificationEmails" name="NotificationEmails" value="@Model.NotificationEmails" />
                            <div id="emailValidationError" class="text-danger small d-none">Please enter a valid email address.</div>
                            <small class="form-hint">Type an email address and press Enter or comma to add it</small>
                        </div>
                    </div>

                    <hr />

                    <!-- Form Actions -->
                    <div class="form-footer">
                        <a href="@Url.Action("Index", "WorkflowTransitions", new { applicationId })" class="btn btn-secondary"><i class="ti ti-arrow-left me-1"></i>Cancel</a>
                        <button type="submit" class="btn btn-primary"><i class="ti ti-check me-1"></i>Update Transition</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Info Card -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header ">
                <h5 class="card-title m-0">Transition Details</h5>
            </div>
            <div class="card-body text-sm">
                <p>
                    <strong class="small text-muted text-uppercase">Entity Type:</strong><br />
                    <span class="text-primary">@Model.EntityTypeName</span>
                </p>
                <p>
                    <strong class="small text-muted text-uppercase">From Status:</strong><br />
                    <span class="text-primary">@Model.FromStatusName</span>
                </p>
                <p>
                    <strong class="small text-muted text-uppercase">To Status:</strong><br />
                    <span class="text-primary">@Model.ToStatusName</span>
                </p>
                <p>
                    <strong class="small text-muted text-uppercase">Action Name:</strong><br />
                    <span class="text-primary">@Model.ActionName</span>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // --- Notification toggle ---
            const sendNotificationCheckbox = document.getElementById('SendNotification');
            const notificationSection = document.getElementById('notificationRecipientsSection');

            function toggleNotificationSection() {
                if (sendNotificationCheckbox.checked) {
                    notificationSection.classList.remove('d-none');
                } else {
                    notificationSection.classList.add('d-none');
                }
            }

            sendNotificationCheckbox.addEventListener('change', toggleNotificationSection);
            toggleNotificationSection();

            // --- Email tags input ---
            const emailInput = document.getElementById('emailInput');
            const emailTagsContainer = document.getElementById('emailTagsContainer');
            const emailTagsSpan = document.getElementById('emailTags');
            const hiddenEmailField = document.getElementById('NotificationEmails');
            const emailValidationError = document.getElementById('emailValidationError');

            // Initialize from existing value
            const emailList = hiddenEmailField.value
                ? hiddenEmailField.value.split(',').map(e => e.trim()).filter(e => e)
                : [];

            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

            function renderTags() {
                emailTagsSpan.innerHTML = '';
                emailList.forEach((email, index) => {
                    const tag = document.createElement('span');
                    tag.className = 'badge bg-primary me-1 mb-1';
                    tag.style.fontSize = '0.85em';
                    tag.innerHTML = email + ' <span class="ms-1" style="cursor:pointer;" data-index="' + index + '">&times;</span>';
                    tag.querySelector('span').addEventListener('click', function () {
                        emailList.splice(index, 1);
                        renderTags();
                    });
                    emailTagsSpan.appendChild(tag);
                });
                hiddenEmailField.value = emailList.join(',');
            }

            function addEmail(value) {
                const email = value.trim();
                if (!email) return;
                if (!emailRegex.test(email)) {
                    emailValidationError.classList.remove('d-none');
                    return;
                }
                emailValidationError.classList.add('d-none');
                if (!emailList.includes(email)) {
                    emailList.push(email);
                    renderTags();
                }
                emailInput.value = '';
            }

            emailInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ',') {
                    e.preventDefault();
                    addEmail(emailInput.value.replace(',', ''));
                }
                if (e.key === 'Backspace' && emailInput.value === '' && emailList.length > 0) {
                    emailList.pop();
                    renderTags();
                }
            });

            emailInput.addEventListener('blur', function () {
                if (emailInput.value.trim()) {
                    addEmail(emailInput.value);
                }
            });

            emailTagsContainer.addEventListener('click', function () {
                emailInput.focus();
            });

            // Render existing tags on load
            renderTags();

            // --- Attachments Management ---
            const requiresAttachmentsCheckbox = document.getElementById('RequiresAttachments');
            const attachmentsConfigSection = document.getElementById('attachmentsConfigSection');
            const attachmentsList = document.getElementById('attachmentsList');
            const noAttachmentsMessage = document.getElementById('noAttachmentsMessage');
            const addAttachmentBtn = document.getElementById('addAttachmentBtn');
            const attachmentsJsonField = document.getElementById('attachmentsJson');

            const fileFormats = [
                { value: 'pdf', label: 'PDF', color: 'danger' },
                { value: 'excel', label: 'Excel', color: 'success' },
                { value: 'docx', label: 'Word (DOCX)', color: 'primary' },
                { value: 'png', label: 'PNG Image', color: 'info' },
                { value: 'jpg', label: 'JPG Image', color: 'warning' }
            ];

            // Seed from model
            let attachments = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.AttachmentRequirements.Select(a => new {
                    id = a.Id,
                    name = a.AttachmentName,
                    formats = a.FormatsList
                })
            ));
            let attachmentCounter = attachments.length;

            function toggleAttachmentsSection() {
                if (requiresAttachmentsCheckbox.checked) {
                    attachmentsConfigSection.classList.remove('d-none');
                } else {
                    attachmentsConfigSection.classList.add('d-none');
                }
            }

            function updateAttachmentsJson() {
                const jsonData = attachments.map((att, index) => ({
                    Id: att.id || 0,
                    WorkflowTransitionId: 0,
                    AttachmentName: att.name,
                    AllowedFormats: att.formats.join(','),
                    DisplayOrder: index + 1,
                    IsRequired: true
                }));
                attachmentsJsonField.value = JSON.stringify(jsonData);
            }

            function renderAttachments() {
                attachmentsList.innerHTML = '';
                if (attachments.length === 0) {
                    noAttachmentsMessage.classList.remove('d-none');
                    updateAttachmentsJson();
                    return;
                }
                noAttachmentsMessage.classList.add('d-none');

                attachments.forEach((attachment, index) => {
                    const card = document.createElement('div');
                    card.className = 'card mb-3 border-primary';
                    card.innerHTML = `
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h6 class="mb-0"><i class="ti ti-file-text me-1"></i>Attachment ${index + 1}</h6>
                                <button type="button" class="btn btn-sm btn-danger" data-index="${index}"><i class="ti ti-trash"></i></button>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Attachment Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control attachment-name" data-index="${index}"
                                       value="${attachment.name}" placeholder="e.g., Approval Letter" required />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Allowed File Formats <span class="text-danger">*</span></label>
                                <div class="d-flex flex-wrap gap-2">
                                    ${fileFormats.map(format => `
                                        <div class="form-check">
                                            <input class="form-check-input format-checkbox" type="checkbox"
                                                   id="format_${index}_${format.value}"
                                                   data-index="${index}" data-format="${format.value}"
                                                   ${attachment.formats.includes(format.value) ? 'checked' : ''}>
                                            <label class="form-check-label" for="format_${index}_${format.value}">
                                                <span class="badge bg-${format.color}">${format.label}</span>
                                            </label>
                                        </div>
                                    `).join('')}
                                </div>
                            </div>
                        </div>`;
                    attachmentsList.appendChild(card);
                });

                attachmentsList.querySelectorAll('.btn-danger').forEach(btn => {
                    btn.addEventListener('click', function () {
                        attachments.splice(parseInt(this.getAttribute('data-index')), 1);
                        renderAttachments();
                    });
                });
                attachmentsList.querySelectorAll('.attachment-name').forEach(input => {
                    input.addEventListener('input', function () {
                        attachments[parseInt(this.getAttribute('data-index'))].name = this.value;
                        updateAttachmentsJson();
                    });
                });
                attachmentsList.querySelectorAll('.format-checkbox').forEach(checkbox => {
                    checkbox.addEventListener('change', function () {
                        const index = parseInt(this.getAttribute('data-index'));
                        const format = this.getAttribute('data-format');
                        if (this.checked) {
                            if (!attachments[index].formats.includes(format)) attachments[index].formats.push(format);
                        } else {
                            attachments[index].formats = attachments[index].formats.filter(f => f !== format);
                        }
                        renderAttachments();
                    });
                });

                updateAttachmentsJson();
            }

            addAttachmentBtn.addEventListener('click', function () {
                attachments.push({ id: 0, name: '', formats: [] });
                renderAttachments();
            });

            requiresAttachmentsCheckbox.addEventListener('change', toggleAttachmentsSection);
            toggleAttachmentsSection();
            renderAttachments();
        });
    </script>
}