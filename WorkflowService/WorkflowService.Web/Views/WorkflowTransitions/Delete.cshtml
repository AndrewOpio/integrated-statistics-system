@using WorkflowService.Core.Models.WorkflowTransitions
@model WorkflowTransitionViewModel
@{
    ViewData["Title"] = "Delete Workflow Transition";
    int applicationId = ViewBag.ApplicationId;
}

<!-- Page title -->
<div class="page-header d-print-none">
    <div class="row align-items-center">
        <div class="col">
            <h5 class="page-title">
                Delete Workflow Transition
            </h5>
        </div>
    </div>
</div>

<div class="row row-deck row-cards">
    <!-- Main Delete Card -->
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <div class="text-center mb-4">
                    <i class="ti ti-alert-triangle text-danger" style="font-size: 2.5rem;"></i>
                </div>

                <h5 class="text-center mb-2">Are you sure?</h5>
                <p class="text-muted text-center small mb-4">
                    You are about to delete this workflow transition. This action cannot be undone, but the data will be preserved.
                </p>

                <div class="alert alert-warning alert-icon mb-4" role="alert">
                    <div class="d-flex">
                        <div>
                            <i class="ti ti-info-circle alert-icon-svg"></i>
                        </div>
                        <div>
                            <h6 class="alert-title mb-1">This transition will be deleted</h6>
                            <div class="text-muted small">This action cannot be undone. The transition will be deleted from the system.</div>
                        </div>
                    </div>
                </div>

                <!-- Transition Details -->
                <h6 class="mb-3">Transition Details:</h6>

                <div class="row mb-2">
                    <div class="col-md-6">
                        <label class="form-label text-muted small text-uppercase">Entity Type</label>
                        <p class="mb-0">
                            <span class="badge bg-tertiary p-2 more-rounded">@Model.EntityTypeName</span>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small text-uppercase">Action Name</label>
                        <p class="mb-0">
                            <code>@Model.ActionName</code>
                        </p>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-md-6">
                        <label class="form-label text-muted small text-uppercase">From Status</label>
                        <p class="mb-0">
                            <span class="badge bg-info p-2 more-rounded">@Model.FromStatusName</span>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small text-uppercase">To Status</label>
                        <p class="mb-0">
                            <span class="badge bg-info p-2 more-rounded">@Model.ToStatusName</span>
                        </p>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-md-6">
                        <label class="form-label text-muted small text-uppercase">Required Role</label>
                        <p class="mb-0">
                            <span class="badge bg-tertiary p-2 more-rounded">@Model.RequiredRoleName</span>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small text-uppercase">Display Label</label>
                        <p class="mb-0">
                            <strong>@Model.DisplayLabel</strong>
                        </p>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Form Actions -->
                <div class="form-footer">
                    <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" asp-route-applicationId="@ViewBag.ApplicationId" method="post" style="display:inline;">
                        <a href="@Url.Action("Index", "WorkflowTransitions", new { applicationId })" class="btn btn-secondary"><i class="ti ti-arrow-left me-1"></i>Cancel</a>
                        <button type="submit" class="btn btn-danger"><i class="ti ti-trash me-1"></i>Delete Transition</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Card -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title m-0">Transition Summary</h5>
            </div>
            <div class="card-body">
                <div class="space-y-4">
                    <!-- Quick Info -->
                    <div>
                        <h6 class="text-sm mb-2">Quick Info</h6>
                        <div class="text-sm space-y-2">
                            <div>
                                <span class="text-muted small text-uppercase">Transition ID:</span>
                                <strong>#@Model.Id</strong>
                            </div>
                            <div>
                                <span class="text-muted small text-uppercase">Entity Type:</span>
                                <strong>@Model.EntityTypeName</strong>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Flow Details -->
                    <div>
                        <h6 class="text-sm mb-2">Flow Details</h6>
                        <div class="text-sm space-y-2">
                            <div>
                                <span class="text-muted small text-uppercase">From:</span><br />
                                <span class="badge bg-info">@Model.FromStatusName</span>
                            </div>
                            <div>
                                <span class="text-muted small text-uppercase">To:</span><br />
                                <span class="badge bg-info">@Model.ToStatusName</span>
                            </div>
                            <div>
                                <span class="text-muted small text-uppercase">Via Action:</span><br />
                                <code>@Model.ActionName</code>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Permission Details -->
                    <div>
                        <h6 class="text-sm mb-2">Permission Details</h6>
                        <div class="text-sm space-y-2">
                            <div>
                                <span class="text-muted small text-uppercase">Required Role:</span><br />
                                <span class="badge bg-tertiary">@Model.RequiredRoleName</span>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Configuration -->
                    <div>
                        <h6 class="text-sm mb-2">Configuration</h6>
                        <div class="text-sm space-y-2">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted small text-uppercase">Comments Required:</span>
                                @if (Model.RequiresComments)
                                {
                                    <i class="ti ti-check text-success"></i>
                                }
                                else
                                {
                                    <i class="ti ti-x text-danger"></i>
                                }
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted small text-uppercase">Active:</span>
                                @if (Model.IsActive)
                                {
                                    <i class="ti ti-check text-success"></i>
                                }
                                else
                                {
                                    <i class="ti ti-x text-danger"></i>
                                }
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- UI Configuration -->
                    <div>
                        <h6 class="text-sm mb-2">UI Configuration</h6>
                        <div class="text-sm space-y-2">
                            <div class="mb-1">
                                <span class="text-muted small text-uppercase">Button Class:</span><br />
                                <code>@Model.ButtonClass</code>
                            </div>
                            <div>
                                <span class="text-muted small text-uppercase">Display Label:</span><br />
                                <em>@Model.DisplayLabel</em>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>