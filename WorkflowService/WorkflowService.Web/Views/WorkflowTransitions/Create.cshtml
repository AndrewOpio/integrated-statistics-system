@using WorkflowService.Core.Models.WorkflowTransitions
@model WorkflowTransitionViewModel
@{
    ViewData["Title"] = "Create Workflow Transition";
    var applicationId = Context.Request.Query["applicationId"].ToString();
}

<div class="page-header d-print-none">
    <div class="row align-items-center">
        <div class="col">
            <h4 class="page-title">
                Create Workflow Transition
            </h4>
        </div>
    </div>
</div>

<div class="row row-deck row-cards">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create" method="post" asp-route-applicationId="@applicationId" class="needs-validation" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert">
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        <span asp-validation-summary="All"></span>
                    </div>

                    <!-- Entity Type -->
                    <div class="mb-3">
                        <label class="form-label" for="EntityTypeId">Entity Type <span class="text-danger">*</span></label>
                        <select asp-for="EntityTypeId" id="EntityTypeId" asp-items="Model.EntityTypesList" class="form-select" required>
                            <option value="">-- Select Entity Type --</option>
                        </select>
                        <span asp-validation-for="EntityTypeId" class="invalid-feedback"></span>
                    </div>

                    <!-- From Status -->
                    <div class="mb-3">
                        <label class="form-label" for="FromStatusId">From Status <span class="text-danger">*</span></label>
                        <select asp-for="FromStatusId" id="FromStatusId" asp-items="Model.FromStatusesList" class="form-select" required data-entity-type="">
                            <option value="">-- Select Status --</option>
                        </select>
                        <span asp-validation-for="FromStatusId" class="invalid-feedback"></span>
                    </div>

                    <!-- To Status -->
                    <div class="mb-3">
                        <label class="form-label" for="ToStatusId">To Status <span class="text-danger">*</span></label>
                        <select asp-for="ToStatusId" id="ToStatusId" asp-items="Model.ToStatusesList" class="form-select" required data-entity-type="">
                            <option value="">-- Select Status --</option>
                        </select>
                        <span asp-validation-for="ToStatusId" class="invalid-feedback"></span>
                    </div>

                    <!-- Action Name -->
                    <div class="mb-3">
                        <label class="form-label" for="ActionName">Action Name <span class="text-danger">*</span></label>
                        <input asp-for="ActionName" type="text" class="form-control" placeholder="e.g., Verify, Reject, Resubmit" required />
                        <span asp-validation-for="ActionName" class="invalid-feedback"></span>
                        <small class="form-hint">The action/button name that triggers this transition</small>
                    </div>

                    <!-- Display Label -->
                    <div class="mb-3">
                        <label class="form-label" for="DisplayLabel">Display Label <span class="text-danger">*</span></label>
                        <input asp-for="DisplayLabel" type="text" class="form-control" placeholder="e.g., Click to Verify" required />
                        <span asp-validation-for="DisplayLabel" class="invalid-feedback"></span>
                        <small class="form-hint">The button label displayed to users</small>
                    </div>

                    <!-- Required Role -->
                    <div class="mb-3">
                        <label class="form-label" for="RequiredRole">Required Role <span class="text-danger">*</span></label>
                        <select asp-for="RequiredRole" id="RequiredRole" asp-items="Model.RequiredRoleList" class="form-select" required>
                            <option value="">-- Select Role --</option>
                        </select>
                        <span asp-validation-for="RequiredRole" class="invalid-feedback"></span>
                        <small class="form-hint">User role required to perform this transition</small>
                    </div>

                    <!-- Button Class -->
                    <div class="mb-3">
                        <label class="form-label" for="ButtonClass">Button Class <span class="text-danger">*</span></label>
                        <select asp-for="ButtonClass" class="form-select" required>
                            <option value="">-- Select Button Class --</option>
                            @foreach (var buttonClass in (List<string>)ViewBag.ButtonClasses)
                            {
                                <option value="@buttonClass">@buttonClass</option>
                            }
                        </select>
                        <span asp-validation-for="ButtonClass" class="invalid-feedback"></span>
                    </div>

                    <!-- Requires Comments -->
                    <div class="mb-3">
                        <div class="form-check">
                            <input asp-for="RequiresComments" type="checkbox" class="form-check-input" id="RequiresComments" />
                            <label class="form-check-label" for="RequiresComments">
                                Requires Comments/Remarks
                            </label>
                        </div>
                        <small class="form-hint d-block mt-2">Check if users must provide comments when performing this transition</small>
                    </div>

                    <!-- Attachment Requirements Section -->
                    <h6 class="mb-3"><i class="ti ti-paperclip me-1"></i>Attachment Requirements</h6>

                    <!-- Requires Attachments Checkbox -->
                    <div class="mb-3">
                        <div class="form-check">
                            <input asp-for="RequiresAttachments" type="checkbox" class="form-check-input" id="RequiresAttachments" />
                            <label class="form-check-label" for="RequiresAttachments">
                                Require Attachment(s)
                            </label>
                        </div>
                        <small class="form-hint d-block mt-2">Check if users must provide attachments when performing this transition</small>
                    </div>

                    <!-- Attachments Configuration (shown when RequiresAttachments is checked) -->
                    <div id="attachmentsConfigSection" class="d-none">
                        <div class="card border">
                            <div class="card-header bg-light">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0">Configure Required Attachments</h6>
                                    <button type="button" id="addAttachmentBtn" class="btn btn-sm btn-primary">
                                        <i class="ti ti-plus me-1"></i>Add Attachment
                                    </button>
                                </div>
                            </div>
                            <div class="card-body">
                                <div id="attachmentsList" class="space-y-3">
                                    <!-- Attachment items will be added here dynamically -->
                                </div>
                                <div id="noAttachmentsMessage" class="text-center text-muted py-4">
                                    <i class="ti ti-file-alert fs-2 mb-2"></i>
                                    <p class="mb-0">No attachments configured yet. Click "Add Attachment" to add one.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Hidden field to store attachments JSON -->
                    <input type="hidden" id="attachmentsJson" name="attachmentsJson" value="" />

                    <hr />

                    <!-- Notification Settings -->
                    <h6 class="mb-3"><i class="ti ti-bell me-1"></i>Notification Settings</h6>

                    <!-- Send Notification -->
                    <div class="mb-3">
                        <div class="form-check">
                            <input asp-for="SendNotification" type="checkbox" class="form-check-input" id="SendNotification" />
                            <label class="form-check-label" for="SendNotification">
                                Send Email Notification
                            </label>
                        </div>
                        <small class="form-hint d-block mt-2">Check to send an email notification when this transition is performed</small>
                    </div>

                    <!-- Notification Recipients (shown when SendNotification is checked) -->
                    <div id="notificationRecipientsSection" class="d-none">
                        <!-- Notification Roles (Multi-select) -->
                        <div class="mb-3">
                            <label class="form-label">Notification Recipient Roles</label>
                            <select id="NotificationRoleIds" name="SelectedNotificationRoleIds" class="form-select" multiple size="4">
                                @foreach (var role in Model.RequiredRoleList)
                                {
                                    <option value="@role.Value">@role.Text</option>
                                }
                            </select>
                            <small class="form-hint">Hold Ctrl/Cmd to select multiple roles that should receive the notification</small>
                        </div>

                        <!-- Notification Emails (Tag-style input) -->
                        <div class="mb-3">
                            <label class="form-label">Notification Email Addresses</label>
                            <div class="border rounded p-2" id="emailTagsContainer" style="min-height: 42px; cursor: text;">
                                <span id="emailTags"></span>
                                <input type="email" id="emailInput" class="border-0 outline-0 flex-grow-1" style="outline: none; min-width: 200px;" placeholder="Type an email and press Enter" />
                            </div>
                            <input type="hidden" id="NotificationEmails" name="NotificationEmails" value="" />
                            <div id="emailValidationError" class="text-danger small d-none">Please enter a valid email address.</div>
                            <small class="form-hint">Type an email address and press Enter or comma to add it</small>
                        </div>
                    </div>

                    <hr/>

                    <!-- Form Actions -->
                    <div class="form-footer">
                        <a href="@Url.Action("Index", "WorkflowTransitions", new { applicationId })" class="btn btn-secondary"><i class="ti ti-arrow-left me-1"></i>Cancel</a>
                        <button type="submit" class="btn btn-primary"><i class="ti ti-check me-1"></i>Create Transition</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Info Card -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Workflow Transition Guide</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">
                    Workflow transitions define the valid state changes in your system.
                </p>
                <h6 class="mt-3 mb-2">Key Fields:</h6>
                <ul class="list-unstyled space-y-2 text-sm">
                    <li><strong>Entity Type:</strong> The object type this applies to</li>
                    <li><strong>From/To Status:</strong> Source and destination statuses</li>
                    <li><strong>Action Name:</strong> Internal action identifier</li>
                    <li><strong>Display Label:</strong> User-facing button text</li>
                    <li><strong>Required Role:</strong> User must have this role</li>
                    <li><strong>Button Class:</strong> Bootstrap button styling</li>
                    <li><strong>Attachments:</strong> Required documents for transition</li>
                    <li><strong>Send Notification:</strong> Send email on transition</li>
                    <li><strong>Recipients:</strong> Roles and/or emails to notify</li>
                </ul>

                <hr />

                <h6 class="mb-2">Available File Formats:</h6>
                <div class="d-flex flex-wrap gap-1">
                    <span class="badge bg-danger">PDF</span>
                    <span class="badge bg-success">Excel</span>
                    <span class="badge bg-primary">Word</span>
                    <span class="badge bg-info">PNG</span>
                    <span class="badge bg-warning">JPG</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const $entityTypeSelect = document.getElementById('EntityTypeId');
            const $fromStatusSelect = document.getElementById('FromStatusId');
            const $toStatusSelect = document.getElementById('ToStatusId');

            // Build a map of entity types to their status options
            const entityTypeStatusMap = {};

            // Populate the map from the initial options
            Array.from($fromStatusSelect.options).forEach(option => {
                if (option.value) {
                    const text = option.text; // Format: "StatusName (EntityTypeName)"
                    const entityTypeMatch = text.match(/\(([^)]+)\)$/);
                    if (entityTypeMatch) {
                        const entityTypeName = entityTypeMatch[1];
                        if (!entityTypeStatusMap[entityTypeName]) {
                            entityTypeStatusMap[entityTypeName] = [];
                        }
                        entityTypeStatusMap[entityTypeName].push({
                            value: option.value,
                            text: option.text
                        });
                    }
                }
            });

            // Store original options
            const originalFromOptions = Array.from($fromStatusSelect.options).map(option => ({
                value: option.value,
                text: option.text
            }));
            const originalToOptions = Array.from($toStatusSelect.options).map(option => ({
                value: option.value,
                text: option.text
            }));

            // Get entity type name from ID
            function getEntityTypeName(entityTypeId) {
                const selectedOption = $entityTypeSelect.options[$entityTypeSelect.selectedIndex];
                return selectedOption.text;
            }

            // Filter status options based on selected entity type
            function filterStatusOptions() {
                const selectedEntityTypeId = $entityTypeSelect.value;
                const selectedEntityTypeName = getEntityTypeName(selectedEntityTypeId);

                if (!selectedEntityTypeId) {
                    // Reset to all options if no entity type selected
                    $fromStatusSelect.innerHTML = '';
                    $toStatusSelect.innerHTML = '';

                    originalFromOptions.forEach(option => {
                        const optFromStatus = document.createElement('option');
                        optFromStatus.value = option.value;
                        optFromStatus.text = option.text;
                        $fromStatusSelect.appendChild(optFromStatus);
                    });

                    originalToOptions.forEach(option => {
                        const optToStatus = document.createElement('option');
                        optToStatus.value = option.value;
                        optToStatus.text = option.text;
                        $toStatusSelect.appendChild(optToStatus);
                    });
                } else {
                    // Filter to only show statuses for the selected entity type
                    const filteredStatuses = entityTypeStatusMap[selectedEntityTypeName] || [];

                    $fromStatusSelect.innerHTML = '';
                    $toStatusSelect.innerHTML = '';

                    // Add placeholder option
                    const placeholderFrom = document.createElement('option');
                    placeholderFrom.value = '';
                    placeholderFrom.text = '-- Select Status --';
                    $fromStatusSelect.appendChild(placeholderFrom);

                    const placeholderTo = document.createElement('option');
                    placeholderTo.value = '';
                    placeholderTo.text = '-- Select Status --';
                    $toStatusSelect.appendChild(placeholderTo);

                    // Add filtered options
                    filteredStatuses.forEach(status => {
                        const optFrom = document.createElement('option');
                        optFrom.value = status.value;
                        optFrom.text = status.text;
                        $fromStatusSelect.appendChild(optFrom);

                        const optTo = document.createElement('option');
                        optTo.value = status.value;
                        optTo.text = status.text;
                        $toStatusSelect.appendChild(optTo);
                    });
                }

                // Clear selections
                $fromStatusSelect.value = '';
                $toStatusSelect.value = '';
            }

            // Handle Entity Type change
            $entityTypeSelect.addEventListener('change', filterStatusOptions);

            // Initialize on page load
            filterStatusOptions();

            // --- Notification toggle ---
            const sendNotificationCheckbox = document.getElementById('SendNotification');
            const notificationSection = document.getElementById('notificationRecipientsSection');

            function toggleNotificationSection() {
                if (sendNotificationCheckbox.checked) {
                    notificationSection.classList.remove('d-none');
                } else {
                    notificationSection.classList.add('d-none');
                }
            }

            sendNotificationCheckbox.addEventListener('change', toggleNotificationSection);
            toggleNotificationSection();

            // --- Email tags input ---
            const emailInput = document.getElementById('emailInput');
            const emailTagsContainer = document.getElementById('emailTagsContainer');
            const emailTagsSpan = document.getElementById('emailTags');
            const hiddenEmailField = document.getElementById('NotificationEmails');
            const emailValidationError = document.getElementById('emailValidationError');
            const emailList = [];

            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

            function renderTags() {
                emailTagsSpan.innerHTML = '';
                emailList.forEach((email, index) => {
                    const tag = document.createElement('span');
                    tag.className = 'badge bg-primary me-1 mb-1';
                    tag.style.fontSize = '0.85em';
                    tag.innerHTML = email + ' <span class="ms-1" style="cursor:pointer;" data-index="' + index + '">&times;</span>';
                    tag.querySelector('span').addEventListener('click', function () {
                        emailList.splice(index, 1);
                        renderTags();
                    });
                    emailTagsSpan.appendChild(tag);
                });
                hiddenEmailField.value = emailList.join(',');
            }

            function addEmail(value) {
                const email = value.trim();
                if (!email) return;
                if (!emailRegex.test(email)) {
                    emailValidationError.classList.remove('d-none');
                    return;
                }
                emailValidationError.classList.add('d-none');
                if (!emailList.includes(email)) {
                    emailList.push(email);
                    renderTags();
                }
                emailInput.value = '';
            }

            emailInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ',') {
                    e.preventDefault();
                    addEmail(emailInput.value.replace(',', ''));
                }
                if (e.key === 'Backspace' && emailInput.value === '' && emailList.length > 0) {
                    emailList.pop();
                    renderTags();
                }
            });

            emailInput.addEventListener('blur', function () {
                if (emailInput.value.trim()) {
                    addEmail(emailInput.value);
                }
            });

            emailTagsContainer.addEventListener('click', function () {
                emailInput.focus();
            });

            // --- Attachments Management ---
            const requiresAttachmentsCheckbox = document.getElementById('RequiresAttachments');
            const attachmentsConfigSection = document.getElementById('attachmentsConfigSection');
            const attachmentsList = document.getElementById('attachmentsList');
            const noAttachmentsMessage = document.getElementById('noAttachmentsMessage');
            const addAttachmentBtn = document.getElementById('addAttachmentBtn');
            const attachmentsJsonField = document.getElementById('attachmentsJson');

            let attachments = [];
            let attachmentCounter = 0;

            const fileFormats = [
                { value: 'pdf', label: 'PDF', color: 'danger' },
                { value: 'excel', label: 'Excel', color: 'success' },
                { value: 'docx', label: 'Word (DOCX)', color: 'primary' },
                { value: 'png', label: 'PNG Image', color: 'info' },
                { value: 'jpg', label: 'JPG Image', color: 'warning' }
            ];

            function toggleAttachmentsSection() {
                if (requiresAttachmentsCheckbox.checked) {
                    attachmentsConfigSection.classList.remove('d-none');
                } else {
                    attachmentsConfigSection.classList.add('d-none');
                }
            }

            function updateAttachmentsJson() {
                const jsonData = attachments.map((att, index) => ({
                    Id: 0,
                    WorkflowTransitionId: 0,
                    AttachmentName: att.name,
                    AllowedFormats: att.formats.join(','),
                    DisplayOrder: index + 1,
                    IsRequired: true
                }));
                attachmentsJsonField.value = JSON.stringify(jsonData);
            }

            function renderAttachments() {
                attachmentsList.innerHTML = '';
                
                if (attachments.length === 0) {
                    noAttachmentsMessage.classList.remove('d-none');
                    updateAttachmentsJson();
                    return;
                }

                noAttachmentsMessage.classList.add('d-none');

                attachments.forEach((attachment, index) => {
                    const attachmentCard = document.createElement('div');
                    attachmentCard.className = 'card mb-3 border-primary';
                    attachmentCard.innerHTML = `
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h6 class="mb-0">
                                    <i class="ti ti-file-text me-1"></i>Attachment ${index + 1}
                                </h6>
                                <button type="button" class="btn btn-sm btn-danger" data-index="${index}">
                                    <i class="ti ti-trash"></i>
                                </button>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label">Attachment Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control attachment-name" data-index="${index}" 
                                       value="${attachment.name}" placeholder="e.g., Approval Letter, Supporting Documents" required />
                            </div>
                            
                            <div class="mb-2">
                                <label class="form-label">Allowed File Formats <span class="text-danger">*</span></label>
                                <div class="d-flex flex-wrap gap-2">
                                    ${fileFormats.map(format => `
                                        <div class="form-check">
                                            <input class="form-check-input format-checkbox" type="checkbox" 
                                                   id="format_${index}_${format.value}" 
                                                   data-index="${index}" 
                                                   data-format="${format.value}"
                                                   ${attachment.formats.includes(format.value) ? 'checked' : ''}>
                                            <label class="form-check-label" for="format_${index}_${format.value}">
                                                <span class="badge bg-${format.color}">${format.label}</span>
                                            </label>
                                        </div>
                                    `).join('')}
                                </div>
                                <small class="form-hint">Select one or more formats</small>
                            </div>
                            
                            ${attachment.formats.length > 0 ? `
                                <div class="mt-2">
                                    <small class="text-muted">Selected formats:</small>
                                    <div class="mt-1">
                                        ${attachment.formats.map(fmt => {
                                            const formatObj = fileFormats.find(f => f.value === fmt);
                                            return `<span class="badge bg-${formatObj.color} me-1">${formatObj.label}</span>`;
                                        }).join('')}
                                    </div>
                                </div>
                            ` : ''}
                        </div>
                    `;
                    
                    attachmentsList.appendChild(attachmentCard);
                });

                // Attach event listeners
                attachmentsList.querySelectorAll('.btn-danger').forEach(btn => {
                    btn.addEventListener('click', function() {
                        const index = parseInt(this.getAttribute('data-index'));
                        attachments.splice(index, 1);
                        renderAttachments();
                    });
                });

                attachmentsList.querySelectorAll('.attachment-name').forEach(input => {
                    input.addEventListener('input', function() {
                        const index = parseInt(this.getAttribute('data-index'));
                        attachments[index].name = this.value;
                        updateAttachmentsJson();
                    });
                });

                attachmentsList.querySelectorAll('.format-checkbox').forEach(checkbox => {
                    checkbox.addEventListener('change', function() {
                        const index = parseInt(this.getAttribute('data-index'));
                        const format = this.getAttribute('data-format');
                        
                        if (this.checked) {
                            if (!attachments[index].formats.includes(format)) {
                                attachments[index].formats.push(format);
                            }
                        } else {
                            attachments[index].formats = attachments[index].formats.filter(f => f !== format);
                        }
                        
                        renderAttachments();
                    });
                });

                updateAttachmentsJson();
            }

            addAttachmentBtn.addEventListener('click', function() {
                attachments.push({
                    id: attachmentCounter++,
                    name: '',
                    formats: []
                });
                renderAttachments();
            });

            requiresAttachmentsCheckbox.addEventListener('change', toggleAttachmentsSection);
            toggleAttachmentsSection();
        });
    </script>
}