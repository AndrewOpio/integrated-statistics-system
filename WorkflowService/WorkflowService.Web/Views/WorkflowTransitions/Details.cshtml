@using WorkflowService.Core.Models.WorkflowTransitions
@model WorkflowTransitionViewModel
@{
    ViewData["Title"] = "Workflow Transition Details";
}

<!-- Page title -->
<div class="page-header d-print-none">
    <div class="row align-items-center">
        <div class="col">
            <h5 class="page-title">
                Workflow Transition Details
            </h5>
        </div>
    </div>
</div>

<div class="row row-deck row-cards">
    <!-- Main Details Card -->
    <div class="col-md-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between">
                <h4 class="card-title m-0">
                    Transition: <strong>@Model.ActionName</strong>
                </h4>
                <div class="col-auto">
                    <div class="btn-list">
                        <a href="@Url.Action("Edit", "WorkflowTransitions", new { id = Model.Id, applicationId = @ViewBag.ApplicationId })" class="btn btn-primary btn-sm">
                            <i class="ti ti-edit"></i> Edit
                        </a>
                        <a href="@Url.Action("Delete", "WorkflowTransitions", new { id = Model.Id, applicationId = @ViewBag.ApplicationId })" class="btn btn-danger btn-sm">
                            <i class="ti ti-trash"></i> Delete Transition
                        </a>
                        <a href="@Url.Action("Index", "WorkflowTransitions", new { applicationId = @ViewBag.ApplicationId })" class="btn btn-secondary btn-sm">
                            <i class="ti ti-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <!-- Entity Type -->
                <div class="row mb-2">
                    <div class="col-md-6">
                        <label class="form-label text-muted small text-uppercase">Entity Type</label>
                        <p class="mb-0">
                            <span class="badge bg-tertiary p-2 more-rounded">@Model.EntityTypeName</span>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small text-uppercase">Status</label>
                        <p class="mb-0">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success p-2 more-rounded">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary p-2 more-rounded">Inactive</span>
                            }
                        </p>
                    </div>
                </div>

                <!-- Status Transition Flow -->
                <div class="mb-2">
                    <label class="form-label text-muted small text-uppercase">Status Transition Flow</label>
                    <div class="d-flex align-items-center gap-3">
                        <span class="badge more-rounded bg-info p-2">
                            <i class="ti ti-badge me-1"></i>
                            <strong>@Model.FromStatusName</strong>
                        </span>
                        <div>
                            <i class="ti ti-arrow-right" style="font-size: 1.5rem;"></i>
                        </div>
                        <span class="badge more-rounded bg-info p-2">
                            <i class="ti ti-badge me-1"></i>
                            <strong>@Model.ToStatusName</strong>
                        </span>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Action Details -->
                <h6 class="mb-3">Action Configuration</h6>

                <div class="row mb-2">
                    <div class="col-md-6">
                        <label class="form-label text-muted small text-uppercase">Action Name</label>
                        <p class="mb-0">
                            <code>@Model.ActionName</code>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small text-uppercase">Display Label</label>
                        <p class="mb-0">
                            <strong>@Model.DisplayLabel</strong>
                        </p>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-md-6">
                        <label class="form-label text-muted small text-uppercase">Required Role</label>
                        <p class="mb-0">
                            <span class="badge bg-tertiary p-2 more-rounded">@Model.RequiredRoleName</span>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small text-uppercase">Button Class</label>
                        <p class="mb-0">
                            <span class="badge p-2 more-rounded" style="background-color: var(--bs-@(Model.ButtonClass.Replace("btn-", "")));">@Model.ButtonClass</span>
                        </p>
                    </div>
                </div>

                <!-- Comments Requirement -->
                <div class="row mb-2">
                    <div class="col-md-6">
                        <label class="form-label text-muted small text-uppercase">Comments Required</label>
                        <p class="mb-0">
                            @if (Model.RequiresComments)
                            {
                                <span class="badge bg-danger">
                                    <i class="ti ti-check me-1"></i> Yes
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    <i class="ti ti-x me-1"></i> No
                                </span>
                            }
                        </p>
                    </div>
                </div>

                <!-- Attachment Requirements -->
                <div class="row mb-2">
                    <div class="col-md-6">
                        <label class="form-label text-muted small text-uppercase">Attachments Required</label>
                        <p class="mb-0">
                            @if (Model.RequiresAttachments)
                            {
                                <span class="badge bg-warning">
                                    <i class="ti ti-check me-1"></i> Yes
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    <i class="ti ti-x me-1"></i> No
                                </span>
                            }
                        </p>
                    </div>
                </div>

                @if (Model.RequiresAttachments && Model.AttachmentRequirements.Any())
                {
                    <div class="mt-3">
                        <label class="form-label text-muted small text-uppercase">Required Attachments</label>
                        <div class="space-y-2">
                            @foreach (var attachment in Model.AttachmentRequirements.OrderBy(a => a.DisplayOrder))
                            {
                                <div class="card border-primary mb-2">
                                    <div class="card-body p-3">
                                        <div class="d-flex align-items-start">
                                            <div class="me-3">
                                                <span class="badge bg-primary rounded-circle" style="width: 30px; height: 30px; display: flex; align-items: center; justify-content: center;">
                                                    @attachment.DisplayOrder
                                                </span>
                                            </div>
                                            <div class="flex-grow-1">
                                                <h6 class="mb-2">
                                                    <i class="ti ti-file-text me-1"></i>@attachment.AttachmentName
                                                </h6>
                                                <div>
                                                    <small class="text-muted">Allowed formats:</small>
                                                    <div class="mt-1">
                                                        @foreach (var format in attachment.FormatsList)
                                                        {
                                                            var badgeColor = format.ToLower() switch
                                                            {
                                                                "pdf" => "danger",
                                                                "excel" => "success",
                                                                "docx" => "primary",
                                                                "png" => "info",
                                                                "jpg" => "warning",
                                                                _ => "secondary"
                                                            };
                                                            var displayName = format.ToLower() switch
                                                            {
                                                                "docx" => "Word (DOCX)",
                                                                "png" => "PNG Image",
                                                                "jpg" => "JPG Image",
                                                                _ => format.ToUpper()
                                                            };
                                                            <span class="badge bg-@badgeColor me-1">@displayName</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <hr class="my-4" />

                <!-- Notification Details -->
                <h6 class="mb-3"><i class="ti ti-bell me-1"></i>Notification Settings</h6>

                <div class="row mb-2">
                    <div class="col-md-6">
                        <label class="form-label text-muted small text-uppercase">Send Notification</label>
                        <p class="mb-0">
                            @if (Model.SendNotification)
                            {
                                <span class="badge bg-success">
                                    <i class="ti ti-check me-1"></i> Yes
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    <i class="ti ti-x me-1"></i> No
                                </span>
                            }
                        </p>
                    </div>
                </div>

                @if (Model.SendNotification)
                {
                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label class="form-label text-muted small text-uppercase">Notification Roles</label>
                            <p class="mb-0">
                                @if (Model.NotificationRoleNames.Any())
                                {
                                    @foreach (var roleName in Model.NotificationRoleNames)
                                    {
                                        <span class="badge bg-tertiary p-2 more-rounded me-1">@roleName</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">None</span>
                                }
                            </p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small text-uppercase">Notification Emails</label>
                            <p class="mb-0">
                                @if (Model.NotificationEmailList.Any())
                                {
                                    @foreach (var email in Model.NotificationEmailList)
                                    {
                                        <span class="badge bg-primary p-2 more-rounded me-1">
                                            <i class="ti ti-mail me-1"></i>@email
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">None</span>
                                }
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Button Preview Card -->
        <div class="card mt-2">
            <div class="card-header">
                <h5 class="card-title m-0">Button Preview</h5>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">This is how the button will appear to users:</p>
                <button class="btn @Model.ButtonClass" disabled>
                    @Model.DisplayLabel
                </button>
                @if (Model.RequiresComments)
                {
                    <p class="text-muted mt-3 small">
                        <i class="ti ti-info-circle me-1"></i>
                        Users will be prompted to enter comments/remarks when clicking this button.
                    </p>
                }
                @if (Model.RequiresAttachments)
                {
                    <p class="text-muted mt-2 small">
                        <i class="ti ti-paperclip me-1"></i>
                        Users will be required to upload @Model.AttachmentRequirements.Count attachment(s) when performing this transition.
                    </p>
                }
            </div>
        </div>
    </div>

    <!-- Summary Card -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title m-0">Transition Summary</h5>
            </div>
            <div class="card-body">
                <div class="space-y-4">
                    <!-- Quick Info -->
                    <div>
                        <h6 class="text-sm mb-2">Quick Info</h6>
                        <div class="text-sm space-y-2">
                            <div>
                                <span class="text-muted small text-uppercase">Transition ID:</span>
                                <strong>#@Model.Id</strong>
                            </div>
                            <div>
                                <span class="text-muted small text-uppercase">Entity Type:</span>
                                <strong>@Model.EntityTypeName</strong>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Flow Details --> 
                    <div>
                        <h6 class="text-sm mb-2">Flow Details</h6>
                        <div class="text-sm space-y-2">
                            <div>
                                <span class="text-muted small text-uppercase">From:</span><br />
                                <span class="badge bg-info">@Model.FromStatusName</span>
                            </div>
                            <div>
                                <span class="text-muted small text-uppercase">To:</span><br />
                                <span class="badge bg-info">@Model.ToStatusName</span>
                            </div>
                            <div>
                                <span class="text-muted small text-uppercase">Via Action:</span><br />
                                <code>@Model.ActionName</code>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Permission Details -->
                    <div>
                        <h6 class="text-sm mb-2">Permission Details</h6>
                        <div class="text-sm space-y-2">
                            <div>
                                <span class="text-muted small text-uppercase">Required Role:</span><br />
                                <span class="badge bg-tertiary">@Model.RequiredRoleName</span>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Configuration -->
                    <div>
                        <h6 class="text-sm mb-2">Configuration</h6>
                        <div class="text-sm space-y-2">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted small text-uppercase">Comments Required:</span>
                                @if (Model.RequiresComments)
                                {
                                    <i class="ti ti-check text-success"></i>
                                }
                                else
                                {
                                    <i class="ti ti-x text-danger"></i>
                                }
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted small text-uppercase">Attachments Required:</span>
                                @if (Model.RequiresAttachments)
                                {
                                    <span class="badge bg-warning">@Model.AttachmentRequirements.Count</span>
                                }
                                else
                                {
                                    <i class="ti ti-x text-danger"></i>
                                }
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted small text-uppercase">Active:</span>
                                @if (Model.IsActive)
                                {
                                    <i class="ti ti-check text-success"></i>
                                }
                                else
                                {
                                    <i class="ti ti-x text-danger"></i>
                                }
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted small text-uppercase">Send Notification:</span>
                                @if (Model.SendNotification)
                                {
                                    <i class="ti ti-check text-success"></i>
                                }
                                else
                                {
                                    <i class="ti ti-x text-danger"></i>
                                }
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- UI Configuration -->
                    <div>
                        <h6 class="text-sm mb-2">UI Configuration</h6>
                        <div class="text-sm space-y-2">
                            <div class="mb-1">
                                <span class="text-muted small text-uppercase">Button Class:</span><br />
                                <code>@Model.ButtonClass</code>
                            </div>
                            <div>
                                <span class="text-muted small text-uppercase">Display Label:</span><br />
                                <em>@Model.DisplayLabel</em>
                            </div>
                        </div>
                    </div>

                    @if (Model.RequiresAttachments && Model.AttachmentRequirements.Any())
                    {
                        <hr />

                        <!-- Attachment Summary -->
                        <div>
                            <h6 class="text-sm mb-2"><i class="ti ti-paperclip me-1"></i>Attachment Summary</h6>
                            <div class="text-sm">
                                <p class="mb-2">
                                    <strong>@Model.AttachmentRequirements.Count</strong> attachment(s) required
                                </p>
                                <ol class="ps-3 mb-0">
                                    @foreach (var attachment in Model.AttachmentRequirements.OrderBy(a => a.DisplayOrder))
                                    {
                                        <li class="mb-1">
                                            <small>@attachment.AttachmentName</small>
                                        </li>
                                    }
                                </ol>
                            </div>
                        </div>
                    }

                    @if (Model.SendNotification)
                    {
                        <hr />

                        <!-- Notification Recipients -->
                        <div>
                            <h6 class="text-sm mb-2"><i class="ti ti-bell me-1"></i>Notification Recipients</h6>
                            <div class="text-sm space-y-2">
                                @if (Model.NotificationRoleNames.Any())
                                {
                                    <div>
                                        <span class="text-muted small text-uppercase">Roles:</span><br />
                                        @foreach (var roleName in Model.NotificationRoleNames)
                                        {
                                            <span class="badge bg-tertiary me-1">@roleName</span>
                                        }
                                    </div>
                                }
                                @if (Model.NotificationEmailList.Any())
                                {
                                    <div class="mt-1">
                                        <span class="text-muted small text-uppercase">Emails:</span><br />
                                        @foreach (var email in Model.NotificationEmailList)
                                        {
                                            <span class="badge bg-primary me-1">@email</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Actions Card -->
        @* <div class="card mt-4">
            <div class="card-header">
                <h3 class="card-title">Actions</h3>
            </div>
            <div class="card-body">
                <div class="space-y-2">
                    <a href="@Url.Action("Edit", "WorkflowTransitions", new { id = Model.Id })" class="btn btn-primary w-100">
                        <i class="ti ti-edit me-2"></i> Edit Transition
                    </a>
                    <a href="@Url.Action("Delete", "WorkflowTransitions", new { id = Model.Id })" class="btn btn-danger w-100">
                        <i class="ti ti-trash me-2"></i> Delete Transition
                    </a>
                    <a href="@Url.Action("Index", "WorkflowTransitions")" class="btn btn-secondary w-100">
                        <i class="ti ti-arrow-left me-2"></i> Back to List
                    </a>
                </div>
            </div>
        </div> *@
    </div>
</div>

@section Scripts {
    <script>
        // Optional: Add copy-to-clipboard functionality for code elements
        document.querySelectorAll('code').forEach(element => {
            element.style.cursor = 'pointer';
            element.title = 'Click to copy';
            element.addEventListener('click', function() {
                const text = this.textContent;
                navigator.clipboard.writeText(text).then(() => {
                    const originalText = this.textContent;
                    this.textContent = 'Copied!';
                    setTimeout(() => {
                        this.textContent = originalText;
                    }, 2000);
                });
            });
        });
    </script>
}