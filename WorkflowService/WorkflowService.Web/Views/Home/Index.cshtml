@model IEnumerable<IdentityService.Dto.ApplicationDto>

@{
    ViewData["Title"] = "Home Page";
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h2 class="fs-5 fw-bold mb-0">Applications</h2>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-centered table-nowrap mb-0 rounded">
                        <thead class="thead-light">
                            <tr>
                                <th class="border-0 rounded-start">#</th>
                                <th class="border-0">Acronym</th>
                                <th class="border-0">Name</th>
                                <th class="border-0">Description</th>
                                <th class="border-0 rounded-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowNumber = 1;
                            }

                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><span class="text-primary fw-bold">@rowNumber</span></td>
                                    <td class="fw-bold">
                                        <div class="d-inline-flex align-items-center gap-2" style="width: fit-content;">
                                            <span class="badge bg-primary">
                                                <i class="ti ti-circle-filled me-1"></i>@item.Acronym
                                            </span>
                                        </div>
                                    </td>
                                    <td class="fw-bold">@item.Name</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            @item.Description
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-controller="WorkflowTransitions" asp-action="Index" asp-route-applicationId="@item.Id" class="btn btn-sm btn-outline-info" title="Edit Transitions">
                                                <i class="ti ti-edit"></i> Edit Transitions
                                            </a>
                                        </div>
                                    </td>
                                    @{
                                        rowNumber++;
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
