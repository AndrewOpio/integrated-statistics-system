<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>WorkflowService.Client</PackageId>
		<Version>1.0.0</Version>
		<Authors>BOU</Authors>
		<Description>Workflow service and Shared Dto classes: StatusType, WorkflowTransition</Description>
		<PackageIcon>bou.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Include="bou.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
	  <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
	  <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
	</ItemGroup>

</Project>
