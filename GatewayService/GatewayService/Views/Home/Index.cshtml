
@model List<Application>
@{
    ViewData["Title"] = "Dashboard";

    var userRoles = User.FindAll("appRole").Select(c => c.Value).ToList();
    var isStaff = User.FindFirst("isStaff")?.Value;
    bool isCbMaker = userRoles.Contains("CAS:CB Maker");
    bool isCbApprover = userRoles.Contains("CAS:CB Approver");
}

<div class="container-fluid px-4 py-4">
        <div class="row">
            <div class="col-12">
                <h2>Welcome, @ViewBag.Username!</h2>
                <p class="lead">Select an application to access:</p>
                <h6 class="text-uppercase text-muted fw-medium mb-4" style="letter-spacing: 0.05em; font-size: 0.875rem;">
                    Available Services
                </h6>
            </div>
        </div>

        <div class="row g-3 mb-4">
            @* <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                <div class="card service-card border" onclick="navigateToService('auth')">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="service-icon">AU</div>
                            <span class="badge badge-active rounded-pill px-3 py-2" style="font-size: 0.75rem;">Active</span>
                        </div>
                        <h5 class="card-title fw-semibold mb-2">Authentication Service</h5>
                        <p class="card-text text-muted small mb-3">
                            User authentication, session management, and OAuth2 provider integration. Handles login, logout, and token refresh flows.
                        </p>
                    </div>
                </div>
            </div> *@
            @* @if (User.HasClaim(SystemPolicy.ClaimType.AppRole, SystemPolicy.Claims.USMAdmin))
            {
                
            } *@

            @if(isStaff == "true")
            {
                @foreach (var app in Model)
                {
                    string requiredAppRoleSubStr = $"{app.Acronym}:";
                    if (userRoles.Any(s => s.Contains(requiredAppRoleSubStr)))
                    {
                        <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                            <a class="card service-card border" href="@app.Url">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div class="service-icon">@app.Acronym</div>
                                        <span class="badge badge-active rounded-pill px-3 py-2" style="font-size: 0.75rem;">@app.Status</span>
                                    </div>
                                    <h5 class="card-title fw-semibold mb-2">@app.Name</h5>
                                    <p class="card-text text-muted small mb-3">
                                        @app.Description
                                    </p>
                                </div>
                            </a>
                        </div>
                    }

                }
            } else if (isCbMaker || isCbApprover)
            {
                <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                    <a class="card service-card border" href="https://localhost:7277/CbRequests/">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="service-icon">DP/WD</div>
                                <span class="badge badge-active rounded-pill px-3 py-2" style="font-size: 0.75rem;">Active</span>
                            </div>
                            <h5 class="card-title fw-semibold mb-2">Commercial Bank Requests</h5>
                            <p class="card-text text-muted small mb-3">
                                Commercial Bank Interface to make a Withdraw (WD) or Deposit (DP) request to the Bank of Uganda.
                            </p>
                        </div>
                    </a>
                </div>
            }
    </div>
</div>
