@model RoleManagementViewModel
@{
    ViewData["Title"] = "Manage Roles";
}

<!-- Section 1: Roles -->
<div class="card mt-4">
    <div class="card-header d-block">
        <div class="mb-4">
            <h3>Roles</h3>
            <h6 class="card-subtitle my-1 text-body-secondary">Manage roles</h6>
            @* <h6 class="card-subtitle my-1 text-body-secondary">Define user roles and assign permissions to role</h6> *@
        </div>
        @* <permission name="@SystemPermissions.Roles.CreateRole"> *@
        <div>
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Role.Id" />
                <input type="hidden" asp-for="Roles" />
                <div class="row mb-3">
                    <div class="col-md-8">
                        <input type="text" asp-for="Role.Name" class="form-control bg-light" placeholder="Create new role here" required>
                        @* <label asp-for="Role.Name">Enter Role Name</label> *@
                        <small class="form-text text-muted">
                            Role names should be concise and descriptive of the permissions they will contain.
                        </small>
                        <span asp-validation-for="Role.Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-crimson btn-md w-100">
                            <i class="ti ti-plus ti-light"></i> Create Role
                        </button>
                    </div>
                </div>
            </form>
        </div>
        
        
        @* </permission> *@
    </div>
    <div class="card-body">
        <table id="rolesTable" class="table table-hover table-striped align-middle w-100 datatable">
            <thead>
                <tr>
                    <th>Role Name</th>
                    <th>Assigned Applications</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model.Roles)
                {
                    <tr>
                        <td class="align-middle">@role.Name</td>
                        <td>
                            @{
                                foreach (var app in role.Applications)
                                {
                                    <span class="badge bg-info me-1">@app.Acronym</span>
                                }
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group" role="group">
                                @* <permission name="@SystemPermissions.Roles.EditRole"> *@
                                    @* <a asp-action="ManagePermissions" asp-route-roleId="@role.Id" class="btn btn-outline-primary btn-sm">
                                        <i class="ti ti-key me-1"></i> Permissions
                                    </a> *@
                                    <a asp-action="Edit" asp-route-roleId="@role.Id" class="btn btn-outline-primary btn-sm">
                                        <i class="ti ti-edit me-1"></i> Edit
                                    </a>
                                @* </permission> *@
                                @*  <button type="button" class="btn btn-outline-danger btn-sm"
                            data-bs-toggle="modal" data-bs-target="#deleteRoleModal-@role.Id">
                            <i class="ti ti-trash me-1"></i>
                            </button> *@
                            </div>

                            <!-- Delete Confirmation Modal -->
                            <div class="modal fade" id="deleteRoleModal-@role.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Confirm Delete</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body text-start">
                                            Are you sure you want to delete the role <strong>@role.Name</strong>?
                                            <p class="text-danger mt-2">This action cannot be undone. All users with this role will lose these permissions.</p>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <form asp-action="DeleteRole" method="post">
                                                <input type="hidden" name="roleId" value="@role.Id" />
                                                <button type="submit" class="btn btn-danger">Delete</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Section 2: Application-Role Assignments -->
<div class="card mt-4">
    <div class="card-header d-block">
        <div class="mb-4">
            <h3>Application-Role Assignments</h3>
            <h6 class="card-subtitle my-1 text-body-secondary">Manage application roles in Aswam</h6>
        </div>
        <div>
            <form asp-action="CreateApplicationRole" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Role.Id" />
                <input type="hidden" asp-for="Roles" />
                <div class="row mb-3">
                    <div class="col-md-4">
                        <select asp-for="SelectedApplicationId" asp-items="Model.SelectApplications" class="form-select" required>
                            <option selected>Select Application</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <select asp-for="SelectedRoleId" asp-items="Model.SelectRoles" class="form-select" required>
                            <option selected>Select Role</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-crimson btn-md w-100">
                            <i class="ti ti-plus ti-light"></i> Add Role to Application
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-striped table-hover datatable">
            <thead>
                <tr>
                    <th>Application</th>
                    <th>Role</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model.ApplicationRoles)
                {
                    <tr>
                        <td class="align-middle">@role.Application.Name</td>
                        <td class="align-middle">@role.Role.Name</td>
                        <td class="text-end">
                            <div class="btn-group" role="group">
                                @* <permission name="@SystemPermissions.Roles.EditRole"> *@
                                <a asp-action="ManagePermissions" asp-route-appRoleId="@role.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="ti ti-key me-1"></i> Permissions
                                </a>
                                <a asp-action="ManageBranches" asp-route-appRoleId="@role.Id" class="btn btn-outline-success btn-sm">
                                    <i class="ti ti-building-bank me-1"></i> Branches
                                </a>
                                <a asp-action="Edit" asp-route-roleId="@role.Id" class="btn btn-outline-info btn-sm">
                                    <i class="ti ti-edit me-1"></i> Edit
                                </a>
                                @* </permission> *@
                                @*  <button type="button" class="btn btn-outline-danger btn-sm"
                            data-bs-toggle="modal" data-bs-target="#deleteRoleModal-@role.Id">
                            <i class="ti ti-trash me-1"></i>
                            </button> *@
                            </div>

                            <!-- Delete Confirmation Modal -->
                            <div class="modal fade" id="deleteApplicationRoleModal-@role.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Confirm Delete</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body text-start">
                                            Are you sure you want to delete the application role?
                                            <p class="text-danger mt-2">This action cannot be undone. All users with this role will lose these permissions.</p>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <form asp-action="DeleteRole" method="post">
                                                <input type="hidden" name="roleId" value="@role.Id" />
                                                <button type="submit" class="btn btn-danger">Delete</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
