@model RoleViewModel
@{
    ViewData["Title"] = "Edit Role";
}


<div class="d-flex justify-content-end align-items-center mb-3 mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h2>Edit Role</h2>
                    <h6 class="card-subtitle my-1 text-body-secondary">Edit Role Name</h6>
                </div>

                @* <a asp-action="ManagePermissions" asp-route-roleId="@Model.Id" class="btn btn-outline-warning">
                    <i class="ti ti-key me-1"></i> Manage Permissions
                </a> *@
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-floating mb-3">
                        <input type="text" asp-for="Name" class="form-control"
                               placeholder="Username" required>
                        <label asp-for="Name">Role Name</label>
                        <small class="form-text text-muted">
                            Role names should be concise and descriptive of the permissions they will contain.
                        </small>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-success">
                            <i class="ti ti-folder me-1"></i> Save Changes
                        </button>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}