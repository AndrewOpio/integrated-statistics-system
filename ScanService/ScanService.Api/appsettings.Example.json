{
  // Copy to appsettings.json (which is gitignored, like every other service in Aswam).
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ScanService": {
    // Name AMSI is initialised with; shows up in Defender telemetry.
    "AmsiApplicationName": "Aswam.ScanService",

    // Largest upload accepted. The whole file is held in memory while it is scanned.
    "MaxFileSizeBytes": 52428800,

    // How many buffers may sit in the antimalware engine at once.
    "MaxConcurrentScans": 4,

    // Reject anything that could not be scanned. Leave true in production.
    "FailClosed": true,

    // Destinations the service will write cleared files into. A requesting microservice can only
    // name a directory under one of these. REQUIRED - an empty list refuses every store request.
    "AllowedDestinationRoots": [ "C:\\CASFiles" ],

    // Rejected before scanning, whatever the engine would say.
    "BlockedExtensions": [
      ".exe", ".dll", ".com", ".scr", ".pif", ".bat", ".cmd", ".ps1", ".psm1", ".vbs", ".vbe",
      ".js", ".jse", ".wsf", ".wsh", ".hta", ".msi", ".msp", ".jar", ".cpl", ".reg", ".lnk",
      ".sys", ".chm", ".application", ".gadget", ".msc", ".inf", ".scf"
    ],

    // When non-empty, only these extensions are accepted.
    "AllowedExtensions": []
  }
}
