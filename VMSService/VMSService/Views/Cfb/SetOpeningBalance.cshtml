@model VMSService.Core.Models.Cfb.CfbOpeningBalanceViewModel
@{
    ViewData["Title"] = $"Opening Balance — {Model.BoxName}";
}

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success alert-dismissible fade show py-2 mb-3" role="alert">
        <i class="ti ti-circle-check me-2"></i>@successMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string errMsg)
{
    <div class="alert alert-danger alert-dismissible fade show py-2 mb-3" role="alert">
        <i class="ti ti-alert-circle me-2"></i>@errMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="mb-3 d-flex align-items-center justify-content-between">
    <div>
        <h5 class="fw-bold mb-0">@Model.BoxName — Opening Balance</h5>
        <p class="text-muted small mb-0">
            @Model.BouBranchName &middot;
            @if (Model.UnsetCount > 0)
            {
                <span class="text-warning fw-semibold">@Model.UnsetCount denomination(s) still need a baseline</span>
            }
        </p>
    </div>
    <a asp-action="BranchDetail" asp-route-bouBranchId="@Model.BouBranchId"
       class="btn btn-sm btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i>Back to branch
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <form asp-action="SetOpeningBalance" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="BoxId" value="@Model.BoxId" />
            <input type="hidden" name="BouBranchId" value="@Model.BouBranchId" />

            <table class="table table-sm mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Denomination</th>
                        <th class="text-end">Face Value (UGX)</th>
                        <th class="text-end pe-3" style="width:240px;">Baseline Amount (UGX)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr class="@(line.IsSet ? "table-light text-muted" : "")">
                            <td class="ps-3 fw-semibold">@line.DenominationName</td>
                            <td class="text-end">@line.DenomValue.ToString("N0")</td>
                            <td class="text-end pe-3">
                                @if (line.IsSet)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        <i class="ti ti-check me-1"></i>@line.ExistingAmount!.Value.ToString("N0")
                                    </span>
                                }
                                else
                                {
                                    <input type="number"
                                           name="Amounts[@line.DenominationId]"
                                           class="form-control form-control-sm text-end"
                                           style="width:200px;display:inline-block;"
                                           min="1"
                                           placeholder="Enter amount"
                                           aria-label="Baseline amount for @line.DenominationName" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="p-3 border-top d-flex align-items-center justify-content-between">
                <p class="text-muted small mb-0">
                    Leave a field blank to skip it — you can return to set remaining denominations later.<br />
                    <strong>A baseline cannot be zero.</strong>
                </p>
                <button type="submit" class="btn btn-primary">
                    <i class="ti ti-device-floppy me-1"></i>Save baselines
                </button>
            </div>
        </form>
    </div>
</div>
