@model IEnumerable<VMSService.Data.Entities.BankingShortage>

@using VMSService.Core.Static

@{
    ViewData["Title"] = "Banking Shortages";
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h2 class="fs-5 fw-bold mb-0">Banking Shortages</h2>
                    </div>
                    <div class="col text-end">
                        <permission name="@SystemPermissions.BankingShortages.Generate">
                            <a asp-action="Generate" class="btn btn-sm btn-primary">
                                <i class="ti ti-refresh me-1"></i>Generate Report
                            </a>
                        </permission>
                    </div>
                </div>
            </div>
            <div class="card-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="ti ti-circle-check me-1"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="ti ti-alert-circle me-1"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                <div class="table-responsive">
                    <table class="table table-centered table-nowrap mb-0 rounded datatable">
                        <thead class="thead-light">
                            <tr>
                                <th class="border-0 rounded-start">#</th>
                                <th class="border-0">Reference</th>
                                <th class="border-0">Month</th>
                                <th class="border-0 text-end">Total Shortage</th>
                                <th class="border-0 text-end">Net Shortage</th>
                                <th class="border-0">Status</th>
                                <th class="border-0 rounded-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int rowNumber = 1; }
                            @foreach (var item in Model)
                            {
                                string badgeClass = item.CurrentStatusName switch
                                {
                                    "Draft"                => "bg-secondary",
                                    "Pending Approval"     => "bg-warning text-dark",
                                    "Pending Confirmation" => "bg-info text-dark",
                                    "Confirmed"            => "bg-success",
                                    _                      => "bg-secondary"
                                };
                                <tr>
                                    <td><span class="text-primary fw-bold">@rowNumber</span></td>
                                    <td class="fw-bold">@item.ReferenceNumber</td>
                                    <td>@item.Period.ToString("MMMM yyyy")</td>
                                    <td class="text-end text-danger">@item.TotalShortage.ToString("N0")</td>
                                    <td class="text-end fw-bold text-danger">@item.NetShortage.ToString("N0")</td>
                                    <td><span class="badge @badgeClass">@item.CurrentStatusName</span></td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                                rowNumber++;
                            }
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">
                                        <i class="ti ti-inbox fs-4 d-block mb-2"></i>No banking shortage records yet.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
