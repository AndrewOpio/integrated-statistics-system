@model VMSService.Core.Models.MonthlyShortageReimbursements.ReimbursementDetailsViewModel

@{
    ViewData["Title"] = "Reimbursement — " + Model.ReferenceNumber;

    string statusBadgeClass = Model.CurrentStatusName switch
    {
        "Draft"            => "bg-secondary",
        "Pending Approval" => "bg-warning text-dark",
        "Approved"         => "bg-success",
        _                  => "bg-secondary"
    };

    var stages = new[] { "Draft", "Pending Approval", "Approved" };
    int currentStageIndex = Model.CurrentStatusName switch
    {
        "Draft"            => 0,
        "Pending Approval" => 1,
        "Approved"         => stages.Length,
        _                  => 0
    };
}

<div class="row g-4 pb-5">

    @* ── Left column ── *@
    <div class="col-12 col-xl-8">

        @* ── Header card ── *@
        <div class="card border-0 shadow mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                    <div>
                        <span class="text-muted small">Shortage Reimbursements</span>
                        <h2 class="fs-3 fw-bold mb-1 mt-1">@Model.ReferenceNumber</h2>
                        <span class="text-muted">
                            <i class="ti ti-building me-1"></i>@Model.BranchName
                            <span class="mx-2">·</span>
                            <i class="ti ti-calendar me-1"></i>@Model.ShortagePeriod.ToString("MMMM yyyy")
                        </span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge @statusBadgeClass px-2 py-1">@Model.CurrentStatusName</span>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="ti ti-arrow-left me-1"></i>Back
                        </a>
                    </div>
                </div>

                @* Workflow stepper *@
                <div class="mt-4 pt-2">
                    <div class="d-flex justify-content-between position-relative" style="z-index:1;">
                        @for (int i = 0; i < stages.Length; i++)
                        {
                            bool done    = i < currentStageIndex;
                            bool current = i == currentStageIndex;
                            string circleClass = done    ? "bg-success text-white" :
                                                 current ? "bg-primary text-white" :
                                                           "bg-light text-muted border";
                            string labelClass  = done    ? "text-success" :
                                                 current ? "text-primary fw-bold" :
                                                           "text-muted";
                            <div class="text-center flex-fill">
                                <div class="d-flex align-items-center justify-content-center mx-auto rounded-circle @circleClass"
                                     style="width:2rem;height:2rem;font-size:.8rem;">
                                    @if (done) { <i class="ti ti-check"></i> }
                                    else if (current) { <i class="ti ti-clock" style="font-size:.75rem;"></i> }
                                    else { <i class="ti ti-circle" style="font-size:.75rem;"></i> }
                                </div>
                                <div class="small mt-1 @labelClass" style="font-size:.7rem;">@stages[i]</div>
                            </div>
                            @if (i < stages.Length - 1)
                            {
                                <div class="flex-fill align-self-start" style="margin-top:calc(1rem - 1px);">
                                    <div class="w-100 @(i < currentStageIndex ? "bg-success" : "bg-light")" style="height:2px;"></div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        @* ── Summary stat cards ── *@
        <div class="row g-3 mb-4">
            <div class="col-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center py-3">
                        <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center mx-auto mb-2" style="width:2.5rem;height:2.5rem;">
                            <i class="ti ti-cash-banknote text-primary fs-5"></i>
                        </div>
                        <div class="text-muted small">Total Amount</div>
                        <div class="fs-5 fw-bold text-primary mt-1">@Model.TotalAmount.ToString("N0")</div>
                    </div>
                </div>
            </div>
            <div class="col-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center py-3">
                        <div class="rounded-circle bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center mx-auto mb-2" style="width:2.5rem;height:2.5rem;">
                            <i class="ti ti-stack text-secondary fs-5"></i>
                        </div>
                        <div class="text-muted small">Denominations</div>
                        <div class="fs-5 fw-bold mt-1">@Model.Denominations.Count</div>
                    </div>
                </div>
            </div>
            <div class="col-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center py-3">
                        <div class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center mx-auto mb-2" style="width:2.5rem;height:2.5rem;">
                            <i class="ti ti-circles text-success fs-5"></i>
                        </div>
                        <div class="text-muted small">Total Pieces</div>
                        <div class="fs-5 fw-bold text-success mt-1">@Model.Denominations.Sum(d => d.NumberOfPieces).ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>

        @* ── Denomination breakdown ── *@
        <div class="card border-0 shadow mb-4">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="ti ti-stack text-primary fs-5"></i>
                <h6 class="fw-bold mb-0">Denomination Breakdown</h6>
                <span class="badge bg-primary ms-auto">@Model.Denominations.Count row(s)</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead style="background-color:#f8fafc;">
                            <tr>
                                <th class="ps-3">#</th>
                                <th>Denomination</th>
                                <th class="text-end">Value (UGX)</th>
                                <th class="text-end">Amount (UGX)</th>
                                <th class="text-end pe-3">No. of Pieces</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int rowNum = 1; }
                            @foreach (var d in Model.Denominations)
                            {
                                <tr>
                                    <td class="ps-3 text-muted small">@(rowNum++)</td>
                                    <td class="fw-semibold">@d.DenominationName</td>
                                    <td class="text-end text-muted">@d.DenominationValue.ToString("N0")</td>
                                    <td class="text-end fw-semibold">@d.Amount.ToString("N0")</td>
                                    <td class="text-end pe-3">@d.NumberOfPieces.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot style="background-color:#f8fafc;" class="fw-bold border-top border-2">
                            <tr>
                                <td class="ps-3" colspan="3">Total</td>
                                <td class="text-end">@Model.TotalAmount.ToString("N0")</td>
                                <td class="text-end pe-3">@Model.Denominations.Sum(d => d.NumberOfPieces).ToString("N0")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        @* ── Remarks ── *@
        @if (!string.IsNullOrWhiteSpace(Model.Remarks))
        {
            <div class="card border-0 shadow mb-4">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="ti ti-notes text-secondary fs-5"></i>
                    <h6 class="fw-bold mb-0">Remarks</h6>
                </div>
                <div class="card-body">
                    <p class="mb-0 text-muted">@Model.Remarks</p>
                </div>
            </div>
        }

        @* ── Status history ── *@
        @if (Model.StatusHistory.Any())
        {
            <div class="card border-0 shadow mb-4">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="ti ti-history text-secondary fs-5"></i>
                    <h6 class="fw-bold mb-0">Comments &amp; History</h6>
                </div>
                <div class="card-body pb-1">
                    @foreach (var h in Model.StatusHistory)
                    {
                        string iconClass = h.NewStatusName == "Approved"         ? "text-success" :
                                           h.NewStatusName == "Draft"             ? "text-warning" :
                                           h.NewStatusName == "Pending Approval"  ? "text-primary" : "text-secondary";
                        <div class="d-flex gap-3 mb-4">
                            <div class="flex-shrink-0 pt-1">
                                <i class="ti ti-circle-check fs-5 @iconClass"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-1">
                                    <div class="fw-semibold small">
                                        <span class="text-secondary">@h.OldStatusName</span>
                                        <i class="ti ti-arrow-right mx-1 text-muted"></i>
                                        <span class="text-dark">@h.NewStatusName</span>
                                    </div>
                                    <small class="text-muted">@h.ChangedAt.ToString("dd MMM yyyy HH:mm")</small>
                                </div>
                                <div class="small text-muted mt-1">by <strong>@h.ChangedBy</strong></div>
                                @if (!string.IsNullOrWhiteSpace(h.Remarks))
                                {
                                    <div class="mt-2 p-2 bg-light rounded border-start border-3 border-primary small">@h.Remarks</div>
                                }
                                @if (h.Attachments.Any())
                                {
                                    <div class="mt-2 d-flex flex-wrap gap-1">
                                        @foreach (var att in h.Attachments)
                                        {
                                            <a asp-action="DownloadAttachment" asp-route-id="@att.Id"
                                               class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1 py-0 px-2">
                                                <i class="ti ti-paperclip"></i>
                                                <span class="small">@att.FileName</span>
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @* ── Meta ── *@
        <div class="text-muted small d-flex gap-4 mb-3">
            <div><i class="ti ti-user me-1"></i>Created by <strong>@Model.CreatedBy</strong></div>
            <div><i class="ti ti-clock me-1"></i>@Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</div>
        </div>

    </div>

    @* ── Right column ── *@
    <div class="col-12 col-xl-4">
        <div style="position:sticky;top:1.5rem;">

            @* Actions panel *@
            <div class="card border-0 shadow mb-3">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="ti ti-player-play text-primary fs-5"></i>
                    <h5 class="fw-bold mb-0">Actions</h5>
                </div>
                <div class="card-body">
                    @if (Model.AvailableTransitions.Any())
                    {
                        <form asp-action="ExecuteAction" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />

                            <div class="mb-3">
                                <label class="form-label fw-semibold small">Select Action</label>
                                <select class="form-select" name="actionName" id="actionSelect" onchange="onActionChange(this)">
                                    <option value="">-- Choose action --</option>
                                    @foreach (var t in Model.AvailableTransitions)
                                    {
                                        <option value="@t.ActionName"
                                                data-requires-attachments="@t.RequiresAttachments.ToString().ToLower()"
                                                data-requirements="@System.Text.Json.JsonSerializer.Serialize(t.AttachmentRequirements)">
                                            @t.DisplayLabel
                                        </option>
                                    }
                                </select>
                            </div>

                            <div id="attachmentFields"></div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold small">Remarks</label>
                                <textarea class="form-control" name="remarks" rows="3" placeholder="Add a comment..."></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                <i class="ti ti-check me-1"></i><span id="submitLabel">Submit</span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto mb-3" style="width:3rem;height:3rem;">
                                <i class="ti ti-lock text-muted fs-4"></i>
                            </div>
                            <p class="text-muted small mb-0">No actions available for your role at this stage.</p>
                        </div>
                    }
                </div>
            </div>

            @* Info card *@
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="fw-bold text-muted small text-uppercase mb-3">
                        <i class="ti ti-info-circle me-1"></i>Reimbursement Info
                    </h6>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Reference</span>
                        <span class="fw-semibold small">@Model.ReferenceNumber</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Monthly Shortage</span>
                        <span class="fw-semibold small">@Model.ShortageReference</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Period</span>
                        <span class="fw-semibold small">@Model.ShortagePeriod.ToString("MMMM yyyy")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Branch</span>
                        <span class="fw-semibold small">@Model.BranchName</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Total Amount</span>
                        <span class="fw-bold text-primary small">UGX @Model.TotalAmount.ToString("N0")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Status</span>
                        <span class="badge @statusBadgeClass">@Model.CurrentStatusName</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Created By</span>
                        <span class="fw-semibold small">@Model.CreatedBy</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Date</span>
                        <span class="fw-semibold small">@Model.CreatedDate.ToString("dd MMM yyyy")</span>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold text-muted small text-uppercase mb-3">
                        <i class="ti ti-help-circle me-1"></i>About this page
                    </h6>
                    <p class="small text-muted mb-3">
                        This page shows the details of a <strong>Shortage Reimbursement</strong> — a record of funds
                        disbursed to a branch to cover a recorded monthly shortage, broken down by denomination.
                    </p>
                    <div class="d-flex align-items-start gap-2 mb-2">
                        <i class="ti ti-cash-banknote text-primary mt-1 flex-shrink-0"></i>
                        <div class="small text-muted"><strong>Summary cards</strong> — total amount reimbursed, number of denomination types, and total piece count.</div>
                    </div>
                    <div class="d-flex align-items-start gap-2 mb-2">
                        <i class="ti ti-stack text-secondary mt-1 flex-shrink-0"></i>
                        <div class="small text-muted"><strong>Denomination breakdown</strong> — each currency note/coin type, the amount in that denomination, and the number of pieces.</div>
                    </div>
                    <div class="d-flex align-items-start gap-2 mb-2">
                        <i class="ti ti-history text-secondary mt-1 flex-shrink-0"></i>
                        <div class="small text-muted"><strong>Comments &amp; History</strong> — a full audit trail of every status change, who made it, when, and any remarks they added.</div>
                    </div>
                    <div class="d-flex align-items-start gap-2">
                        <i class="ti ti-player-play text-primary mt-1 flex-shrink-0"></i>
                        <div class="small text-muted"><strong>Actions panel</strong> — if your role permits an action at the current stage, it will appear here. Select the action, add remarks, and submit.</div>
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script>
        function onActionChange(select) {
            const option = select.options[select.selectedIndex];

            const label = document.getElementById('submitLabel');
            label.textContent = option.value ? option.textContent.trim() : 'Submit';

            const requiresAtt = option.dataset.requiresAttachments === 'true';
            const container   = document.getElementById('attachmentFields');
            container.innerHTML = '';
            if (!requiresAtt) return;
            let requirements = [];
            try { requirements = JSON.parse(option.dataset.requirements || '[]'); } catch { return; }
            requirements.forEach(req => {
                const div = document.createElement('div');
                div.className = 'mb-3';
                div.innerHTML =
                    '<label class="form-label fw-semibold small">' + req.AttachmentName +
                    (req.IsRequired ? ' <span class="text-danger">*</span>' : '') + '</label>' +
                    '<input type="file" class="form-control form-control-sm" name="attachments_' + req.Id +
                    '" accept="' + (req.AllowedFormats || '.pdf,.jpg,.jpeg,.png') + '"' +
                    (req.IsRequired ? ' required' : '') + ' />';
                container.appendChild(div);
            });
        }
    </script>
}
