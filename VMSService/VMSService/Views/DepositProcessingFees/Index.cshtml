@model List<VMSService.Core.Models.DepositProcessingFees.DepositProcessingFeeViewModel>

@{
    ViewData["Title"] = "Deposit Processing Fees";
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h2 class="fs-5 fw-bold mb-0">Deposit Processing Fees</h2>
                    </div>
                    <div class="col text-end">
                        <a asp-action="Create" class="btn btn-sm btn-primary">
                            <i class="ti ti-plus me-1"></i>Add Deposit Processing Fee
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-centered table-nowrap mb-0 rounded datatable">
                        <thead class="thead-light">
                            <tr>
                                <th class="border-0 rounded-start">#</th>
                                <th class="border-0">Start Value</th>
                                <th class="border-0">End Value</th>
                                <th class="border-0">Median Value</th>
                                <th class="border-0">Rate (%)</th>
                                <th class="border-0">Charge</th>
                                <th class="border-0">Denomination Type</th>
                                <th class="border-0 rounded-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowNumber = 1;
                            }

                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><span class="text-primary fw-bold">@rowNumber</span></td>
                                    <td>@item.StartValue.ToString("N0")</td>
                                    <td>@item.EndValue.ToString("N0")</td>
                                    <td class="fw-bold">@item.MedianValue.ToString("N0")</td>
                                    <td>@item.Rate.ToString("N2")</td>
                                    <td>@item.Charge.ToString("N0")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.DenominationTypeName))
                                        {
                                            <div class="d-inline-flex align-items-center gap-2" style="width: fit-content;">
                                                <span class="badge bg-primary">
                                                    <i class="ti ti-tag me-1"></i>@item.DenominationTypeName
                                                </span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                                <i class="ti ti-edit"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="ti ti-eye"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="ti ti-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                    @{
                                        rowNumber++;
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>