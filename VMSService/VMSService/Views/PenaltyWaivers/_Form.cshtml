@model VMSService.Core.Models.Penalties.PenaltyWaiverViewModel

<input type="hidden" asp-for="Id" />

<div class="mb-3">
    <label class="form-label" asp-for="PenaltyId">Penalty <span class="text-danger">*</span></label>
    <select class="form-select" asp-for="PenaltyId" asp-items="@Model.Penalties" required>
        <option value="">-- Select --</option>
    </select>
    <span asp-validation-for="PenaltyId" class="text-danger small d-block mt-1"></span>
</div>

<div class="mb-3">
    <label class="form-label" asp-for="BouBranchId">BOU Branch <span class="text-danger">*</span></label>
    <select class="form-select" asp-for="BouBranchId" asp-items="@Model.BouBranches" required>
        <option value="">-- Select --</option>
    </select>
    <span asp-validation-for="BouBranchId" class="text-danger small d-block mt-1"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label class="form-label" asp-for="StartDate">Start Date <span class="text-danger">*</span></label>
        <input type="date" class="form-control" asp-for="StartDate" required>
        <span asp-validation-for="StartDate" class="text-danger small d-block mt-1"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label class="form-label" asp-for="EndDate">End Date <span class="text-danger">*</span></label>
        <input type="date" class="form-control" asp-for="EndDate" required>
        <span asp-validation-for="EndDate" class="text-danger small d-block mt-1"></span>
    </div>
</div>

<div class="mb-3">
    <label class="form-label" asp-for="Reason">Reason <span class="text-danger">*</span></label>
    <textarea class="form-control" asp-for="Reason" rows="3" placeholder="Why is this penalty being waived for this branch and period?" required></textarea>
    <span asp-validation-for="Reason" class="text-danger small d-block mt-1"></span>
</div>

@if (Model.Id != 0)
{
    <div class="mb-3">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" asp-for="Active" id="activeSwitch">
            <label class="form-check-label" for="activeSwitch">Active</label>
        </div>
    </div>
}
