@using VMSService.Core.Models.WorkflowTransitions
@model WorkflowTransitionViewModel
@{
    ViewData["Title"] = "Delete Workflow Transition";
}

<div class="container-xl">
    <div class="page-header d-print-none">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title">
                    Delete Workflow Transition
                </h2>
            </div>
        </div>
    </div>
</div>

<div class="page-wrapper">
    <div class="container-xl">
        <div class="row row-deck row-cards">
            <div class="col-md-8">
                <div class="card card-md">
                    <div class="card-body">
                        <div class="text-center mb-4">
                            <i class="ti ti-alert-triangle text-danger" style="font-size: 3rem;"></i>
                        </div>

                        <h3 class="text-center mb-2">Are you sure?</h3>
                        <p class="text-muted text-center">
                            You are about to delete this workflow transition. This action cannot be undone, but the data will be preserved.
                        </p>

                        <div class="alert alert-warning alert-icon mt-4" role="alert">
                            <div class="d-flex">
                                <div>
                                    <i class="ti ti-info-circle alert-icon-svg"></i>
                                </div>
                                <div>
                                    <h4 class="alert-title">This is a soft delete</h4>
                                    <div class="text-muted">The transition will be marked as deleted but historical data will be retained.</div>
                                </div>
                            </div>
                        </div>

                        <!-- Transition Details -->
                        <div class="card bg-light mt-4">
                            <div class="card-body">
                                <h4 class="mb-3">Transition Details:</h4>
                                <div class="row">
                                    <div class="col-md-6">
                                        <p><strong>Entity Type:</strong></p>
                                        <p class="text-muted">@Model.EntityType</p>
                                    </div>
                                    <div class="col-md-6">
                                        <p><strong>Action Name:</strong></p>
                                        <p class="text-muted">@Model.ActionName</p>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <p><strong>From Status:</strong></p>
                                        <p class="text-muted">@Model.FromStatusName</p>
                                    </div>
                                    <div class="col-md-6">
                                        <p><strong>To Status:</strong></p>
                                        <p class="text-muted">@Model.ToStatusName</p>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <p><strong>Required Role:</strong></p>
                                        <p class="text-muted">@Model.RequiredRole</p>
                                    </div>
                                    <div class="col-md-6">
                                        <p><strong>Display Label:</strong></p>
                                        <p class="text-muted">@Model.DisplayLabel</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Form Actions -->
                        <div class="form-footer mt-4">
                            <form asp-action="DeleteConfirmed" method="post" style="display:inline;">
                                <input type="hidden" asp-for="Id" />
                                <a href="@Url.Action("Index", "WorkflowTransitions")" class="btn btn-link">Cancel</a>
                                <button type="submit" class="btn btn-danger">Delete Transition</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>