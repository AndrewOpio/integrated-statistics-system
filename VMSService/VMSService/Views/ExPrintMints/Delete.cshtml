@model VMSService.Core.Models.ExPrintMints.ExPrintMintViewModel

@{
    ViewData["Title"] = "Delete Expected Stock";
}

<div class="row">
    <div class="col-12 col-lg-12">
        <div class="card border-0 shadow mb-4 border-danger border-2">
            <div class="card-header pb-4 bg-light">
                <div class="d-flex flex-column">
                    <span class="text-danger small mb-2">
                        <i class="ti ti-alert-triangle me-1"></i>Delete Expected Stock
                    </span>
                    <h2 class="fs-4 fw-bold mb-3">@Model.ExPrintMintReference</h2>
                    <div class="d-flex gap-2 flex-wrap">
                        @if (Model.CurrencyVendor?.VendorType?.Name == "Printer")
                        {
                            <span class="badge bg-primary">
                                <i class="ti ti-tag me-1"></i>ExPrint
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-primary">
                                <i class="ti ti-tag me-1"></i>ExMint
                            </span>
                        }
                        @if (Model.CurrentStatus != null)
                        {
                            <span class="badge bg-info">
                                <i class="ti ti-badge me-1"></i>@Model.CurrentStatus.Name
                            </span>
                        }
                    </div>
                </div>
            </div>

            <div class="card-body">
                <div class="alert alert-warning mb-4" role="alert">
                    <i class="ti ti-alert-triangle me-2"></i>
                    <strong>Warning!</strong> This action cannot be undone. Please confirm you want to permanently delete this record.
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="field mb-4">
                            <span class="d-block text-muted small mb-2 text-uppercase">Reference</span>
                            <span class="d-block fw-normal">@Model.ExPrintMintReference</span>
                        </div>

                        <div class="field mb-4">
                            <span class="d-block text-muted small mb-2 text-uppercase">Vendor</span>
                            <span class="d-block fw-normal">
                                @if (Model.CurrencyVendor != null)
                                {
                                    @Model.CurrencyVendor.Name
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </span>
                        </div>

                        <div class="field">
                            <span class="d-block text-muted small mb-2 text-uppercase">Delivery Date</span>
                            <span class="d-block fw-normal">@Model.DeliveryDate.ToString("dddd, MMMM dd, yyyy")</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="field mb-4">
                            <span class="d-block text-muted small mb-2 text-uppercase">Denomination</span>
                            <span class="d-block fw-normal">
                                @if (Model.Denomination != null)
                                {
                                    @Model.Denomination.Name
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </span>
                        </div>

                        <div class="field mb-4">
                            <span class="d-block text-muted small mb-2 text-uppercase">Number of Pieces</span>
                            <span class="d-block fw-normal">@Model.NumberOfPieces</span>
                        </div>

                        <div class="field">
                            <span class="d-block text-muted small mb-2 text-uppercase">Total Value (UGX)</span>
                            <span class="d-block fw-normal text-success fw-bold">@Model.Value.ToString("N2")</span>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.BoxNumberPrefix))
                {
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="field mb-4">
                                <span class="d-block text-muted small mb-2 text-uppercase">Box Number Prefix</span>
                                <span class="d-block fw-normal">
                                    <span class="badge bg-warning">@Model.BoxNumberPrefix</span>
                                </span>
                            </div>

                            <div class="field">
                                <span class="d-block text-muted small mb-2 text-uppercase">Box Number Range</span>
                                <span class="d-block fw-normal">
                                    @if (Model.BoxNumberRangeStart.HasValue && Model.BoxNumberRangeEnd.HasValue)
                                    {
                                        <span>@Model.BoxNumberPrefix@Model.BoxNumberRangeStart - @Model.BoxNumberPrefix@Model.BoxNumberRangeEnd</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="field mb-4">
                                <span class="d-block text-muted small mb-2 text-uppercase">Serial Number Prefix</span>
                                <span class="d-block fw-normal">
                                    @if (!string.IsNullOrEmpty(Model.SerialNumberPrefix))
                                    {
                                        <span class="badge bg-danger text-white">@Model.SerialNumberPrefix</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </span>
                            </div>

                            <div class="field">
                                <span class="d-block text-muted small mb-2 text-uppercase">Serial Number Range</span>
                                <span class="d-block fw-normal">
                                    @if (Model.SerialNumberRangeStart.HasValue && Model.SerialNumberRangeEnd.HasValue)
                                    {
                                        <span>@Model.SerialNumberPrefix@Model.SerialNumberRangeStart - @Model.SerialNumberPrefix@Model.SerialNumberRangeEnd</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="card-footer bg-transparent border-top pt-3">
                <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="ti ti-trash me-1"></i>Confirm Delete
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="ti ti-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .field {
        display: flex;
        flex-direction: column;
    }

    .field span:first-child {
        font-size: 0.75rem;
        font-weight: 600;
        color: #718096;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
    }

    .field span:last-child {
        font-size: 1rem;
        color: #2d3748;
    }
</style>