@model VMSService.Core.Models.ExPrintMints.ExPrintMintViewModel

@{
    ViewData["Title"] = "Edit Expected Stock";
}

<div class="row">
    <div class="col-12 col-lg-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header pb-4">
                <div class="d-flex flex-column">
                    <span class="text-muted small mb-2">Edit Expected Stock</span>
                    <h2 class="fs-4 fw-bold mb-0">Expected Stock - @Model.ExPrintMintReference</h2>
                </div>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert">
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <form asp-action="Edit" method="post" enctype="multipart/form-data" id="editForm">
                    <input type="hidden" asp-for="Id">
                    <input type="hidden" asp-for="Attachment">
                    <input type="hidden" asp-for="CurrentStatusId">

                    <!-- Section 1: Basic Information -->
                    <div class="form-section mb-4 shadow">
                        <div class="mb-3 pb-2 border-bottom">
                            <small class="fw-bold text-muted mb-0 text-uppercase">
                                <i class="ti ti-info-circle me-2"></i>Basic Information
                            </small>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" asp-for="ExPrintMintReference">Reference <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" asp-for="ExPrintMintReference" placeholder="e.g., EPM-2024-001" required>
                                <small class="text-muted d-block mt-1">Unique identifier for this stock shipment</small>
                                <span asp-validation-for="ExPrintMintReference" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="VendorTypeId">Vendor Type <span class="text-danger">*</span></label>
                                <select class="form-select" id="VendorTypeId" required>
                                    <option value="">-- Select Vendor Type --</option>
                                    @if (ViewBag.VendorTypes != null)
                                    {
                                        @foreach (var vendorType in ViewBag.VendorTypes)
                                        {
                                            <option value="@vendorType.Id" data-name="@vendorType.Name">@vendorType.Name</option>
                                        }
                                    }
                                </select>
                                <small class="text-muted d-block mt-1">Vendors will be filtered based on selected type</small>
                                <span class="text-danger small d-block mt-1" id="vendorTypeError"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" asp-for="DeliveryDate">Expected Delivery Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" asp-for="DeliveryDate" required>
                                <span asp-validation-for="DeliveryDate" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label" asp-for="CurrencyVendorId">Currency Vendor <span class="text-danger">*</span></label>
                                <select class="form-select" asp-for="CurrencyVendorId" id="CurrencyVendorId" required>
                                    <option value="">-- Select Vendor --</option>
                                    @if (ViewBag.CurrencyVendors != null)
                                    {
                                        @foreach (var vendor in ViewBag.CurrencyVendors)
                                        {
                                            <option value="@vendor.Id" data-vendor-type="@vendor.VendorType?.Id">@vendor.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="CurrencyVendorId" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" asp-for="ApprovedCurrencyProcurementId">Approved Currency Procurement <span class="text-danger">*</span></label>
                                <select class="form-select" asp-for="ApprovedCurrencyProcurementId" id="ApprovedCurrencyProcurementId" required>
                                    <option value="">-- Select Approved Currency Procurement --</option>
                                    @if (ViewBag.ApprovedCurrencyProcurements != null)
                                    {
                                        @foreach (var proc in ViewBag.ApprovedCurrencyProcurements)
                                        {
                                            <option value="@proc.Id"><span>#PR</span>@proc.Id - @proc.Amount.ToString("N0")</option>
                                        }
                                    }
                                </select>
                                <span class="text-danger small d-block mt-1" id="approvedCurrencyError"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" asp-for="BranchId">Branch<span class="text-danger">*</span></label>
                                <select class="form-select" asp-for="BranchId" id="CurrencyVendorId" required>
                                    <option value="">-- Select Branch --</option>
                                    @if (ViewBag.BranchList != null)
                                    {
                                        @foreach (var branch in ViewBag.BranchList)
                                        {
                                            <option value="@branch.Id" data-name="@branch.Name">@branch.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="BranchId" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Section 2: Denominations & Stock Details -->
                    <div class="form-section mb-4 shadow">
                        <div class="mb-3 pb-2 border-bottom">
                            <small class="fw-bold text-muted mb-0 text-uppercase">
                                <i class="ti ti-package me-2"></i>Denominations & Stock Details
                            </small>
                        </div>

                        <div class="alert alert-info mb-3">
                            <i class="ti ti-info-circle me-2"></i>
                            Edit denomination details below. Changes will be saved when you click Save Changes.
                        </div>

                        <!-- Denominations Table -->
                        <div class="table-responsive">
                            <table class="table table-bordered align-middle" id="denominations-table">
                                <thead style="background-color: #f8f9fa !important;">
                                    <tr>
                                        <th>Denomination</th>
                                        <th>Number of Pieces</th>
                                        <th>Amount</th>
                                        <th>Number of Boxes</th>
                                        <th class="text-center" style="width: 80px;">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Details != null && Model.Details.Any())
                                    {
                                        @for (var index = 0; index < Model.Details.Count; index++)
                                        {
                                            var detail = Model.Details.ElementAt(index);
                                            <tr>
                                                <td>
                                                    <input type="hidden" name="Details[@index].Id" value="@detail.Id" />
                                                    <input type="hidden" name="Details[@index].ExPrintMintId" value="@detail.ExPrintMintId" />
                                                    <select name="Details[@index].DenominationId" class="form-select denomination-select">
                                                        <option value="">-- Select Denomination --</option>
                                                        @if (ViewBag.Denominations != null)
                                                        {
                                                            @foreach (var denom in ViewBag.Denominations)
                                                            {
                                                                @if (denom.Id == detail.DenominationId)
                                                                {
                                                                    <option value="@denom.Id" data-denomination-value="@denom.Value" data-pieces-in-box="@denom.NumberOfPiecesInABox" selected>@denom.Name</option>
                                                                }
                                                                else
                                                                {
                                                                    <option value="@denom.Id" data-denomination-value="@denom.Value" data-pieces-in-box="@denom.NumberOfPiecesInABox">@denom.Name</option>
                                                                }
                                                            }
                                                        }
                                                    </select>
                                                </td>
                                                <td>
                                                    <input name="Details[@index].NumberOfPieces" class="form-control pieces-input" type="number" value="@detail.NumberOfPieces" placeholder="Enter number of pieces" />
                                                </td>
                                                <td>
                                                    <input name="Details[@index].Value" class="form-control value-input" type="text" value="@detail.Value.ToString("N0")" placeholder="Amount" readonly />
                                                </td>
                                                <td>
                                                    <input name="Details[@index].NumberOfBoxes" class="form-control boxes-input" type="number" value="@detail.NumberOfBoxes" placeholder="Number of boxes" readonly />
                                                </td>
                                                <td class="text-center">
                                                    <button type="button" class="btn btn-sm btn-outline-danger remove-row" title="Remove row">
                                                        <i class="ti ti-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center text-muted">No denominations added</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex gap-2 mt-3 mb-3">
                            <button type="button" id="add-row" class="btn btn-outline-primary">
                                <i class="ti ti-plus me-1"></i>Add Denomination Row
                            </button>
                        </div>
                    </div>

                    <!-- Section 3: Box Number Details (Only for Printer) -->
                    @*  *@

                    <!-- Section 4: Serial Number Details (Only for Printer) -->
                    @* <div class="form-section mb-4 shadow" id="serialNumberDetailSection" style="display: none;"> *@
                    @*     <div class="mb-3 pb-2 border-bottom"> *@
                    @*         <small class="fw-bold text-muted mb-0 text-uppercase"> *@
                    @*             <i class="ti ti-barcode me-2"></i>Serial Number Details *@
                    @*         </small> *@
                    @*     </div> *@

                    @*     <div class="mb-3"> *@
                    @*         <label class="form-label" asp-for="SerialNumberPrefix">Serial Number Prefix <span class="text-danger">*</span></label> *@
                    @*         <input type="text" class="form-control" asp-for="SerialNumberPrefix" placeholder="Enter serial number prefix"> *@
                    @*         <small class="text-muted d-block mt-1">Prefix used before serial numbers</small> *@
                    @*         <span asp-validation-for="SerialNumberPrefix" class="text-danger small d-block mt-1"></span> *@
                    @*     </div> *@
                    @*     <div class="row"> *@
                    @*         <div class="col-md-6 mb-3"> *@
                    @*             <label class="form-label" asp-for="SerialNumberRangeStart">Serial Number Range Start <span class="text-danger">*</span></label> *@
                    @*             <input type="number" class="form-control" asp-for="SerialNumberRangeStart" placeholder="Enter start range"> *@
                    @*             <span asp-validation-for="SerialNumberRangeStart" class="text-danger small d-block mt-1"></span> *@
                    @*         </div> *@

                    @*         <div class="col-md-6 mb-3"> *@
                    @*             <label class="form-label" asp-for="SerialNumberRangeEnd">Serial Number Range End <span class="text-danger">*</span></label> *@
                    @*             <input type="number" class="form-control" asp-for="SerialNumberRangeEnd" placeholder="Enter end range"> *@
                    @*             <span asp-validation-for="SerialNumberRangeEnd" class="text-danger small d-block mt-1"></span> *@
                    @*         </div> *@
                    @*     </div> *@
                    @* </div> *@

                    <!-- Section 5: Documentation -->
                    <div class="form-section mb-4 shadow">
                        <div class="mb-3 pb-2 border-bottom">
                            <small class="fw-bold text-muted mb-0 text-uppercase">
                                <i class="ti ti-file me-2"></i>Documentation
                            </small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" asp-for="AttachmentFile">Attachment (PDF) <span class="text-danger">*</span></label>
                            @if (!string.IsNullOrEmpty(Model.Attachment))
                            {
                                <div class="mb-2">
                                    <a href="@Url.Action("ViewAttachment", "ExPrintMints", new { id = Model.Id })" target="_blank" class="btn btn-outline-primary btn-sm">
                                        <i class="ti ti-file-type-pdf me-1"></i>Current Attachment
                                    </a>
                                </div>
                            }
                            <input type="file" class="form-control" id="AttachmentFile" name="AttachmentFile" accept=".pdf,application/pdf">
                            <small class="text-muted d-block mt-2"><i class="ti ti-info-circle me-1"></i>Accepted formats: PDF only. Max size: 10MB</small>
                            <span asp-validation-for="AttachmentFile" class="text-danger small d-block mt-1"></span>
                        </div>
                    </div>
                    
                    <!-- Form Actions -->
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-check me-1"></i>Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="ti ti-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        // Store vendors data grouped by vendor type
        const vendorsData = {};
        @if (ViewBag.CurrencyVendors != null)
        {
            @:const allVendors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.CurrencyVendors));
            @:allVendors.forEach(function(vendor) {
            @:    const vendorTypeId = vendor.VendorTypeId;
            @:    if (vendorTypeId) {
            @:        if (!vendorsData[vendorTypeId]) {
            @:            vendorsData[vendorTypeId] = [];
            @:        }
            @:        vendorsData[vendorTypeId].push(vendor);
            @:    }
            @:});
        }

        // Initialize form with current values
        function initializeForm() {
            const currentVendorId = $('#CurrencyVendorId').val();
            
            if (currentVendorId) {
                // Find the vendor type of the current vendor
                const $currentOption = $(`#CurrencyVendorId option[value="${currentVendorId}"]`);
                const currentVendorType = $currentOption.data('vendor-type');
                
                if (currentVendorType) {
                    $('#VendorTypeId').val(currentVendorType);
                    triggerVendorTypeChange();
                }
            }
        }

        // Handle Vendor Type Selection
        $('#VendorTypeId').on('change', triggerVendorTypeChange);

        function triggerVendorTypeChange() {
            const selectedVendorTypeId = $('#VendorTypeId').val();
            const selectedVendorTypeName = $('#VendorTypeId').find('option:selected').data('name');
            const $vendorSelect = $('#CurrencyVendorId');
            const $boxNumberSection = $('#boxNumberDetailSection');
            const $serialNumberSection = $('#serialNumberDetailSection');

            // Clear vendor select but keep current value
            const currentVendorId = $vendorSelect.val();
            $vendorSelect.html('<option value="">-- Select Vendor --</option>');

            // Show/Hide Box Number and Serial Number sections based on Vendor Type
            if (selectedVendorTypeName && selectedVendorTypeName.toLowerCase() === 'printer') {
                $boxNumberSection.slideDown(300);
                $serialNumberSection.slideDown(300);
                
                // Make fields required
                $('#boxNumberDetailSection input, #boxNumberDetailSection select').prop('required', true);
                $('#serialNumberDetailSection input, #serialNumberDetailSection select').prop('required', true);
            } else {
                $boxNumberSection.slideUp(300);
                $serialNumberSection.slideUp(300);
                
                // Remove required attribute
                $('#boxNumberDetailSection input, #boxNumberDetailSection select').prop('required', false);
                $('#serialNumberDetailSection input, #serialNumberDetailSection select').prop('required', false);
                
                // Clear the fields
                $('#boxNumberDetailSection input, #boxNumberDetailSection select').val('');
                $('#serialNumberDetailSection input, #serialNumberDetailSection select').val('');
            }

            if (selectedVendorTypeId) {
                // Filter and populate vendors
                const filteredVendors = vendorsData[selectedVendorTypeId] || [];
                
                if (filteredVendors.length > 0) {
                    filteredVendors.forEach(function(vendor) {
                        $vendorSelect.append(
                            `<option value="${vendor.Id}">${vendor.Name}</option>`
                        );
                    });
                    $('#vendorTypeError').text('').hide();
                    
                    // Restore previous selection if still available
                    if (currentVendorId) {
                        $vendorSelect.val(currentVendorId);
                    }
                } else {
                    $('#vendorTypeError').text('No vendors available for this type').show();
                }
            }
        }

        // Form submission - validate denomination details
        $('#editForm').on('submit', function(e) {
            // Validate that at least one denomination with valid pieces is present
            const rows = tableBody.querySelectorAll('tr');
            let hasValidDenomination = false;

            rows.forEach(row => {
                const denominationSelect = row.querySelector('.denomination-select');
                const piecesInput = row.querySelector('.pieces-input');
                
                if (denominationSelect && denominationSelect.value && piecesInput && parseInt(piecesInput.value) > 0) {
                    hasValidDenomination = true;
                }
            });

            if (!hasValidDenomination) {
                e.preventDefault();
                alert('Please add at least one denomination with a valid number of pieces');
                return false;
            }

            // Validate Box Number fields if section is visible
            if ($('#boxNumberDetailSection').is(':visible')) {
                const boxPrefix = $('[name="BoxNumberPrefix"]').val();
                const boxStart = $('[name="BoxNumberRangeStart"]').val();
                const boxEnd = $('[name="BoxNumberRangeEnd"]').val();

                if (!boxPrefix || !boxStart || !boxEnd) {
                    e.preventDefault();
                    alert('Please fill all Box Number fields');
                    return false;
                }
            }

            // Validate Serial Number fields if section is visible
            if ($('#serialNumberDetailSection').is(':visible')) {
                const serialPrefix = $('[name="SerialNumberPrefix"]').val();
                const serialStart = $('[name="SerialNumberRangeStart"]').val();
                const serialEnd = $('[name="SerialNumberRangeEnd"]').val();

                if (!serialPrefix || !serialStart || !serialEnd) {
                    e.preventDefault();
                    alert('Please fill all Serial Number fields');
                    return false;
                }
            }
        });

        // Initialize form on page load
        initializeForm();

        // Denomination table management
        const tableBody = document.querySelector('#denominations-table tbody');
        const addRowButton = document.getElementById('add-row');

        const calculateRowValues = (row) => {
            const denominationSelect = row.querySelector('.denomination-select');
            const piecesInput = row.querySelector('.pieces-input');
            const valueInput = row.querySelector('.value-input');
            const boxesInput = row.querySelector('.boxes-input');

            if (!denominationSelect || !piecesInput || !valueInput || !boxesInput) return;

            const selectedOption = denominationSelect.options[denominationSelect.selectedIndex];
            const pieces = parseInt(piecesInput.value) || 0;
            const denominationValue = parseFloat(selectedOption?.dataset.denominationValue) || 0;
            const piecesInBox = parseInt(selectedOption?.dataset.piecesInBox) || 1;

            if (pieces > 0 && denominationValue > 0) {
                const value = pieces * denominationValue;
                const numberOfBoxes = Math.ceil(pieces / piecesInBox);

                valueInput.value = value.toLocaleString('en-US', {
                    minimumFractionDigits: 0,
                    maximumFractionDigits: 0
                });
                boxesInput.value = numberOfBoxes;
            } else {
                valueInput.value = '';
                boxesInput.value = '';
            }
        };

        const reindexRows = () => {
            const rows = tableBody.querySelectorAll('tr');
            rows.forEach((row, index) => {
                row.querySelectorAll('input, select').forEach(field => {
                    const name = field.getAttribute('name');
                    if (name) {
                        const newName = name.replace(/Details\[\d+\]/g, `Details[${index}]`);
                        field.setAttribute('name', newName);
                    }
                });
            });
        };

        const initializeExistingRows = () => {
            const rows = tableBody.querySelectorAll('tr');
            rows.forEach(row => {
                const denominationSelect = row.querySelector('.denomination-select');
                const piecesInput = row.querySelector('.pieces-input');
                
                if (denominationSelect) {
                    denominationSelect.addEventListener('change', () => calculateRowValues(row));
                }
                if (piecesInput) {
                    piecesInput.addEventListener('input', () => calculateRowValues(row));
                }
                
                // Initial calculation
                calculateRowValues(row);
            });
        };

        if (addRowButton) {
            addRowButton.addEventListener('click', (e) => {
                e.preventDefault();
                const rows = tableBody.querySelectorAll('tr');
                const newIndex = rows.length;

                const newRow = document.createElement('tr');
                newRow.innerHTML = `
                    <td>
                        <select name="Details[${newIndex}].DenominationId" class="form-select denomination-select">
                            <option value="">-- Select Denomination --</option>
                            @if (ViewBag.Denominations != null)
                            {
                                @foreach (var denom in ViewBag.Denominations)
                                {
                                    @:<option value="@denom.Id" data-denomination-value="@denom.Value" data-pieces-in-box="@denom.NumberOfPiecesInABox">@denom.Name</option>
                                }
                            }
                        </select>
                    </td>
                    <td>
                        <input name="Details[${newIndex}].NumberOfPieces" class="form-control pieces-input" type="number" placeholder="Enter number of pieces" />
                    </td>
                    <td>
                        <input name="Details[${newIndex}].Value" class="form-control value-input" type="text" placeholder="Amount" readonly />
                    </td>
                    <td>
                        <input name="Details[${newIndex}].NumberOfBoxes" class="form-control boxes-input" type="number" placeholder="Number of boxes" readonly />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-danger remove-row" title="Remove row">
                            <i class="ti ti-trash"></i>
                        </button>
                    </td>
                `;

                tableBody.appendChild(newRow);
                
                const denominationSelect = newRow.querySelector('.denomination-select');
                const piecesInput = newRow.querySelector('.pieces-input');
                const removeBtn = newRow.querySelector('.remove-row');

                if (denominationSelect) {
                    denominationSelect.addEventListener('change', () => calculateRowValues(newRow));
                }
                if (piecesInput) {
                    piecesInput.addEventListener('input', () => calculateRowValues(newRow));
                }

                if (removeBtn) {
                    removeBtn.addEventListener('click', (e) => {
                        e.preventDefault();
                        newRow.remove();
                        reindexRows();
                    });
                }
            });
        }

        // Remove row functionality
        tableBody.addEventListener('click', (e) => {
            if (e.target.closest('.remove-row')) {
                e.preventDefault();
                const row = e.target.closest('tr');
                row.remove();
                reindexRows();
            }
        });

        // Initialize existing rows
        initializeExistingRows();
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
