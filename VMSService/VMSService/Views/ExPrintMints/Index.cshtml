@model List<VMSService.Core.Models.ExPrintMints.ExPrintMintViewModel>

@{
    ViewData["Title"] = "Expected Stock";
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h2 class="fs-5 fw-bold mb-0">Expected Stock</h2>
                    </div>
                    <div class="col text-end">
                        <a asp-action="Create" class="btn btn-sm btn-primary">
                            <i class="ti ti-plus me-1"></i>Add Expected Stock
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <!-- Success Message -->
                @* @if (!string.IsNullOrEmpty(TempData?["Success"]?.ToString()))
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="ti ti-check-circle me-2"></i>
                        <strong>Success!</strong> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                } *@

                <!-- Error Message -->
                @* @if (!string.IsNullOrEmpty(TempData?["Error"]?.ToString()))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="ti ti-alert-circle me-2"></i>
                        <strong>Error!</strong> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                } *@

                <div class="table-responsive">
                    <table class="table table-centered mb-0 rounded datatable">
                        <thead class="thead-light">
                            <tr>
                                <th class="border-0 rounded-start">#</th>
                                <th class="border-0">Reference</th>
                                <th class="border-0">Vendor</th>
                                <th class="border-0">Denomination</th>
                                <th class="border-0">Delivery Date</th>
                                <th class="border-0">Value (UGX)</th>
                                <th class="border-0">Type</th>
                                <th class="border-0">Status</th>
                                <th class="border-0 rounded-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowNumber = 1;
                            }
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td><span class="text-primary fw-bold">@rowNumber</span></td>
                                        <td class="fw-bold">@item.ExPrintMintReference</td>
                                        <td>
                                            @if (item.CurrencyVendor != null)
                                            {
                                                @item.CurrencyVendor.Name
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.Denomination != null)
                                            {
                                                @item.Denomination.Name
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>@item.DeliveryDate.ToString("dd/MMM/yyyy")</td>
                                        <td>
                                            <span class="fw-bold">@item.Value.ToString("N0")</span>
                                        </td>
                                        <td>
                                            <div class="d-inline-flex align-items-center gap-2" style="width: fit-content;">
                                                @if (item.CurrencyVendor?.VendorType?.Name == "Printer")
                                                {
                                                    <span class="badge bg-primary">
                                                        <i class="ti ti-tag me-1"></i>ExPrint
                                                    </span>
                                                } else
                                                {
                                                    <span class="badge bg-primary">
                                                        <i class="ti ti-tag me-1"></i>ExMint
                                                    </span>
                                                }

                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-inline-flex align-items-center gap-2" style="width: fit-content;">
                                                @if (item.CurrentStatusId > 0)
                                                {
                                                    <span class="badge bg-info">
                                                        <i class="ti ti-badge me-1"></i>@item.CurrentStatus?.Name
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">
                                                        <i class="ti ti-question-mark me-1"></i>Unknown
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                                    <i class="ti ti-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                                    <i class="ti ti-edit"></i>
                                                </a>
                                                @* <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                                    <i class="ti ti-trash"></i>
                                                </a> *@
                                            </div>
                                        </td>
                                        @{
                                            rowNumber++;
                                        }
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">
                                        <i class="ti ti-inbox me-2"></i>No expected stock found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}