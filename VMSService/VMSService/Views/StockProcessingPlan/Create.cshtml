@using VMSService.Core.Models.StockProcessingPlans
@model StockProcessingPlanCreateViewModel

@{
    ViewData["Title"] = "Create Processing Plan";
}

<style>
    .room-card-header {
        background: #fff;
        border-bottom: 1px solid #e9ecef;
        border-top: 3px solid #31316A;
        border-radius: .5rem .5rem 0 0;
    }
    .bag-chip {
        display: inline-flex; align-items: center; gap: 4px;
        padding: .22rem .55rem; border-radius: 999px;
        font-size: .72rem; font-weight: 600; cursor: pointer;
        background: #e8f5e9; color: #1b5e20;
        border: 1.5px solid rgba(0,0,0,.1);
        transition: all .15s; user-select: none;
    }
    .bag-chip:hover { background: #c8e6c9; }
    .bag-chip.selected { background: #31316A !important; color: #fff !important; border-color: #31316A !important; }
    .bag-chip.board-assigned { background: #e3f2fd; color: #0d47a1; border-color: #90caf9; }
    .board-zone {
        min-height: 64px; border: 2px dashed #dee2e6; border-radius: .5rem;
        padding: .5rem; background: #f8fafc;
        display: flex; flex-wrap: wrap; gap: 4px; align-items: flex-start;
        cursor: pointer; transition: border-color .15s, background .15s;
    }
    .board-zone:hover, .board-zone.can-drop {
        border-color: #31316A; background: #f0f4ff;
    }
    .remove-chip { margin-left: 3px; opacity: .6; cursor: pointer; }
    .remove-chip:hover { opacity: 1; }
</style>

@* Page Header *@
<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i>Back
        </a>
        <div>
            <p class="text-muted small mb-0">New Processing Plan</p>
            <h4 class="fw-bold mb-0" style="color:#31316A;">@Model.ProcessingDate.ToString("dd MMMM yyyy")</h4>
        </div>
        @if (!string.IsNullOrEmpty(Model.BranchName))
        {
            <span class="badge bg-primary"><i class="ti ti-building me-1"></i>@Model.BranchName</span>
        }
        <span class="badge bg-secondary">Draft</span>
    </div>
    <button type="button" class="btn btn-primary" onclick="submitPlan()">
        <i class="ti ti-device-floppy me-1"></i>Save Plan
    </button>
</div>

@* Hidden save form *@
<form id="planForm" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="processingDate" value="@Model.ProcessingDate.ToString("yyyy-MM-dd")" />
    <input type="hidden" name="branchId" value="@Model.BranchId" />
    <input type="hidden" id="assignmentsJson" name="assignmentsJson" value="[]" />
</form>

@* Available Bags Pool *@
<div class="card border-0 shadow mb-4">
    <div class="card-header" style="background:#fff;border-top:3px solid #BA7517;border-radius:.5rem .5rem 0 0;">
        <div class="row align-items-center">
            <div class="col">
                <h6 class="fw-bold mb-0" style="color:#BA7517;">
                    <i class="ti ti-packages me-2"></i>Available Bags
                    <span class="badge bg-warning text-dark ms-2 fw-normal" id="availableCount">@Model.AvailableBags.Count</span>
                </h6>
                <p class="small text-muted mb-0">
                    Click a bag to select it (turns dark), then click a Processing Board zone to assign it.
                </p>
            </div>
        </div>
    </div>
    <div class="card-body p-3" id="bagPool">
        @if (!Model.AvailableBags.Any())
        {
            <p class="text-muted small mb-0 text-center py-2">No bags available for this branch.</p>
        }
        @foreach (var bag in Model.AvailableBags)
        {
            <span class="bag-chip me-1 mb-1"
                  data-bag-id="@bag.Id"
                  data-bag-ref="@bag.ReferenceNumber"
                  onclick="toggleSelectBag(this)">
                <i class="ti ti-package" style="font-size:.65rem;"></i>@bag.ReferenceNumber
            </span>
        }
    </div>
</div>

@* Counting Rooms with Processing Boards *@
@if (!Model.CountingRooms.Any())
{
    <div class="card border-0 shadow">
        <div class="card-body text-center py-5">
            <i class="ti ti-door d-block mb-3 text-secondary" style="font-size:3rem;opacity:.4;"></i>
            <p class="fw-semibold text-muted mb-1">No Counting Rooms configured for this branch</p>
        </div>
    </div>
}

@foreach (var room in Model.CountingRooms)
{
    <div class="card border-0 shadow mb-4">
        <div class="room-card-header d-flex align-items-center px-3 py-2">
            <div class="rounded d-flex align-items-center justify-content-center me-2"
                 style="width:32px;height:32px;background:rgba(49,49,106,.08);flex-shrink:0;">
                <i class="ti ti-door" style="color:#31316A;font-size:.9rem;"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-0" style="color:#31316A;">@room.Name</h6>
                <span class="small text-muted">@room.Boards.Count board@(room.Boards.Count == 1 ? "" : "s")</span>
            </div>
        </div>
        <div class="card-body p-3">
            @if (!room.Boards.Any())
            {
                <div class="text-center py-4 text-muted">
                    <i class="ti ti-layout-grid-remove d-block mb-2" style="font-size:2rem;opacity:.4;"></i>
                    <p class="small mb-0">No Processing Boards in this room</p>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var board in room.Boards)
                    {
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="border rounded-3 h-100" style="border-color:#e9ecef!important;">
                                <div class="p-3 border-bottom d-flex align-items-center justify-content-between"
                                     style="background:#f8fafc;border-radius:.75rem .75rem 0 0;">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="ti ti-cpu" style="color:#31316A;"></i>
                                        <div>
                                            <span class="fw-semibold small">@board.Name</span>
                                            @if (!string.IsNullOrEmpty(board.MachineName))
                                            {
                                                <p class="mb-0" style="font-size:.68rem;color:#6c757d;">@board.MachineName</p>
                                            }
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-xs btn-outline-danger"
                                            style="padding:.15rem .4rem;font-size:.7rem;"
                                            onclick="clearBoard(@board.Id)" title="Clear board">
                                        <i class="ti ti-x"></i>
                                    </button>
                                </div>
                                <div class="p-3">
                                    <div class="board-zone" id="zone-@board.Id" data-board-id="@board.Id"
                                         onclick="handleZoneClick(this)">
                                        <span class="hint-text small text-muted w-100 text-center"
                                              style="display:block;padding:.5rem 0;">
                                            Select a bag then click here to assign
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@section Scripts {
<script>
    let selectedBag = null;        // { id, ref, el }
    const assignments = {};        // boardId -> [{id, ref}]

    function toggleSelectBag(el) {
        if (selectedBag && selectedBag.el === el) {
            el.classList.remove('selected');
            selectedBag = null;
            return;
        }
        if (selectedBag) selectedBag.el.classList.remove('selected');
        selectedBag = { id: +el.dataset.bagId, ref: el.dataset.bagRef, el };
        el.classList.add('selected');
    }

    function handleZoneClick(zoneEl) {
        if (!selectedBag) return;
        const boardId = +zoneEl.dataset.boardId;

        if (!assignments[boardId]) assignments[boardId] = [];
        if (assignments[boardId].some(b => b.id === selectedBag.id)) return;

        assignments[boardId].push({ id: selectedBag.id, ref: selectedBag.ref });

        const hint = zoneEl.querySelector('.hint-text');
        if (hint) hint.remove();

        const chip = document.createElement('span');
        chip.className = 'bag-chip board-assigned';
        chip.dataset.bagId = selectedBag.id;
        const bagId = selectedBag.id;
        chip.innerHTML = `<i class="ti ti-package" style="font-size:.65rem;"></i>${selectedBag.ref}<span class="remove-chip" title="Remove">✕</span>`;
        chip.querySelector('.remove-chip').addEventListener('click', function (e) {
            e.stopPropagation();
            removeFromBoard(bagId, boardId, chip);
        });
        zoneEl.appendChild(chip);

        selectedBag.el.style.display = 'none';
        selectedBag = null;
        updateCount();
    }

    function removeFromBoard(bagId, boardId, chipEl) {
        if (assignments[boardId])
            assignments[boardId] = assignments[boardId].filter(b => b.id !== bagId);

        chipEl.remove();

        const zone = document.getElementById('zone-' + boardId);
        if (zone && !zone.querySelector('.board-assigned')) {
            const hint = document.createElement('span');
            hint.className = 'hint-text small text-muted w-100 text-center';
            hint.style.cssText = 'display:block;padding:.5rem 0;';
            hint.textContent = 'Select a bag then click here to assign';
            zone.appendChild(hint);
        }

        const poolEl = document.querySelector(`#bagPool [data-bag-id="${bagId}"]`);
        if (poolEl) poolEl.style.display = '';
        updateCount();
    }

    function clearBoard(boardId) {
        const zone = document.getElementById('zone-' + boardId);
        if (!zone) return;
        zone.querySelectorAll('.board-assigned').forEach(chip => {
            const bagId = +chip.dataset.bagId;
            const poolEl = document.querySelector(`#bagPool [data-bag-id="${bagId}"]`);
            if (poolEl) poolEl.style.display = '';
            chip.remove();
        });
        assignments[boardId] = [];
        if (!zone.querySelector('.hint-text')) {
            const hint = document.createElement('span');
            hint.className = 'hint-text small text-muted w-100 text-center';
            hint.style.cssText = 'display:block;padding:.5rem 0;';
            hint.textContent = 'Select a bag then click here to assign';
            zone.appendChild(hint);
        }
        updateCount();
    }

    function updateCount() {
        const visible = [...document.querySelectorAll('#bagPool .bag-chip')].filter(el => el.style.display !== 'none').length;
        document.getElementById('availableCount').textContent = visible;
    }

    function submitPlan() {
        const result = Object.entries(assignments)
            .filter(([, bags]) => bags.length > 0)
            .map(([boardId, bags]) => ({ processingBoardId: +boardId, bagIds: bags.map(b => b.id) }));
        document.getElementById('assignmentsJson').value = JSON.stringify(result);
        document.getElementById('planForm').submit();
    }
</script>
}
