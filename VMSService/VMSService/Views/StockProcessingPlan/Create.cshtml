@using VMSService.Core.Models.StockProcessingPlans
@model StockProcessingPlanCreateViewModel

@{
    ViewData["Title"] = "Create Processing Plan";
}

<style>
    .room-card-header {
        background: #fff;
        border-bottom: 1px solid #e9ecef;
        border-top: 3px solid #31316A;
        border-radius: .5rem .5rem 0 0;
    }
    .bags-panel {
        position: sticky;
        top: 1rem;
    }
    .bag-pool-scroll {
        max-height: calc(100vh - 280px);
        overflow-y: auto;
        overflow-x: hidden;
    }
    .bag-card {
        display: flex; flex-direction: column;
        padding: .35rem .65rem; border-radius: .4rem;
        font-size: .78rem; cursor: pointer;
        background: #e8f5e9; color: #1b5e20;
        border: 1.5px solid rgba(0,0,0,.1);
        transition: all .15s; user-select: none;
    }
    .bag-card:hover { background: #c8e6c9; }
    .bag-card.bag-full { background: #fff3cd; color: #664d03; border-color: rgba(102,77,3,.2); }
    .bag-card.bag-full:hover { background: #ffe69c; }
    .bag-card.selected { background: #31316A !important; color: #fff !important; border-color: #31316A !important; }
    .bag-card.hidden-assigned, .bag-card.hidden-filter { display: none !important; }
    .bag-ref { font-weight: 700; line-height: 1.3; font-size: .8rem; }
    .bag-meta { font-size: .68rem; opacity: .8; line-height: 1.3; margin-top: 2px; }
    .bag-denom { font-size: .68rem; font-weight: 600; opacity: .75; }
    .board-zone {
        min-height: 64px; border: 2px dashed #dee2e6; border-radius: .5rem;
        padding: .5rem; background: #f8fafc;
        display: flex; flex-wrap: wrap; gap: 4px; align-items: flex-start;
        cursor: pointer; transition: border-color .15s, background .15s;
    }
    .board-zone:hover, .board-zone.can-drop { border-color: #31316A; background: #f0f4ff; }
    .board-chip {
        display: inline-flex; flex-direction: column;
        padding: .2rem .5rem; border-radius: .4rem; font-size: .72rem;
        background: #e3f2fd; color: #0d47a1; border: 1.5px solid #90caf9;
        vertical-align: top;
    }
    .board-chip-ref { font-weight: 700; font-size: .73rem; }
    .board-chip-meta { font-size: .63rem; opacity: .75; }
    .remove-chip { margin-left: 4px; opacity: .5; cursor: pointer; font-size: .65rem; }
    .remove-chip:hover { opacity: 1; }
</style>

@* Page Header *@
<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i>Back
        </a>
        <div>
            <p class="text-muted small mb-0">New Processing Plan</p>
            <h4 class="fw-bold mb-0" style="color:#31316A;">@Model.ProcessingDate.ToString("dd MMMM yyyy")</h4>
        </div>
        @if (!string.IsNullOrEmpty(Model.BranchName))
        {
            <span class="badge bg-primary p-2 more-rounded"><i class="ti ti-building me-1"></i>@Model.BranchName</span>
        }
        <span class="badge bg-info p-2 more-rounded"><i class="ti ti-badge me-1"></i>Draft</span>
    </div>
    <button type="button" class="btn btn-primary" onclick="submitPlan()">
        <i class="ti ti-device-floppy me-1"></i>Save Plan
    </button>
</div>

@* Hidden save form *@
<form id="planForm" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="processingDate" value="@Model.ProcessingDate.ToString("yyyy-MM-dd")" />
    <input type="hidden" name="branchId" value="@Model.BranchId" />
    <input type="hidden" id="assignmentsJson" name="assignmentsJson" value="[]" />
    <input type="hidden" id="roomSupervisorsJson" name="roomSupervisorsJson" value="[]" />
</form>

<div class="row g-4 align-items-start">

    @* ── Left column: Counting Rooms ─────────────────────────── *@
    <div class="col-12 col-xl-8">

        @if (!Model.CountingRooms.Any())
        {
            <div class="card border-0 shadow">
                <div class="card-body text-center py-5">
                    <i class="ti ti-door d-block mb-3 text-secondary" style="font-size:3rem;opacity:.4;"></i>
                    <p class="fw-semibold text-muted mb-1">No Counting Rooms configured for this branch</p>
                </div>
            </div>
        }

        @foreach (var room in Model.CountingRooms)
        {
            <div class="card border-0 shadow mb-4">
                <div class="room-card-header d-flex align-items-center px-3 py-2 gap-3">
                    <div class="rounded d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:32px;height:32px;background:rgba(49,49,106,.08);">
                        <i class="ti ti-door" style="color:#31316A;font-size:.9rem;"></i>
                    </div>
                    <div class="flex-shrink-0">
                        <h6 class="fw-bold mb-0" style="color:#31316A;">@room.Name</h6>
                        <span class="small text-muted">@room.Boards.Count board@(room.Boards.Count == 1 ? "" : "s")</span>
                    </div>
                    @if (Model.BoardSupervisors.Any())
                    {
                        <div class="ms-auto d-flex align-items-center gap-2 flex-shrink-0">
                            <label class="small text-muted mb-0 text-nowrap" style="font-size:.72rem;">
                                <i class="ti ti-user-check me-1"></i>Supervisor
                            </label>
                            <select class="form-select form-select-sm room-supervisor-select"
                                    data-room-id="@room.Id"
                                    style="min-width:180px;font-size:.75rem;">
                                <option value="">— Optional —</option>
                                @foreach (var supervisor in Model.BoardSupervisors)
                                {
                                    <option value="@supervisor.UserName">@supervisor.FirstName @supervisor.LastName</option>
                                }
                            </select>
                        </div>
                    }
                </div>
                <div class="card-body p-3">
                    @if (!room.Boards.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="ti ti-layout-grid-remove d-block mb-2" style="font-size:2rem;opacity:.4;"></i>
                            <p class="small mb-0">No Processing Boards in this room</p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var board in room.Boards)
                            {
                                <div class="col-12 col-md-6">
                                    <div class="border rounded-3 h-100" style="border-color:#e9ecef!important;">
                                        <div class="p-3 py-1 border-bottom d-flex align-items-center justify-content-between"
                                             style="background:#f8fafc;border-radius:1rem 1rem 0 0;">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="ti ti-cpu" style="color:#31316A;"></i>
                                                <div>
                                                    <span class="fw-semibold small">@board.Name</span>
                                                    @if (!string.IsNullOrEmpty(board.MachineName))
                                                    {
                                                        <p class="mb-0" style="font-size:.68rem;color:#6c757d;">@board.MachineName</p>
                                                    }
                                                </div>
                                            </div>
                                            <div class="d-flex gap-1">
                                                <button type="button"
                                                        class="btn btn-xs"
                                                        style="padding:.15rem .5rem;font-size:.7rem;background:#eef0ff;color:#31316A;border:1px solid #c5c7e8;"
                                                        data-board-name="@board.Name"
                                                        onclick="openNewBagModal(@board.Id, this.dataset.boardName)"
                                                        title="Add a new bag to this board">
                                                    <i class="ti ti-plus me-1"></i>New Bag
                                                </button>
                                                <button type="button" class="btn btn-xs btn-outline-danger"
                                                        style="padding:.15rem .4rem;font-size:.7rem;"
                                                        onclick="clearBoard(@board.Id)" title="Clear board">
                                                    <i class="ti ti-x"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="p-3">
                                            <div class="board-zone" id="zone-@board.Id" data-board-id="@board.Id"
                                                 onclick="handleZoneClick(this)">
                                                <span class="hint-text small text-muted w-100 text-center"
                                                      style="display:block;padding:.5rem 0;">
                                                    Select a bag then click here to assign
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

    </div>

    @* ── Right column: Available Bags ─────────────────────────── *@
    <div class="col-12 col-xl-4">
        <div class="bags-panel">
            <div class="card border-0 shadow">
                <div class="card-header" style="background:#fff;border-top:3px solid #BA7517;border-radius:.5rem .5rem 0 0;">
                    <h6 class="fw-bold mb-0" style="color:#BA7517;">
                        <i class="ti ti-packages me-2"></i>Available Bags
                        <span class="badge bg-warning text-dark ms-2 fw-normal" id="availableCount">@Model.AvailableBags.Count</span>
                    </h6>
                    <p class="small text-muted mb-0 mt-1">
                        Click a bag to select it, then click a board zone to assign it.
                    </p>
                </div>
                <div class="card-body p-3 pb-2">

                    @* Filters *@
                    <div class="d-flex flex-column gap-2 mb-3 pb-2 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <i class="ti ti-filter text-muted" style="font-size:.85rem;flex-shrink:0;"></i>
                            <select id="filterDenomination" class="form-select form-select-sm"
                                    onchange="applyFilters()">
                                <option value="">All Denominations</option>
                            </select>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="ti ti-building text-muted" style="font-size:.85rem;flex-shrink:0;"></i>
                            <select id="filterBank" class="form-select form-select-sm"
                                    onchange="applyFilters()">
                                <option value="">All Commercial Banks</option>
                            </select>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="ti ti-building-bank text-muted" style="font-size:.85rem;flex-shrink:0;"></i>
                            <select id="filterVault" class="form-select form-select-sm"
                                    onchange="onVaultFilterChange()">
                                <option value="">All Vaults</option>
                            </select>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="ti ti-archive text-muted" style="font-size:.85rem;flex-shrink:0;"></i>
                            <select id="filterVaultSection" class="form-select form-select-sm"
                                    onchange="applyFilters()">
                                <option value="">All Sections</option>
                            </select>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary w-100" onclick="clearFilters()">
                            <i class="ti ti-x me-1"></i>Clear Filters
                        </button>
                    </div>

                    @* Bag Pool *@
                    <div class="bag-pool-scroll">
                        <div class="ps-2 pe-2">
                            <div class="row" id="bagPool">
                                @if (!Model.AvailableBags.Any())
                                {
                                    <p class="text-muted small mb-0 text-center py-2">No bags available for this branch.</p>
                                }
                                @foreach (var bag in Model.AvailableBags)
                                {
                                    <div class="col-md-6 p-1">
                                        <div class="bag-card @(bag.TotalBundles >= 50 ? "bag-full" : "")"
                                             data-bag-id="@bag.Id"
                                             data-bag-ref="@bag.ReferenceNumber"
                                             data-denomination-value="@bag.DenominationValue.ToString("F0")"
                                             data-vault-id="@(bag.VaultId?.ToString() ?? "0")"
                                             data-vault-name="@(bag.VaultName ?? "")"
                                             data-vault-section-id="@(bag.VaultSectionId?.ToString() ?? "0")"
                                             data-vault-section-name="@(bag.VaultSectionName ?? "")"
                                             data-bank-names="@string.Join(",", bag.CommercialBankNames)"
                                             onclick="toggleSelectBag(this)">
                                            <span class="bag-ref">
                                                <i class="ti ti-package" style="font-size:.7rem;"></i> @bag.ReferenceNumber
                                            </span>
                                            @if (bag.DenominationValue > 0 || !string.IsNullOrEmpty(bag.SubCategoryName))
                                            {
                                                <span class="bag-denom">
                                                    @if (bag.DenominationValue > 0)
                                                    {
                                                        <text>UGX @bag.DenominationValue.ToString("N0")</text>
                                                    }
                                                    @if (!string.IsNullOrEmpty(bag.SubCategoryName))
                                                    {
                                                        if (bag.DenominationValue > 0) { <text> &middot; </text> }
                                                        <text>@bag.SubCategoryName</text>
                                                    }
                                                </span>
                                            }
                                            <span class="bag-meta">
                                                @bag.TotalBundles bundle@(bag.TotalBundles == 1 ? "" : "s")
                                                @if (bag.TotalAmount > 0)
                                                {
                                                    <span>&nbsp;&middot;&nbsp;@bag.TotalAmount.ToString("N0")</span>
                                                }
                                            </span>
                                            @if (!string.IsNullOrEmpty(bag.VaultSectionName))
                                            {
                                                <span class="bag-meta" style="font-size:.63rem;">
                                                    <i class="ti ti-archive" style="font-size:.6rem;"></i>Vault Section: @bag.VaultSectionName
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>

@* ── Add New Bag Modal ──────────────────────────────────────────── *@
<div class="modal fade" id="newBagModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
        <div class="modal-content border-0 shadow-lg" style="border-radius:.65rem;overflow:hidden;">
            <div class="modal-header py-3 px-4" style="background:#31316A;">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:30px;height:30px;background:rgba(255,255,255,.12);">
                        <i class="ti ti-package" style="color:#fff;font-size:.9rem;"></i>
                    </div>
                    <div>
                        <h6 class="modal-title text-white fw-bold mb-0" style="font-size:.88rem;line-height:1.2;">Add New Bag</h6>
                        <p class="text-white mb-0" style="font-size:.68rem;opacity:.7;line-height:1.2;" id="newBagBoardLabel"></p>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 pt-3 pb-2">
                <input type="hidden" id="newBagTargetBoardId" />
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label small fw-semibold mb-1" style="color:#31316A;">
                            <i class="ti ti-building me-1"></i>Commercial Bank <span class="text-danger">*</span>
                        </label>
                        <select class="form-select form-select-sm" id="newBagBank">
                            <option value="">— Select Commercial Bank —</option>
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small fw-semibold mb-1" style="color:#31316A;">
                            <i class="ti ti-calendar me-1"></i>Deposit Date <span class="text-danger">*</span>
                        </label>
                        <input type="date" class="form-control form-control-sm" id="newBagDepositDate" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small fw-semibold mb-1" style="color:#31316A;">
                            <i class="ti ti-building-bank me-1"></i>Source Deposit Branch <span class="text-danger">*</span>
                        </label>
                        <select class="form-select form-select-sm" id="newBagBranch">
                            <option value="">— Select Branch —</option>
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small fw-semibold mb-1" style="color:#31316A;">
                            <i class="ti ti-coin me-1"></i>Denomination <span class="text-danger">*</span>
                        </label>
                        <select class="form-select form-select-sm" id="newBagDenom">
                            <option value="" data-denom-value="0">— Select Denomination —</option>
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small fw-semibold mb-1" style="color:#31316A;">
                            <i class="ti ti-cash me-1"></i>Value (UGX) <span class="text-danger">*</span>
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text px-2"
                                  style="font-size:.75rem;background:#f8fafc;border-color:#dee2e6;">UGX</span>
                            <input type="text" class="form-control" id="newBagValue"
                                   placeholder="0" inputmode="decimal"
                                   oninput="newBagFormatValue(this)" />
                        </div>
                    </div>
                </div>
                <div id="newBagError" class="alert alert-danger mt-3 mb-0 py-2 px-3 d-none"
                     style="font-size:.78rem;"></div>
            </div>
            <div class="modal-footer px-4 py-2" style="background:#f8fafc;border-top:1px solid #e9ecef;">
                <span class="text-muted me-auto" style="font-size:.68rem;">
                    <span class="text-danger">*</span> Required fields
                </span>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" class="btn btn-sm btn-primary" id="newBagSubmitBtn"
                        onclick="submitNewBag()">
                    <i class="ti ti-device-floppy me-1"></i>Save Bag
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let selectedBag = null;
    const assignments = {};

    // ── Filters ───────────────────────────────────────────────────

    function populateFilters() {
        const cards = document.querySelectorAll('#bagPool .bag-card');
        const denomMap = new Map();
        const bankSet = new Set();
        const vaultMap = new Map();
        const sectionMap = new Map();

        cards.forEach(c => {
            const dv = c.dataset.denominationValue;
            if (dv && dv !== '0') {
                const num = parseFloat(dv);
                if (!denomMap.has(dv)) denomMap.set(dv, 'UGX ' + num.toLocaleString());
            }
            (c.dataset.bankNames || '').split(',').map(s => s.trim()).filter(Boolean)
                .forEach(name => bankSet.add(name));
            const vid = c.dataset.vaultId, vname = c.dataset.vaultName;
            if (vid && vid !== '0' && !vaultMap.has(vid)) vaultMap.set(vid, vname || 'Vault ' + vid);
            const sid = c.dataset.vaultSectionId, sname = c.dataset.vaultSectionName;
            if (sid && sid !== '0' && !sectionMap.has(sid)) sectionMap.set(sid, sname || 'Section ' + sid);
        });

        const denomSel = document.getElementById('filterDenomination');
        [...denomMap.entries()].sort((a, b) => parseFloat(a[0]) - parseFloat(b[0]))
            .forEach(([v, label]) => denomSel.add(new Option(label, v)));

        const bankSel = document.getElementById('filterBank');
        [...bankSet].sort().forEach(name => bankSel.add(new Option(name, name)));

        const vaultSel = document.getElementById('filterVault');
        vaultMap.forEach((name, id) => vaultSel.add(new Option(name, id)));

        const secSel = document.getElementById('filterVaultSection');
        sectionMap.forEach((name, id) => secSel.add(new Option(name, id)));
    }

    function onVaultFilterChange() {
        const vid = document.getElementById('filterVault').value;
        const secSel = document.getElementById('filterVaultSection');
        secSel.innerHTML = '<option value="">All Sections</option>';
        const seen = new Set();
        const selector = vid
            ? `#bagPool .bag-card[data-vault-id="${vid}"]`
            : '#bagPool .bag-card';
        document.querySelectorAll(selector).forEach(c => {
            const sid = c.dataset.vaultSectionId, sname = c.dataset.vaultSectionName;
            if (sid && sid !== '0' && !seen.has(sid)) {
                seen.add(sid);
                secSel.add(new Option(sname || 'Section ' + sid, sid));
            }
        });
        applyFilters();
    }

    function applyFilters() {
        const dv   = document.getElementById('filterDenomination').value;
        const bank = document.getElementById('filterBank').value;
        const vid  = document.getElementById('filterVault').value;
        const sid  = document.getElementById('filterVaultSection').value;
        document.querySelectorAll('#bagPool .bag-card').forEach(c => {
            if (c.classList.contains('hidden-assigned')) return;
            const banks = (c.dataset.bankNames || '').split(',').map(s => s.trim()).filter(Boolean);
            const match =
                (!dv   || c.dataset.denominationValue === dv)  &&
                (!bank || banks.includes(bank))                 &&
                (!vid  || c.dataset.vaultId            === vid) &&
                (!sid  || c.dataset.vaultSectionId     === sid);
            c.classList.toggle('hidden-filter', !match);
        });
        updateCount();
    }

    function clearFilters() {
        document.getElementById('filterDenomination').value = '';
        document.getElementById('filterBank').value = '';
        document.getElementById('filterVault').value = '';
        onVaultFilterChange();
        document.getElementById('filterVaultSection').value = '';
        applyFilters();
    }

    // ── Selection ─────────────────────────────────────────────────

    function toggleSelectBag(el) {
        if (selectedBag && selectedBag.el === el) {
            el.classList.remove('selected');
            selectedBag = null;
            return;
        }
        if (selectedBag) selectedBag.el.classList.remove('selected');
        selectedBag = { id: +el.dataset.bagId, ref: el.dataset.bagRef, el };
        el.classList.add('selected');
    }

    // ── Assignment ────────────────────────────────────────────────

    function handleZoneClick(zoneEl) {
        if (!selectedBag) return;
        const boardId = +zoneEl.dataset.boardId;
        if (!assignments[boardId]) assignments[boardId] = [];
        if (assignments[boardId].some(b => b.id === selectedBag.id)) return;

        const bag = selectedBag;
        assignments[boardId].push({ id: bag.id, ref: bag.ref });

        const hint = zoneEl.querySelector('.hint-text');
        if (hint) hint.remove();

        const denom  = bag.el.querySelector('.bag-denom')?.textContent.trim()  ?? '';
        const meta   = bag.el.querySelector('.bag-meta')?.textContent.trim()   ?? '';

        const chip = document.createElement('div');
        chip.className = 'board-chip';
        chip.dataset.bagId = bag.id;
        chip.innerHTML =
            `<span class="board-chip-ref"><i class="ti ti-package" style="font-size:.65rem;"></i> ${bag.ref}` +
            `<span class="remove-chip" title="Remove">✕</span></span>` +
            (denom ? `<span class="board-chip-meta">${denom}</span>` : '') +
            (meta  ? `<span class="board-chip-meta">${meta}</span>`  : '');
        chip.querySelector('.remove-chip').addEventListener('click', e => {
            e.stopPropagation();
            removeFromBoard(bag.id, boardId, chip);
        });
        zoneEl.appendChild(chip);

        bag.el.classList.add('hidden-assigned');
        selectedBag = null;
        updateCount();
    }

    function removeFromBoard(bagId, boardId, chipEl) {
        if (assignments[boardId])
            assignments[boardId] = assignments[boardId].filter(b => b.id !== bagId);
        chipEl.remove();

        const zone = document.getElementById('zone-' + boardId);
        if (zone && !zone.querySelector('.board-chip')) {
            const hint = document.createElement('span');
            hint.className = 'hint-text small text-muted w-100 text-center';
            hint.style.cssText = 'display:block;padding:.5rem 0;';
            hint.textContent = 'Select a bag then click here to assign';
            zone.appendChild(hint);
        }

        const poolEl = document.querySelector(`#bagPool .bag-card[data-bag-id="${bagId}"]`);
        if (poolEl) {
            poolEl.classList.remove('hidden-assigned');
            reFilterCard(poolEl);
        }
        updateCount();
    }

    function clearBoard(boardId) {
        const zone = document.getElementById('zone-' + boardId);
        if (!zone) return;
        zone.querySelectorAll('.board-chip').forEach(chip => {
            const bagId = +chip.dataset.bagId;
            const poolEl = document.querySelector(`#bagPool .bag-card[data-bag-id="${bagId}"]`);
            if (poolEl) { poolEl.classList.remove('hidden-assigned'); reFilterCard(poolEl); }
            chip.remove();
        });
        assignments[boardId] = [];
        if (!zone.querySelector('.hint-text')) {
            const hint = document.createElement('span');
            hint.className = 'hint-text small text-muted w-100 text-center';
            hint.style.cssText = 'display:block;padding:.5rem 0;';
            hint.textContent = 'Select a bag then click here to assign';
            zone.appendChild(hint);
        }
        updateCount();
    }

    function reFilterCard(card) {
        const dv   = document.getElementById('filterDenomination').value;
        const bank = document.getElementById('filterBank').value;
        const vid  = document.getElementById('filterVault').value;
        const sid  = document.getElementById('filterVaultSection').value;
        const banks = (card.dataset.bankNames || '').split(',').map(s => s.trim()).filter(Boolean);
        const match =
            (!dv   || card.dataset.denominationValue === dv)  &&
            (!bank || banks.includes(bank))                    &&
            (!vid  || card.dataset.vaultId            === vid) &&
            (!sid  || card.dataset.vaultSectionId     === sid);
        card.classList.toggle('hidden-filter', !match);
    }

    function updateCount() {
        const visible = document.querySelectorAll('#bagPool .bag-card:not(.hidden-assigned):not(.hidden-filter)').length;
        document.getElementById('availableCount').textContent = visible;
    }

    function submitPlan() {
        const result = Object.entries(assignments)
            .filter(([, bags]) => bags.length > 0)
            .map(([boardId, bags]) => ({ processingBoardId: +boardId, bagIds: bags.map(b => b.id) }));
        document.getElementById('assignmentsJson').value = JSON.stringify(result);

        const supervisors = [];
        document.querySelectorAll('.room-supervisor-select').forEach(sel => {
            if (sel.value) {
                supervisors.push({ countingRoomId: +sel.dataset.roomId, boardSupervisorUserId: sel.value });
            }
        });
        document.getElementById('roomSupervisorsJson').value = JSON.stringify(supervisors);

        document.getElementById('planForm').submit();
    }

    document.addEventListener('DOMContentLoaded', populateFilters);

    // ── New Bag Modal ─────────────────────────────────────────────
    @{
        var _modalBanks = Model.AvailableBags
            .SelectMany(b => b.CommercialBankNames)
            .Distinct()
            .OrderBy(n => n)
            .ToList();

        var _modalDenoms = Model.AvailableBags
            .Where(b => b.DenominationValue > 0)
            .GroupBy(b => b.DenominationId)
            .Select(g => new {
                id    = g.Key,
                name  = g.First().DenominationName ?? $"UGX {g.First().DenominationValue:N0}",
                value = g.First().DenominationValue
            })
            .OrderBy(d => d.value)
            .ToList();
    }

    const NEW_BAG_BANKS  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_modalBanks));
    const NEW_BAG_DENOMS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_modalDenoms));

    let _newBagTempIdx = 0;

    function openNewBagModal(boardId, boardName) {
        document.getElementById('newBagTargetBoardId').value = boardId;
        document.getElementById('newBagBoardLabel').textContent = boardName;

        // Reset fields
        ['newBagBank','newBagBranch','newBagDenom'].forEach(id => document.getElementById(id).value = '');
        document.getElementById('newBagDepositDate').value = '';
        document.getElementById('newBagValue').value = '';
        document.getElementById('newBagError').classList.add('d-none');

        // Populate Commercial Bank
        const bankSel = document.getElementById('newBagBank');
        bankSel.innerHTML = '<option value="">— Select Commercial Bank —</option>';
        NEW_BAG_BANKS.forEach(name => bankSel.add(new Option(name, name)));

        // Populate Denomination
        const denomSel = document.getElementById('newBagDenom');
        denomSel.innerHTML = '<option value="" data-denom-value="0">— Select Denomination —</option>';
        NEW_BAG_DENOMS.forEach(d => {
            const opt = new Option(d.name, d.id);
            opt.dataset.denomValue = d.value;
            denomSel.add(opt);
        });

        // Populate Source Deposit Branch via API
        const branchSel = document.getElementById('newBagBranch');
        branchSel.innerHTML = '<option value="">Loading…</option>';
        branchSel.disabled = true;
        fetch('/StockProcessingPlan/GetBranchesJson')
            .then(r => r.ok ? r.json() : [])
            .then(list => {
                branchSel.innerHTML = '<option value="">— Select Branch —</option>';
                (list || []).forEach(b => branchSel.add(new Option(b.name, b.id)));
            })
            .catch(() => {
                branchSel.innerHTML = '<option value="">— Select Branch —</option>';
            })
            .finally(() => { branchSel.disabled = false; });

        new bootstrap.Modal(document.getElementById('newBagModal')).show();
    }

    function newBagFormatValue(input) {
        const caret = input.selectionStart;
        const before = (input.value.slice(0, caret).match(/,/g) || []).length;
        const raw = input.value.replace(/[^0-9.]/g, '');
        const parts = raw.split('.');
        parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        input.value = parts.length > 1 ? parts[0] + '.' + parts[1] : parts[0];
        const after = (input.value.slice(0, caret).match(/,/g) || []).length;
        input.setSelectionRange(caret + after - before, caret + after - before);
    }

    function submitNewBag() {
        const bankVal   = document.getElementById('newBagBank').value.trim();
        const dateVal   = document.getElementById('newBagDepositDate').value.trim();
        const branchVal = document.getElementById('newBagBranch').value.trim();
        const denomSel  = document.getElementById('newBagDenom');
        const denomId   = denomSel.value;
        const denomOpt  = denomSel.options[denomSel.selectedIndex];
        const denomName = denomOpt?.text ?? '';
        const denomVal  = parseFloat(denomOpt?.dataset?.denomValue ?? '0');
        const rawVal    = document.getElementById('newBagValue').value.replace(/,/g, '');
        const numVal    = parseFloat(rawVal);

        const errEl  = document.getElementById('newBagError');
        const errors = [];
        if (!bankVal)                          errors.push('Commercial Bank is required.');
        if (!dateVal)                          errors.push('Deposit Date is required.');
        if (!branchVal)                        errors.push('Source Deposit Branch is required.');
        if (!denomId)                          errors.push('Denomination is required.');
        if (!rawVal || isNaN(numVal) || numVal <= 0) errors.push('A valid Value is required.');

        if (errors.length) {
            errEl.innerHTML = errors.map(e => `<span>${e}</span>`).join('<br>');
            errEl.classList.remove('d-none');
            return;
        }
        errEl.classList.add('d-none');

        const boardId   = +document.getElementById('newBagTargetBoardId').value;
        const submitBtn = document.getElementById('newBagSubmitBtn');
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Saving…';

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

        fetch('/StockProcessingPlan/CreateBag', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({
                commercialBankName:    bankVal,
                depositDate:           dateVal,
                sourceDepositBranchId: +branchVal,
                denominationId:        +denomId,
                value:                 numVal,
                branchId:              @Model.BranchId
            })
        })
        .then(r => r.ok ? r.json() : Promise.reject())
        .then(data => {
            _addNewBagToPool(data.id, data.referenceNumber, bankVal, denomName, denomVal, boardId);
            bootstrap.Modal.getInstance(document.getElementById('newBagModal'))?.hide();
        })
        .catch(() => {
            errEl.textContent = 'Failed to save the bag. Please try again.';
            errEl.classList.remove('d-none');
        })
        .finally(() => {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="ti ti-device-floppy me-1"></i>Save Bag';
        });
    }

    function _addNewBagToPool(bagId, refNum, bankName, denomName, denomValue, boardId) {
        const col  = document.createElement('div');
        col.className = 'col-md-6 p-1';

        const card = document.createElement('div');
        card.className = 'bag-card';
        card.dataset.bagId            = bagId;
        card.dataset.bagRef           = refNum;
        card.dataset.denominationValue = denomValue;
        card.dataset.vaultId          = '0';
        card.dataset.vaultName        = '';
        card.dataset.vaultSectionId   = '0';
        card.dataset.vaultSectionName = '';
        card.dataset.bankNames        = bankName;
        card.innerHTML =
            `<span class="bag-ref"><i class="ti ti-package" style="font-size:.7rem;"></i> ${refNum}</span>` +
            `<span class="bag-denom">UGX ${parseFloat(denomValue).toLocaleString()} &middot; ${denomName}</span>` +
            `<span class="bag-meta">${bankName}</span>` +
            `<span class="bag-meta" style="font-size:.62rem;color:#31316A;font-weight:600;">` +
                `<i class="ti ti-sparkles" style="font-size:.6rem;"></i> Newly added</span>`;
        card.addEventListener('click', () => toggleSelectBag(card));
        col.appendChild(card);
        document.getElementById('bagPool').appendChild(col);

        // Auto-select and assign to the originating board
        selectedBag = { id: bagId, ref: refNum, el: card };
        card.classList.add('selected');
        const zone = document.getElementById('zone-' + boardId);
        if (zone) handleZoneClick(zone);
        updateCount();
    }
</script>
}
