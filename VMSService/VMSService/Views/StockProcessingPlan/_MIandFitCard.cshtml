@using VMSService.Core.Models.MIandFits
@model MIandFitCardViewModel

@* MI & Fit — declared by the maker alongside the plan; ReturnedFitValue/ReturnedUnFitValue
   are filled in later by the assigned Board Supervisor via the separate "MI & Fit" area.

   Issued Fit / Issued Un-Fit are read-only: they are the branch's current "Fit" and "MI" stock
   positions for the denomination, resolved server-side and re-derived again on save. *@
<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2"
                 style="background:#fff;border-top:3px solid #31316A;border-radius:.5rem .5rem 0 0;">
                <h6 class="fw-bold mb-0" style="color:#31316A;">
                    <i class="ti ti-scale me-2"></i>MI &amp; Fit
                </h6>
                <div class="d-flex align-items-center gap-2">
                    <label class="small text-muted mb-0 text-nowrap">Set supervisor for all:</label>
                    <select id="miFitBulkSupervisor" class="form-select form-select-sm" style="min-width:200px;">
                        <option value="">— Select —</option>
                        @foreach (var supervisor in Model.BoardSupervisors)
                        {
                            <option value="@supervisor.UserName">@supervisor.FirstName @supervisor.LastName</option>
                        }
                    </select>
                </div>
            </div>
            <div class="card-body p-3">
                <div id="miFitEmptyState" class="text-center py-4 d-none">
                    <i class="ti ti-scale d-block mb-2 text-secondary" style="font-size:2rem;opacity:.4;"></i>
                    <p class="text-muted small mb-0">No bags assigned yet — attach bags to boards to declare MI &amp; Fit.</p>
                </div>
                <div id="miFitTableWrapper" class="table-responsive">
                    <table class="table table-sm align-middle mb-0" id="miFitTable">
                        <thead>
                            <tr>
                                <th style="min-width:160px;">Denomination</th>
                                <th style="min-width:160px;">Issued Fit Value</th>
                                <th style="min-width:160px;">Issued Un-Fit Value</th>
                                <th style="min-width:220px;">Board Supervisor</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mf in Model.MIandFits)
                            {
                                <tr data-denom-id="@mf.DenominationId"
                                    data-issued-fit="@mf.IssuedFitValue.ToString("0")"
                                    data-issued-unfit="@mf.IssuedUnFitValue.ToString("0")">
                                    <td class="fw-semibold">
                                        @mf.DenominationName <span class="text-muted small">(UGX @mf.DenominationValue.ToString("N0"))</span>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm bg-light mifit-issued-fit"
                                               value="@mf.IssuedFitValue.ToString("N0")" readonly tabindex="-1"
                                               title="Current 'Fit' stock position for this denomination" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm bg-light mifit-issued-unfit"
                                               value="@mf.IssuedUnFitValue.ToString("N0")" readonly tabindex="-1"
                                               title="Current 'MI' stock position for this denomination" />
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm mifit-supervisor">
                                            <option value="">— Select —</option>
                                            @foreach (var supervisor in Model.BoardSupervisors)
                                            {
                                                if (supervisor.UserName == mf.BoardSupervisorUserId)
                                                {
                                                    <option value="@supervisor.UserName" selected>@supervisor.FirstName @supervisor.LastName</option>
                                                }
                                                else
                                                {
                                                    <option value="@supervisor.UserName">@supervisor.FirstName @supervisor.LastName</option>
                                                }
                                            }
                                        </select>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var bulkSelect = document.getElementById('miFitBulkSupervisor');
        if (bulkSelect && !bulkSelect.dataset.wired) {
            bulkSelect.dataset.wired = '1';
            bulkSelect.addEventListener('change', function () {
                if (!this.value) return;
                document.querySelectorAll('#miFitTable .mifit-supervisor').forEach(function (sel) {
                    sel.value = bulkSelect.value;
                });
            });
        }
    })();

    // Shows only the MI & Fit rows for denominations currently present among assigned bags
    // (per the global `assignments` state), hiding the rest without removing them so any values
    // already typed in survive a detach/re-attach within the same page session.
    function refreshMIandFitVisibility() {
        var assignedDenomIds = new Set();
        if (typeof assignments !== 'undefined' && assignments) {
            Object.values(assignments).flat().forEach(function (bag) {
                var card = document.querySelector('#bagPool .bag-card[data-bag-id="' + bag.id + '"]');
                if (card && card.dataset.denominationId) {
                    assignedDenomIds.add(card.dataset.denominationId);
                }
            });
        }

        var anyVisible = false;
        document.querySelectorAll('#miFitTable tbody tr').forEach(function (row) {
            var visible = assignedDenomIds.has(row.dataset.denomId);
            row.style.display = visible ? '' : 'none';
            if (visible) anyVisible = true;
        });

        var emptyState = document.getElementById('miFitEmptyState');
        var tableWrapper = document.getElementById('miFitTableWrapper');
        if (emptyState && tableWrapper) {
            emptyState.classList.toggle('d-none', anyVisible);
            tableWrapper.classList.toggle('d-none', !anyVisible);
        }
    }

    // Collects the MI & Fit table into the JSON shape MIandFitAssignment expects, and returns any
    // validation errors (a row with an issued value > 0 must have a Board Supervisor assigned).
    // The issued values themselves are NOT posted — the server re-derives them from the branch's
    // current Fit/MI stock positions — so they're only read here to drive that validation.
    function collectMIandFits() {
        var entries = [];
        var errors = [];
        document.querySelectorAll('#miFitTable tbody tr').forEach(function (row) {
            if (row.style.display === 'none') return;
            var denomId = +row.dataset.denomId;
            var issuedFit = parseFloat(row.dataset.issuedFit) || 0;
            var issuedUnFit = parseFloat(row.dataset.issuedUnfit) || 0;
            var supervisorId = row.querySelector('.mifit-supervisor').value;

            if (issuedFit === 0 && issuedUnFit === 0 && !supervisorId) return;

            if ((issuedFit > 0 || issuedUnFit > 0) && !supervisorId) {
                errors.push(row.querySelector('td').textContent.trim());
                return;
            }

            entries.push({
                denominationId: denomId,
                boardSupervisorUserId: supervisorId || null
            });
        });
        return { entries: entries, errors: errors };
    }
</script>
