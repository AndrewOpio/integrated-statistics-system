@using ConfigurationsService.Client
@using VMSService.Core.Models.StockProcessingPlans
@model List<VMSService.Core.Models.StockProcessingPlans.StockProcessingPlanViewModel>

@{
    ViewData["Title"] = "Stock Processing Plans";
    var branches = ViewBag.Branches as ICollection<BranchDto> ?? new List<BranchDto>();
    int? selectedBranchId = ViewBag.SelectedBranchId as int?;
    var userRoles = string.Join(", ", User.FindAll("appRole").Where(c => c.Value.StartsWith($"{SystemPolicy.SystemSettings.AppAcronym}:")).Select(c => c.Value.Split(":")[1]).ToList());
}

<style>
    .branch-pill {
        display: inline-flex;
        align-items: center;
        padding: .25rem .75rem;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 600;
        letter-spacing: .04em;
        text-decoration: none;
        border: 1.5px solid #dee2e6;
        background: #fff;
        color: #495057;
        transition: background .15s, color .15s, border-color .15s;
    }
    .branch-pill:hover {
        background: #f0f4ff;
        border-color: #31316A;
        color: #31316A;
    }
    .branch-pill.active {
        background: #31316A;
        border-color: #31316A;
        color: #fff;
    }
</style>

@* Branch Filter Pills *@
<div class="d-flex align-items-center gap-2 flex-wrap mb-3">
    <span class="small text-muted fw-semibold me-1">
        <i class="ti ti-filter me-1"></i>Branch:
    </span>
    @foreach (var branch in branches.OrderBy(b => b.Name))
    {
        <a asp-action="Index" asp-route-branchId="@branch.Id"
           class="branch-pill @(selectedBranchId == branch.Id ? "active" : "")"
           title="@branch.Name">
            @(string.IsNullOrWhiteSpace(branch.BranchCode) ? branch.Name : branch.BranchCode)
        </a>
    }
</div>

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h2 class="fs-5 fw-bold mb-0">Stock Processing Plans</h2>
                    </div>
                    <div class="col-auto">
                        @if (userRoles.Contains(SystemPolicy.Roles.PanelB))
                        {
                            <button type="button" class="btn btn-sm btn-primary"
                                    data-bs-toggle="modal" data-bs-target="#createPlanModal">
                                <i class="ti ti-plus me-1"></i>Create New Plan
                            </button>
                        }
                    </div>
                </div>
            </div>
            <div class="card-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                <div class="table-responsive">
                    <table class="table table-centered table-nowrap mb-0 rounded" id="plansTable">
                        <thead class="thead-light">
                            <tr>
                                <th class="border-0 rounded-start">#</th>
                                <th class="border-0">Processing Date</th>
                                <th class="border-0">Branch</th>
                                <th class="border-0">Status</th>
                                <th class="border-0 rounded-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowNumber = 1;
                            }
                            @foreach (var item in Model)
                            {
                                // string badgeClass = item.CurrentStatusName switch
                                // {
                                //     "Draft" => "bg-info",
                                //     "Issued To Boards" => "bg-primary",
                                //     "Processed" => "bg-success",
                                //     _ => "bg-info"
                                // };
                                <tr>
                                    <td><span class="text-primary fw-bold">@rowNumber</span></td>
                                    <td class="fw-bold">@item.ProcessingDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.BranchName))
                                        {
                                            <span class="badge bg-primary">
                                                <i class="ti ti-building me-1"></i>@item.BranchName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-info"><i class="ti ti-badge me-1"></i>@item.CurrentStatusName</span>
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info" title="View Details">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                    </td>
                                    @{ rowNumber++; }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@* Create Plan Modal *@
<div class="modal fade" id="createPlanModal" tabindex="-1" aria-labelledby="createPlanModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-white border-bottom" style="border-top:3px solid #31316A;">
                <h5 class="modal-title fw-bold" style="color:#31316A;" id="createPlanModalLabel">
                    <i class="ti ti-calendar-plus me-2"></i>Create New Processing Plan
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label for="planDate" class="form-label fw-semibold">
                        Processing Date <span class="text-danger">*</span>
                    </label>
                    <input type="date" class="form-control" id="planDate" onchange="validateDate()" />
                    <div class="form-text">Only today and tomorrow are available.</div>
                    <div class="text-danger small mt-1" id="dateError"></div>
                </div>
            </div>
            <div class="modal-footer bg-light border-top">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary fw-semibold" id="createPlanBtn"
                        onclick="navigateToCreate()" disabled>
                    <i class="ti ti-arrow-right me-1"></i>Continue
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#plansTable').DataTable({ order: [[1, 'desc']] });
        });

        let usedDates = [];
        const selectedBranchId = @(selectedBranchId.HasValue ? selectedBranchId.Value.ToString() : "0");

        document.getElementById('createPlanModal').addEventListener('show.bs.modal', async function () {
            const dateInput = document.getElementById('planDate');
            const today = new Date();
            const tomorrow = new Date(today);
            tomorrow.setDate(tomorrow.getDate() + 1);

            const todayStr = formatDateStr(today);
            const tomorrowStr = formatDateStr(tomorrow);

            dateInput.min = todayStr;
            dateInput.max = tomorrowStr;
            dateInput.value = '';
            document.getElementById('dateError').textContent = '';
            document.getElementById('createPlanBtn').disabled = true;

            if (selectedBranchId > 0) {
                try {
                    const resp = await fetch(`@Url.Action("GetUsedDates", "StockProcessingPlan")?branchId=${selectedBranchId}`);
                    usedDates = await resp.json();
                } catch (e) {
                    usedDates = [];
                }
            } else {
                usedDates = [];
            }
        });

        function formatDateStr(d) {
            const yr = d.getFullYear();
            const mo = String(d.getMonth() + 1).padStart(2, '0');
            const dy = String(d.getDate()).padStart(2, '0');
            return `${yr}-${mo}-${dy}`;
        }

        function validateDate() {
            const val = document.getElementById('planDate').value;
            const errEl = document.getElementById('dateError');
            const btn = document.getElementById('createPlanBtn');

            if (!val) {
                errEl.textContent = '';
                btn.disabled = true;
                return;
            }

            if (usedDates.includes(val)) {
                errEl.textContent = 'A processing plan already exists for this date in the selected branch.';
                btn.disabled = true;
            } else {
                errEl.textContent = '';
                btn.disabled = false;
            }
        }

        function navigateToCreate() {
            const val = document.getElementById('planDate').value;
            if (!val || usedDates.includes(val)) return;
            if (selectedBranchId <= 0) {
                document.getElementById('dateError').textContent = 'Please select a branch first using the branch filter above.';
                return;
            }
            window.location.href = `@Url.Action("Create", "StockProcessingPlan")?processingDate=${val}&branchId=${selectedBranchId}`;
        }
    </script>
}
