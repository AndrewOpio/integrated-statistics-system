@model List<VMSService.Core.Models.ApprovedCurrencyProcurements.ApprovedCurrencyProcurementsViewModel>

@{
    ViewData["Title"] = "Approved Currency Procurements";
    var userRoles = string.Join(", ", User.FindAll("appRole").Where(c => c.Value.StartsWith("VMS:")).Select(c => c.Value.Split(":")[1]).ToList());
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h2 class="fs-5 fw-bold mb-0">Approved Currency Procurements</h2>
                    </div>
                    @if (userRoles.Contains(SystemPolicy.Roles.ContractManager))
                    {
                        <div class="col text-end">
                            <a asp-action="Create" class="btn btn-sm btn-primary">
                                <i class="ti ti-plus me-1"></i>Add Approved Currency Procurement
                            </a>
                        </div>
                    }
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-centered table-nowrap mb-0 rounded datatable">
                        <thead class="thead-light">
                            <tr>
                                <th class="border-0 rounded-start">#</th>
                                <th class="border-0">Id</th>
                                <th class="border-0">Total Approved Amount (UGX)</th>
                                <th class="border-0">Status</th>
                                <th class="border-0">Attachment</th>
                                <th class="border-0 rounded-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowNumber = 1;
                            }
                            
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><span class="text-primary fw-bold">@rowNumber</span></td>
                                    <td><span>#PR</span>@item.Id</td>
                                    <td>@item.Amount.ToString("N0")</td>
                                    <td>
                                        <div class="d-inline-flex align-items-center gap-2" style="width: fit-content;">
                                            <span class="badge bg-info">
                                                <i class="ti ti-badge me-1"></i>@item.CurrentStatusName
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.BoardApprovalAttachment))
                                        {
                                            <a asp-controller="ApprovedCurrencyProcurements" asp-action="ViewAttachment" asp-route-id="@item.Id" target="_blank" class="text-primary">
                                                <i class="ti ti-external-link me-1"></i>View
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="ti ti-eye"></i>
                                            </a>
                                            @{
                                                bool isEditable = item.CurrentStatusName == StatusConstants.ApprovedCurrencyProcurement.Draft || item.CurrentStatusName == StatusConstants.ApprovedCurrencyProcurement.Returned;
                                            }
                                            @if (isEditable && userRoles.Contains(SystemPolicy.Roles.ContractManager))
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                                    <i class="ti ti-edit"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                                    <i class="ti ti-trash"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                    @{
                                        rowNumber++;
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>