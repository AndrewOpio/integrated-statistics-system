@model VMSService.Core.Models.ApprovedCurrencyProcurements.ApprovedCurrencyProcurementsViewModel
@using VMSService.Core.Static

@{
    ViewData["Title"] = "Approved Currency Procurement Details";
    var userRoles = string.Join(", ", User.FindAll("appRole").Where(c => c.Value.StartsWith($"{SystemPolicy.SystemSettings.AppAcronym}:")).Select(c => c.Value.Split(":")[1]).ToList());
    // var userRole = User.FindFirst(VMSService.Core.Static.SystemPolicy.ClaimType.AppRole)?.Value ?? "";
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-3">
            <div class="card-header pb-4 bg-light">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="d-flex flex-column">
                        <span class="text-muted small mb-2">Approved Currency Procurement</span>
                        <h2 class="fs-4 fw-bold mb-3">UGX @Model.Amount.ToString("N0")</h2>
                        <div class="d-inline-flex align-items-center gap-2" style="width: fit-content;">
                            <span class="badge bg-info">
                                <i class="ti ti-badge me-1"></i>@Model.CurrentStatusName
                            </span>
                        </div>
                    </div>
                    <!-- Action Buttons -->
                    <div class="d-flex gap-2 flex-row align-items-end">
                        @{
                            bool isEditable = Model.CurrentStatusName == StatusConstants.ApprovedCurrencyProcurement.Draft || Model.CurrentStatusName == StatusConstants.ApprovedCurrencyProcurement.Returned;
                        }
                        @if (isEditable && userRoles.Contains(SystemPolicy.Roles.ContractManager))
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
                                <i class="ti ti-edit me-1"></i>Edit
                            </a>
                        }
                        <a asp-action="Index" class="btn btn-secondary btn-sm">
                            <i class="ti ti-arrow-left me-1"></i>Back to List
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <div class="field mb-4">
                    <span class="d-block text-muted small mb-2 text-uppercase">Total Approved Amount</span>
                    <span class="d-block fw-normal">UGX @Model.Amount.ToString("N0")</span>
                </div>

                <!-- Denominations Section -->
                <div class="field mb-4">
                    <span class="d-block text-muted small mb-2 text-uppercase">Denominations</span>
                    <div>
                        <div class="table-responsive">
                            <table class="table table-centered table-nowrap mb-0 rounded table-bordered" id="denominationsTable">
                                <thead class="thead-light">
                                    <tr>
                                        <th class="fw-bold">Denomination</th>
                                        <th class="fw-bold">Currency Vendor</th>
                                        <th class="fw-bold">Number of Pieces</th>
                                        <th class="fw-bold">Amount (UGX)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var denomination in Model.ApprovedCurrencyDenominations)
                                    {
                                        <tr>
                                            <td>
                                                <span>@denomination.Denomination?.Name</span>
                                            </td>
                                            <td>
                                                <span>@denomination.CurrencyVendor?.Name</span>
                                            </td>
                                            <td>
                                                <span>@denomination.NumberOfPieces.ToString("N0")</span>
                                            </td>
                                            <td>
                                                <span>@denomination.Amount.ToString("N0")</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <input type="hidden" id="denominationCount" value="0">
                        <span id="denominationsError" class="text-danger small d-block mt-1" style="display: none;"></span>
                    </div>
                </div>

                <div class="field mb-4">
                    <span class="d-block text-muted small mb-2 text-uppercase">Status</span>
                    @if (Model.CurrentStatusName != null && !string.IsNullOrEmpty(Model.CurrentStatusName))
                    {
                        <span class="d-block fw-normal">@Model.CurrentStatusName</span>
                    }
                    else
                    {
                        <span class="d-block fw-normal text-muted">-</span>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.BoardApprovalAttachment))
                {
                    <div class="field">
                        <span class="d-block text-muted small mb-2 text-uppercase">Board Resolution Attachment</span>
                        <a asp-controller="ApprovedCurrencyProcurements" asp-action="ViewAttachment" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-tertiary">
                            <i class="ti ti-file-type-pdf me-1 fs-5"></i>View Attachment
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <!-- Status History Section -->
        <div class="card border-0 shadow mb-3">
            <div class="card-header bg-white border-bottom no-after">
                <h6 class="card-title mb-0">
                    <i class="ti ti-message me-2 text-secondary"></i>Comments
                </h6>
            </div>
            <div class="card-body">
                @if (Model.StatusHistory != null && Model.StatusHistory.Any())
                {
                    <div class="timeline">
                        @foreach (var history in Model.StatusHistory.OrderBy(x => x.ChangedAt))
                        {
                            <div class="timeline-item mb-4">
                                <div class="d-flex gap-3">
                                    <div class="timeline-marker">
                                        <i class="ti ti-circle-check text-success"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h6 class="mb-1 small">
                                                    <strong>@history.OldStatusName</strong>
                                                    <i class="ti ti-arrow-right text-muted"></i>
                                                    <strong>@history.NewStatusName</strong>
                                                </h6>
                                                <small class="text-muted">
                                                    By: <strong>@history.ChangedBy</strong>
                                                </small>
                                            </div>
                                            <small class="text-muted">
                                                @history.ChangedAt.ToString("dd/MMM/yyyy HH:mm:ss")
                                            </small>
                                        </div>
                                        @if (!string.IsNullOrEmpty(history.Remarks))
                                        {
                                            <div class="mt-2 p-2 bg-white rounded border">
                                                <span class="d-block">@history.Remarks</span>
                                            </div>
                                        }

                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted text-center">
                        <i class="ti ti-inbox me-2"></i>No comments yet.
                    </p>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <!-- Workflow Actions Section -->
        @if (Model.AvailableTransitions.Any())
        {
            <div class="card border-0 bg-light mb-1 shadow-sm">
                <div class="card-header bg-white border-bottom no-after">
                    <h6 class="card-title mb-0">
                        <i class="ti ti-checkbox me-2 text-primary"></i>Available Actions
                    </h6>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="ExecuteAction" asp-route-id="@Model.Id" id="workflowForm">
                        <div class="mb-3">
                            <label class="form-label">
                                Action <span class="text-danger">*</span>
                            </label>
                            <select id="actionSelect" name="actionName" class="form-select" required>
                                <option value="">-- Select an action --</option>
                                @foreach (var transition in Model.AvailableTransitions)
                                {
                                    <option value="@transition.ActionName" data-requires-comments="@transition.RequiresComments.ToString().ToLower()" data-button-class="@transition.ButtonClass" data-display-label="@transition.DisplayLabel">
                                        @transition.DisplayLabel
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Comments
                                <span id="commentRequired" class="text-danger" style="display: none;">*</span>
                            </label>
                            <textarea id="remarksTextarea"
                                      class="form-control"
                                      name="remarks"
                                      rows="3"
                                      placeholder="Enter your comments..."></textarea>
                            <small id="commentHint" class="text-muted d-block mt-1"></small>
                        </div>

                        <button type="submit" id="submitBtn" class="text-white btn btn-primary" disabled>
                            <i class="ti ti-check me-1"></i><span id="submitBtnLabel">Submit</span>
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .timeline {
        position: relative;
        padding-left: 0;
    }

    .timeline-item {
        position: relative;
    }

    .timeline-marker {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-color: #f0f0f0;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .timeline-marker i {
            font-size: 16px;
        }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const actionSelect = document.getElementById('actionSelect');
        const remarksTextarea = document.getElementById('remarksTextarea');
        const commentRequired = document.getElementById('commentRequired');
        const commentHint = document.getElementById('commentHint');
        const submitBtn = document.getElementById('submitBtn');
        const submitBtnLabel = document.getElementById('submitBtnLabel');

        // Define hint messages for each action
        const hintMessages = {
            'Verify': 'Provide your verification comments.',
            'Reject': 'Explain why you are rejecting this procurement.',
            'Resubmit': 'Explain what changes were made.'
        };

        // Handle action selection change
        actionSelect.addEventListener('change', function () {
            const selectedOption = this.options[this.selectedIndex];
            const requiresComments = selectedOption.dataset.requiresComments === 'true';
            const actionName = selectedOption.value;
            const displayLabel = selectedOption.dataset.displayLabel;
            const buttonClass = selectedOption.dataset.buttonClass;

            if (actionName) {
                // Update comment requirement
                if (requiresComments) {
                    commentRequired.style.display = 'inline';
                    remarksTextarea.required = true;
                } else {
                    commentRequired.style.display = 'none';
                    remarksTextarea.required = false;
                }

                // Update hint message
                commentHint.textContent = hintMessages[actionName] || '';

                // Update button
                submitBtn.disabled = false;
                submitBtnLabel.textContent = displayLabel;
                submitBtn.className = `text-white btn ${buttonClass}`;
            } else {
                // Reset to default state
                commentRequired.style.display = 'none';
                remarksTextarea.required = false;
                remarksTextarea.value = '';
                commentHint.textContent = '';
                submitBtn.disabled = true;
                submitBtnLabel.textContent = 'Submit';
                submitBtn.className = 'text-white btn btn-primary';
            }
        });

        // Form submission validation
        document.getElementById('workflowForm').addEventListener('submit', function (e) {
            const selectedOption = actionSelect.options[actionSelect.selectedIndex];
            const requiresComments = selectedOption.dataset.requiresComments === 'true';
            const remarksValue = remarksTextarea.value.trim();

            if (requiresComments && !remarksValue) {
                e.preventDefault();
                alert('Comments are required for this action.');
                remarksTextarea.focus();
                return false;
            }
        });
    });
</script>