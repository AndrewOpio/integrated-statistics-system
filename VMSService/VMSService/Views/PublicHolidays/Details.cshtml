@model VMSService.Core.Models.PublicHolidays.PublicHolidayViewModel

@{
    ViewData["Title"] = "Public Holiday Details";
}

<div class="row">
    <div class="col-12 col-lg-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header pb-4">
                <div class="d-flex flex-column">
                    <span class="text-muted small mb-2">Public Holiday</span>
                    <h2 class="fs-4 fw-bold mb-3">@Model.Name</h2>
                    <div class="d-inline-flex align-items-center gap-2" style="width: fit-content;">
                        @if (Model.Active)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                        @if (Model.IsPast)
                        {
                            <span class="badge bg-light text-dark">Date passed — locked</span>
                        }
                    </div>
                </div>
            </div>

            <div class="card-body">
                <div class="field mb-4">
                    <span class="d-block text-muted small mb-2 text-uppercase">Date</span>
                    <span class="d-block fw-normal">@Model.Date.ToString("dd MMMM yyyy")</span>
                </div>
            </div>

            <div class="card-footer bg-transparent border-top pt-3">
                <div class="d-flex gap-2">
                    @if (!Model.IsPast)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="ti ti-pencil me-1"></i>Edit
                        </a>
                    }
                    @if (Model.Active)
                    {
                        <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="ti ti-toggle-left me-1"></i>Deactivate
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Activate" asp-route-id="@Model.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-success">
                                <i class="ti ti-toggle-right me-1"></i>Activate
                            </button>
                        </form>
                    }
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="ti ti-arrow-left me-1"></i>Back
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
