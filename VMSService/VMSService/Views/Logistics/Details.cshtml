@model VMSService.Data.Entities.Logistics

@{
    ViewData["Title"] = "Logistics Details";
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="fs-5 fw-bold mb-0">Logistics Details</h2>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">
                        <i class="ti ti-edit me-1"></i>Edit
                    </a>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="ti ti-arrow-left me-1"></i>Back to List
                    </a>
                </div>
            </div>
            <div class="card-body">
                <!-- Basic Information -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Title</label>
                        <p class="fw-bold mb-0">@Model.Title</p>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small">Date</label>
                        <p class="fw-bold mb-0">@Model.Date.ToString("dd/MMM/yyyy")</p>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small">Reference Number</label>
                        <p class="fw-bold mb-0">@(Model.ReferenceNumber ?? "—")</p>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="row mb-4">
                        <div class="col-12">
                            <label class="form-label text-muted small">Description</label>
                            <p class="mb-0">@Model.Description</p>
                        </div>
                    </div>
                }

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Created By</label>
                        <p class="mb-0">@Model.CreatedByName</p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Created Date</label>
                        <p class="mb-0">@Model.CreatedDate.ToString("dd/MMM/yyyy HH:mm")</p>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Categories Section -->
                <h5 class="fw-bold mb-3">Categories</h5>

                @if (Model.Categories != null && Model.Categories.Any())
                {
                    decimal grandTotal = 0;

                    foreach (var category in Model.Categories.OrderBy(c => c.SortOrder))
                    {
                        decimal categoryTotal = category.Details?.Sum(d => d.TotalPrice) ?? 0;
                        grandTotal += categoryTotal;

                        <div class="card border mb-3">
                            <div class="card-header bg-light py-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@category.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(category.Description))
                                        {
                                            <span class="text-muted ms-2">— @category.Description</span>
                                        }
                                    </div>
                                    <span class="badge bg-primary">@(category.Details?.Count ?? 0) items</span>
                                </div>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-bordered mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 5%;">#</th>
                                                <th style="width: 20%;">Item Name</th>
                                                <th style="width: 20%;">Description</th>
                                                <th style="width: 12%;" class="text-end">Quantity</th>
                                                <th style="width: 12%;" class="text-end">Unit Price</th>
                                                <th style="width: 12%;" class="text-end">Total</th>
                                                <th style="width: 19%;">Notes</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (category.Details != null && category.Details.Any())
                                            {
                                                int rowNum = 1;
                                                foreach (var detail in category.Details.OrderBy(d => d.SortOrder))
                                                {
                                                    <tr>
                                                        <td>@rowNum</td>
                                                        <td>@detail.ItemName</td>
                                                        <td>@(detail.Description ?? "—")</td>
                                                        <td class="text-end">@detail.Quantity.ToString("N2")</td>
                                                        <td class="text-end">@detail.UnitPrice.ToString("N2")</td>
                                                        <td class="text-end">@detail.TotalPrice.ToString("N2")</td>
                                                        <td>@(detail.Notes ?? "—")</td>
                                                    </tr>
                                                    rowNum++;
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="7" class="text-center text-muted">No details</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot class="table-light">
                                            <tr>
                                                <td colspan="5" class="text-end fw-bold">Category Total:</td>
                                                <td class="text-end fw-bold">@categoryTotal.ToString("N2")</td>
                                                <td></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="card border-primary">
                        <div class="card-body py-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold">Grand Total:</span>
                                <span class="fs-5 fw-bold text-primary">@grandTotal.ToString("N2")</span>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="ti ti-info-circle me-2"></i>No categories found.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
