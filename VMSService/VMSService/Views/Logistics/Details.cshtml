@model VMSService.Data.Entities.Logistics
@using VMSService.Core.Models.Logistics

@{
    ViewData["Title"] = "Logistics — " + Model.Title;

    var availableTransitions = ViewBag.AvailableTransitions as List<WorkflowTransitionDto> ?? new();
    var statusHistory        = ViewBag.StatusHistory as List<VMSService.Data.Entities.LogisticsStatusHistory> ?? new();
    string currentStatus     = ViewBag.CurrentStatusName as string ?? "Draft";

    decimal grandTotal = Model.Categories?
        .Sum(c => c.Details?.Sum(d => d.TotalCost) ?? 0) ?? 0;
}

<div class="row g-4">

    @* ── Left column ─────────────────────────────────────────────── *@
    <div class="col-12 col-xl-8">

        @* ── Header card ── *@
        <div class="card border-0 shadow mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                    <div>
                        <span class="text-muted small">Logistics</span>
                        <h2 class="fs-3 fw-bold mb-1 mt-1">@Model.Title</h2>
                        <div class="d-flex flex-wrap gap-3 text-muted small">
                            <span><i class="ti ti-calendar me-1"></i>@Model.Date.ToString("dd MMM yyyy")</span>
                            @if (!string.IsNullOrWhiteSpace(Model.ReferenceNumber))
                            {
                                <span><i class="ti ti-hash me-1"></i>@Model.ReferenceNumber</span>
                            }
                            <span><i class="ti ti-clock me-1"></i>Created @Model.CreatedDate.ToString("dd MMM yyyy")</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-secondary px-2 py-1">@currentStatus</span>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                            <i class="ti ti-edit me-1"></i>Edit
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="ti ti-arrow-left me-1"></i>Back
                        </a>
                    </div>
                </div>

                @* Team + Description *@
                <div class="row mt-4 g-3">
                    @if (!string.IsNullOrWhiteSpace(Model.TeamLeader))
                    {
                        <div class="col-md-4">
                            <div class="p-3 rounded" style="background:#f8fafc;">
                                <div class="text-muted small mb-1"><i class="ti ti-user me-1"></i>Team Leader</div>
                                <div class="fw-semibold">@Model.TeamLeader</div>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.AssistantTeamLeader))
                    {
                        <div class="col-md-4">
                            <div class="p-3 rounded" style="background:#f8fafc;">
                                <div class="text-muted small mb-1"><i class="ti ti-user-check me-1"></i>Assistant Team Leader</div>
                                <div class="fw-semibold">@Model.AssistantTeamLeader</div>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <div class="col-12">
                            <div class="p-3 rounded" style="background:#f8fafc;">
                                <div class="text-muted small mb-1"><i class="ti ti-notes me-1"></i>Description</div>
                                <div>@Model.Description</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── Budget summary card ── *@
        @if (Model.Categories != null && Model.Categories.Any())
        {
            <div class="card border-0 border-start border-4 border-primary shadow mb-4">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-4">
                        <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width:3rem;height:3rem;">
                            <i class="ti ti-receipt text-white fs-4"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="text-muted small">Total Budget (UGX)</div>
                            <div class="fs-2 fw-bold text-primary lh-1">@grandTotal.ToString("N0")</div>
                        </div>
                        <div class="text-end">
                            <div class="text-muted small">Categories</div>
                            <div class="fs-4 fw-bold">@Model.Categories.Count()</div>
                        </div>
                    </div>

                    @* Category proportion bars *@
                    <div class="mt-4">
                        @foreach (var cat in Model.Categories.OrderBy(c => c.SortOrder))
                        {
                            decimal catTotal  = cat.Details?.Sum(d => d.TotalCost) ?? 0;
                            decimal pct       = grandTotal > 0 ? Math.Round(catTotal / grandTotal * 100, 1) : 0;
                            <div class="mb-2">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="fw-semibold">@cat.Name</span>
                                    <span class="text-muted">@catTotal.ToString("N0") &nbsp;<span class="text-primary">@pct%</span></span>
                                </div>
                                <div class="progress" style="height:6px;">
                                    <div class="progress-bar bg-primary" style="width:@pct%"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* ── Category detail cards ── *@
            @foreach (var category in Model.Categories.OrderBy(c => c.SortOrder))
            {
                decimal categoryTotal = category.Details?.Sum(d => d.TotalCost) ?? 0;
                decimal catPct        = grandTotal > 0 ? Math.Round(categoryTotal / grandTotal * 100, 1) : 0;

                <div class="card border-0 shadow mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center py-3" style="background:#fafafa;">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded d-flex align-items-center justify-content-center bg-primary bg-opacity-10"
                                 style="width:2rem;height:2rem;">
                                <i class="ti ti-folder text-primary" style="font-size:.85rem;"></i>
                            </div>
                            <span class="fw-bold">@category.Name</span>
                            <span class="badge bg-light text-dark border small">@(category.Details?.Count ?? 0) items</span>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold text-primary">@categoryTotal.ToString("N0")</div>
                            <div class="text-muted" style="font-size:.7rem;">@catPct% of total</div>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 small">
                                <thead style="background:#f8fafc;">
                                    <tr>
                                        <th class="ps-3 border-0 text-muted fw-semibold">#</th>
                                        <th class="border-0 text-muted fw-semibold">Item</th>
                                        <th class="border-0 text-muted fw-semibold">Description</th>
                                        <th class="border-0 text-muted fw-semibold text-end">Unit Cost</th>
                                        <th class="border-0 text-muted fw-semibold text-end">Qty</th>
                                        <th class="border-0 text-muted fw-semibold text-end">Freq</th>
                                        <th class="border-0 text-muted fw-semibold text-end pe-3">Total</th>
                                        <th class="border-0 text-muted fw-semibold">Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (category.Details != null && category.Details.Any())
                                    {
                                        int rowNum = 1;
                                        foreach (var detail in category.Details.OrderBy(d => d.SortOrder))
                                        {
                                            <tr>
                                                <td class="ps-3 text-muted">@rowNum</td>
                                                <td class="fw-semibold">@detail.ItemName</td>
                                                <td class="text-muted">@(detail.Description ?? "—")</td>
                                                <td class="text-end">@detail.UnitCost.ToString("N0")</td>
                                                <td class="text-end">@detail.Quantity.ToString("N0")</td>
                                                <td class="text-end">@detail.Frequency.ToString("N0")</td>
                                                <td class="text-end pe-3 fw-semibold">@detail.TotalCost.ToString("N0")</td>
                                                <td class="text-muted">@(detail.Notes ?? "—")</td>
                                            </tr>
                                            rowNum++;
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="8" class="text-center text-muted py-3">No items in this category.</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot style="background:#f8fafc;border-top:2px solid #e9ecef;">
                                    <tr>
                                        <td colspan="6" class="text-end fw-bold ps-3 text-muted small">Category Total</td>
                                        <td class="text-end fw-bold pe-3">@categoryTotal.ToString("N0")</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="card border-0 shadow mb-4">
                <div class="card-body text-center py-5 text-muted">
                    <i class="ti ti-folder-off fs-1 d-block mb-2"></i>
                    No categories have been added yet.
                </div>
            </div>
        }

        @* ── Status history ── *@
        <div class="card border-0 shadow mb-4">
            <div class="card-header d-flex align-items-center gap-2 py-3" style="background:#fafafa;">
                <i class="ti ti-history text-secondary fs-5"></i>
                <h6 class="fw-bold mb-0">Status History</h6>
            </div>
            <div class="card-body">
                @if (statusHistory.Any())
                {
                    <div class="ps-2">
                        @foreach (var h in statusHistory)
                        {
                            <div class="d-flex gap-3 mb-4">
                                <div class="d-flex flex-column align-items-center">
                                    <div class="rounded-circle bg-success d-flex align-items-center justify-content-center flex-shrink-0"
                                         style="width:2rem;height:2rem;">
                                        <i class="ti ti-check text-white" style="font-size:.75rem;"></i>
                                    </div>
                                    <div class="bg-light flex-grow-1 mt-1" style="width:2px;min-height:1.5rem;"></div>
                                </div>
                                <div class="pb-2 flex-grow-1">
                                    <div class="d-flex gap-2 align-items-center flex-wrap mb-1">
                                        <span class="fw-semibold small text-secondary">@h.OldStatusName</span>
                                        <i class="ti ti-arrow-right text-muted" style="font-size:.75rem;"></i>
                                        <span class="fw-semibold small text-dark">@h.NewStatusName</span>
                                    </div>
                                    <div class="text-muted" style="font-size:.75rem;">
                                        <i class="ti ti-user me-1"></i>@h.ChangedBy
                                        &nbsp;&bull;&nbsp;
                                        <i class="ti ti-clock me-1"></i>@h.ChangedAt.ToString("dd MMM yyyy HH:mm")
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(h.Remarks))
                                    {
                                        <div class="mt-2 p-2 rounded border bg-light small">@h.Remarks</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted text-center mb-0"><i class="ti ti-inbox me-1"></i>No status history yet.</p>
                }
            </div>
        </div>

    </div>

    @* ── Right column (sticky) ──────────────────────────────────── *@
    <div class="col-12 col-xl-4">
        <div class="sticky-top" style="top:1.5rem;">

            @* ── Workflow actions ── *@
            <div class="card border-0 shadow mb-4">
                <div class="card-header d-flex align-items-center gap-2 py-3" style="background:#fafafa;">
                    <i class="ti ti-player-play text-primary fs-5"></i>
                    <h6 class="fw-bold mb-0">Actions</h6>
                </div>
                <div class="card-body">
                    @if (availableTransitions.Any())
                    {
                        <form method="post" asp-action="WorkflowAction" asp-route-id="@Model.Id" id="workflowForm">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Select Action <span class="text-danger">*</span></label>
                                <select id="actionSelect" name="actionName" class="form-select form-select-sm" required>
                                    <option value="">-- Choose an action --</option>
                                    @foreach (var t in availableTransitions)
                                    {
                                        <option value="@t.ActionName"
                                                data-requires-comments="@t.RequiresComments.ToString().ToLower()"
                                                data-button-class="@t.ButtonClass"
                                                data-display-label="@t.DisplayLabel">
                                            @t.DisplayLabel
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">
                                    Comments <span id="commentRequired" class="text-danger" style="display:none;">*</span>
                                </label>
                                <textarea id="remarksTextarea" name="remarks" class="form-control form-control-sm" rows="3"
                                          placeholder="Optional remarks..."></textarea>
                                <div id="commentHint" class="text-muted mt-1" style="font-size:.75rem;"></div>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm w-100" id="submitBtn" disabled>
                                <span id="submitBtnLabel">Submit</span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <p class="text-muted small mb-0 text-center">
                            <i class="ti ti-lock me-1"></i>No actions available at this stage.
                        </p>
                    }
                </div>
            </div>

            @* ── Quick info ── *@
            <div class="card border-0 shadow">
                <div class="card-header d-flex align-items-center gap-2 py-3" style="background:#fafafa;">
                    <i class="ti ti-info-circle text-secondary fs-5"></i>
                    <h6 class="fw-bold mb-0">Details</h6>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush small">
                        <li class="list-group-item d-flex justify-content-between px-3 py-2">
                            <span class="text-muted">Status</span>
                            <span class="badge bg-secondary">@currentStatus</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-3 py-2">
                            <span class="text-muted">Date</span>
                            <span class="fw-semibold">@Model.Date.ToString("dd MMM yyyy")</span>
                        </li>
                        @if (!string.IsNullOrWhiteSpace(Model.ReferenceNumber))
                        {
                            <li class="list-group-item d-flex justify-content-between px-3 py-2">
                                <span class="text-muted">Reference</span>
                                <span class="fw-semibold">@Model.ReferenceNumber</span>
                            </li>
                        }
                        <li class="list-group-item d-flex justify-content-between px-3 py-2">
                            <span class="text-muted">Created</span>
                            <span class="fw-semibold">@Model.CreatedDate.ToString("dd MMM yyyy")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-3 py-2">
                            <span class="text-muted">Total (UGX)</span>
                            <span class="fw-bold text-primary">@grandTotal.ToString("N0")</span>
                        </li>
                    </ul>
                </div>
            </div>

        </div>
    </div>

</div>

<script>
    const actionSelect = document.getElementById('actionSelect');
    if (actionSelect) {
        actionSelect.addEventListener('change', function () {
            const opt              = this.options[this.selectedIndex];
            const requiresComments = opt.getAttribute('data-requires-comments') === 'true';
            const buttonClass      = opt.getAttribute('data-button-class') || 'btn-primary';
            const displayLabel     = opt.getAttribute('data-display-label') || 'Submit';

            const submitBtn    = document.getElementById('submitBtn');
            const submitLabel  = document.getElementById('submitBtnLabel');
            const hint         = document.getElementById('commentHint');
            const reqMark      = document.getElementById('commentRequired');
            const remarks      = document.getElementById('remarksTextarea');

            if (!this.value) {
                submitBtn.disabled = true;
                reqMark.style.display = 'none';
                hint.textContent = '';
                remarks.required = false;
            } else {
                submitBtn.disabled = false;
                submitLabel.textContent = displayLabel;
                submitBtn.className = `btn btn-sm w-100 text-white ${buttonClass}`;
                if (requiresComments) {
                    reqMark.style.display = 'inline';
                    remarks.required = true;
                    hint.textContent = 'Comments are required for this action.';
                } else {
                    reqMark.style.display = 'none';
                    remarks.required = false;
                    hint.textContent = 'Comments are optional.';
                }
            }
        });
    }

    const workflowForm = document.getElementById('workflowForm');
    if (workflowForm) {
        workflowForm.addEventListener('submit', function (e) {
            e.preventDefault();
            const opt = actionSelect.options[actionSelect.selectedIndex];
            const requiresComments = opt.getAttribute('data-requires-comments') === 'true';
            const remarks = document.getElementById('remarksTextarea');

            if (requiresComments && !remarks.value.trim()) {
                remarks.focus();
                return;
            }

            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Submitting...';

            fetch(workflowForm.action, {
                method: 'POST',
                body: new FormData(workflowForm),
                headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' }
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) window.location.reload();
                else {
                    alert(data.message ?? 'Action failed.');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<span id="submitBtnLabel">Submit</span>';
                }
            })
            .catch(() => {
                alert('An error occurred.');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<span id="submitBtnLabel">Submit</span>';
            });
        });
    }
</script>
