@model IEnumerable<VMSService.Data.Entities.Logistics>

@{
    ViewData["Title"] = "Logistics";
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h2 class="fs-5 fw-bold mb-0">Logistics</h2>
                    </div>
                    <div class="col text-end">
                        <a asp-action="Create" class="btn btn-sm btn-primary">
                            <i class="ti ti-plus me-1"></i>Add New
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-centered table-nowrap mb-0 rounded datatable">
                        <thead class="thead-light">
                            <tr>
                                <th class="border-0 rounded-start">#</th>
                                <th class="border-0">Title</th>
                                <th class="border-0">Date</th>
                                <th class="border-0">Reference Number</th>
                                <th class="border-0">TeamLeader</th>
                                <th class="border-0">Status</th>
                                <th class="border-0 rounded-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowNumber = 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><span class="text-primary fw-bold">@rowNumber</span></td>
                                    <td class="fw-bold">@item.Title</td>
                                    <td>@item.Date.ToString("dd/MMM/yyyy")</td>
                                    <td>@item.ReferenceNumber</td>
                                    <td>@item.TeamLeader</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.CurrentStatus?.Name))
                                        {
                                            <span class="badge bg-secondary" style="font-size:1em;">@item.CurrentStatus.Name</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="ti ti-eye"></i>
                                            </a>
                                            @if (item.CurrentStatus?.Name == "Draft" || item.CurrentStatus?.Name == "Returned")
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                                    <i class="ti ti-edit"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                rowNumber++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.btn-delete').on('click', function () {
                var id = $(this).data('id');
                if (confirm('Are you sure you want to delete this record?')) {
                    $.ajax({
                        url: '@Url.Action("Delete", "Logistics")/' + id,
                        type: 'POST',
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (result) {
                            if (result.success) {
                                location.reload();
                            } else {
                                alert(result.message || 'Error deleting record');
                            }
                        },
                        error: function () {
                            alert('Error deleting record');
                        }
                    });
                }
            });
        });
    </script>
    @Html.AntiForgeryToken()
}
