@model List<VMSService.Core.Models.BranchCategories.BranchCategoryViewModel>

@{
    ViewData["Title"] = "Branch Categories";
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h2 class="fs-5 fw-bold mb-0">Vault Stores</h2>
                    </div>
                    <div class="col text-end">
                        <a asp-action="Create" class="btn btn-sm btn-primary">
                            <i class="ti ti-plus me-1"></i>Add Vault Store
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-centered table-nowrap mb-0 rounded datatable">
                        <thead class="thead-light">
                            <tr>
                                <th class="border-0 rounded-start">#</th>
                                <th class="border-0">Vault Store</th>
                                <th class="border-0">Branch</th>
                                <th class="border-0">Category</th>
                                <th class="border-0">Classification</th>
                                <th class="border-0 rounded-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowNumber = 1;
                            }
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="fw-bold"><span class="text-primary fw-bold">@rowNumber</span></td>
                                        <td>@item.Branch?.Name - @item.Category?.Name</td>
                                        <td>@item.Branch?.Name</td>
                                        <td class="fw-bold">
                                            <span class="badge bg-primary">
                                                <i class="ti ti-building-store me-1"></i>@item.Category?.Name
                                            </span>
                                        </td>
                                        <td class="fw-bold">
                                            <span class="badge bg-info">
                                                <i class="ti ti-archive me-1"></i>@item.Category?.Classification
                                            </span>
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                                    <i class="ti ti-edit"></i>
                                                </a>
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                                    <i class="ti ti-eye"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                                    <i class="ti ti-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                        @{
                                            rowNumber++;
                                        }
                                    </tr>
                                }
                            }
                            else
                            {
                                @* <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">
                                        <i class="ti ti-inbox me-2"></i>No branch categories found.
                                    </td>
                                </tr> *@
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>