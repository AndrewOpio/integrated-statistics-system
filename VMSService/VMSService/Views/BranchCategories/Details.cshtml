@model VMSService.Core.Models.BranchCategories.BranchCategoryViewModel

@{
    ViewData["Title"] = "Branch Category Details";
}

<div class="row">
    <div class="col-12 col-lg-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header pb-4">
                <div class="d-flex flex-column">
                    <span class="text-muted small mb-2">Vault Store Details</span>
                    <h2 class="fs-4 fw-bold mb-3">@Model.Branch?.Name - @Model.Category?.Name</h2>
                    <div class="d-inline-flex align-items-center gap-2" style="width: fit-content;">
                        <span class="badge bg-primary">
                            <i class="ti ti-building-store me-1"></i>@Model.Category?.Name
                        </span>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label text-muted small text-uppercase">Branch</label>
                            <p class="form-control-plaintext">@Model.Branch?.Name</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label text-muted small text-uppercase">Category</label>
                            <p class="form-control-plaintext">@Model.Category?.Name</p>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label text-muted small text-uppercase">Category Classification</label>
                            <p class="form-control-plaintext">@Model.Category?.Classification</p>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="ti ti-edit me-1"></i>Edit
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="ti ti-arrow-left me-1"></i>Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>