@model VMSService.Core.Models.VendorTypes.VendorTypeViewModel

@{
    ViewData["Title"] = "Edit Vendor Type";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12 col-lg-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header pb-4">
                <div class="d-flex flex-column">
                    <span class="text-muted small mb-2">Edit Vendor Type</span>
                    <h2 class="fs-4 fw-bold mb-0">@Model.Name</h2>
                </div>
            </div>

            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="ti ti-alert-triangle me-2"></i>
                        <strong>Please fix the following errors:</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>

                    <input type="hidden" asp-for="Id" />

                    <!-- Name Field -->
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-bold">Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Enter vendor type name" required>
                        <span asp-validation-for="Name" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Description Field -->
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-bold">Description</label>
                        <textarea asp-for="Description" class="form-control" placeholder="Enter vendor type description" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small d-block mt-1"></span>
                        <small class="text-muted d-block mt-2">Provide a detailed description of this vendor type.</small>
                    </div>

                    <!-- Form Actions -->
                    <div class="d-flex gap-2 mt-5">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-check me-1"></i>Update
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="ti ti-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}