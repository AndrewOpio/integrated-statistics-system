@model VMSService.Core.Models.CfbTopupRequests.TopupListViewModel
@{
    ViewData["Title"] = "CFB Top-Up Requests";
}

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success alert-dismissible fade show py-2 mb-3" role="alert">
        <i class="ti ti-circle-check me-2"></i>@successMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string errorMsg)
{
    <div class="alert alert-danger alert-dismissible fade show py-2 mb-3" role="alert">
        <i class="ti ti-alert-circle me-2"></i>@errorMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Info"] is string infoMsg)
{
    <div class="alert alert-info alert-dismissible fade show py-2 mb-3" role="alert">
        <i class="ti ti-info-circle me-2"></i>@infoMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h5 class="fw-bold mb-0">CFB Top-Up Requests</h5>
        <p class="text-muted small mb-0">Baseline increment requests for CFB boxes</p>
    </div>
    @if (Model.IsCfbSupervisor)
    {
        <a asp-action="Create" class="btn btn-sm btn-primary">
            <i class="ti ti-plus me-1"></i>New Top-Up Request
        </a>
    }
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Rows.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="ti ti-inbox fs-1 d-block mb-2"></i>
                No top-up requests found.
            </div>
        }
        else
        {
            <table class="table align-middle mb-0">
                <thead style="background:#f8f9fa;">
                    <tr>
                        <th class="ps-3" style="font-size:11px;">#</th>
                        <th style="font-size:11px;">STATUS</th>
                        <th style="font-size:11px;">SUBMITTED BY</th>
                        <th style="font-size:11px;">DATE</th>
                        <th class="pe-3" style="font-size:11px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr class="border-bottom">
                            <td class="ps-3 fw-semibold small">TR-@row.Id.ToString("D4")</td>
                            <td>
                                @{
                                    var badgeClass = row.StatusName switch {
                                        "Approved" => "bg-success",
                                        "Rejected" => "bg-danger",
                                        "Draft" => "bg-secondary",
                                        _ => "bg-primary"
                                    };
                                }
                                <span class="badge @badgeClass rounded-pill px-2 py-1" style="font-size:10px;">
                                    @row.StatusName
                                </span>
                            </td>
                            <td class="small text-muted">@row.CreatedBy</td>
                            <td class="small text-muted">@row.CreatedDate.ToString("dd MMM yyyy")</td>
                            <td class="pe-3 text-end">
                                <a asp-action="Details" asp-route-id="@row.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    <i class="ti ti-eye me-1"></i>View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
