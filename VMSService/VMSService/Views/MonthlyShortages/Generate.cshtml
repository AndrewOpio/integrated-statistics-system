@{
    ViewData["Title"] = "Generate Monthly Shortage Report";
    int defaultMonth = DateTime.Now.AddMonths(-1).Month;
    int defaultYear  = DateTime.Now.Year;
    var monthNames   = Enumerable.Range(1, 12)
        .ToDictionary(m => m, m => new DateTime(2000, m, 1).ToString("MMMM"));
}

<div class="row justify-content-center">
    <div class="col-12 col-md-6">
        <div class="card border-0 shadow">
            <div class="card-header">
                <div>
                    <span class="text-muted small mb-1 d-block">Monthly Shortages</span>
                    <h2 class="fs-4 fw-bold mb-0">Generate Report</h2>
                </div>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-4">
                    Select a month to automatically compile net shortage amounts from all approved EOD
                    discrepancy reports. One record will be created per branch that has a net shortage.
                </p>

                <form asp-action="Generate" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Month</label>
                            <select class="form-select" name="month" required>
                                @foreach (var kvp in monthNames)
                                {
                                    <option value="@kvp.Key" selected="@(kvp.Key == defaultMonth)">@kvp.Value</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Year</label>
                            <select class="form-select" name="year" required>
                                @for (int y = defaultYear; y >= defaultYear - 3; y--)
                                {
                                    <option value="@y" selected="@(y == defaultYear)">@y</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="alert alert-info mt-4 small">
                        <i class="ti ti-info-circle me-1"></i>
                        Only <strong>Approved</strong> EOD reports are included. Records already past Draft status will not be overwritten.
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-refresh me-1"></i>Generate
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
