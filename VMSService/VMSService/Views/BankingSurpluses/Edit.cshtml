@using ConfigurationsService.Client
@model VMSService.Data.Entities.BankingSurplus

@{
    ViewData["Title"] = "Edit Banking Surplus";
    var branches = ViewBag.Branches as List<BranchDto> ?? new();
    string periodValue = Model.Period.ToString("yyyy-MM");
    string depositDateValue = Model.DepositDate.HasValue ? Model.DepositDate.Value.ToString("yyyy-MM-dd") : DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header pb-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="d-flex flex-column">
                        <span class="text-muted small mb-2">Banking Surpluses</span>
                        <h2 class="fs-4 fw-bold mb-0">Edit Banking Surplus</h2>
                    </div>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                        <i class="ti ti-arrow-left me-1"></i> Back to Details
                    </a>
                </div>
            </div>

            <div class="card-body">
                <div id="formAlerts"></div>

                <form id="surplusForm">
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label">Branch <span class="text-danger">*</span></label>
                            <select class="form-select" id="branchId" name="branchId" onchange="computeNetPosition()">
                                <option value="">-- Select Branch --</option>
                                @foreach (var b in branches)
                                {
                                    if (b.Id == Model.BranchId)
                                    {
                                        <option value="@b.Id" selected>@b.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@b.Id">@b.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Month <span class="text-danger">*</span></label>
                            <input type="month" class="form-control" id="period" value="@periodValue" onchange="computeNetPosition()" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Date of Deposit <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="depositDate" name="depositDate"
                                   value="@depositDateValue" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Amount (UGX) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" class="form-control" id="amount" name="amount" min="0" step="1"
                                       value="@Model.Amount" readonly />
                                <span class="input-group-text" id="netPositionBadge" style="display:none;"></span>
                            </div>
                            <div id="netPositionInfo" class="form-text mt-1">
                                <span class="text-muted small">Change branch or month to recompute.</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Remarks</label>
                            <textarea class="form-control" id="remarks" name="remarks" rows="2" placeholder="Optional">@Model.Remarks</textarea>
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                        <button type="button" class="btn btn-primary px-4" id="submitBtn" onclick="submitForm()">
                            <i class="ti ti-device-floppy me-1"></i>Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fmt(n) {
            return Number(n).toLocaleString(undefined, { minimumFractionDigits: 0 });
        }

        function computeNetPosition() {
            const branchId = document.getElementById('branchId').value;
            const period   = document.getElementById('period').value;
            const amountEl = document.getElementById('amount');
            const badge    = document.getElementById('netPositionBadge');
            const info     = document.getElementById('netPositionInfo');

            amountEl.value = '';
            badge.style.display = 'none';
            badge.className = 'input-group-text';
            badge.textContent = '';
            info.innerHTML = '';

            if (!branchId || !period) return;

            info.innerHTML = '<span class="text-muted"><span class="spinner-border spinner-border-sm me-1"></span>Computing...</span>';

            fetch(`@Url.Action("ComputeNetPosition")?branchId=${branchId}&period=${period}`)
                .then(r => r.json())
                .then(data => {
                    if (!data.hasEntries) {
                        info.innerHTML = '<span class="text-warning"><i class="ti ti-alert-triangle me-1"></i>No approved Banking EOD entries found for this branch and month.</span>';
                        return;
                    }

                    if (data.isSurplus) {
                        amountEl.value = data.netSurplus;
                        badge.style.display = '';
                        badge.className = 'input-group-text text-success fw-bold';
                        badge.textContent = 'Surplus';
                        info.innerHTML =
                            `<span class="text-muted small">Surplus: <strong class="text-success">${fmt(data.totalSurplus)}</strong> &nbsp;|&nbsp; ` +
                            `Shortage: <strong class="text-danger">${fmt(data.totalShortage)}</strong> &nbsp;|&nbsp; ` +
                            `Net: <strong class="text-success">+${fmt(data.netSurplus)}</strong></span>`;
                    } else {
                        badge.style.display = '';
                        badge.className = 'input-group-text text-danger fw-bold';
                        badge.textContent = 'Shortage';
                        info.innerHTML =
                            `<span class="text-muted small">Surplus: <strong class="text-success">${fmt(data.totalSurplus)}</strong> &nbsp;|&nbsp; ` +
                            `Shortage: <strong class="text-danger">${fmt(data.totalShortage)}</strong> &nbsp;|&nbsp; ` +
                            `Net: <strong class="text-danger">${fmt(data.netSurplus)}</strong> — not a surplus, amount not populated.</span>`;
                    }
                })
                .catch(() => {
                    info.innerHTML = '<span class="text-danger"><i class="ti ti-x me-1"></i>Failed to compute net position.</span>';
                });
        }

        function submitForm() {
            const branchId        = document.getElementById('branchId').value;
            const period          = document.getElementById('period').value;
            const amount          = document.getElementById('amount').value;
            const depositDate     = document.getElementById('depositDate').value;
            const remarks         = document.getElementById('remarks').value.trim();

            const alerts = document.getElementById('formAlerts');
            alerts.innerHTML = '';

            const errors = [];
            if (!branchId)               errors.push('Branch is required.');
            if (!period)                 errors.push('Month is required.');
            if (!amount || amount <= 0)  errors.push('Amount must be greater than zero.');
            if (!depositDate)            errors.push('Date of Deposit is required.');

            if (errors.length > 0) {
                alerts.innerHTML = '<div class="alert alert-danger"><ul class="mb-0">' + errors.map(e => '<li>' + e + '</li>').join('') + '</ul></div>';
                return;
            }

            const dto = {
                branchId: parseInt(branchId),
                period: period + '-01',
                amount: parseFloat(amount),
                depositDate: depositDate || null,
                remarks: remarks || null
            };

            fetch('@Url.Action("Edit", new { id = Model.Id })', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(dto)
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) window.location.href = data.redirectUrl;
                else alerts.innerHTML = '<div class="alert alert-danger">' + (data.message || 'An error occurred.') + '</div>';
            })
            .catch(() => alerts.innerHTML = '<div class="alert alert-danger">An unexpected error occurred.</div>');
        }
    </script>
}
