@using System.Security.Claims
@using VMSService.Core.Static
@model VMSService.Core.Models.CbDepositRequest.DepositRequestDetailsViewModel
@{
    ViewData["Title"] = "Deposit Request Details";
}

<style>
    .bag-card {
        background: #f8f9fa;
        transition: box-shadow 0.15s ease;
    }
    .bag-card:hover {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        cursor: pointer;
    }
    .bag-title {
        font-size: 13px;
        font-weight: 600;
        color: #212529;
        line-height: 1.3;
    }
    .bag-sub {
        font-size: 11px;
        color: #6c757d;
    }
    .item-row + .item-row {
        border-top: 1px solid #e9ecef;
        padding-top: 6px;
        margin-top: 6px;
    }
    .payment-person {
        font-size: 12px;
        font-weight: 600;
        color: #212529;
    }
    .payment-meta {
        font-size: 10px;
        color: #6c757d;
    }
    .payment-bundles {
        font-size: 11px;
    }
</style>

@*Hero Header*@
<div class="rounded-2 p-4 mb-3" style="background:linear-gradient(135deg, #b31b34 15%, #c9973a 100%);">

    @*Top row: ref + amount*@
    <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-3">
        <div>
            <p class="text-uppercase mb-1 fs-6" style="letter-spacing:.08em;color:#e8e8f0;">
                @if (Model.RequiresSpecialApproval)
                {
                    <span>Exceptional Approval &middot;</span>
                }
                Cash Deposit Request
            </p>
            <h2 class="fw-medium mb-1 text-white">
                @(string.IsNullOrEmpty(Model.ReferenceNumber) ? "Not Generated" : Model.ReferenceNumber)
            </h2>
            <p class="small" style="color:#e8e8f0;">
                Submitted by @Model.CbName
                &middot; Deposit @Model.DepositDate.ToString("dddd dd MMM yyyy")
            </p>
            <span class="badge bg-primary rounded-pill px-3 py-2 mt-1 bg-opacity-50">
                <i class="ti ti-badge me-1"></i>@Model.StatusName
            </span>
            @if (Model.RequiresSpecialApproval)
            {
                <span class="badge rounded-pill bg-secondary px-3 py-2 mt-1 ms-1 bg-opacity-75"
                      style="font-size:11px;">
                    <i class="ti ti-star me-1"></i>Exceptional Approval Required
                </span>
            }
        </div>
        <div class="text-end">
            <p class="text-uppercase mb-1" style="color:#e8e8f0;">Request Amount</p>
            <h3 class="fw-medium mb-1 text-white">
                UGX @Model.TotalAmount.ToString("N0")
            </h3>
            <p style="font-size:12px;color:#e8e8f0;" id="hero-words"></p>
            @* Add Print Button Here *@
            <button onclick="window.open('@Url.Action("PrintRequest", "CbDepositRequests", new { id = Model.Id })', '_blank')"
                    class="btn btn-sm btn-secondary mt-2 text-white">
                <i class="ti ti-printer me-1"></i> Print
            </button>
        </div>
    </div>

    @*Stepper*@
    @await Html.PartialAsync("~/Views/Shared/_Deposit/_DepositNavStepsInternal.cshtml", Model.Steps)
</div>

@*Two Column Layout*@ 
<div class="row g-3">

    @*Left Column*@
    <div class="col-md-8 d-flex flex-column gap-3">
        @*Exceptional Approval Alert*@
        @if (Model.RequiresSpecialApproval && !string.IsNullOrEmpty(Model.SpecialApprovalReason))
        {
            <div class="rounded-3 p-3" style="background:#fdf6e3;border:0.5px solid #c8a96e;">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="text-uppercase fw-semibold" style="font-size:10px;letter-spacing:.1em;color:#9a6a1f;">
                        Exceptional Approval Reason
                    </span>
                </div>
                <div class="ps-3" style="border-left:3px solid #c8a96e;">
                    <p class="mb-2" style="font-size:14px;color:#7a4f10;line-height:1.6;">@Model.SpecialApprovalReason</p>
                </div>
            </div>
        }

        @*Sender & Receiver*@ 
        <div class="card border-top-0 border-end-0 border-bottom-0 border-4 border-light shadow-sm">

            <div class="card-body">
                <p class="text-uppercase text-muted small fw-semibold mb-3">
                    <i class="ti ti-replace text-muted"></i>
                    Sender & Receiver Details
                </p>
                <hr />
                <div class="row g-4 align-items-end">

                    @* CB Branch (Sender) *@
                    <div class="col-md-6">
                        <div class="text-uppercase small mb-1">
                            FROM — SENDER (DEPOSITOR)
                        </div>
                        <div class="d-flex align-items-stretch rounded-3 overflow-hidden border border-success">
                            <div class="d-flex align-items-center justify-content-center px-3 bg-success bg-opacity-10">
                                <i class="ti ti-circle-arrow-down-left-filled text-success fs-4"></i>
                            </div>
                            <div class="flex-grow-1 px-3 py-2">
                                <p class="text-muted mb-0" style="font-size:9px;">FROM COMMERCIAL BANK</p>
                                <p class="fw-bold mb-0">@Model.CbName</p>
                                <p class="mb-0">@Model.CbBicCode</p>
                                <p class="mb-0" id="cbCode">@Model.CbCode</p>
                                <p class="mb-0">@Model.CbBranchName</p>
                            </div>
                            <div class="d-flex align-items-center pe-3">
                                <span class="badge bg-success">
                                    <i class="ti ti-toggle-left"></i>
                                    Sender
                                </span>
                            </div>
                        </div>
                    </div>

                    @* BOU Branch (Receiver) *@
                    <div class="col-md-6">
                        <div class="text-uppercase small mb-1">
                            TO — RECEIVER
                        </div>
                        <div class="d-flex align-items-stretch rounded-3 overflow-hidden border border-danger">
                            <div class="d-flex align-items-center justify-content-center px-3 bg-danger bg-opacity-10">
                                <i class="ti ti-building-bank text-danger fs-4"></i>
                            </div>
                            <div class="flex-grow-1 px-3 py-2">
                                <p class="text-muted mb-0" style="font-size:9px;">TO BRANCH</p>
                                <p class="fw-bold mb-0">Bank of Uganda</p>
                                <p class="mb-0">@Model.BouBranchName</p>
                                <p class="text-muted fw-light mb-0">@Model.BouBranchCode</p>
                            </div>
                            <div class="d-flex align-items-center pe-3">
                                <span class="badge bg-danger">
                                    <i class="ti ti-toggle-right-filled"></i>
                                    Receiver
                                </span>
                            </div>
                        </div>
                    </div>

                </div>

                @* Deposit Details *@
                <div class="row g-3 mt-2 pt-2 border-top">
                    <div class="col-md-4">
                        <p class="text-muted mb-0 small"><i class="ti ti-calendar me-1"></i>DEPOSIT DATE</p>
                        <p class="fw-bold mb-0">
                            @Model.DepositDate.ToString("dd MMM yyyy")
                        </p>
                    </div>
                    @* <div class="col-md-4">
                        <p class="text-muted mb-0" style="font-size:9px;">RTGS DATE</p>
                        <p class="fw-semibold small mb-0">
                            @(Model.RtgsDate.HasValue? Model.RtgsDate.Value.ToString("dd MMM yyyy") : "—")
                        </p>
                    </div>
                    <div class="col-md-4">
                        <p class="text-muted mb-0" style="font-size:9px;">RTGS CODE</p>
                        <p class="fw-semibold small mb-0">
                            @(string.IsNullOrEmpty(Model.RtgsCode) ? "—" : Model.RtgsCode)
                        </p>
                    </div> *@
                </div>
            </div>
        </div>

        @*Agents*@ 
        <div class="card border-top-0 border-end-0 border-bottom-0 border-4 shadow-sm border-light">
            <div class="card-body">
                <p class="text-uppercase text-muted small fw-semibold mb-3">
                    <i class="ti ti-friends text-muted"></i>
                    Agent Details
                </p>
                <hr />
                <div class="row g-4 mb-4">
                    @{
                        var agentIndex = 0;
                    }
                    @foreach (var agent in Model.DepositAgents)
                    {
                        agentIndex++;
                        <div class="col-md-6" style="cursor:pointer;" onclick="window.location.href='@Url.Action("Details", "AgentDetailsInternal", new { id = agent.Id })'">
                            <div class="border bg-light rounded-3 p-3">

                                @* Header *@
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge rounded-pill bg-secondary text-white justify-content-center"
                                              style="width:24px;height:24px;display:inline-flex;align-items:center;font-size:11px;">
                                            @agentIndex
                                        </span>
                                        <span class="text-uppercase text-muted small fw-semibold">
                                            Agent @agentIndex
                                        </span>
                                    </div>
                                </div>

                                @* Photo + Details side by side *@
                                <div class="d-flex gap-3 mb-3">
                                    @* Photo *@
                                    <div class="flex-shrink-0">
                                        @if (!string.IsNullOrEmpty(agent.PassportPhoto))
                                        {
                                            <img src="@FileUrlHelper.ToWebPath(agent.PassportPhoto)" alt="Photo"
                                                 class="rounded-2 border"
                                                 style="width:100px;height:120px;object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <div class="border rounded-2 bg-white d-flex align-items-center justify-content-center"
                                                 style="width:100px;height:120px;">
                                                <i class="ti ti-user text-muted fs-1"></i>
                                            </div>
                                        }
                                    </div>

                                    @* Name + details *@
                                    <div class="flex-grow-1">
                                        <p class="fw-bold mb-1">@agent.AgentNames</p>
                                        <div class="mb-1">
                                            <p class="text-muted mb-0" style="font-size:9px;">NIN</p>
                                            <p class="fw-semibold small mb-0">@agent.NIN</p>
                                        </div>
                                        <div>
                                            <p class="text-muted mb-0" style="font-size:9px;">PHONE</p>
                                            <p class="fw-semibold small mb-0 text-primary">@(agent.PhoneNumber ?? "—")</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    @* Work ID Scan — full width *@
                                    @if (!string.IsNullOrEmpty(agent.WorkIdScan))
                                    {
                                        <div class="col-md-6">
                                            <p class="text-muted mb-1" style="font-size:9px;">WORK ID SCAN</p>
                                            <img src="@FileUrlHelper.ToWebPath(agent.WorkIdScan)" alt="Work ID Scan"
                                                 class="rounded-2 border w-100"
                                                 style="max-height:150px;object-fit:contain;" />
                                        </div>
                                    }

                                    @* Signature — full width *@
                                    @if (!string.IsNullOrEmpty(agent.SignatureScan))
                                    {
                                        <div class="col-md-6">
                                            <p class="text-muted mb-1" style="font-size:9px;">SIGNATURE</p>
                                            <img src="@FileUrlHelper.ToWebPath(agent.SignatureScan)" alt="Signature"
                                                 class="rounded-2 border w-100"
                                                 style="max-height:70px;object-fit:contain;" />
                                        </div>
                                    }
                                </div>

                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @*Denominations*@ 
        <div class="card border-top-0 border-end-0 border-bottom-0 border-4 shadow-sm border-light">

            <div class="card-body d-flex flex-column gap-3">
                <div>
                    <p class="text-uppercase text-muted small fw-semibold mb-3">
                        <i class="ti ti-cash text-muted"></i>
                        Denomination Details
                    </p>
                    <hr />
                </div>

                @* Fit Notes *@
                @if (Model.FitNotes.Any())
                {
                    <div class="denom-sec border rounded-top">
                        <div class="d-flex align-items-center justify-content-between px-4 py-2 bg-gray-200 rounded">
                            <div class="d-flex align-items-center gap-2 text-uppercase fw-bold">
                                <i class="ti ti-check text-dark"></i>
                                <span class="text-dark small">Fit Banknotes</span>
                            </div>
                            <span class="fw-bold small text-dark">UGX @Model.FitNotes.Sum(d => d.Amount).ToString("N0")</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <colgroup>
                                    <col style="width:35%">
                                    <col style="width:25%">
                                    <col style="width:40%">
                                </colgroup>
                                <thead class="small text-muted">
                                    <tr>
                                        <th class="px-4 py-2">DENOMINATION</th>
                                        <th class="px-4 py-2 text-end">NO. OF BUNDLES</th>
                                        <th class="px-4 py-2 text-end">AMOUNT</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in Model.FitNotes)
                                    {
                                        <tr>
                                            <td class="px-4">@d.DenominationLabel</td>
                                            <td class="px-4 text-end">@d.Bundles</td>
                                            <td class="px-4 text-end fw-bold">UGX @d.Amount.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @* Unfit Notes *@
                @if (Model.UnfitNotes.Any())
                {
                    <div class="denom-sec mt-3 border rounded-top">
                        <div class="d-flex align-items-center justify-content-between px-4 py-2 bg-gray-200 rounded">
                            <div class="d-flex align-items-center gap-2 text-uppercase fw-bold">
                                <i class="ti ti-x text-dark"></i>
                                <span class="text-dark small">Unfit Banknotes</span>
                            </div>
                            <span class="fw-bold small text-dark">UGX @Model.UnfitNotes.Sum(d => d.Amount).ToString("N0")</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <colgroup>
                                    <col style="width:35%">
                                    <col style="width:25%">
                                    <col style="width:40%">
                                </colgroup>
                                <thead class="small text-muted">
                                    <tr>
                                        <th class="px-4 py-2">DENOMINATION</th>
                                        <th class="px-4 py-2 text-end">NO. OF BUNDLES</th>
                                        <th class="px-4 py-2 text-end">AMOUNT</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in Model.UnfitNotes)
                                    {
                                        <tr>
                                            <td class="px-4">@d.DenominationLabel</td>
                                            <td class="px-4 text-end">@d.Bundles</td>
                                            <td class="px-4 text-end fw-bold">UGX @d.Amount.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @* N/A Notes *@
                @if (Model.NANotes.Any())
                {
                    <div class="denom-sec mt-3 border rounded-top">
                        <div class="d-flex align-items-center justify-content-between px-4 py-2 bg-gray-200 rounded">
                            <div class="d-flex align-items-center gap-2 text-uppercase fw-bold">
                                <i class="ti ti-minus text-dark"></i>
                                <span class="text-dark small">N/A Banknotes</span>
                            </div>
                            <span class="fw-bold small text-dark">UGX @Model.NANotes.Sum(d => d.Amount).ToString("N0")</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <colgroup>
                                    <col style="width:35%">
                                    <col style="width:25%">
                                    <col style="width:40%">
                                </colgroup>
                                <thead class="small text-muted">
                                    <tr>
                                        <th class="px-4 py-2">DENOMINATION</th>
                                        <th class="px-4 py-2 text-end">NO. OF BUNDLES</th>
                                        <th class="px-4 py-2 text-end">AMOUNT</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in Model.NANotes)
                                    {
                                        <tr>
                                            <td class="px-4">@d.DenominationLabel</td>
                                            <td class="px-4 text-end">@d.Bundles</td>
                                            <td class="px-4 text-end fw-bold">UGX @d.Amount.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @* Coins *@
                @if (Model.Coins.Any())
                {
                    <div class="denom-sec mt-3 border rounded-top">
                        <div class="d-flex align-items-center justify-content-between px-4 py-2 bg-gray-200 rounded">
                            <div class="d-flex align-items-center gap-2 text-uppercase fw-bold">
                                <i class="ti ti-circle-letter-c-filled text-dark"></i>
                                <span class="text-dark small">Coins</span>
                                <span class="badge bg-secondary text-dark small ms-2">Always N/A</span>
                            </div>
                            <span class="fw-bold small text-dark">UGX @Model.Coins.Sum(d => d.Amount).ToString("N0")</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <colgroup>
                                    <col style="width:35%">
                                    <col style="width:25%">
                                    <col style="width:40%">
                                </colgroup>
                                <thead class="small">
                                    <tr>
                                        <th class="px-4 py-2">DENOMINATION</th>
                                        <th class="px-4 py-2 text-end">NO. OF BOXES</th>
                                        <th class="px-4 py-2 text-end">AMOUNT</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in Model.Coins)
                                    {
                                        <tr>
                                            <td class="px-4">@d.DenominationLabel</td>
                                            <td class="px-4 text-end">@d.Boxes</td>
                                            <td class="px-4 text-end fw-bold">UGX @d.Amount.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @* Sub-Totals by Category *@
                <div class="mt-4 border rounded-3">
                    @* <div class="d-flex justify-content-between align-items-center px-4 py-2 border-bottom">
                <span class="d-flex align-items-center gap-2 small fw-semibold text-success">
                    <i class="ti ti-check"></i> Fit Banknotes
                </span>
                <span class="fw-bold text-success">UGX @Model.FitNotes.Sum(d => d.Amount).ToString("N0")</span>
            </div>
            <div class="d-flex justify-content-between align-items-center px-4 py-2 border-bottom">
                <span class="d-flex align-items-center gap-2 small fw-semibold text-danger">
                    <i class="ti ti-x"></i> Unfit Banknotes
                </span>
                <span class="fw-bold text-danger">UGX @Model.UnfitNotes.Sum(d => d.Amount).ToString("N0")</span>
            </div> *@
                    <div class="d-flex justify-content-between align-items-center px-4 py-2 border-bottom">
                        <span class="d-flex align-items-center gap-2 small fw-semibold text-primary">
                            <i class="ti ti-circle-letter-n-filled"></i> Total Banknotes
                        </span>
                        <span class="fw-bold text-primary">UGX @Model.TotalNotesAmount.ToString("N0")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center px-4 py-2">
                        <span class="d-flex align-items-center gap-2 small fw-semibold text-primary">
                            <i class="ti ti-circle-letter-c-filled"></i> Total Coins
                        </span>
                        <span class="fw-bold text-primary">UGX @Model.TotalCoinsAmount.ToString("N0")</span>
                    </div>
                </div>
                @* Grand Total *@
                <div class="bg-greene rounded-3 px-4 py-3">
                    <div class="d-flex justify-content-between align-items-baseline mb-2">
                        <span class="text-uppercase fw-bold text-white fs-6 opacity-75"
                              style="letter-spacing:.07em;">Grand Total</span>
                        <span class="fw-bold text-white" style="font-size:20px;">UGX @Model.TotalAmount.ToString("N0")</span>
                    </div>
                    <div class="fs-6 fst-italic text-end text-white opacity-75" style="border-color:rgba(255,255,255,.2)!important;">
                        <span id="total-in-words" class="small">@Model.TotalAmountInWords</span>
                    </div>
                </div>

            </div>
        </div>

        @*Fees Table*@
        <div class="card mb-3 border-top-0 border-end-0 border-bottom-0 border-4 border-light shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3 justify-content-between">
                    <div class="d-flex align-items-center gap-2 fw-bolder">
                        <i class="ti ti-receipt"></i>
                        <span class="text-uppercase mb-0">Fees Summary</span>
                    </div>
                    <span class="badge bg-info bg-opacity-10 text-uppercase text-info small">
                        Calculated at Submission
                    </span>
                </div>

                <div class="border rounded-3">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th class="px-4 py-2 rounded-start" style="width: 60%">Fee Type</th>
                                <th class="px-4 py-2 rounded-end text-end" style="width: 40%">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="px-4 py-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="ti ti-calculator"></i>
                                        <span class="fw-semibold">Processing Fees</span>
                                    </div>
                                    <small class="text-muted d-block ms-4">Based on "N/A" notes and coins total</small>
                                </td>
                                <td class="px-4 py-2 text-end fw-bold" id="fees-processing">
                                    @if (Model.ProcessingFee > 0)
                                    {
                                        <span>UGX @Model.ProcessingFee.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">UGX 0</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td class="px-4 py-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="ti ti-alert-triangle"></i>
                                        <span class="fw-semibold">Minimum Deposit Penalty Fees</span>
                                    </div>
                                    <small class="text-muted d-block ms-4">For bundles below minimum standards</small>
                                </td>
                                <td class="px-4 py-2 text-end fw-bold" id="fees-penalty">
                                    @if (Model.MinimumDepositPenaltyFee > 0)
                                    {
                                        <span>UGX @Model.MinimumDepositPenaltyFee.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">UGX 0</span>
                                    }
                                </td>
                            </tr>
                            <tr class="border-top">
                                <td class="px-4 py-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="ti ti-sum"></i>
                                        <span class="fw-bold text-uppercase">Total Fees</span>
                                    </div>
                                </td>
                                <td class="px-4 py-2 text-end fw-bold text-danger fs-6" id="fees-total">
                                    @if (Model.TotalFees > 0)
                                    {
                                        <span class="text-danger">UGX @Model.TotalFees.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">UGX 0</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div id="penalty-details" class="mt-3" style="display: none;">
                    <div class="alert alert-warning d-flex align-items-start gap-2 py-2">
                        <i class="ti ti-info-circle text-warning mt-1 flex-shrink-0"></i>
                        <div class="flex-grow-1">
                            <p class="fw-bold mb-1 small">Penalty Details</p>
                            <div id="penalty-violations-list"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @*Status History*@
        @if (Model.StatusHistory.Any())
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white border-bottom">
                    <h6 class="card-title mb-0">
                        <i class="ti ti-message me-2 text-secondary"></i>Comments
                    </h6>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        @foreach (var history in Model.StatusHistory.OrderBy(x => x.ChangedAt))
                        {
                            <div class="timeline-item mb-4">
                                <div class="d-flex gap-3">
                                    <div class="timeline-marker">
                                        <i class="ti ti-circle-check text-success"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h6 class="mb-1 small">
                                                    <strong>@history.OldStatusName</strong>
                                                    <i class="ti ti-arrow-right text-muted"></i>
                                                    <strong>@history.NewStatusName</strong>
                                                </h6>
                                                <small class="text-muted">
                                                    By: <strong>@history.ChangedBy</strong>
                                                </small>
                                            </div>
                                            <small class="text-muted">
                                                @history.ChangedAt.ToString("dd/MMM/yyyy HH:mm:ss")
                                            </small>
                                        </div>
                                        @if (!string.IsNullOrEmpty(history.Remarks))
                                        {
                                            <div class="mt-2 p-2 bg-white rounded border">
                                                <span class="d-block">@history.Remarks</span>
                                            </div>
                                        }
                                        
                                        @* Display Attachments *@
                                        @if (history.Attachments != null && history.Attachments.Any())
                                        {
                                            <div class="mt-3">
                                                <p class="small text-muted mb-2">
                                                    <i class="ti ti-paperclip me-1"></i>
                                                    <strong>Attachments (@history.Attachments.Count)</strong>
                                                </p>
                                                <div class="d-flex flex-column gap-2">
                                                    @foreach (var attachment in history.Attachments)
                                                    {
                                                        <div class="d-flex align-items-center gap-2 p-2 border rounded bg-light">
                                                            <i class="ti @attachment.FileIcon @attachment.FileColor fs-4"></i>
                                                            <div class="flex-grow-1">
                                                                <p class="mb-0 small fw-semibold">@attachment.FileName</p>
                                                                <small class="text-muted">
                                                                    @attachment.FileSizeFormatted —
                                                                    Uploaded @attachment.UploadedDate.ToString("dd MMM yyyy HH:mm")
                                                                </small>
                                                            </div>
                                                            <div class="d-flex gap-1">
                                                                @if (attachment.IsPreviewable)
                                                                {
                                                                    <a href="/@attachment.FilePath" 
                                                                       target="_blank"
                                                                       class="btn btn-sm btn-outline-info"
                                                                       title="@(attachment.IsPdf ? "Preview PDF" : "View Image")">
                                                                        <i class="ti ti-external-link"></i>
                                                                    </a>
                                                                }
                                                                <a asp-action="DownloadAttachment" 
                                                                   asp-route-id="@attachment.Id" 
                                                                   class="btn btn-sm btn-outline-primary"
                                                                   title="Download">
                                                                    <i class="ti ti-download"></i>
                                                                </a>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @*Bottom nav*@
        <div class="d-flex justify-content-between mb-5">
            <a asp-action="Index" asp-controller="DepositRequests" class="btn btn-secondary">
                <i class="ti ti-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>

    @*Right Column - Sticky Panel*@
    <div class="col-md-4">
        <div class="sticky-top" style="top:80px;">
            <div class="card border border-success overflow-hidden">

                @*Panel header*@
                <div class="card-header text-white d-flex align-items-center gap-2"
                     style="background:#0d6e3e;">
                    <i class="ti ti-circle-arrow-down-left-filled fs-4"></i>
                    <div>
                        <p class="fw-bold small mb-0 text-uppercase">
                            @(Model.AvailableTransitions.Any() ? "Action Required" : "Deposit Request Summary")
                        </p>
                        <p class="mb-0 text-white-50" style="font-size:11px;">
                            @(Model.AvailableTransitions.Any() ? "Review the request and take action" : "Overview of Deposit request")
                        </p>
                    </div>
                </div>

                @*Summary rows*@
                <div class="card-body pb-0">
                    <div class="d-flex justify-content-between py-2 border-bottom small">
                        <span class="text-muted">Request ID</span>
                        <span class="fw-semibold">
                            @(string.IsNullOrEmpty(Model.ReferenceNumber) ? "Not Generated" : Model.ReferenceNumber)
                        </span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom small">
                        <span class="text-muted">Amount</span>
                        <span class="fw-bolder text-success">UGX @Model.TotalAmount.ToString("N0")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom small">
                        <span class="text-muted">From</span>
                        <span class="fw-semibold">@Model.CbName</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom small">
                        <span class="text-muted">To</span>
                        <span class="fw-semibold">BOU @Model.BouBranchName</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom small">
                        <span class="text-muted">Deposit Date</span>
                        <span class="fw-semibold">@Model.DepositDate.ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 small">
                        <span class="text-muted">Status</span>
                        <span class="bg-primary rounded-pill px-3 py-1 text-white">
                            <i class="ti ti-badge me-1"></i>@Model.StatusName
                        </span>
                    </div>
                </div>

                @*All Attachments Section*@
                @if (Model.AllAttachments.Any())
                {
                    <div class="card-body border-top pt-3">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="mb-0 fw-bold text-uppercase small">
                                <i class="ti ti-paperclip me-1"></i>
                                Attachments
                            </h6>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary">
                                @Model.AllAttachments.Count()
                            </span>
                        </div>

                        <div class="d-flex flex-column gap-2">
                            @foreach (var attachment in Model.AllAttachments.OrderByDescending(a => a.UploadedDate))
                            {
                                <div class="border rounded p-2 bg-light">
                                    <div class="d-flex align-items-start gap-2 mb-2">
                                        <i class="ti @attachment.FileIcon @attachment.FileColor fs-4 flex-shrink-0"></i>
                                        <div class="flex-grow-1 overflow-hidden">
                                            <p class="mb-0 small fw-semibold text-truncate" title="@attachment.FileName">
                                                @attachment.FileName
                                            </p>
                                            <small class="text-muted d-block">
                                                @attachment.FileSizeFormatted
                                            </small>
                                            <small class="text-muted d-block">
                                                @attachment.UploadedDate.ToString("dd MMM yyyy HH:mm")
                                            </small>
                                        </div>
                                    </div>

                                    @* Preview Section *@
                                    @* @if (attachment.IsPreviewable)
                                    {
                                        <div class="mb-2">
                                            @if (attachment.IsImage)
                                            {
                                                <img src="/@attachment.FilePath" 
                                                     alt="@attachment.FileName" 
                                                     class="img-fluid rounded border w-100"
                                                     style="max-height: 200px; object-fit: contain; cursor: pointer;"
                                                     onclick="window.open('/@attachment.FilePath', '_blank')" />
                                            }
                                            else if (attachment.IsPdf)
                                            {
                                                <div class="border rounded bg-white p-2 text-center">
                                                    <iframe src="/@attachment.FilePath" 
                                                            style="width: 100%; height: 200px; border: none;"
                                                            title="@attachment.FileName"></iframe>
                                                </div>
                                            }
                                        </div>
                                    } *@

                                    @* Action Buttons *@
                                    <div class="d-flex gap-1">
                                        @if (attachment.IsPreviewable)
                                        {
                                            <a href="/@attachment.FilePath"
                                               target="_blank"
                                               class="btn btn-sm btn-outline-info flex-fill">
                                                <i class="ti ti-external-link me-1"></i>
                                                @(attachment.IsPdf ? "Open PDF" : "Open")
                                            </a>
                                        }
                                        <a asp-action="DownloadAttachment"
                                           asp-route-id="@attachment.Id"
                                           class="btn btn-sm btn-outline-primary flex-fill">
                                            <i class="ti ti-download me-1"></i>Download
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @*Associated Bags Section*@
                @if (Model.Bags.Any())
                {
                    <div class="card-body border-top pt-3">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="mb-0 fw-bold text-uppercase small">
                                <i class="ti ti-package me-1 text-tertiary"></i>Associated Bags
                            </h6>
                            <span class="badge bg-tertiary bg-opacity-10 text-tertiary border border-tertiary"
                                  style="font-size:11px;">
                                @Model.Bags.Count bag@(Model.Bags.Count == 1 ? "" : "s")
                            </span>
                        </div>
                        <div class="d-flex flex-column gap-2" style="max-height:420px;overflow-y:auto;">
                            @foreach (var bag in Model.Bags)
                            {
                                <a asp-controller="Bagging" asp-action="Details" asp-route-id="@bag.Id" class="bag-card border rounded-3 p-3">

                                    @* Header *@
                                    <div class="d-flex align-items-start justify-content-between mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="ti ti-package text-tertiary" aria-hidden="true"
                                               style="font-size:20px;flex-shrink:0;"></i>
                                            <div>
                                                <div class="bag-title">@bag.ReferenceNumber</div>
                                                <div class="bag-sub">UGX @bag.TotalAmount.ToString("N0")</div>
                                            </div>
                                        </div>
                                        <span class="badge bg-tertiary bg-opacity-10 text-tertiary border border-tertiary small ms-1"
                                              style="white-space:nowrap;">
                                            @bag.DenominationLabel
                                        </span>
                                    </div>

                                    @* Progress Bar *@
                                    <div class="mb-2">
                                        <div class="progress mb-1" style="height:5px;border-radius:3px;">
                                            <div class="progress-bar @(bag.Status == "full" ? "bg-tertiary" : "bg-warning")"
                                                 role="progressbar"
                                                 aria-valuenow="@bag.FillPercent"
                                                 aria-valuemin="0"
                                                 aria-valuemax="100"
                                                 style="width:@(bag.FillPercent)%;"></div>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="text-muted" style="font-size:10px;">
                                                @bag.NumberOfBundlesOrBoxes / @bag.MaxBundlesPerBag bundles
                                            </span>
                                            <span class="badge rounded-pill px-2 @(bag.Status == "full" ? "bg-tertiary" : "bg-warning bg-opacity-10 text-warning border border-warning")"
                                                  style="font-size:10px;">
                                                @bag.StatusLabel
                                            </span>
                                        </div>
                                    </div>

                                    @* Items *@
                                    @* @if (bag.Items.Any())
                                    {
                                        <div class="items-list border-top pt-2 mt-1 d-flex flex-column gap-0">
                                            @foreach (var item in bag.Items)
                                            {
                                                <div class="item-row py-1">
                                                    <div class="d-flex align-items-center justify-content-between">
                                                        <div class="payment-person">@item.CbName</div>
                                                        <span class="payment-bundles">
                                                            @item.Bundles bundles
                                                        </span>
                                                    </div>
                                                    <div class="payment-meta">
                                                        <i class="ti ti-calendar me-1"></i>
                                                        @item.DepositDate.ToString("dd MMM yyyy")
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    } *@

                                </a>
                            }
                        </div>
                    </div>
                }

                @*Workflow actions*@
                @if (Model.AvailableTransitions.Any())
                {
                    <div class="card-body border-top pt-3">
                        <form method="post"
                              asp-action="ExecuteAction"
                              asp-route-id="@Model.Id"
                              id="workflowForm"
                              enctype="multipart/form-data">
                            @Html.AntiForgeryToken()

                            <label class="form-label text-uppercase text-muted fw-semibold" style="font-size:10px;">
                                Comment
                                <span id="commentRequired" class="text-danger" style="display:none;">*</span>
                            </label>
                            <textarea id="remarksTextarea"
                                      class="form-control form-control-sm mb-3"
                                      name="remarks"
                                      rows="4"
                                      placeholder="Add a comment..."></textarea>
                            <small id="commentHint" class="text-muted d-block mb-2"></small>

                            @* Attachments Section *@
                            <div id="attachmentsSection" style="display: none;">
                                <div class="border-top pt-3 mb-3">
                                    <label class="form-label text-uppercase text-muted fw-semibold d-flex align-items-center gap-2" style="font-size:10px;">
                                        <i class="ti ti-paperclip"></i>
                                        Required Attachments
                                        <span class="text-danger">*</span>
                                    </label>
                                    <small class="text-muted d-block mb-3">Please upload all required documents before submitting</small>
                                    
                                    <div id="attachmentsList" class="d-flex flex-column gap-3">
                                        @* Attachment items will be dynamically inserted here *@
                                    </div>
                                </div>
                            </div>

                            @if (Model.AvailableTransitions.Count == 1)
                            {
                                @*Single transition - show button directly*@
                                var t = Model.AvailableTransitions.First();
                                <input name="actionName" id="soloActionName" value="@t.ActionName" 
                                       data-requires-comments="@t.RequiresComments.ToString().ToLower()"
                                       data-requires-attachments="@t.RequiresAttachments.ToString().ToLower()"
                                       data-attachment-requirements='@System.Text.Json.JsonSerializer.Serialize(t.AttachmentRequirements)' 
                                       hidden />
                                <div class="d-grid gap-2">
                                    <button type="submit"
                                            id="submitBtn"
                                            class="btn @t.ButtonClass text-white">
                                        <i class="ti ti-check me-1"></i>
                                        <span id="submitBtnLabel">@t.DisplayLabel</span>
                                    </button>
                                </div>
                            }
                            else
                            {
                                @*Multiple transitions - dropdown + confirm*@
                                <div class="mb-3">
                                    <label class="form-label small text-uppercase text-muted fw-semibold">
                                        Select Action <span class="text-danger">*</span>
                                    </label>
                                    <select id="actionSelect" name="actionName" class="form-select form-select-sm" required>
                                        <option value="">— Choose an action —</option>
                                        @foreach (var transition in Model.AvailableTransitions)
                                        {
                                            <option value="@transition.ActionName"
                                                    data-requires-comments="@transition.RequiresComments.ToString().ToLower()"
                                                    data-requires-attachments="@transition.RequiresAttachments.ToString().ToLower()"
                                                    data-attachment-requirements='@System.Text.Json.JsonSerializer.Serialize(transition.AttachmentRequirements)'
                                                    data-button-class="@transition.ButtonClass" 
                                                    data-display-label="@transition.DisplayLabel">
                                                @transition.DisplayLabel
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="d-grid">
                                    <button type="submit"
                                            id="submitBtn"
                                            class="btn btn-primary"
                                            disabled>
                                        <i class="ti ti-check me-1"></i><span id="submitBtnLabel">Confirm Action</span>
                                    </button>
                                </div>
                            }
                        </form>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const actionSelect = document.getElementById('actionSelect');
            const remarksTextarea = document.getElementById('remarksTextarea');
            const commentRequired = document.getElementById('commentRequired');
            const commentHint = document.getElementById('commentHint');
            const submitBtn = document.getElementById('submitBtn');
            const submitBtnLabel = document.getElementById('submitBtnLabel');
            const workflowForm = document.getElementById('workflowForm');
            const soloActionName = document.getElementById('soloActionName');
            const attachmentsSection = document.getElementById('attachmentsSection');
            const attachmentsList = document.getElementById('attachmentsList');

            // Track uploaded files
            let uploadedFiles = {};

            // Handle solo action
            if (soloActionName) {
                const requiresComments = soloActionName.dataset.requiresComments === 'true';
                const requiresAttachments = soloActionName.dataset.requiresAttachments === 'true';
                const attachmentRequirements = JSON.parse(soloActionName.dataset.attachmentRequirements || '[]');

                if (requiresComments) {
                    commentRequired.style.display = 'inline';
                    remarksTextarea.required = true;
                }

                if (requiresAttachments && attachmentRequirements.length > 0) {
                    displayAttachmentFields(attachmentRequirements);
                }
            }

            // Handle action selection for multiple transitions
            if (actionSelect && workflowForm) {
                const hintMessages = {
                    'Verify': 'Provide your verification comments.',
                    'Reject': 'Explain why you are rejecting this request.',
                    'Resubmit': 'Explain what changes were made.'
                };

                actionSelect.addEventListener('change', function () {
                    const selectedOption = this.options[this.selectedIndex];
                    const requiresComments = selectedOption.dataset.requiresComments === 'true';
                    const requiresAttachments = selectedOption.dataset.requiresAttachments === 'true';
                    const attachmentRequirements = JSON.parse(selectedOption.dataset.attachmentRequirements || '[]');
                    const actionName = selectedOption.value;
                    const displayLabel = selectedOption.dataset.displayLabel;
                    const buttonClass = selectedOption.dataset.buttonClass;

                    if (actionName) {
                        // Update comment requirement
                        if (requiresComments) {
                            commentRequired.style.display = 'inline';
                            remarksTextarea.required = true;
                        } else {
                            commentRequired.style.display = 'none';
                            remarksTextarea.required = false;
                        }

                        // Update hint message
                        commentHint.textContent = hintMessages[actionName] || '';

                        // Handle attachments
                        if (requiresAttachments && attachmentRequirements.length > 0) {
                            displayAttachmentFields(attachmentRequirements);
                        } else {
                            attachmentsSection.style.display = 'none';
                            attachmentsList.innerHTML = '';
                            uploadedFiles = {};
                        }

                        // Update button
                        submitBtn.disabled = false;
                        submitBtnLabel.textContent = displayLabel;
                        submitBtn.className = `text-white btn ${buttonClass}`;
                    } else {
                        // Reset to default state
                        commentRequired.style.display = 'none';
                        remarksTextarea.required = false;
                        remarksTextarea.value = '';
                        commentHint.textContent = '';
                        attachmentsSection.style.display = 'none';
                        attachmentsList.innerHTML = '';
                        uploadedFiles = {};
                        submitBtn.disabled = true;
                        submitBtnLabel.textContent = 'Submit';
                        submitBtn.className = 'text-white btn btn-primary';
                    }
                });

                // Form submission validation
                workflowForm.addEventListener('submit', function (e) {
                    const selectedOption = actionSelect ? actionSelect.options[actionSelect.selectedIndex] : null;
                    const requiresComments = selectedOption ? selectedOption.dataset.requiresComments === 'true' : 
                                           soloActionName ? soloActionName.dataset.requiresComments === 'true' : false;
                    const requiresAttachments = selectedOption ? selectedOption.dataset.requiresAttachments === 'true' :
                                              soloActionName ? soloActionName.dataset.requiresAttachments === 'true' : false;
                    const attachmentRequirements = selectedOption ? JSON.parse(selectedOption.dataset.attachmentRequirements || '[]') :
                                                 soloActionName ? JSON.parse(soloActionName.dataset.attachmentRequirements || '[]') : [];
                    const remarksValue = remarksTextarea.value.trim();

                    // Validate comments
                    if (requiresComments && !remarksValue) {
                        e.preventDefault();
                        alert('Comments are required for this action.');
                        remarksTextarea.focus();
                        return false;
                    }

                    // Validate attachments
                    if (requiresAttachments) {
                        const requiredAttachments = attachmentRequirements.filter(req => req.isRequired);
                        const missingAttachments = [];

                        requiredAttachments.forEach(req => {
                            const fileInput = document.getElementById(`attachment_${req.id}`);
                            if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
                                missingAttachments.push(req.attachmentName);
                            }
                        });

                        if (missingAttachments.length > 0) {
                            e.preventDefault();
                            alert('Please upload the following required attachments:\n- ' + missingAttachments.join('\n- '));
                            return false;
                        }
                    }
                });
            }

            // Function to display attachment fields
            function displayAttachmentFields(requirements) {
                attachmentsSection.style.display = 'block';
                attachmentsList.innerHTML = '';
                uploadedFiles = {};

                // Sort by display order
                const sortedRequirements = [...requirements].sort((a, b) => a.displayOrder - b.displayOrder);

                sortedRequirements.forEach(req => {
                    const attachmentCard = createAttachmentCard(req);
                    attachmentsList.appendChild(attachmentCard);
                });
            }

            // Function to create attachment card
            function createAttachmentCard(requirement) {
                const card = document.createElement('div');
                card.className = 'card border';
                card.style.cssText = 'background: #f8f9fa;';

                // Safely handle allowedFormats - check if it exists and provide a default
                const allowedFormats = requirement.AllowedFormats || 'pdf,docx,xlsx,png,jpg';
                const allowedFormatsArray = allowedFormats.split(',').map(f => f.trim());
                const acceptAttribute = allowedFormatsArray.map(format => {
                    const formatMap = {
                        'pdf': '.pdf',
                        'excel': '.xls,.xlsx',
                        'docx': '.doc,.docx',
                        'word': '.doc,.docx',
                        'png': '.png',
                        'jpg': '.jpg,.jpeg',
                        'jpeg': '.jpg,.jpeg'
                    };
                    return formatMap[format.toLowerCase()] || '.' + format;
                }).join(',');

                card.innerHTML = `
                    <div class="card-body p-3">
                        <div class="d-flex align-items-start justify-content-between mb-2">
                            <div class="flex-grow-1">
                                <label class="form-label fw-semibold mb-1 d-flex align-items-center gap-2">
                                    <i class="ti ti-file-text text-primary"></i>
                                    ${requirement.AttachmentName || 'Attachment'}
                                    ${requirement.IsRequired ? '<span class="text-danger">*</span>' : '<span class="badge bg-secondary bg-opacity-10 text-secondary small">Optional</span>'}
                                </label>
                                <small class="text-muted d-block mb-2">
                                    <i class="ti ti-info-circle"></i>
                                    Allowed formats: <strong class="text-info">${allowedFormatsArray.join(', ').toUpperCase()}</strong>
                                </small>
                            </div>
                        </div>
                        
                        <div class="position-relative">
                            <input type="file" 
                                   class="form-control form-control-sm" 
                                   id="attachment_${requirement.Id}"
                                   name="attachments_${requirement.Id}"
                                   accept="${acceptAttribute}"
                                   ${requirement.IsRequired ? 'required' : ''}
                                   data-attachment-id="${requirement.Id}"
                                   data-attachment-name="${requirement.AttachmentName || 'Attachment'}">
                            <div id="preview_${requirement.Id}" class="mt-2" style="display: none;">
                                <div class="alert alert-success py-2 mb-0 d-flex align-items-center gap-2">
                                    <i class="ti ti-circle-check"></i>
                                    <span class="small flex-grow-1" id="fileName_${requirement.Id}"></span>
                                    <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="clearFile(${requirement.Id})">
                                        <i class="ti ti-x"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;

                // Add change event listener
                const fileInput = card.querySelector(`#attachment_${requirement.Id}`);
                fileInput.addEventListener('change', function(e) {
                    handleFileSelect(e, requirement.Id, allowedFormats);
                });

                return card;
            }

            // Function to handle file selection
            function handleFileSelect(event, attachmentId, allowedFormats) {
                const file = event.target.files[0];
                const preview = document.getElementById(`preview_${attachmentId}`);
                const fileNameSpan = document.getElementById(`fileName_${attachmentId}`);

                if (file) {
                    // Validate file format
                    const fileExtension = file.name.split('.').pop().toLowerCase();
                    const allowedFormatsArray = (allowedFormats || 'pdf,docx,xlsx,png,jpg').split(',').map(f => f.trim().toLowerCase());
                    
                    const formatMap = {
                        'excel': ['xls', 'xlsx'],
                        'word': ['doc', 'docx'],
                        'docx': ['doc', 'docx'],
                        'jpg': ['jpg', 'jpeg'],
                        'jpeg': ['jpg', 'jpeg']
                    };

                    let isValid = false;
                    allowedFormatsArray.forEach(format => {
                        if (formatMap[format]) {
                            if (formatMap[format].includes(fileExtension)) {
                                isValid = true;
                            }
                        } else if (format === fileExtension) {
                            isValid = true;
                        }
                    });

                    if (!isValid) {
                        alert(`Invalid file format. Allowed formats: ${allowedFormats.toUpperCase()}`);
                        event.target.value = '';
                        preview.style.display = 'none';
                        return;
                    }

                    // Validate file size (e.g., 10MB max)
                    const maxSize = 10 * 1024 * 1024; // 10MB
                    if (file.size > maxSize) {
                        alert('File size exceeds 10MB limit. Please choose a smaller file.');
                        event.target.value = '';
                        preview.style.display = 'none';
                        return;
                    }

                    // Show preview
                    const fileSizeKB = (file.size / 1024).toFixed(2);
                    fileNameSpan.textContent = `${file.name} (${fileSizeKB} KB)`;
                    preview.style.display = 'block';
                    uploadedFiles[attachmentId] = file;
                } else {
                    preview.style.display = 'none';
                    delete uploadedFiles[attachmentId];
                }
            }

            // Global function to clear file
            window.clearFile = function(attachmentId) {
                const fileInput = document.getElementById(`attachment_${attachmentId}`);
                const preview = document.getElementById(`preview_${attachmentId}`);
                
                if (fileInput) {
                    fileInput.value = '';
                    preview.style.display = 'none';
                    delete uploadedFiles[attachmentId];
                }
            };

            // Amount in words
            const ONES = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine',
                'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen',
                'Seventeen', 'Eighteen', 'Nineteen'];
            const TENS = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];

            function wordsUnder1000(n) {
                if (n === 0) return '';
                if (n < 20) return ONES[n];
                if (n < 100) return TENS[Math.floor(n / 10)] + (n % 10 ? ' ' + ONES[n % 10] : '');
                return ONES[Math.floor(n / 100)] + ' Hundred' + (n % 100 ? ' ' + wordsUnder1000(n % 100) : '');
            }

            function toWords(n) {
                if (n === 0) return 'Zero shillings';
                const scales = [[1e12, 'Trillion'], [1e9, 'Billion'], [1e6, 'Million'], [1e3, 'Thousand'], [1, '']];
                let res = '', rem = n;
                scales.forEach(([s, name]) => {
                    if (rem >= s) {
                        const chunk = Math.floor(rem / s);
                        res += wordsUnder1000(chunk) + (name ? ' ' + name + ' ' : ' ');
                        rem %= s;
                    }
                });
                return res.trim() + ' Shillings';
            }

            document.getElementById('total-in-words').textContent = toWords(@Html.Raw(Model.TotalAmount)) + ' only';
            document.getElementById('hero-words').textContent = toWords(@Html.Raw(Model.TotalAmount)) + ' only';

            // Calculate fees on page load for Details view
            calculateFeesForDetailsView();
        });

        // Function to calculate fees for details view (read-only)
        async function calculateFeesForDetailsView() {
            try {
                const denominations = [
                    @foreach (var d in Model.FitNotes)
                    {
                        @:{ denominationId: @d.DenominationId, denominationValue: @d.Amount, bundles: @d.Bundles },
                    }
                    @foreach (var d in Model.UnfitNotes)
                    {
                        @:{ denominationId: @d.DenominationId, denominationValue: @d.Amount, bundles: @d.Bundles },
                    }
                    @foreach (var d in Model.NANotes)
                    {
                        @:{ denominationId: @d.DenominationId, denominationValue: @d.Amount, bundles: @d.Bundles },
                    }
                ];

                const penaltyResponse = await fetch('/CbDepositRequests/CheckMinimumDepositStandards', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    },
                    body: JSON.stringify({
                        bouBranchId: @Model.BouBranchId,
                        denominations: denominations
                    })
                });

                if (penaltyResponse.ok) {
                    const penaltyData = await penaltyResponse.json();
                    if (penaltyData.violations && penaltyData.violations.length > 0) {
                        const violationsList = document.getElementById('penalty-violations-list');
                        violationsList.innerHTML = penaltyData.violations.map(v =>
                            `<div class="small mb-1">
                                <strong>UGX ${v.denominationValue.toLocaleString()}</strong>:
                                Required ${v.required} bundles, submitted ${v.actual} bundles
                                (shortage: ${v.shortage})
                                - Penalty: <strong class="text-danger">UGX ${v.penalty.toLocaleString()}</strong>
                            </div>`
                        ).join('');
                        document.getElementById('penalty-details').style.display = 'block';
                    }
                }
            } catch (error) {
                console.error('Error calculating penalty fees:', error);
            }
        }
    </script>
}