@model VMSService.Core.Models.CbDepositRequest.DepositRequestDetailsViewModel

@* Deposits carry two independent charge mechanisms — the FeeType-based deposit fees (processing +
   minimum-deposit penalty) and the AppliedPenalty charges. They are stored separately, so the
   combined figure is shown here to give reviewers one number. *@
@if (Model.ApplicablePenalties.Any() || Model.AppliedPenalties.Any())
{
    <div class="card mb-3 border-top-0 border-end-0 border-bottom-0 border-4 border-danger shadow-sm">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <p class="text-uppercase text-muted fw-bold mb-0">
                    <i class="ti ti-gavel text-muted"></i>
                    Penalties
                </p>
                <div class="d-flex align-items-center gap-2">
                    @if (Model.AppliedPenalties.Any())
                    {
                        <span class="badge bg-danger rounded-pill px-3 py-2">
                            Total Applied: UGX @Model.TotalAppliedPenalties.ToString("N0")
                        </span>
                    }
                    @if (Model.ApplicablePenalties.Any())
                    {
                        var checkedCount = Model.ApplicablePenalties.Count(p => p.IsChecked);
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal" data-bs-target="#penaltiesModal">
                            <i class="ti ti-edit me-1"></i>Manage Penalties
                            @if (checkedCount > 0)
                            {
                                <span class="badge bg-danger ms-1">@checkedCount</span>
                            }
                        </button>
                    }
                </div>
            </div>
            <hr />

            @if (Model.AppliedPenalties.Any())
            {
                <div>
                    <p class="text-uppercase text-muted small fw-semibold mb-2">Applied Penalties</p>
                    @{
                        ViewData["RequestId"] = Model.Id;
                        ViewData["CanManagePenalties"] = Model.CanManagePenalties;
                        ViewData["WaiveController"] = "DepositRequests";
                    }
                    @await Html.PartialAsync("~/Views/Shared/_Withdrawal/_AppliedPenaltiesTable.cshtml", Model.AppliedPenalties)
                </div>

                @* Combined figure across both mechanisms *@
                <hr />
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="small text-muted">
                        <div>Deposit Fees: <span class="fw-semibold">UGX @Model.TotalFees.ToString("N0")</span></div>
                        <div>Applied Penalties: <span class="fw-semibold">UGX @Model.TotalAppliedPenalties.ToString("N0")</span></div>
                    </div>
                    <div class="text-end">
                        <p class="text-uppercase text-muted small fw-semibold mb-0">Total Fees &amp; Penalties</p>
                        <span class="fw-bold fs-5 text-danger">UGX @Model.TotalFeesAndPenalties.ToString("N0")</span>
                    </div>
                </div>
            }
        </div>
    </div>
}
