@model IEnumerable<VMSService.Data.Entities.MonthlySurplus>

@using VMSService.Core.Static

@{
    ViewData["Title"] = "Monthly Surpluses";
    var bankNames = ViewBag.BankNames as Dictionary<int, string> ?? new();
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h2 class="fs-5 fw-bold mb-0">Monthly Surpluses</h2>
                    </div>
                    <div class="col text-end">
                        <a asp-controller="MonthlySurpluses" asp-action="CheckPosition" class="btn btn-sm btn-outline-primary">
                            <i class="ti ti-calculator me-1"></i>Check Net Position
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-centered table-nowrap mb-0 rounded datatable">
                        <thead class="thead-light">
                            <tr>
                                <th class="border-0 rounded-start">#</th>
                                <th class="border-0">Reference Number</th>
                                <th class="border-0">Month</th>
                                <th class="border-0 text-end">Amount</th>
                                <th class="border-0">Date of Deposit</th>
                                <th class="border-0">Bank</th>
                                <th class="border-0">Status</th>
                                <th class="border-0 rounded-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int rowNumber = 1; }
                            @foreach (var item in Model)
                            {
                                string badgeClass = item.CurrentStatusName switch
                                {
                                    "Draft"                => "bg-secondary",
                                    "Pending Approval"     => "bg-warning text-dark",
                                    "Pending Confirmation" => "bg-info text-dark",
                                    "Confirmed"            => "bg-success",
                                    _                      => "bg-secondary"
                                };
                                string depositStr = item.DepositDate.HasValue
                                    ? item.DepositDate.Value.ToString("dd/MMM/yyyy")
                                    : "-";
                                string bankStr = item.CommercialBankId.HasValue && bankNames.TryGetValue(item.CommercialBankId.Value, out var bn)
                                    ? bn
                                    : "-";
                                <tr>
                                    <td><span class="text-primary fw-bold">@rowNumber</span></td>
                                    <td class="fw-bold">@item.ReferenceNumber</td>
                                    <td>@item.Period.ToString("MMM yyyy")</td>
                                    <td class="text-end">@item.Amount.ToString("N0")</td>
                                    <td>@depositStr</td>
                                    <td>@bankStr</td>
                                    <td><span class="badge @badgeClass">@item.CurrentStatusName</span></td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="ti ti-eye"></i>
                                            </a>
                                            @if (item.CurrentStatusName == "Draft")
                                            {
                                                <permission name="@SystemPermissions.MonthlySurpluses.Edit">
                                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                                        <i class="ti ti-edit"></i>
                                                    </a>
                                                </permission>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                rowNumber++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
