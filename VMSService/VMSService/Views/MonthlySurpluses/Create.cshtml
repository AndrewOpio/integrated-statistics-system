@model dynamic

@using ConfigurationsService.Client

@{
    ViewData["Title"] = "New Monthly Surplus";
    var branches = ViewBag.Branches as List<BranchDto> ?? new();
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header pb-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="d-flex flex-column">
                        <span class="text-muted small mb-2">Monthly Surpluses</span>
                        <h2 class="fs-4 fw-bold mb-0">New Surplus</h2>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="ti ti-arrow-left me-1"></i> Back to List
                    </a>
                </div>
            </div>

            <div class="card-body">
                <div id="formAlerts"></div>

                <form id="settlementForm">
                    <div class="row mb-3">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Branch <span class="text-danger">*</span></label>
                            <select class="form-select" id="branchId" name="branchId">
                                <option value="">-- Select Branch --</option>
                                @foreach (var b in branches)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Month <span class="text-danger">*</span></label>
                            <input type="month" class="form-control" id="period" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">EFT Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="eftDate" name="eftDate" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Amount (UGX) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="amount" name="amount" min="0" step="1" placeholder="0" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Remarks</label>
                        <textarea class="form-control" id="remarks" name="remarks" rows="2" placeholder="Optional"></textarea>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="button" class="btn btn-primary px-4" onclick="submitForm()">
                            <i class="ti ti-device-floppy me-1"></i>Save Draft
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Pre-fill from CheckPosition and lock fields so they cannot be edited
        (function () {
            const params = new URLSearchParams(window.location.search);
            const branchId = params.get('branchId');
            const period   = params.get('period');
            const amount   = params.get('amount');

            const branchEl = document.getElementById('branchId');
            const periodEl = document.getElementById('period');
            const amountEl = document.getElementById('amount');

            if (branchId) { branchEl.value = branchId; branchEl.disabled = true; }
            if (period)   { periodEl.value = period;   periodEl.readOnly = true; periodEl.classList.add('bg-light'); }
            if (amount)   { amountEl.value = amount;   amountEl.readOnly = true; amountEl.classList.add('bg-light'); }
        })();

        function submitForm() {
            const branchId    = document.getElementById('branchId').value;
            const period      = document.getElementById('period').value;
            const amount      = document.getElementById('amount').value;
            const eftDate = document.getElementById('eftDate').value;
            const remarks     = document.getElementById('remarks').value.trim();

            const alerts = document.getElementById('formAlerts');
            alerts.innerHTML = '';

            const errors = [];
            if (!branchId)              errors.push('Branch is required.');
            if (!period)                errors.push('Period is required.');
            if (!amount || amount <= 0) errors.push('Amount must be greater than zero.');
            if (!eftDate)               errors.push('EFT Date is required.');

            if (errors.length > 0) {
                alerts.innerHTML = '<div class="alert alert-danger"><ul class="mb-0">' + errors.map(e => '<li>' + e + '</li>').join('') + '</ul></div>';
                return;
            }

            const dto = {
                branchId: parseInt(branchId),
                period: period + '-01',
                amount: parseFloat(amount),
                eftDate: eftDate || null,
                remarks: remarks || null
            };

            fetch('@Url.Action("Create")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(dto)
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) window.location.href = data.redirectUrl;
                else alerts.innerHTML = '<div class="alert alert-danger">' + (data.message || 'An error occurred.') + '</div>';
            })
            .catch(() => alerts.innerHTML = '<div class="alert alert-danger">An unexpected error occurred.</div>');
        }
    </script>
}
