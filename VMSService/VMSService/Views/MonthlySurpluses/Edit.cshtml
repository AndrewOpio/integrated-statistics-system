@model VMSService.Data.Entities.MonthlySurplus

@using ConfigurationsService.Client

@{
    ViewData["Title"] = "Edit Surplus";
    var branches = ViewBag.Branches as List<BranchDto> ?? new();
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header pb-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="d-flex flex-column">
                        <span class="text-muted small mb-2">Monthly Surpluses</span>
                        <h2 class="fs-4 fw-bold mb-0">Edit Surplus</h2>
                    </div>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                        <i class="ti ti-arrow-left me-1"></i> Back
                    </a>
                </div>
            </div>

            <div class="card-body">
                <div id="formAlerts"></div>

                <form id="editForm">

                    <div class="row mb-3">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Branch <span class="text-danger">*</span></label>
                            <select class="form-select" id="branchId">
                                <option value="">-- Select Branch --</option>
                                @foreach (var b in branches)
                                {
                                    <option value="@b.Id" selected="@(b.Id == Model.BranchId ? "selected" : null)">@b.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Month <span class="text-danger">*</span></label>
                            <input type="month" class="form-control" id="period" value="@Model.Period.ToString("yyyy-MM")" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">EFT Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="eftDate" value="@Model.EftDate?.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Amount (UGX) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="amount" value="@Model.Amount" min="0" step="1" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Remarks</label>
                        <textarea class="form-control" id="remarks" rows="2" placeholder="Optional">@Model.Remarks</textarea>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                        <button type="button" class="btn btn-primary px-4" onclick="submitEdit()">
                            <i class="ti ti-device-floppy me-1"></i>Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function submitEdit() {
            const branchId    = parseInt(document.getElementById('branchId').value);
            const period      = document.getElementById('period').value;
            const amount      = parseFloat(document.getElementById('amount').value);
            const eftDate = document.getElementById('eftDate').value;
            const remarks     = document.getElementById('remarks').value.trim();

            const alerts = document.getElementById('formAlerts');
            alerts.innerHTML = '';

            const errors = [];
            if (!branchId)              errors.push('Branch is required.');
            if (!period)                errors.push('Period is required.');
            if (!amount || amount <= 0) errors.push('Amount must be greater than zero.');
            if (!eftDate)               errors.push('EFT Date is required.');

            if (errors.length > 0) {
                alerts.innerHTML = '<div class="alert alert-danger"><ul class="mb-0">' + errors.map(e => '<li>' + e + '</li>').join('') + '</ul></div>';
                return;
            }

            const dto = {
                id: @Model.Id,
                branchId,
                period: period + '-01',
                amount,
                eftDate: eftDate || null,
                remarks: remarks || null
            };

            fetch('@Url.Action("Edit")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(dto)
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) window.location.href = data.redirectUrl;
                else alerts.innerHTML = '<div class="alert alert-danger">' + (data.message || 'An error occurred.') + '</div>';
            })
            .catch(() => alerts.innerHTML = '<div class="alert alert-danger">An unexpected error occurred.</div>');
        }
    </script>
}
