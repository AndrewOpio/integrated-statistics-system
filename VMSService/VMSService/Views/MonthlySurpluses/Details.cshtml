@model VMSService.Core.Models.MonthlySurpluses.MonthlySurplusDetailsViewModel

@using VMSService.Core.Static

@{
    ViewData["Title"] = "Monthly Surplus — " + Model.Period.ToString("MMMM yyyy");

    string statusBadgeClass = Model.CurrentStatusName switch
    {
        "Draft"                   => "bg-secondary",
        "Pending Acknowledgement" => "bg-warning text-dark",
        "Acknowledged"            => "bg-success",
        _                         => "bg-secondary"
    };

    var stages = new[] { "Draft", "Pending Acknowledgement", "Acknowledged" };
    int currentStageIndex = Model.CurrentStatusName switch
    {
        "Draft"                   => 0,
        "Pending Acknowledgement" => 1,
        "Acknowledged"            => stages.Length, // all stages done → every circle gets a tick
        _                         => 0
    };
    bool isReturned = false;
}

<div class="row g-4 pb-5">

    @* ── Left column ────────────────────────────────────────────── *@
    <div class="col-12 col-xl-8">

        @* ── Header card ── *@
        <div class="card border-0 shadow mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                    <div>
                        <span class="text-muted small">Monthly Surpluses</span>
                        <h2 class="fs-3 fw-bold mb-1 mt-1">@Model.ReferenceNumber</h2>
                        <span class="text-muted">
                            <i class="ti ti-calendar me-1"></i>@Model.Period.ToString("MMMM yyyy")
                            &nbsp;&bull;&nbsp;
                            <i class="ti ti-building me-1"></i>@Model.BranchName
                        </span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge @statusBadgeClass px-2 py-1">@Model.CurrentStatusName</span>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="ti ti-arrow-left me-1"></i>Back
                        </a>
                    </div>
                </div>

                @* Workflow progress *@
                <div class="mt-4 pt-2">
                    <div class="d-flex justify-content-between position-relative" style="z-index:1;">
                        @for (int i = 0; i < stages.Length; i++)
                        {
                            bool done    = i < currentStageIndex;
                            bool current = i == currentStageIndex;
                            string circleClass = done    ? "bg-success text-white" :
                                                 current && isReturned ? "bg-danger text-white" :
                                                 current ? "bg-primary text-white" :
                                                           "bg-light text-muted border";
                            string labelClass  = done    ? "text-success" :
                                                 current && isReturned ? "text-danger fw-bold" :
                                                 current ? "text-primary fw-bold" :
                                                           "text-muted";
                            <div class="text-center flex-fill">
                                <div class="d-flex align-items-center justify-content-center mx-auto rounded-circle @circleClass"
                                     style="width:2rem;height:2rem;font-size:.8rem;">
                                    @if (done)
                                    {
                                        <i class="ti ti-check"></i>
                                    }
                                    else if (current && isReturned)
                                    {
                                        <i class="ti ti-arrow-back-up" style="font-size:.75rem;"></i>
                                    }
                                    else if (current)
                                    {
                                        <i class="ti ti-clock" style="font-size:.75rem;"></i>
                                    }
                                    else
                                    {
                                        <i class="ti ti-circle" style="font-size:.75rem;"></i>
                                    }
                                </div>
                                <div class="small mt-1 @labelClass" style="font-size:.7rem;">@stages[i]</div>
                            </div>
                            @if (i < stages.Length - 1)
                            {
                                <div class="flex-fill align-self-start" style="margin-top:calc(1rem - 1px);">
                                    <div class="w-100 @(i < currentStageIndex ? "bg-success" : "bg-light")" style="height:2px;"></div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        @* ── Surplus amount highlight ── *@
        @{
            decimal eodTotalSurplus  = Model.EodEntries.Where(e => e.IsSurplus).Sum(e => e.Amount);
            decimal eodTotalShortage = Model.EodEntries.Where(e => !e.IsSurplus).Sum(e => e.Amount);
            decimal eodNetPosition   = eodTotalSurplus - eodTotalShortage;
        }
        <div class="card border-0 border-start border-4 border-success shadow mb-4">
            <div class="card-body d-flex align-items-center gap-4 py-3">
                <div class="rounded-circle bg-success d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:3rem;height:3rem;">
                    <i class="ti ti-trending-up text-white fs-4"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="text-muted small">Surplus Amount (UGX)</div>
                    <div class="fs-2 fw-bold text-success lh-1">@Model.Amount.ToString("N0")</div>
                </div>
                <button type="button" class="btn btn-outline-success btn-sm"
                        data-bs-toggle="modal" data-bs-target="#eodBreakdownModal">
                    <i class="ti ti-chart-bar me-1"></i>View Breakdown
                </button>
            </div>
        </div>

        @* ── Details grid ── *@
        <div class="card border-0 shadow mb-4">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="ti ti-info-circle text-primary fs-5"></i>
                <h6 class="fw-bold mb-0">Surplus Details</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small mb-1">Reference Number</div>
                            <div class="fw-semibold">@Model.ReferenceNumber</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small mb-1">Branch</div>
                            <div class="fw-semibold"><i class="ti ti-building me-1 text-muted"></i>@Model.BranchName</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small mb-1">Period</div>
                            <div class="fw-semibold"><i class="ti ti-calendar me-1 text-muted"></i>@Model.Period.ToString("MMMM yyyy")</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small mb-1">EFT Date</div>
                            <div class="fw-semibold">
                                @(Model.EftDate.HasValue
                                    ? Model.EftDate.Value.ToString("dd MMM yyyy")
                                    : "<span class=\"text-muted\">—</span>")
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Remarks))
                    {
                        <div class="col-12">
                            <div class="p-3 bg-light rounded">
                                <div class="text-muted small mb-1">Remarks</div>
                                <div>@Model.Remarks</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── Attachments ── *@
        @if (Model.Attachments.Any())
        {
            <div class="card border-0 shadow mb-4">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="ti ti-paperclip text-secondary fs-5"></i>
                    <h6 class="fw-bold mb-0">Attachments</h6>
                </div>
                <div class="list-group list-group-flush">
                    @foreach (var att in Model.Attachments)
                    {
                        <a href="@FileUrlHelper.ToWebPath(att.FilePath)" download="@att.FileName" target="_blank"
                           class="list-group-item list-group-item-action d-flex align-items-center gap-3 px-3 py-2">
                            <i class="ti ti-file-description text-primary fs-5"></i>
                            <span class="flex-grow-1 small fw-semibold">@att.FileName</span>
                            <small class="text-muted">@((att.FileSize / 1024.0).ToString("F1")) KB</small>
                            <i class="ti ti-download text-muted"></i>
                        </a>
                    }
                </div>
            </div>
        }

        @* ── Status history ── *@
        @if (Model.StatusHistory.Any())
        {
            <div class="card border-0 shadow mb-4">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="ti ti-history text-secondary fs-5"></i>
                    <h6 class="fw-bold mb-0">Comments &amp; History</h6>
                </div>
                <div class="card-body pb-1">
                    @foreach (var h in Model.StatusHistory.OrderBy(x => x.ChangedAt))
                    {
                        string iconClass = h.NewStatusName == "Approved"  ? "text-success" :
                                           h.NewStatusName == "Returned"  ? "text-danger"  :
                                           h.NewStatusName == "Draft"     ? "text-warning"  :
                                           h.NewStatusName.StartsWith("Pending") ? "text-primary" : "text-secondary";
                        <div class="d-flex gap-3 mb-4">
                            <div class="flex-shrink-0 pt-1">
                                <i class="ti ti-circle-check fs-5 @iconClass"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-1">
                                    <div class="fw-semibold small">
                                        <span class="text-secondary">@h.OldStatusName</span>
                                        <i class="ti ti-arrow-right mx-1 text-muted"></i>
                                        <span class="text-dark">@h.NewStatusName</span>
                                    </div>
                                    <small class="text-muted">@h.ChangedAt.ToString("dd MMM yyyy HH:mm")</small>
                                </div>
                                <div class="small text-muted mt-1">by <strong>@h.ChangedBy</strong></div>
                                @if (!string.IsNullOrWhiteSpace(h.Remarks))
                                {
                                    <div class="mt-2 p-2 bg-light rounded border-start border-3 border-primary small">
                                        @h.Remarks
                                    </div>
                                }
                                @if (h.Attachments.Any())
                                {
                                    <div class="mt-2 d-flex flex-wrap gap-1">
                                        @foreach (var att in h.Attachments)
                                        {
                                            <a href="@FileUrlHelper.ToWebPath(att.FilePath)" download="@att.FileName" target="_blank"
                                               class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1 py-0 px-2">
                                                <i class="ti ti-paperclip"></i>
                                                <span class="small">@att.FileName</span>
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @* ── Meta ── *@
        <div class="text-muted small d-flex gap-4 mb-3">
            <div><i class="ti ti-user me-1"></i>Created by <strong>@Model.CreatedBy</strong></div>
            <div><i class="ti ti-clock me-1"></i>@Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</div>
        </div>

    </div>

    @* ── Right column ────────────────────────────────────────── *@
    <div class="col-12 col-xl-4">
        <div style="position: sticky; top: 1.5rem;">

            @* Action panel *@
            <div class="card border-0 shadow mb-3">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="ti ti-player-play text-primary fs-5"></i>
                    <h5 class="fw-bold mb-0">Actions</h5>
                </div>
                <div class="card-body">
                    @if (Model.AvailableTransitions.Any())
                    {
                        <form asp-action="ExecuteAction" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />

                            <div class="mb-3">
                                <label class="form-label fw-semibold small">Select Action</label>
                                <select class="form-select" name="actionName" id="actionSelect" onchange="onActionChange(this)">
                                    <option value="">-- Choose action --</option>
                                    @foreach (var t in Model.AvailableTransitions)
                                    {
                                        <option value="@t.ActionName"
                                                data-requires-attachments="@t.RequiresAttachments.ToString().ToLower()"
                                                data-requirements="@System.Text.Json.JsonSerializer.Serialize(t.AttachmentRequirements)">
                                            @t.DisplayLabel
                                        </option>
                                    }
                                </select>
                            </div>

                            <div id="attachmentFields"></div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold small">Remarks</label>
                                <textarea class="form-control" name="remarks" rows="3"
                                          placeholder="Add a comment..."></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                <i class="ti ti-check me-1"></i>Submit
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto mb-3"
                                 style="width:3rem;height:3rem;">
                                <i class="ti ti-lock text-muted fs-4"></i>
                            </div>
                            <p class="text-muted small mb-0">No actions available for your role at this stage.</p>
                        </div>
                    }

                    @if (Model.CurrentStatusName == StatusConstants.MonthlySurplus.Draft)
                    {
                        <permission name="@SystemPermissions.MonthlySurpluses.Edit">
                            <hr />
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary w-100">
                                <i class="ti ti-edit me-1"></i>Edit Surplus
                            </a>
                        </permission>
                    }
                </div>
            </div>

            @* About this page *@
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="fw-bold text-muted small text-uppercase mb-3">
                        <i class="ti ti-info-circle me-1"></i>About this page
                    </h6>
                    <p class="small text-muted mb-3">
                        This page shows the full details of a <strong>Monthly Surplus</strong> record — the net surplus
                        position for a specific branch over a calendar month, derived from approved EOD discrepancy reports.
                    </p>
                    <hr class="my-3" />
                    <div class="d-flex align-items-start gap-2 mb-2">
                        <i class="ti ti-timeline text-primary mt-1 flex-shrink-0"></i>
                        <div class="small text-muted"><strong>Workflow stepper</strong> — tracks the record from Draft through to Acknowledged.</div>
                    </div>
                    <div class="d-flex align-items-start gap-2 mb-2">
                        <i class="ti ti-trending-up text-success mt-1 flex-shrink-0"></i>
                        <div class="small text-muted"><strong>Surplus amount</strong> — the declared net surplus for the branch and period. Click <em>View Breakdown</em> to see the individual EOD sessions that make up this figure.</div>
                    </div>
                    <div class="d-flex align-items-start gap-2 mb-2">
                        <i class="ti ti-info-circle text-secondary mt-1 flex-shrink-0"></i>
                        <div class="small text-muted"><strong>Surplus details</strong> — shows the branch, period, the commercial bank the funds were deposited to, account number, date of deposit, and any remarks.</div>
                    </div>
                    <div class="d-flex align-items-start gap-2 mb-2">
                        <i class="ti ti-paperclip text-secondary mt-1 flex-shrink-0"></i>
                        <div class="small text-muted"><strong>Attachments</strong> — supporting documents uploaded during workflow transitions, available for download.</div>
                    </div>
                    <div class="d-flex align-items-start gap-2 mb-2">
                        <i class="ti ti-history text-secondary mt-1 flex-shrink-0"></i>
                        <div class="small text-muted"><strong>Comments &amp; History</strong> — a full audit trail of every status change, who made it, when, and any remarks they added.</div>
                    </div>
                    <div class="d-flex align-items-start gap-2">
                        <i class="ti ti-player-play text-primary mt-1 flex-shrink-0"></i>
                        <div class="small text-muted"><strong>Actions panel</strong> — if your role permits an action at the current stage (e.g. Submit, Acknowledge), it will appear here. Select the action, add remarks if needed, and submit.</div>
                    </div>
                </div>
            </div>

            @* Quick info card *@
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold text-muted small text-uppercase mb-3">Surplus Info</h6>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Reference</span>
                        <span class="fw-semibold small">@Model.ReferenceNumber</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Branch</span>
                        <span class="fw-semibold small">@Model.BranchName</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Period</span>
                        <span class="fw-semibold small">@Model.Period.ToString("MMMM yyyy")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Amount</span>
                        <span class="fw-bold text-success small">@Model.Amount.ToString("N0")</span>
                    </div>
                    @if (Model.EftDate.HasValue)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small">Deposit Date</span>
                            <span class="fw-semibold small">@Model.EftDate.Value.ToString("dd MMM yyyy")</span>
                        </div>
                    }
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Status</span>
                        <span class="badge @statusBadgeClass">@Model.CurrentStatusName</span>
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>

@* EOD Breakdown Modal *@
<div class="modal fade" id="eodBreakdownModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="ti ti-chart-bar me-2 text-success"></i>EOD Breakdown — @Model.Period.ToString("MMMM yyyy")
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (!Model.EodEntries.Any())
                    {
                        <div class="text-center py-5">
                            <i class="ti ti-inbox text-muted" style="font-size:2.5rem;"></i>
                            <p class="text-muted mt-2 mb-0">No approved EOD entries found for this branch and period.</p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3 mb-4">
                            <div class="col-4">
                                <div class="text-center p-3 bg-success bg-opacity-10 rounded">
                                    <div class="text-muted small">Total Surplus</div>
                                    <div class="fs-5 fw-bold text-success">@eodTotalSurplus.ToString("N0")</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="text-center p-3 bg-danger bg-opacity-10 rounded">
                                    <div class="text-muted small">Total Shortage</div>
                                    <div class="fs-5 fw-bold text-danger">@eodTotalShortage.ToString("N0")</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="text-center p-3 @(eodNetPosition >= 0 ? "bg-success" : "bg-danger") bg-opacity-10 rounded">
                                    <div class="text-muted small">Net Position</div>
                                    <div class="fs-5 fw-bold @(eodNetPosition >= 0 ? "text-success" : "text-danger")">
                                        @(eodNetPosition >= 0 ? "+" : "")@eodNetPosition.ToString("N0")
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead style="background-color:#f4f6f8;">
                                    <tr>
                                        <th>#</th>
                                        <th>Session Date</th>
                                        <th>Bank</th>
                                        <th>Denomination</th>
                                        <th>Type</th>
                                        <th class="text-end">Amount (UGX)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int eodRow = 1; }
                                    @foreach (var e in Model.EodEntries)
                                    {
                                        <tr>
                                            <td class="text-muted">@eodRow</td>
                                            <td>@e.SessionDate.ToString("dd MMM yyyy")</td>
                                            <td class="text-muted small">@e.CommercialBankName</td>
                                            <td class="text-muted small">@e.DenominationName</td>
                                            <td>
                                                <span class="badge @(e.IsSurplus ? "bg-success" : "bg-danger")">
                                                    @(e.IsSurplus ? "Surplus" : "Shortage")
                                                </span>
                                            </td>
                                            <td class="text-end fw-semibold @(e.IsSurplus ? "text-success" : "text-danger")">
                                                @e.Amount.ToString("N0")
                                            </td>
                                        </tr>
                                        eodRow++;
                                    }
                                </tbody>
                                <tfoot class="fw-bold" style="background-color:#f4f6f8;">
                                    <tr>
                                        <td colspan="4">Total (@Model.EodEntries.Count transaction@(Model.EodEntries.Count != 1 ? "s" : ""))</td>
                                        <td>
                                            <span class="text-success me-2">S+ @eodTotalSurplus.ToString("N0")</span>
                                            <span class="text-danger">S- @eodTotalShortage.ToString("N0")</span>
                                        </td>
                                        <td class="text-end @(eodNetPosition >= 0 ? "text-success" : "text-danger")">
                                            Net: @(eodNetPosition >= 0 ? "+" : "")@eodNetPosition.ToString("N0")
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
    <script>
        function onActionChange(select) {
            const option      = select.options[select.selectedIndex];
            const requiresAtt = option.dataset.requiresAttachments === 'true';
            const container   = document.getElementById('attachmentFields');
            container.innerHTML = '';
            if (!requiresAtt) return;
            let requirements = [];
            try { requirements = JSON.parse(option.dataset.requirements || '[]'); } catch { return; }
            requirements.forEach(req => {
                const div = document.createElement('div');
                div.className = 'mb-3';
                div.innerHTML =
                    '<label class="form-label fw-semibold small">' + req.AttachmentName +
                    (req.IsRequired ? ' <span class="text-danger">*</span>' : '') + '</label>' +
                    '<input type="file" class="form-control form-control-sm" name="attachments_' + req.Id +
                    '" accept="' + (req.AllowedFormats || '.pdf,.jpg,.jpeg,.png') + '"' +
                    (req.IsRequired ? ' required' : '') + ' />';
                container.appendChild(div);
            });
        }
    </script>
}
