@using ConfigurationsService.Client

@{
    ViewData["Title"] = "Generate Commercial Bank Settlement";
    var banks = ViewBag.Banks as List<CommercialBankDto> ?? new List<CommercialBankDto>();
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="fs-5 fw-bold mb-0">Generate Commercial Bank Settlement</h2>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="ti ti-arrow-left me-1"></i>Back
                </a>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-4">
                    Aggregates all surplus and shortage transactions for the selected commercial bank in the chosen month
                    from approved EOD discrepancy reports. If a Draft settlement already exists for that bank/month it will be regenerated.
                </p>
                <form asp-action="Generate" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Commercial Bank <span class="text-danger">*</span></label>
                        <select name="bankId" class="form-select" required>
                            <option value="">-- Select Commercial Bank --</option>
                            @foreach (var b in banks)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Month <span class="text-danger">*</span></label>
                            <select name="month" class="form-select" required>
                                @for (int m = 1; m <= 12; m++)
                                {
                                    <option value="@m" selected="@(m == DateTime.Today.Month)">@(new DateTime(2000, m, 1).ToString("MMMM"))</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Year <span class="text-danger">*</span></label>
                            <select name="year" class="form-select" required>
                                @for (int y = DateTime.Today.Year; y >= DateTime.Today.Year - 3; y--)
                                {
                                    <option value="@y" selected="@(y == DateTime.Today.Year)">@y</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-refresh me-1"></i>Generate
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
