@model VMSService.Core.Models.MonthlyCommercialBankSettlements.MonthlyCommercialBankSettlementDetailsViewModel

@using VMSService.Core.Static

@{
    ViewData["Title"] = "CB Settlement — " + Model.ReferenceNumber;

    string statusBadgeClass = Model.CurrentStatusName switch
    {
        "Draft"                => "bg-secondary",
        "Pending Approval"     => "bg-warning text-dark",
        "Pending Confirmation" => "bg-info text-dark",
        "Confirmed"            => "bg-success",
        _                      => "bg-secondary"
    };

    var stages = new[] { "Draft", "Pending Approval", "Pending Confirmation", "Confirmed" };
    int currentStageIndex = Model.CurrentStatusName switch
    {
        "Draft"                => 0,
        "Pending Approval"     => 1,
        "Pending Confirmation" => 2,
        "Confirmed"            => stages.Length,
        _                      => 0
    };

    bool isNetSurplus  = Model.NetPosition > 0;
    bool isNetShortage = Model.NetPosition < 0;
    string netColor = isNetSurplus ? "success" : isNetShortage ? "danger" : "secondary";
    string netIcon  = isNetSurplus ? "ti-trending-up" : isNetShortage ? "ti-trending-down" : "ti-scale";
    string netLabel = isNetSurplus ? "Net Surplus" : isNetShortage ? "Net Shortage" : "Balanced";
}

<div class="row g-4">

    @* ── Left column ── *@
    <div class="col-12 col-xl-8">

        @* ── Header card ── *@
        <div class="card border-0 shadow mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                    <div>
                        <span class="text-muted small">Monthly CB Settlements</span>
                        <h2 class="fs-3 fw-bold mb-1 mt-1">@Model.ReferenceNumber</h2>
                        <span class="text-muted">
                            <i class="ti ti-calendar me-1"></i>@Model.Period.ToString("MMMM yyyy")
                            &nbsp;&bull;&nbsp;
                            <i class="ti ti-building-bank me-1"></i>@Model.CommercialBankName
                        </span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge @statusBadgeClass px-2 py-1">@Model.CurrentStatusName</span>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="ti ti-arrow-left me-1"></i>Back
                        </a>
                    </div>
                </div>

                @* Workflow progress *@
                <div class="mt-4 pt-2">
                    <div class="d-flex justify-content-between position-relative" style="z-index:1;">
                        @for (int i = 0; i < stages.Length; i++)
                        {
                            bool done    = i < currentStageIndex;
                            bool current = i == currentStageIndex;
                            string circleClass = done    ? "bg-success text-white" :
                                                 current ? "bg-primary text-white" :
                                                           "bg-light text-muted border";
                            string labelClass  = done    ? "text-success" :
                                                 current ? "text-primary fw-bold" :
                                                           "text-muted";
                            <div class="text-center flex-fill">
                                <div class="d-flex align-items-center justify-content-center mx-auto rounded-circle @circleClass"
                                     style="width:2rem;height:2rem;font-size:.8rem;">
                                    @if (done)
                                    {
                                        <i class="ti ti-check"></i>
                                    }
                                    else if (current)
                                    {
                                        <i class="ti ti-clock" style="font-size:.75rem;"></i>
                                    }
                                    else
                                    {
                                        <i class="ti ti-circle" style="font-size:.75rem;"></i>
                                    }
                                </div>
                                <div class="small mt-1 @labelClass" style="font-size:.7rem;">@stages[i]</div>
                            </div>
                            @if (i < stages.Length - 1)
                            {
                                <div class="flex-fill align-self-start" style="margin-top:calc(1rem - 1px);">
                                    <div class="w-100 @(i < currentStageIndex ? "bg-success" : "bg-light")" style="height:2px;"></div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        @* ── Net position highlight ── *@
        <div class="card border-0 border-start border-4 border-@netColor shadow mb-4">
            <div class="card-body d-flex align-items-center gap-4 py-3">
                <div class="rounded-circle bg-@netColor d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:3rem;height:3rem;">
                    <i class="ti @netIcon text-white fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">@netLabel (UGX)</div>
                    <div class="fs-2 fw-bold text-@netColor lh-1">
                        @(isNetSurplus ? "+" : "")@Math.Abs(Model.NetPosition).ToString("N0")
                    </div>
                </div>
            </div>
        </div>

        @* ── Details grid ── *@
        <div class="card border-0 shadow mb-4">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="ti ti-info-circle text-primary fs-5"></i>
                <h6 class="fw-bold mb-0">Settlement Details</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small mb-1">Reference Number</div>
                            <div class="fw-semibold">@Model.ReferenceNumber</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small mb-1">Commercial Bank</div>
                            <div class="fw-semibold"><i class="ti ti-building-bank me-1 text-muted"></i>@Model.CommercialBankName</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small mb-1">Period</div>
                            <div class="fw-semibold"><i class="ti ti-calendar me-1 text-muted"></i>@Model.Period.ToString("MMMM yyyy")</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small mb-1">Total Surplus</div>
                            <div class="fw-semibold text-success">@Model.TotalSurplus.ToString("N0")</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small mb-1">Total Shortage</div>
                            <div class="fw-semibold text-danger">@Model.TotalShortage.ToString("N0")</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small mb-1">Generated</div>
                            <div class="fw-semibold"><i class="ti ti-clock me-1 text-muted"></i>@Model.CreatedDate.ToString("dd MMM yyyy")</div>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Remarks))
                    {
                        <div class="col-12">
                            <div class="p-3 bg-light rounded">
                                <div class="text-muted small mb-1">Remarks</div>
                                <div>@Model.Remarks</div>
                            </div>
                        </div>
                    }
                </div>
                <div class="mt-3 text-end">
                    <button type="button" class="btn btn-outline-primary btn-sm"
                            data-bs-toggle="modal" data-bs-target="#breakdownModal"
                            onclick="loadBreakdown(@Model.Id)">
                        <i class="ti ti-list-details me-1"></i>View Transaction Breakdown
                    </button>
                </div>
            </div>
        </div>

        @* ── Status history ── *@
        @if (Model.StatusHistory.Any())
        {
            <div class="card border-0 shadow mb-4">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="ti ti-history text-secondary fs-5"></i>
                    <h6 class="fw-bold mb-0">Comments &amp; History</h6>
                </div>
                <div class="card-body pb-1">
                    @foreach (var h in Model.StatusHistory.OrderBy(x => x.ChangedAt))
                    {
                        string iconClass = h.NewStatusName == "Confirmed"             ? "text-success" :
                                           h.NewStatusName.StartsWith("Pending")      ? "text-primary" : "text-secondary";
                        <div class="d-flex gap-3 mb-4">
                            <div class="flex-shrink-0 pt-1">
                                <i class="ti ti-circle-check fs-5 @iconClass"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-1">
                                    <div class="fw-semibold small">
                                        <span class="text-secondary">@h.OldStatusName</span>
                                        <i class="ti ti-arrow-right mx-1 text-muted"></i>
                                        <span class="text-dark">@h.NewStatusName</span>
                                    </div>
                                    <small class="text-muted">@h.ChangedAt.ToString("dd MMM yyyy HH:mm")</small>
                                </div>
                                <div class="small text-muted mt-1">by <strong>@h.ChangedBy</strong></div>
                                @if (!string.IsNullOrWhiteSpace(h.Remarks))
                                {
                                    <div class="mt-2 p-2 bg-light rounded border-start border-3 border-primary small">
                                        @h.Remarks
                                    </div>
                                }
                                @if (h.Attachments.Any())
                                {
                                    <div class="mt-2 d-flex flex-wrap gap-1">
                                        @foreach (var att in h.Attachments)
                                        {
                                            <a asp-action="DownloadAttachment" asp-route-id="@att.Id"
                                               class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1 py-0 px-2">
                                                <i class="ti ti-paperclip"></i>
                                                <span class="small">@att.FileName</span>
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @* ── Meta ── *@
        <div class="text-muted small d-flex gap-4 mb-3">
            <div><i class="ti ti-user me-1"></i>Created by <strong>@Model.CreatedBy</strong></div>
            <div><i class="ti ti-clock me-1"></i>@Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</div>
        </div>

    </div>

    @* ── Right column ── *@
    <div class="col-12 col-xl-4">
        <div style="position: sticky; top: 1.5rem;">

            @* Action panel *@
            <div class="card border-0 shadow mb-3">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="ti ti-player-play text-primary fs-5"></i>
                    <h5 class="fw-bold mb-0">Actions</h5>
                </div>
                <div class="card-body">
                    @if (Model.AvailableTransitions.Any())
                    {
                        <form asp-action="ExecuteAction" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />

                            <div class="mb-3">
                                <label class="form-label fw-semibold small">Select Action</label>
                                <select class="form-select" name="actionName" id="actionSelect" onchange="onActionChange(this)">
                                    <option value="">-- Choose action --</option>
                                    @foreach (var t in Model.AvailableTransitions)
                                    {
                                        <option value="@t.ActionName"
                                                data-requires-attachments="@t.RequiresAttachments.ToString().ToLower()"
                                                data-requirements="@System.Text.Json.JsonSerializer.Serialize(t.AttachmentRequirements)">
                                            @t.DisplayLabel
                                        </option>
                                    }
                                </select>
                            </div>

                            <div id="attachmentFields"></div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold small">Remarks</label>
                                <textarea class="form-control" name="remarks" rows="3"
                                          placeholder="Add a comment..."></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                <i class="ti ti-check me-1"></i>Submit
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto mb-3"
                                 style="width:3rem;height:3rem;">
                                <i class="ti ti-lock text-muted fs-4"></i>
                            </div>
                            <p class="text-muted small mb-0">No actions available for your role at this stage.</p>
                        </div>
                    }
                </div>
            </div>

            @* Quick info card *@
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold text-muted small text-uppercase mb-3">Settlement Info</h6>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Reference</span>
                        <span class="fw-semibold small">@Model.ReferenceNumber</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Commercial Bank</span>
                        <span class="fw-semibold small">@Model.CommercialBankName</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Period</span>
                        <span class="fw-semibold small">@Model.Period.ToString("MMMM yyyy")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Net Position</span>
                        <span class="fw-bold text-@netColor small">
                            @(isNetSurplus ? "+" : "")@Math.Abs(Model.NetPosition).ToString("N0")
                        </span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Status</span>
                        <span class="badge @statusBadgeClass">@Model.CurrentStatusName</span>
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>

@* ── Breakdown Modal ── *@
<div class="modal fade" id="breakdownModal" tabindex="-1" aria-labelledby="breakdownModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="breakdownModalLabel">
                    <i class="ti ti-list-details me-2 text-primary"></i>Transaction Breakdown — @Model.Period.ToString("MMMM yyyy")
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="breakdownBody">
                <div class="text-center py-4">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <span class="ms-2 text-muted small">Loading...</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function onActionChange(select) {
            const option      = select.options[select.selectedIndex];
            const requiresAtt = option.dataset.requiresAttachments === 'true';
            const container   = document.getElementById('attachmentFields');
            container.innerHTML = '';
            if (!requiresAtt) return;
            let requirements = [];
            try { requirements = JSON.parse(option.dataset.requirements || '[]'); } catch { return; }
            requirements.forEach(req => {
                const div = document.createElement('div');
                div.className = 'mb-3';
                div.innerHTML =
                    '<label class="form-label fw-semibold small">' + req.AttachmentName +
                    (req.IsRequired ? ' <span class="text-danger">*</span>' : '') + '</label>' +
                    '<input type="file" class="form-control form-control-sm" name="attachments_' + req.Id +
                    '" accept="' + (req.AllowedFormats || '.pdf,.jpg,.jpeg,.png') + '"' +
                    (req.IsRequired ? ' required' : '') + ' />';
                container.appendChild(div);
            });
        }

        function fmt(n) {
            return Number(n).toLocaleString(undefined, { minimumFractionDigits: 0 });
        }

        function loadBreakdown(settlementId) {
            const body = document.getElementById('breakdownBody');
            body.innerHTML = `<div class="text-center py-4">
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                <span class="ms-2 text-muted small">Loading...</span>
            </div>`;

            fetch(`/MonthlyCommercialBankSettlements/Breakdown/${settlementId}`)
                .then(r => r.json())
                .then(data => {
                    const transactions = data.transactions || [];
                    if (!transactions.length) {
                        body.innerHTML = `<p class="text-muted text-center mb-0"><i class="ti ti-inbox me-1"></i>No transactions found for this period.</p>`;
                        return;
                    }

                    let totalSurplus = 0, totalShortage = 0, rows = '';
                    transactions.forEach((t, i) => {
                        if (t.isSurplus) totalSurplus  += t.amount;
                        else             totalShortage += t.amount;
                        rows += `<tr>
                            <td>${i + 1}</td>
                            <td>${t.sessionDate}</td>
                            <td class="text-muted small">${t.denomination}</td>
                            <td><span class="badge ${t.isSurplus ? 'bg-success' : 'bg-danger'}">${t.isSurplus ? 'Surplus' : 'Shortage'}</span></td>
                            <td class="text-end fw-semibold ${t.isSurplus ? 'text-success' : 'text-danger'}">${fmt(t.amount)}</td>
                        </tr>`;
                    });

                    const grandNet      = totalSurplus - totalShortage;
                    const grandNetClass = grandNet > 0 ? 'text-success' : grandNet < 0 ? 'text-danger' : '';
                    const grandNetSign  = grandNet >= 0 ? '+' : '';

                    body.innerHTML = `
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead style="background-color:#f4f6f8">
                                    <tr>
                                        <th>#</th>
                                        <th>Session Date</th>
                                        <th>Denomination</th>
                                        <th>Type</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>${rows}</tbody>
                                <tfoot class="fw-bold" style="background-color:#f4f6f8">
                                    <tr>
                                        <td colspan="3">Total (${transactions.length} transaction${transactions.length !== 1 ? 's' : ''})</td>
                                        <td>
                                            <span class="text-success me-2">S+ ${fmt(totalSurplus)}</span>
                                            <span class="text-danger">S- ${fmt(totalShortage)}</span>
                                        </td>
                                        <td class="text-end ${grandNetClass}">${grandNetSign}${fmt(grandNet)}</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>`;
                })
                .catch(() => {
                    body.innerHTML = `<p class="text-danger text-center mb-0">Failed to load breakdown.</p>`;
                });
        }
    </script>
}
