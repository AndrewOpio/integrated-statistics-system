@model VMSService.Core.Models.Denominations.DenominationViewModel

@{
    ViewData["Title"] = "Denomination Details";
}

<div class="row">
    <div class="col-12 col-lg-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header pb-4">
                <div class="d-flex flex-column">
                    <span class="text-muted small mb-2">Denomination Profile</span>
                    <h2 class="fs-4 fw-bold mb-3">@Model.Name</h2>
                    @if (Model.DenominationType != null && !string.IsNullOrEmpty(Model.DenominationType.Name))
                    {
                        <div class="d-inline-flex align-items-center gap-2" style="width: fit-content;">
                            <span class="badge bg-primary">
                                <i class="ti ti-tag me-1"></i>@Model.DenominationType.Name
                            </span>
                        </div>
                    }
                </div>
            </div>

            <div class="card-body">
                <div class="field mb-4">
                    <span class="d-block text-muted small mb-2 text-uppercase">Name</span>
                    <span class="d-block fw-normal">@Model.Name</span>
                </div>

                <div class="field mb-4">
                    <span class="d-block text-muted small mb-2 text-uppercase">Value (UGX)</span>
                    <span class="d-block fw-normal">@Model.Value.ToString("N0")</span>
                </div>

                <div class="field mb-4">
                    <span class="d-block text-muted small mb-2 text-uppercase">Number of Pieces in a Box</span>
                    <span class="d-block fw-normal">@Model.NumberOfPiecesInABox.ToString("N0")</span>
                </div>

                @if (Model.DenominationType != null && !string.IsNullOrEmpty(Model.DenominationType.Name))
                {
                    <div class="field">
                        <span class="d-block text-muted small mb-2 text-uppercase">Denomination Type</span>
                        <span class="d-block fw-normal">@Model.DenominationType.Name</span>
                    </div>
                }
            </div>

            <div class="card-footer bg-transparent border-top pt-3">
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="ti ti-pencil me-1"></i>Edit
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="ti ti-arrow-left me-1"></i>Back
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>