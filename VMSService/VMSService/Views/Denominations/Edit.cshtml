@model VMSService.Core.Models.Denominations.DenominationViewModel

@{
    ViewData["Title"] = "Edit Denomination";
}

<div class="row">
    <div class="col-12 col-lg-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header pb-4">
                <div class="d-flex flex-column">
                    <span class="text-muted small mb-2">Edit Denomination</span>
                    <h2 class="fs-4 fw-bold mb-3">@Model.Name</h2>
                    @if (Model.DenominationType != null && !string.IsNullOrEmpty(Model.DenominationType.Name))
                    {
                        <div class="d-inline-flex align-items-center gap-2" style="width: fit-content;">
                            <span class="badge bg-primary">
                                <i class="ti ti-tag me-1"></i>@Model.DenominationType.Name
                            </span>
                        </div>
                    }
                </div>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert">
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id">
                    <input type="number" class="form-control" asp-for="Value" required hidden>
                    <input type="number" class="form-control" asp-for="NumberOfPiecesInABox" required hidden>
                    <input type="number" class="form-control" asp-for="NumberOfPiecesInABundle" required hidden>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Name">Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" asp-for="Name" required>
                        <span asp-validation-for="Name" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Value">Value <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="ValueText" value="@Model.Value.ToString("N0")" required>
                        <span asp-validation-for="Value" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="NumberOfPiecesInABox">Number Of Pieces In A Box <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="NumberOfPiecesInABoxText" value="@Model.NumberOfPiecesInABox.ToString("N0")" placeholder="Enter the Number of Pieces in a Box">
                        <span asp-validation-for="NumberOfPiecesInABox" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="NumberOfPiecesInABundle">Number Of Pieces In A Bundle <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="NumberOfPiecesInABundleText" value="@Model.NumberOfPiecesInABundle.ToString("N0")" placeholder="Enter the Number of Pieces in a Bundle">
                        <span asp-validation-for="NumberOfPiecesInABundle" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="DenominationTypeId">Denomination Type <span class="text-danger">*</span></label>
                        <select class="form-select" asp-for="DenominationTypeId" required>
                            <option value="">-- Select Type --</option>
                            @if (ViewBag.DenominationTypes != null)
                            {
                                @foreach (var type in ViewBag.DenominationTypes)
                                {
                                    <option value="@type.Id" selected="@(type.Id == Model.DenominationTypeId)">@type.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="DenominationTypeId" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-check me-1"></i>Update
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="ti ti-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    const plainValue = document.getElementById("Value");
    const plainNumberOfPieces = document.getElementById("NumberOfPiecesInABox");
    const plainNumberOfPiecesInABundle = document.getElementById("NumberOfPiecesInABundle");

    // Format Value input with commas
    document.getElementById("ValueText").addEventListener("input", function (e) {
        // 1. Remove everything except digits and decimal point
        let raw = e.target.value.replace(/[^0-9.]/g, "");

        // 2. Ensure only a single decimal point
        const parts = raw.split(".");
        if (parts.length > 2) {
            raw = parts[0] + "." + parts.slice(1).join("");
        }

        // 3. Format with commas
        const number = parseFloat(raw);
        if (!isNaN(number)) {
            e.target.value = number.toLocaleString("en-US", {
                minimumFractionDigits: 0,
                maximumFractionDigits: 2
            });
        } else {
            e.target.value = "";
        }

        plainValue.value = number;
    });

    // Format NumberOfPiecesInABox input with commas
    document.getElementById("NumberOfPiecesInABoxText").addEventListener("input", function (e) {
        // 1. Remove everything except digits
        let raw = e.target.value.replace(/[^0-9]/g, "");

        // 2. Format with commas
        const number = parseInt(raw);
        if (!isNaN(number)) {
            e.target.value = number.toLocaleString("en-US");
        } else {
            e.target.value = "";
        }

        plainNumberOfPieces.value = number;
    });

    // Format NumberOfPiecesInABundle input with commas
    document.getElementById("NumberOfPiecesInABundleText").addEventListener("input", function (e) {
        // 1. Remove everything except digits
        let raw = e.target.value.replace(/[^0-9]/g, "");

        // 2. Format with commas
        const number = parseInt(raw);
        if (!isNaN(number)) {
            e.target.value = number.toLocaleString("en-US");
        } else {
            e.target.value = "";
        }

        plainNumberOfPiecesInABundle.value = number;
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}