@model IEnumerable<VMSService.Data.Entities.DestructionRequest>

@{
    ViewData["Title"] = "Destruction Requests";
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h2 class="fs-5 fw-bold mb-0">Destruction Requests</h2>
                    </div>
                    <div class="col text-end">
                        <a asp-action="Create" class="btn btn-sm btn-primary">
                            <i class="ti ti-plus me-1"></i>Add Request
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-centered table-nowrap mb-0 rounded datatable">
                        <thead class="thead-light">
                            <tr>
                                <th class="border-0 rounded-start">#</th>
                                <th class="border-0">Authorization</th>
                                <th class="border-0">Destruction Type</th>
                                <th class="border-0">Date</th>
                                <th class="border-0">Reference Number</th>
                                <th class="border-0">Verification Officer</th>
                                <th class="border-0">Status</th>
                                <th class="border-0">Grand Total Value</th>
                                <th class="border-0 rounded-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowNumber = 1;
                            }
                            @foreach (var item in Model)
                            {
                                var grandTotal = item.DestructionRequestDenominations?.Sum(d => d.Amount) ?? 0m;
                                <tr>
                                    <td><span class="text-primary fw-bold">@rowNumber</span></td>
                                    <td>
                                        @if (item.DestructionAuthorizationId.HasValue)
                                        {
                                            <a asp-controller="DestructionAuthorizations" asp-action="Details" asp-route-id="@item.DestructionAuthorizationId" class="text-decoration-none">
                                                <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2">
                                                    <i class="ti ti-file-check me-1"></i>@item.DestructionAuthorization?.ReferenceNumber
                                                </span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td class="fw-bold">@item.DestructionType?.Name</td>
                                    <td>@item.Date.ToString("dd/MMM/yyyy")</td>
                                    <td>@item.ReferenceNumber</td>
                                    <td>@item.VerificationOfficer</td>
                                    <td>
                                        @{
                                            string badgeClass = item.CurrentStatusName switch
                                            {
                                                "Draft"                    => "bg-secondary",
                                                "Pending Verification"     => "bg-warning text-dark",
                                                "Pending Approval"         => "bg-warning text-dark",
                                                "Approved"                 => "bg-success",
                                                "Completed"                => "bg-primary",
                                                "Returned to Storage"      => "bg-danger",
                                                "Returned for Destruction" => "bg-info",
                                                _                          => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass">@item.CurrentStatusName</span>
                                    </td>
                                    <td>@grandTotal.ToString("N0")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="ti ti-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                                <i class="ti ti-edit"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                rowNumber++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

