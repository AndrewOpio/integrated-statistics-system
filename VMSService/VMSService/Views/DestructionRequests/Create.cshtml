@model dynamic

@using VMSService.Data.Entities
@using ConfigurationsService.Client
@using VMSService.Web.Controllers
@using VMSService.Core.Static

@{
    ViewData["Title"] = "Create Destruction Request";
    var destructionTypes   = ViewBag.DestructionTypes as List<DestructionType> ?? new List<DestructionType>();
    var branches           = ViewBag.Branches as List<BranchDto>;
    var authorizations     = ViewBag.Authorizations as List<VMSService.Data.Entities.DestructionAuthorization> ?? new();
    var locations          = ViewBag.Locations as List<VMSService.Data.Entities.DestructionLocation> ?? new();
    var verificationOfficers = ViewBag.VerificationOfficers as ICollection<VMSService.Core.Services.Identity.IdentityEntities.UserDto> ?? new List<VMSService.Core.Services.Identity.IdentityEntities.UserDto>();
    var onlineTypeName     = StockConstants.DestructionTypes.Online;
    var offsiteTypeName    = StockConstants.DestructionTypes.Offsite;
}

<div class="row">
    <div class="col-12 col-lg-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header pb-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="d-flex flex-column">
                        <span class="text-muted small mb-2">Destruction Management</span>
                        <h2 class="fs-4 fw-bold mb-0">New Destruction Request</h2>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="ti ti-arrow-left me-1"></i> Back to List
                    </a>
                </div>
            </div>

            <div class="card-body">
                <div id="formAlerts"></div>

                <form id="destructionRequestForm">
                    <div class="row mb-3">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Destruction Type <span class="text-danger">*</span></label>
                            <select class="form-select" id="destructionTypeId">
                                <option value="">-- Select Type --</option>
                                @foreach (var dt in destructionTypes)
                                {
                                    <option value="@dt.Id">@dt.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Branch <span class="text-danger">*</span></label>
                            <select class="form-select" id="branchId">
                                <option value="">-- Select Branch --</option>
                                @foreach (var b in branches)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Reference Number <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="referenceNumber" placeholder="e.g. DR-2025-001" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 mb-3" id="authorizationRow">
                            <label class="form-label">Destruction Authorization <span class="text-danger">*</span></label>
                            <select class="form-select" id="destructionAuthorizationId">
                                <option value="">-- Select Authorization --</option>
                                @foreach (var a in authorizations)
                                {
                                    <option value="@a.Id">@a.ReferenceNumber — @a.Date.ToString("dd/MMM/yyyy")</option>
                                }
                            </select>
                            <div class="form-text text-muted" id="authorizationHint"></div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="requestDate" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Verification Officer <span class="text-danger">*</span></label>
                            <select class="form-select" id="verificationOfficer">
                                <option value="">-- Select Verification Officer --</option>
                                @foreach (var officer in verificationOfficers)
                                {
                                    <option value="@officer.UserName">@officer.FirstName @officer.LastName</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3" id="locationRow" style="display:none;">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Location <span class="text-danger">*</span></label>
                            <select class="form-select" id="destructionLocationId">
                                <option value="">-- Select Location --</option>
                                @foreach (var l in locations)
                                {
                                    <option value="@l.Id">@l.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Denomination Details</label>
                        <table class="table table-bordered" id="denominationTable">
                            <thead>
                                <tr>
                                    <th>Denomination</th>
                                    <th id="denomQtyHeader">Number of Bags</th>
                                    <th>Amount</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                            <tfoot style="background-color: #f8f9fa;">
                                <tr>
                                    <td colspan="2" class="text-end align-middle">Grand Total Amount</td>
                                    <td style="min-width: 160px;">
                                        <input type="text" class="form-control text-end" id="grandTotalAmount" readonly placeholder="0" />
                                    </td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                        <div class="d-flex justify-content-end mt-3">
                            <button type="button" class="btn btn-success btn-sm" id="addDenominationRow">
                                <i class="ti ti-plus"></i> Add Row
                            </button>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Destruction Committee</label>
                        <table class="table table-bordered" id="membersTable">
                            <thead>
                                <tr>
                                    <th>ID Number</th>
                                    <th>Full Name</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                        <div class="d-flex justify-content-end mt-3">
                            <button type="button" class="btn btn-outline-primary btn-sm" id="addMemberRow">
                                <i class="ti ti-user-plus me-1"></i> Add Committee Member
                            </button>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary" id="submitBtn">
                            <i class="ti ti-check me-1"></i>Save
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="ti ti-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).ready(function () {

    // ─── Razor data passed into JS ────────────────────────────────────────────

    const denominationOptions = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
        ViewBag.Denominations != null
            ? ((List<VMSService.Core.Services.Stocks.StockEntities.Denomination>)ViewBag.Denominations)
                .Select(d => new { id = d.Id, name = d.Name, value = d.Value, piecesInBox = d.NumberOfPiecesInABox })
            : Enumerable.Empty<object>()
    ));

    const ONLINE_TYPE_NAME   = '@onlineTypeName';
    const OFFSITE_TYPE_NAME  = '@offsiteTypeName';

    function isOnlineType()  { return $('#destructionTypeId option:selected').text().trim() === ONLINE_TYPE_NAME; }
    function isOffsiteType() { return $('#destructionTypeId option:selected').text().trim() === OFFSITE_TYPE_NAME; }

    function updateDenomTableForType() {
        if (isOnlineType()) {
            $('#denomQtyHeader').text('Number of Notes');
        } else {
            $('#denomQtyHeader').text('Number of Bags');
        }
        renderDenominationTable();
    }

    $('#destructionTypeId').on('change', function () {
        if (isOnlineType()) {
            $('#authorizationRow').hide().find('select').val('');
            denominationRows = [{ denominationId: '', numberOfBags: '', amount: '' }];
            $('#authorizationHint').text('');
        } else {
            $('#authorizationRow').show();
        }

        if (isOffsiteType()) {
            $('#locationRow').show();
        } else {
            $('#locationRow').hide().find('select').val('');
        }

        updateDenomTableForType();
    });

    // Authorization denomination data keyed by authorizationId
    const authorizationData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
        authorizations.ToDictionary(
            a => a.Id,
            a => (a.DestructionAuthorizationDenominations ?? new List<VMSService.Data.Entities.DestructionAuthorizationDenomination>())
                .Select(d => new { denominationId = d.DenominationId, numberOfBags = d.NumberOfBags, amount = d.Amount })
        )
    ));

    // What's actually still available per denomination — the authorized amount minus whatever
    // other Destruction Requests have already drawn against this same authorization.
    const authorizationRemaining = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.AuthorizationRemaining));

    function remainingFor(authId, denominationId) {
        const rows = authorizationRemaining && authorizationRemaining[authId];
        if (!rows) return null;
        return rows.find(r => String(r.denominationId) === String(denominationId)) ?? null;
    }

    // ─── State ────────────────────────────────────────────────────────────────

    let denominationRows = [
        { denominationId: '', numberOfBags: '', amount: '' }
    ];

    let memberRows = [
        { idNumber: '', fullName: '' }
    ];

    // ─── Authorization selection ──────────────────────────────────────

    $('#destructionAuthorizationId').on('change', function () {
        const authId = parseInt($(this).val());
        if (!authId || !authorizationData[authId]) return;

        const authDenoms = authorizationData[authId];
        denominationRows = authDenoms.map(d => {
            const remaining = remainingFor(authId, d.denominationId);
            return {
                denominationId: String(d.denominationId),
                numberOfBags:   '',
                amount:         '',
                maxBags:        remaining ? remaining.remainingBags : (d.numberOfBags ?? 0),
                maxAmount:      remaining ? remaining.remainingAmount : d.amount
            };
        });
        renderDenominationTable();
        $('#authorizationHint').text(`${authDenoms.length} denomination(s) loaded from authorization.`);
    });

    // ─── Option builders ──────────────────────────────────────────────────────

    function buildDenomOptions(selectedId) {
        let html = '<option value="">-- Select Denomination --</option>';
        denominationOptions.forEach(d => {
            html += `<option value="${d.id}" data-value="${d.value}" data-pieces="${d.piecesInBox}" ${String(d.id) === String(selectedId) ? 'selected' : ''}>${d.name} (${Number(d.value).toLocaleString()})</option>`;
        });
        return html;
    }

    // ─── Render denomination table ────────────────────────────────────────────

    function renderDenominationTable() {
        const $tbody = $('#denominationTable tbody');
        $tbody.empty();

        denominationRows.forEach((row, idx) => {
            const hasMax  = !isOnlineType() && row.maxBags !== undefined && row.maxBags !== null;
            const bagsQty = parseInt(row.numberOfBags) || 0;
            const isOver  = hasMax && bagsQty > row.maxBags;
            $tbody.append(`
                <tr data-idx="${idx}">
                    <td>
                        <select class="form-select denom-id">${buildDenomOptions(row.denominationId)}</select>
                    </td>
                    <td>
                        <input type="text" class="form-control denom-bags ${isOver ? 'is-invalid' : ''}" value="${row.numberOfBags}" placeholder="${isOnlineType() ? 'e.g. 1000' : 'e.g. 5'}" />
                        ${hasMax ? `<div class="form-text ${isOver ? 'text-danger' : 'text-muted'}">Available: ${Number(row.maxBags).toLocaleString()} bag(s)</div>` : ''}
                    </td>
                    <td>
                        <input type="text" class="form-control text-end denom-amount" value="${formatAmount(row.amount)}" placeholder="0" readonly />
                    </td>
                    <td class="text-center align-middle">
                        <button type="button" class="btn btn-danger btn-sm remove-denom-row">
                            <i class="ti ti-trash"></i>
                        </button>
                    </td>
                </tr>
            `);
        });

        recalculateGrandTotal();
    }

    // ─── Render members table ─────────────────────────────────────────────────

    function renderMembersTable() {
        const $tbody = $('#membersTable tbody');
        $tbody.empty();

        memberRows.forEach((row, idx) => {
            $tbody.append(`
                <tr data-idx="${idx}">
                    <td>
                        <input type="text" class="form-control member-id-number" value="${row.idNumber}" placeholder="Employee ID" />
                    </td>
                    <td>
                        <input type="text" class="form-control member-full-name" value="${row.fullName}" placeholder="Full name" />
                    </td>
                    <td class="text-center align-middle">
                        <button type="button" class="btn btn-danger btn-sm remove-member-row">
                            <i class="ti ti-trash"></i>
                        </button>
                    </td>
                </tr>
            `);
        });
    }

    // ─── Formatting helpers ───────────────────────────────────────────────────

    function formatAmount(val) {
        const n = parseFloat(val);
        if (isNaN(n)) return '';
        return n.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    }

    // ─── Denomination events ──────────────────────────────────────────────────

    $('#denominationTable').on('change', '.denom-id', function () {
        const idx = $(this).closest('tr').data('idx');
        denominationRows[idx].denominationId = $(this).val();
        calculateDenomRow(idx);
        recalculateGrandTotal();
    });

    $('#denominationTable').on('input', '.denom-bags', function () {
        const idx = $(this).closest('tr').data('idx');
        denominationRows[idx].numberOfBags = $(this).val();
        calculateDenomRow(idx);
        recalculateGrandTotal();
    });

    function updateBagsAvailabilityUI(idx) {
        const row  = denominationRows[idx];
        const $row = $(`#denominationTable tbody tr[data-idx="${idx}"]`);
        if (!$row.length) return;

        const hasMax  = !isOnlineType() && row.maxBags !== undefined && row.maxBags !== null;
        const bagsQty = parseInt(row.numberOfBags) || 0;
        const isOver  = hasMax && bagsQty > row.maxBags;

        $row.find('.denom-bags').toggleClass('is-invalid', isOver);
        const $hint = $row.find('.form-text');
        if (hasMax) {
            $hint.text(`Available: ${Number(row.maxBags).toLocaleString()} bag(s)`)
                 .toggleClass('text-danger', isOver)
                 .toggleClass('text-muted', !isOver);
        }
    }

    function calculateDenomRow(idx) {
        const row  = denominationRows[idx];
        const $row = $(`#denominationTable tbody tr[data-idx="${idx}"]`);
        if (!$row.length) return;

        const denom = denominationOptions.find(d => String(d.id) === String(row.denominationId));
        const qty   = parseInt(row.numberOfBags) || 0;

        updateBagsAvailabilityUI(idx);

        if (!denom || qty === 0) {
            denominationRows[idx].amount = '';
            $row.find('.denom-amount').val('');
            return;
        }

        // Online: amount = face value × number of notes
        // Other:  amount = pieces per bag × face value × number of bags
        const amount = isOnlineType()
            ? denom.value * qty
            : denom.piecesInBox * denom.value * qty;
        denominationRows[idx].amount = amount;
        $row.find('.denom-amount').val(formatAmount(amount));
    }

    $('#addDenominationRow').on('click', function () {
        denominationRows.push({ denominationId: '', numberOfBags: '', amount: '' });
        renderDenominationTable();
    });

    $('#denominationTable').on('click', '.remove-denom-row', function () {
        const idx = $(this).closest('tr').data('idx');
        if (denominationRows.length > 1) {
            denominationRows.splice(idx, 1);
            renderDenominationTable();
        }
    });

    function recalculateGrandTotal() {
        const grand = denominationRows.reduce((sum, r) => sum + (parseFloat(r.amount) || 0), 0);
        $('#grandTotalAmount').val(formatAmount(grand));
    }

    // ─── Member events ────────────────────────────────────────────────────────

    $('#addMemberRow').on('click', function () {
        memberRows.push({ idNumber: '', fullName: '' });
        renderMembersTable();
    });

    $('#membersTable').on('input', '.member-id-number', function () {
        const idx = $(this).closest('tr').data('idx');
        memberRows[idx].idNumber = $(this).val();
    });

    $('#membersTable').on('input', '.member-full-name', function () {
        const idx = $(this).closest('tr').data('idx');
        memberRows[idx].fullName = $(this).val();
    });

    $('#membersTable').on('click', '.remove-member-row', function () {
        const idx = $(this).closest('tr').data('idx');
        if (memberRows.length > 1) {
            memberRows.splice(idx, 1);
            renderMembersTable();
        }
    });

    // ─── AJAX Submit ──────────────────────────────────────────────────────────

    $('#destructionRequestForm').on('submit', function (e) {
        e.preventDefault();

        const $submitBtn = $('#submitBtn');

        const errors = [];

        const authId          = parseInt($('#destructionAuthorizationId').val()) || 0;
        const destructionType = parseInt($('#destructionTypeId').val()) || 0;
        const branch          = parseInt($('#branchId').val()) || 0;
        const refNumber       = $('#referenceNumber').val().trim();
        const date            = $('#requestDate').val();
        const officer         = $('#verificationOfficer').val().trim();
        const validDenoms     = denominationRows.filter(r => r.denominationId !== '');

        if (!destructionType)            errors.push('Please select a Destruction Type.');
        if (!branch)                     errors.push('Please select a Branch.');
        if (!isOnlineType() && !authId)  errors.push('Please select a Destruction Authorization.');
        if (!refNumber)                  errors.push('Reference Number is required.');
        if (!date)                       errors.push('Date is required.');
        if (!officer)                    errors.push('Verification Officer is required.');
        if (!validDenoms.length)         errors.push('At least one denomination must be added.');
        if (isOffsiteType() && !(parseInt($('#destructionLocationId').val()) || 0))
                                         errors.push('Location is required for Offsite destruction.');

        // Destruction Committee — each added row must be fully filled, and at least 2 members are required
        let completeMemberCount = 0;
        memberRows.forEach((r, i) => {
            const hasId   = r.idNumber.trim() !== '';
            const hasName = r.fullName.trim() !== '';
            if (hasId && !hasName)  errors.push(`Committee member row ${i + 1}: Full Name is required.`);
            if (!hasId && hasName)  errors.push(`Committee member row ${i + 1}: ID Number is required.`);
            if (hasId && hasName)   completeMemberCount++;
        });
        if (completeMemberCount < 2) errors.push('At least 2 Destruction Committee members are required.');

        // Bags/amount validation against what's actually still remaining on the authorization (skip for Online)
        if (!isOnlineType()) {
            for (const row of validDenoms) {
                const remaining = remainingFor(authId, row.denominationId);
                if (!remaining) continue;

                const bagsQty = parseInt(row.numberOfBags) || 0;
                if (bagsQty > remaining.remainingBags) {
                    errors.push(`Number of bags for a denomination exceeds the remaining available bags of ${remaining.remainingBags.toLocaleString()}.`);
                    break;
                }
                if (parseFloat(row.amount) > remaining.remainingAmount) {
                    errors.push(`Amount for a denomination exceeds the remaining authorized amount of ${remaining.remainingAmount.toLocaleString()}.`);
                    break;
                }
            }
        }

        if (errors.length) {
            $('#formAlerts').html(
                '<div class="alert alert-danger alert-dismissible fade show"><ul class="mb-0">' +
                errors.map(e => `<li>${e}</li>`).join('') +
                '</ul><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>'
            );
            $submitBtn.prop('disabled', false).html('<i class="ti ti-check me-1"></i>Save');
            return;
        }

        const payload = {
            DestructionAuthorizationId: authId || null,
            DestructionTypeId:          destructionType,
            DestructionLocationId:      parseInt($('#destructionLocationId').val()) || null,
            BranchId:                   branch,
            ReferenceNumber:            refNumber,
            Date:                       date,
            VerificationOfficerUserId:  officer,
            Denominations: denominationRows
                .filter(r => r.denominationId !== '')
                .map(r => ({
                    DenominationId: parseInt(r.denominationId) || 0,
                    NumberOfBags:   isOnlineType() ? null : (r.numberOfBags || null),
                    NumberOfNotes:  isOnlineType() ? (r.numberOfBags || null) : null,
                    Amount:         parseFloat(r.amount) || 0
                })),
            Members: memberRows
                .filter(r => r.idNumber !== '' || r.fullName !== '')
                .map(r => ({
                    IDNumber:  r.idNumber,
                    FullName:  r.fullName
                }))
        };

        $submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Saving...');
        $('#formAlerts').empty();

        $.ajax({
            url:         '@Url.Action("Create")',
            type:        'POST',
            contentType: 'application/json',
            data:        JSON.stringify(payload),
            success: function (response) {
                if (response && response.redirectUrl) {
                    window.location.href = response.redirectUrl;
                    return;
                }
                if (response && response.success === true) {
                    $('#formAlerts').html(
                        '<div class="alert alert-success alert-dismissible fade show">' +
                        '<i class="ti ti-check me-1"></i>Destruction request saved successfully.' +
                        '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>'
                    );
                    // Reset state
                    denominationRows = [{ denominationId: '', numberOfBags: '', amount: '' }];
                    memberRows       = [{ idNumber: '', fullName: '' }];
                    $('#destructionTypeId').val('');
                    $('#referenceNumber').val('');
                    $('#requestDate').val('');
                    $('#verificationOfficer').val('');
                    renderDenominationTable();
                    renderMembersTable();
                    return;
                }
                if (response && response.errors) {
                    let html = '<div class="alert alert-danger alert-dismissible fade show"><ul class="mb-0">';
                    Object.values(response.errors).forEach(msg => { html += `<li>${msg}</li>`; });
                    html += '</ul><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>';
                    $('#formAlerts').html(html);
                }
            },
            error: function (xhr) {
                console.error('Submission error:', xhr.status, xhr.statusText, xhr.responseText);
                let html = '<div class="alert alert-danger alert-dismissible fade show"><ul class="mb-0">';

                if (xhr.responseJSON) {
                    const errors = xhr.responseJSON;
                    if (errors.message) {
                        html += `<li>${errors.message}</li>`;
                    } else if (errors.errors) {
                        for (let key in errors.errors) {
                            (errors.errors[key] || []).forEach(e => { html += `<li>${e}</li>`; });
                        }
                    } else {
                        for (let key in errors) {
                            if (Array.isArray(errors[key])) {
                                errors[key].forEach(e => { html += `<li>${e}</li>`; });
                            } else if (typeof errors[key] === 'string') {
                                html += `<li>${errors[key]}</li>`;
                            }
                        }
                    }
                } else {
                    html += `<li>Unexpected error: ${xhr.status} ${xhr.statusText}</li>`;
                }

                html += '</ul><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>';
                $('#formAlerts').html(html);
            },
            complete: function () {
                $submitBtn.prop('disabled', false).html('<i class="ti ti-check me-1"></i>Save');
            }
        });
    });

    // ─── Init ─────────────────────────────────────────────────────────────────

    $('#requestDate').val(new Date().toISOString().split('T')[0]);
    renderDenominationTable();
    renderMembersTable();

});
</script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
