@model VMSService.Core.Models.CbDepositRequests.DepositStepViewModel

<div class="dash-hero mb-4">

    @*Requestor status banner*@
    @if (Model.IsInProgress)
    {
        <div class="d-flex align-items-center gap-2 text-white-50 mb-3">
            <i class="ti ti-clock-hour-4 fs-5"></i>
            <span>Your request has been submitted and is currently being processed by BOU.</span>
        </div>
    }
    @* @if (Model.IsApproved)
    {
        <div class="d-flex align-items-center gap-2 text-success mb-3">
            <i class="ti ti-circle-check fs-5"></i>
            <span>This request has been approved.</span>
        </div>
    } *@

    @*Step pills*@
    <div class="d-flex align-items-center flex-wrap gap-3">
        @{
            var visibleSteps = Model.Steps.Where(s => s.IsVisible).ToList();
        }
        @for (int i = 0; i < visibleSteps.Count; i++)
        {
            var step = visibleSteps[i];

            @* Arrow connector *@
            @if (i > 0)
            {
                <div class="step-arrow @(step.IsConnectorDone ? "done" : "")">
                    <i class="ti ti-chevron-right fs-4 @(step.IsConnectorDone ? "" : "opacity-50")"></i>
                </div>
            }

            <button class="step-pill @step.CssState"
                    @(step.IsClickable ? "" : "disabled")
                    title="@step.Label — @step.SubLabel">

                <div class="sp-icon">
                    @if (step.ShowCheckIcon)
                    {
                        <i class="ti ti-check"></i>
                    }
                    else
                    {
                        <i class="ti @step.Icon"></i>
                    }
                </div>

                <div class="d-none d-sm-block">
                    <div class="text-white">@step.Label</div>
                    <div class="text-white-50">@step.SubLabel</div>
                </div>

            </button>
        }

        @*"In progress" pill for company users while request is with the bank*@
        @if (Model.IsInProgress)
        {
            <div class="step-arrow">
                <i class="ti ti-chevron-right fs-4 opacity-50"></i>
            </div>
            <div class="step-pill wait" title="Being processed by BOU">
                <div class="sp-icon">
                    <i class="ti ti-clock-hour-4"></i>
                </div>
                <div class="d-none d-sm-block">
                    <div class="text-white">In Progress</div>
                    <div class="text-white-50">With BOU</div>
                </div>
            </div>
        }
    </div>

</div>


