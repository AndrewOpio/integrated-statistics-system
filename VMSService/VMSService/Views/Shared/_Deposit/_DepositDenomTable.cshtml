@model VMSService.Core.Models.CbDepositRequests.DepositDenomTableViewModel

<div class="card mb-4 border-top-0 border-end-0 border-bottom-0 border-4 shadow-sm" style="border-color: #b31b34">

    <div class="card-body">
        @* ?? Card Header ?? *@
        <div class="d-flex align-items-center mb-3 justify-content-between">
            <div class="d-flex align-items-center gap-2 fw-bolder">
                <i class="ti ti-cash"></i>
                <span class="text-uppercase mb-0">Deposit Denomination Details</span>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1"
                        onclick="depositDenomAddRow('notes')">
                    <i class="ti ti-circle-letter-n-filled"></i>Add Banknote
                </button>
                <button type="button" class="btn btn-sm btn-warning d-inline-flex align-items-center gap-1"
                        onclick="depositDenomAddRow('coins')">
                    <i class="ti ti-circle-letter-c-filled"></i>Add Coin
                </button>
            </div>
        </div>

        @* ?? Subcategory Legend ?? *@
        <div class="d-flex gap-3 mb-3 flex-wrap">
            <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-3 py-2">
                <i class="ti ti-check me-1"></i> Fit — Good condition banknotes
            </span>
            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-3 py-2">
                <i class="ti ti-x me-1"></i> Unfit — Worn/damaged banknotes
            </span>
            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle px-3 py-2">
                <i class="ti ti-minus me-1"></i> N/A — Not applicable (unsorted)
            </span>
        </div>

        @* ?? Banknotes ?? *@
        <div class="denom-sec">
            <div class="d-flex align-items-center justify-content-between px-4 py-2 bg-light">
                <div class="d-flex align-items-center gap-2 text-uppercase fw-bold">
                    <i class="ti ti-circle-letter-n-filled text-primary"></i>Banknotes
                </div>
                <span class="fw-bold small text-primary" id="dep-denom-note-sub">UGX 0</span>
            </div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <colgroup>
                        <col style="width:22%">
                        <col style="width:18%">
                        <col style="width:25%">
                        <col style="width:20%">
                        <col style="width:15%">
                    </colgroup>
                    <thead class="small text-muted">
                        <tr>
                            <th class="px-4 py-2">DENOMINATION</th>
                            <th class="px-4 py-2">SUBCATEGORY</th>
                            <th class="px-4 py-2 text-end">AMOUNT</th>
                            <th class="px-4 py-2 text-end">NO. OF BUNDLES</th>
                            <th class="text-center">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody id="dep-denom-notes-body">
                        <tr class="denom-empty-row">
                            <td colspan="5" class="text-center py-3 text-muted small">No banknotes added</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        @* ?? Coins (always N/A subcategory) ?? *@
        <div class="denom-sec">
            <div class="d-flex align-items-center justify-content-between mt-3 px-4 py-2 bg-light">
                <div class="d-flex align-items-center gap-2 text-uppercase fw-bold">
                    <i class="ti ti-circle-letter-c-filled text-warning"></i> Coins
                    <span class="badge bg-secondary bg-opacity-10 text-secondary small ms-2">Always N/A</span>
                </div>
                <span class="fw-bold small text-warning" id="dep-denom-coin-sub">UGX 0</span>
            </div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <colgroup>
                        <col style="width:30%">
                        <col style="width:30%">
                        <col style="width:25%">
                        <col style="width:15%">
                    </colgroup>
                    <thead class="small text-secondary">
                        <tr>
                            <th class="px-4 py-2">DENOMINATION</th>
                            <th class="px-4 py-2 text-end">AMOUNT</th>
                            <th class="px-4 py-2 text-end">NO. OF BOXES</th>
                            <th class="text-center">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody id="dep-denom-coins-body">
                        <tr class="denom-empty-row">
                            <td colspan="4" class="text-center py-3 text-muted small">No coins added</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        @*Sub-Totals by Category*@
        <div class="mt-3">
            <div class="d-flex justify-content-between align-items-center px-4 py-2 border-bottom">
                <span class="d-flex align-items-center gap-2 small fw-semibold text-success">
                    <i class="ti ti-check"></i> Fit Banknotes
                </span>
                <span class="fw-bold text-success" id="dep-t-fit">UGX 0</span>
            </div>
            <div class="d-flex justify-content-between align-items-center px-4 py-2 border-bottom">
                <span class="d-flex align-items-center gap-2 small fw-semibold text-danger">
                    <i class="ti ti-x"></i> Unfit Banknotes
                </span>
                <span class="fw-bold text-danger" id="dep-t-unfit">UGX 0</span>
            </div>
            <div class="d-flex justify-content-between align-items-center px-4 py-2 border-bottom">
                <span class="d-flex align-items-center gap-2 small fw-semibold text-primary">
                    <i class="ti ti-circle-letter-n-filled"></i> Total Banknotes
                </span>
                <span class="fw-bold text-primary" id="dep-t-notes">UGX 0</span>
            </div>
            <div class="d-flex justify-content-between align-items-center px-4 py-2">
                <span class="d-flex align-items-center gap-2 small fw-semibold text-warning">
                    <i class="ti ti-circle-letter-c-filled"></i> Total Coins
                </span>
                <span class="fw-bold text-warning" id="dep-t-coins">UGX 0</span>
            </div>
        </div>

        @*Grand Total*@
        <div class="denom-grand rounded px-4 py-3">
            <div class="d-flex justify-content-between align-items-baseline mb-2">
                <span class="text-uppercase fw-bold text-white fs-6 opacity-75"
                      style="letter-spacing:.07em;">Grand Total</span>
                <span class="fw-bold text-white" style="font-size:20px;" id="dep-g-val">UGX 0</span>
            </div>
            <div class="border-top pt-2 fs-6 fst-italic text-end text-white opacity-75" style="border-color:rgba(255,255,255,.2)!important;">
                <span id="dep-g-words">Zero shillings only</span>
            </div>
        </div>

    </div>
</div>