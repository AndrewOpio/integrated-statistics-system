                                        <a asp-controller="MonthlyShortages" asp-action="Index" class="nav-link">
                                            <span class="sidebar-text">Monthly Discrepancies</span>
                                        </a>
                                    </permission>
                                </li>
                                <permission name="@SystemPermissions.MonthlyShortageReimbursements.View">
                                    <li class="nav-item">
                                        <a asp-controller="MonthlyShortageReimbursements" asp-action="Index" class="nav-link">
                                            <span class="sidebar-text">Reimbursements</span>
                                        </a>
