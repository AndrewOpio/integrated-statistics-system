@{
    // var userRoles = User.FindAll("appRole").Select(c => c.Value);
    var userRoles = string.Join(", ", User.FindAll("appRole").Where(c => c.Value.StartsWith("VMS:")).Select(c => c.Value.Split(":")[1]).ToList());
    bool isAdmin = userRoles.Contains(SystemPolicy.Roles.Admin);
    bool isCurrencyApprover = userRoles.Contains(SystemPolicy.Roles.CurrencyApprover);
    bool isContractManager = userRoles.Contains(SystemPolicy.Roles.ContractManager);
    bool isStockVerifier = userRoles.Contains(SystemPolicy.Roles.StockVerifier);
    bool isStockApprover = userRoles.Contains(SystemPolicy.Roles.StockApprover);
    
    bool isRemittancesOfficer = userRoles.Contains(SystemPolicy.Roles.RemittancesOfficer);
    bool isHeadOfBackOffice = userRoles.Contains(SystemPolicy.Roles.HeadBackOffice);
    bool isBranchManager = userRoles.Contains(SystemPolicy.Roles.StockApprover);
    bool isAssistantBranchManager = userRoles.Contains(SystemPolicy.Roles.StockVerifier);

    // bool isCommercialBank = userRoles.Contains("VMS:Commercial Bank");
    // bool isStockReceiver = userRoles.Contains("VMS:StockReceiver");
    // bool isStockManager = userRoles.Contains("VMS:StockManager");
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <!-- Primary Meta Tags -->
    <title>VMS - @ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no">
    <link rel="stylesheet" href="~/css/tabler-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dataTables.dataTables.css" asp-append-version="true" />
    <!-- Volt CSS -->
    <link type="text/css" href="../../css/volt.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <nav class="navbar navbar-dark navbar-theme-primary px-4 col-12 d-lg-none">
        <a asp-controller="Home" asp-action="Index" class="navbar-brand me-lg-5">
            <img class="navbar-brand-dark" src="../../img/bou.png" alt="BOU logo">
            <img class="navbar-brand-light" src="../../img/bou.png" alt="BOU logo">
            <span>Vault Management System</span>
        </a>
        <div class="d-flex align-items-center">
            <button class="navbar-toggler d-lg-none collapsed" type="button"
                    data-bs-toggle="collapse" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu" aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>
    </nav>
    <nav id="sidebarMenu" class="sidebar d-lg-block bg-crimson text-white collapse" data-simplebar>
        <div class="sidebar-inner px-4 pt-3">
            <div class="user-card d-flex d-md-none align-items-center justify-content-between justify-content-md-center pb-4">
                <div class="d-flex align-items-center">
                    <div class="d-flex align-items-center me-4"><i class="ti ti-user-filled fs-6 text-gray-900"></i></div>
                    <div class="d-block">
                        <h2 class="h5 mb-3">Hi, @User.Identity?.Name</h2>
                        <a href="/Home/Logout" class="btn btn-secondary btn-sm d-inline-flex align-items-center">
                            <svg class="icon icon-xxs me-1"
                                 fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                            </svg> Sign Out
                        </a>
                    </div>
                </div>
                <div class="collapse-close d-md-none">
                    <a href="#sidebarMenu" data-bs-toggle="collapse"
                       data-bs-target="#sidebarMenu" aria-controls="sidebarMenu" aria-expanded="true"
                       aria-label="Toggle navigation">
                        <svg class="icon icon-xs" fill="currentColor" viewBox="0 0 20 20"l
                             xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd"
                                  d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                                  clip-rule="evenodd"></path>
                        </svg>
                    </a>
                </div>
            </div>
            <ul class="nav flex-column pt-3 pt-md-0">
                <li class="nav-item mt-2">
                    <div>
                        <div class="d-flex justify-content-center">
                            <img src="../../img/bou.png" height="50" width="50" alt="BOU Logo">
                        </div>
                        <div class="align-items-center">
                            <span class="mt-3 ms-1 sidebar-text">Vault Management System</span>
                        </div>
                    </div>
                </li>
                <li role="separator" class="dropdown-divider mt-4 mb-3"></li>
                <li class="nav-item active">
                    <a asp-controller="Home" asp-action="Index" class="nav-link d-flex align-items-center">
                        <span class="sidebar-icon fs-5 me-4">
                            <i class="ti ti-chart-pie-filled"></i>
                        </span>
                        <span class="sidebar-text">Dashboard</span>
                    </a>
                </li>
                @if (isContractManager || isCurrencyApprover || isStockVerifier || isStockApprover)
                {
                    <li class="nav-item">
                        <a asp-controller="ExPrintMints" asp-action="Index" class="nav-link d-flex align-items-center">
                            <span class="sidebar-icon fs-5 me-4">
                                <i class="ti ti-cash-banknote-move"></i>
                            </span>
                            <span class="sidebar-text">Expected Stock</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="ReceivedStocks" asp-action="Index" class="nav-link d-flex align-items-center">
                            <span class="sidebar-icon fs-5 me-4">
                                <i class="ti ti-cash-banknote-plus"></i>
                            </span>
                            <span class="sidebar-text">Received Stock</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="ApprovedCurrencyProcurements" asp-action="Index" class="nav-link d-flex align-items-center">
                            <span class="sidebar-icon fs-5 me-4">
                                <i class="ti ti-currency"></i>
                            </span>
                            <span class="sidebar-text">Approved Procurements</span>
                        </a>
                    </li>
                }


                @if (isRemittancesOfficer || isCurrencyApprover || isBranchManager || isAssistantBranchManager || isHeadOfBackOffice)
                {
                    <li class="nav-item">
                        <a asp-controller="StockMovement" asp-action="Index" class="nav-link d-flex align-items-center">
                            <span class="sidebar-icon fs-5 me-4">
                                <i class="ti ti-cash-banknote-move"></i>
                            </span>
                            <span class="sidebar-text">Stock Movement</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-controller="CbDepositRequests" asp-action="Create" target="_blank" class="nav-link d-flex align-items-center">
                            <span class="sidebar-icon fs-5 me-4">
                                <i class="ti ti-circle-arrow-down-left-filled"></i>
                            </span>
                            <span class="sidebar-text">Deposits</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="AgentDetails" asp-action="Index" target="_blank" class="nav-link d-flex align-items-center">
                            <span class="sidebar-icon fs-5 me-4">
                                <i class="ti ti-user-square-rounded"></i>
                            </span>
                            <span class="sidebar-text">Agent Details</span>
                        </a>
                    </li>
                }

                @if (isAdmin)
                {
                    <li class="nav-item">
                        <span class="nav-link collapsed d-flex justify-content-between align-items-center"
                              data-bs-toggle="collapse" data-bs-target="#submenu-app">
                            <span class="d-flex align-items-center">
                                <span class="sidebar-icon fs-5 me-4">
                                    <i class="ti ti-settings"></i>
                                </span>
                                <span class="sidebar-text">Stock Settings</span>
                            </span>
                            <span class="link-arrow">
                                <svg class="icon icon-sm" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                    <path fill-rule="evenodd"
                                          d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                          clip-rule="evenodd"></path>
                                </svg>
                            </span>
                        </span>
                        <div class="multi-level collapse" role="list" id="submenu-app" aria-expanded="false">
                            <ul class="flex-column nav">
                                <li class="nav-item">
                                    <a asp-controller="DenominationTypes" asp-action="Index" class="nav-link">
                                        <span class="sidebar-text">Denomination Types</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Denominations" asp-action="Index" class="nav-link">
                                        <span class="sidebar-text">Denomination</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="CounterPartyTypes" asp-action="Index" class="nav-link">
                                        <span class="sidebar-text">Counter Party Types</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Categories" asp-action="Index" class="nav-link">
                                        <span class="sidebar-text">Currency Categories</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="BranchCategories" asp-action="Index" class="nav-link">
                                        <span class="sidebar-text">Vault Stores</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>
                    <li class="nav-item">
                        <span class="nav-link collapsed d-flex justify-content-between align-items-center"
                              data-bs-toggle="collapse" data-bs-target="#submenu1-app">
                            <span class="d-flex align-items-center">
                                <span class="sidebar-icon fs-5 me-4">
                                    <i class="ti ti-settings"></i>
                                </span>
                                <span class="sidebar-text">VMS Settings</span>
                            </span>
                            <span class="link-arrow">
                                <svg class="icon icon-sm" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                    <path fill-rule="evenodd"
                                          d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                          clip-rule="evenodd"></path>
                                </svg>
                            </span>
                        </span>
                        <div class="multi-level collapse" role="list" id="submenu1-app" aria-expanded="false">
                            <ul class="flex-column nav">
                                <li class="nav-item">
                                    <a asp-controller="VendorTypes" asp-action="Index" class="nav-link">
                                        <span class="sidebar-text">Vendor Types</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="CurrencyVendors" asp-action="Index" class="nav-link">
                                        <span class="sidebar-text">Currency Vendors</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="CommercialBankUsers" asp-action="Index" class="nav-link">
                                        <span class="sidebar-text">Commercial Bank Users</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>
                }
                
                <li role="separator" class="dropdown-divider mt-4 mb-3"></li>
                <li class="nav-item">
                    <a asp-controller="Home" asp-action="About" class="nav-link d-flex align-items-center">
                        <span class="sidebar-icon">
                            <svg class="icon icon-xs me-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd"
                                      d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z"
                                      clip-rule="evenodd"></path>
                            </svg>
                        </span><span class="sidebar-text">About</span>
                    </a>
                </li>
            </ul>
        </div>
    </nav>
    <main class="content min-h-100">
        <nav class="navbar navbar-top navbar-expand navbar-dashboard navbar-dark ps-0 pe-2 pb-0 pt-1">
            <div class="container-fluid px-0">
                <div class="d-flex justify-content-between w-100" id="navbarSupportedContent">
                    <div class="d-flex align-items-center">
                        <breadcrumb class="mt-3 me-3"></breadcrumb>
                    </div>
                    <!-- Navbar links -->
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item d-flex align-items-center d-flex align-items-center">
                            <a class="btn btn-sm btn-outline-secondary me-2" href="@Configuration["MicroServices:gatewayservice"]"><i class="ti ti-home me-2 fs-6"></i>Go To Aswam Home</a>
                        </li>
                        <li class="nav-item dropdown ms-lg-3">
                            <a class="nav-link dropdown-toggle pt-1 px-0" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="media d-flex align-items-center">
                                    <div class="media-body text-dark align-items-center d-none d-lg-block">
                                        <span class="mb-0 font-small text-gray-900 me-3">Welcome, @User.Identity?.Name</span>
                                    </div>
                                    <div class="d-flex align-items-center"><i class="ti ti-user-filled fs-6 text-gray-900"></i></div>
                                </div>
                            </a>
                            <div class="dropdown-menu dashboard-dropdown dropdown-menu-end mt-2 p-3">
                                <table class="table table-borderless table-sm mb-0">
                                    <tbody>
                                        <tr>
                                            <td><i class="ti ti-user fs-6"></i></td>
                                            <td>Name:</td>
                                            <td><b>@User.FindFirst("DisplayName")?.Value</b></td>
                                        </tr>
                                        <tr>
                                            <td><i class="ti ti-shield fs-6"></i></td>
                                            <td>Roles:</td>
                                            <td>@string.Join(", ", User.FindAll("appRole").Where(c => c.Value.StartsWith("VMS:")).Select(c => c.Value.Split(":")[1]).ToList())</td>
                                        </tr>
                                    </tbody>
                                </table>
                                <a asp-controller="Home" asp-action="Logout" class="btn btn-outline-danger btn-sm mt-2 w-100">Logout</a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        <div class="container-fluid pt-3">
            @if (TempData["Success"] != null)
            {
                <div>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                </div>
            }
            @RenderBody()
        </div>
        
    </main>
    <!-- Core -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="../../vendor/bootstrap/dist/js/bootstrap.min.js"></script>
    <!-- Vanilla JS Datepicker -->
    <script src="../../vendor/vanillajs-datepicker/dist/js/datepicker.min.js"></script>
    <!-- Simplebar -->
    <script src="../../vendor/simplebar/dist/simplebar.min.js"></script>
    <script src="~/js/dataTables.js"></script>
    <!-- Volt JS -->
    <script src="../../js/volt.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>