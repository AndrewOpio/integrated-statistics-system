                                        <a asp-controller="MonthlySurpluses" asp-action="CheckPosition" class="nav-link">
                                            <span class="sidebar-text">Check Net Position</span>
                                        </a>
                                    </li>
                                </permission>
                                <li class="nav-item">
                                    <a asp-controller="MonthlySurpluses" asp-action="Index" class="nav-link">
