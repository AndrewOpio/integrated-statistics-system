@{
    // var userRoles = User.FindAll("appRole").Select(c => c.Value);
    var userRoles = string.Join(", ", User.FindAll("appRole").Where(c => c.Value.StartsWith($"{SystemPolicy.SystemSettings.AppAcronym}:")).Select(c => c.Value.Split(":")[1]).ToList());
    bool isAdmin = userRoles.Contains(SystemPolicy.Roles.Admin);
    bool isCurrencyApprover = userRoles.Contains(SystemPolicy.Roles.CurrencyApprover);
    bool isContractManager = userRoles.Contains(SystemPolicy.Roles.ContractManager);
    bool isStockVerifier = userRoles.Contains(SystemPolicy.Roles.StockVerifier);
    bool isStockApprover = userRoles.Contains(SystemPolicy.Roles.StockApprover);
    
    bool isRemittancesOfficer = userRoles.Contains(SystemPolicy.Roles.RemittancesOfficer);
    bool isHeadOfBackOffice = userRoles.Contains(SystemPolicy.Roles.HeadBackOffice);
    bool isBackOffice = userRoles.Contains(SystemPolicy.Roles.BackOffice);
    bool isBranchManager = userRoles.Contains(SystemPolicy.Roles.StockApprover);
    bool isAssistantBranchManager = userRoles.Contains(SystemPolicy.Roles.StockVerifier) || userRoles.Contains(SystemPolicy.Roles.AssistantBranchManager);
    bool isPanelA = userRoles.Contains(SystemPolicy.Roles.PanelA);
    bool isPanelB = userRoles.Contains(SystemPolicy.Roles.PanelB);
    bool isVO = userRoles.Contains(SystemPolicy.Roles.VerificationOfficer);
    bool isBoardSupervisor = userRoles.Contains(SystemPolicy.Roles.BoardSupervisor);
    bool isCfbSupervisor = userRoles.Contains(SystemPolicy.Roles.CfbSupervisor);
    bool isVerificationOfficer = userRoles.Contains(SystemPolicy.Roles.VerificationOfficer);
    bool isTreasury = userRoles.Contains(SystemPolicy.Roles.Treasury);

    // bool isCommercialBank = userRoles.Contains($"{SystemSettings.AppAcronym}:Commercial Bank");
    // bool isStockReceiver = userRoles.Contains($"{SystemSettings.AppAcronym}:StockReceiver");
    // bool isStockManager = userRoles.Contains($"{SystemSettings.AppAcronym}:StockManager");

    var userRoleList = User.FindAll("appRole")
        .Where(c => c.Value.StartsWith($"{SystemPolicy.SystemSettings.AppAcronym}:"))
        .Select(c => c.Value.Split(":")[1])
        .Distinct().ToList();
    var displayName = User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "";
    var initials = string.Concat(
        displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                   .Take(2).Select(w => char.ToUpper(w[0]).ToString()));
    if (string.IsNullOrEmpty(initials) && !string.IsNullOrEmpty(User.Identity?.Name))
        initials = char.ToUpper(User.Identity.Name[0]).ToString();
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <!-- Primary Meta Tags -->
    <title>CAS - @ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no">
    <link rel="stylesheet" href="~/css/tabler-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dataTables.dataTables.css" asp-append-version="true" />
    <!-- Volt CSS -->
    <link type="text/css" href="../../css/volt.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

