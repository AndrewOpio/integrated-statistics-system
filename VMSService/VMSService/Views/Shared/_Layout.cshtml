                <permission name="@SystemPermissions.EndOfDayDiscrepancies.View">
                    <li class="nav-item">
                        <a asp-controller="EndOfDayDiscrepancies" asp-action="Index" class="nav-link d-flex align-items-center">
                            <span class="sidebar-icon fs-5 me-4">
                                <i class="ti ti-scale"></i>
                            </span>
                            <span class="sidebar-text">EOD Discrepancies</span>
                        </a>
                    </li>
                </permission>
                <permission name="@SystemPermissions.MonthlySurpluses.View">
                    <li class="nav-item">
                        <span class="nav-link collapsed d-flex justify-content-between align-items-center"
                              data-bs-toggle="collapse" data-bs-target="#submenu-monthly-settlements">
                            <span class="d-flex align-items-center">
                                <span class="sidebar-icon fs-5 me-4">
                                    <i class="ti ti-report-money"></i>
                                </span>
                                <span class="sidebar-text">Monthly Settlements</span>
                            </span>
                            <span class="link-arrow">
                                <svg class="icon icon-sm" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                    <path fill-rule="evenodd"
                                          d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                          clip-rule="evenodd"></path>
                                </svg>
                            </span>
                        </span>
                        <div class="multi-level collapse" role="list" id="submenu-monthly-settlements" aria-expanded="false">
                            <ul class="flex-column nav">
                                <permission name="@SystemPermissions.MonthlySurpluses.CheckPosition">
