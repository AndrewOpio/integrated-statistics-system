<div class="modal fade" id="editDispatchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <form id="editDispatchForm"
                  method="post"
                  asp-action="SaveBankDenominations"
                  asp-route-id="@Model.Id"
                  class="d-flex flex-column overflow-hidden"
                  style="max-height: 100%;">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Edit Dispatch Denominations</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body" style="overflow-y: auto;">

                    @* Wishlist reference strip *@
                    <div class="rounded-3 p-3 mb-3 bg-light border">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-uppercase fw-bold">
                                Commercial Bank Total
                            </span>
                            <span class="fw-bold">UGX @Model.TotalAmount.ToString("N0")</span>
                        </div>
                    </div>

                    @* Variance indicator *@
                    <div id="varianceIndicator" class="rounded-3 p-3 mb-3 border"
                         data-wishlist-total="@Model.TotalAmount">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-uppercase small fw-semibold">Bank Total</span>
                            <span class="fw-bold" id="bankGrandTotal">UGX 0</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <span class="text-uppercase small fw-semibold">Variance</span>
                            <span class="fw-bold" id="varianceAmount">UGX 0</span>
                        </div>
                    </div>

                    @* NEW BANKNOTES *@
                    <div class="border rounded-3 mb-3 overflow-hidden">
                        <div class="px-3 py-2 border-bottom d-flex justify-content-between align-items-center bg-light">
                            <span class="text-uppercase fw-semibold small">New Banknotes</span>
                            <div class="d-flex align-items-center gap-2">
                                <span class="small fw-semibold text-primary" id="newSubtotal">UGX 0</span>
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        onclick="addDispatchRow('new')">
                                    <i class="ti ti-plus"></i> Add
                                </button>
                            </div>
                        </div>
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="small text-muted">
                                <tr>
                                    <th class="ps-3">DENOMINATION</th>
                                    <th>BOX RANGES</th>
                                    <th class="text-end">BUNDLES</th>
                                    <th class="text-end">AMOUNT</th>
                                    <th class="text-center">ACTIONS</th>
                                </tr>
                            </thead>
                            <tbody id="newBanknotesBody"></tbody>
                        </table>
                    </div>

                    @* REISSUE BANKNOTES *@
                    <div class="border rounded-3 mb-3 overflow-hidden">
                        <div class="px-3 py-2 border-bottom d-flex justify-content-between align-items-center bg-light">
                            <span class="text-uppercase fw-semibold small">Reissue Banknotes</span>
                            <div class="d-flex align-items-center gap-2">
                                <span class="small fw-semibold text-primary" id="reissueSubtotal">UGX 0</span>
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        onclick="addDispatchRow('reissue')">
                                    <i class="ti ti-plus"></i> Add
                                </button>
                            </div>
                        </div>
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="small text-muted">
                                <tr>
                                    <th class="ps-3">DENOMINATION</th>
                                    <th class="text-end">BUNDLES</th>
                                    <th class="text-end">AMOUNT</th>
                                    <th class="text-center">ACTIONS</th>
                                </tr>
                            </thead>
                            <tbody id="reissueBanknotesBody"></tbody>
                        </table>
                    </div>

                    @* COINS *@
                    <div class="border rounded-3 mb-3 overflow-hidden">
                        <div class="px-3 py-2 border-bottom d-flex justify-content-between align-items-center bg-light">
                            <span class="text-uppercase fw-semibold small">Coins</span>
                            <div class="d-flex align-items-center gap-2">
                                <span class="small fw-semibold text-warning" id="coinSubtotal">UGX 0</span>
                                <button type="button" class="btn btn-sm btn-outline-warning"
                                        onclick="addDispatchRow('coin')">
                                    <i class="ti ti-plus"></i> Add
                                </button>
                            </div>
                        </div>
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="small text-muted">
                                <tr>
                                    <th class="ps-3">DENOMINATION</th>
                                    <th class="text-end">BOXES</th>
                                    <th class="text-end">AMOUNT</th>
                                    <th class="text-center">ACTIONS</th>
                                </tr>
                            </thead>
                            <tbody id="coinsBody"></tbody>
                        </table>
                    </div>

                    <input type="hidden" name="payload" id="dispatchPayload" />
                    <input type="hidden" name="actionName" value="Save Bank Draft" />
                    <input type="hidden" name="remarks" id="dispatchRemarks" value="" />
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-device-floppy me-1"></i>Save Draft
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
