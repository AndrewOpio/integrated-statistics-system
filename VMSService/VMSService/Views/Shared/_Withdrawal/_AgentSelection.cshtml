@model VMSService.Core.Models.CbRequests.AgentSelectionViewModel


<p class="text-uppercase text-muted small fw-semibold mb-3">Agent Details</p>

<div class="card mb-4">
    <div class="card-body">

        <div class="mb-4">
            <div class="row g-4">
                @for (int i = 1; i <= 2; i++)
                {
                    <div class="col-md-6">
                        <label class="form-label">Agent @i</label>
                        <select id="agentSelect@(i)"
                                name="agentIds[@(i - 1)]"
                                class="form-select mb-3"
                                onchange="loadAgentDetails(@i, this.value)">
                            <option value="">— Select Agent @i —</option>
                            @foreach (var c in Model.Agents)
                            {
                                <option value="@c.Id">@c.AgentNames</option>
                            }
                        </select>

                        @* ID Card *@
                        <div id="agentCard@(i)" style="display:none;">
                            <p class="text-uppercase text-muted small fw-semibold mb-2">ID Cards</p>
                            <div class="card rounded-3 shadow overflow-hidden border-0">

                                @* ── Header ── *@
                                <div class="card-header d-flex justify-content-between align-items-center"
                                     style="background-color:#1a2e5a;">
                                    <div>
                                        <p class="text-white fw-bold small mb-0 text-uppercase ls-wide">Agent Details</p>
                                        <p class="text-white-50 mb-0" style="font-size:9px;">OFFICIAL USE ONLY</p>
                                    </div>
                                </div>

                                @* ── Body ── *@
                                <div class="card-body p-3">
                                    <div class="d-flex gap-3">

                                        @* Photo *@
                                        <div class="flex-shrink-0 text-center">
                                            <div class="bg-light border rounded-2 d-flex align-items-center justify-content-center overflow-hidden"
                                                 style="width:118px;height:100px;">
                                                <img id="agentPhoto@(i)"
                                                     src="" alt="Photo"
                                                     class="img-fluid"
                                                     style="width:118px;height:100px;object-fit:cover;display:none;" />
                                                <i id="agentPhotoPlaceholder@(i)"
                                                   class="ti ti-user text-muted fs-2"></i>
                                            </div>
                                        </div>

                                        @* Name + Company *@
                                        <div class="flex-grow-1">
                                            <p class="text-muted mb-0" style="font-size:9px;">FULL NAME</p>
                                            <p class="fw-bold mb-1" id="agentNames@(i)"></p>
                                            <p class="text-primary small mb-0" id="agentCompany@(i)"></p>
                                            <p class="text-primary small mb-0" id="agentBranch@(i)"></p>
                                        </div>

                                        @* Work ID Scan *@
                                        <div class="flex-shrink-0">
                                            <p class="text-muted mb-1" style="font-size:9px;">WORK ID SCAN</p>
                                            <div id="agentScanPlaceholder@(i)"
                                                 class="bg-light border border-dashed rounded-2 d-flex flex-column align-items-center justify-content-center p-2"
                                                 style="width:200px;min-height:200px;">
                                                <i class="ti ti-photo text-muted fs-4"></i>
                                                <span class="text-muted text-center" style="font-size:9px;">No scan uploaded</span>
                                            </div>
                                            <img id="agentWorkIdScanImg@(i)"
                                                 src="" alt="Work ID Scan"
                                                 class="rounded-2 border"
                                                 style="width:200px;min-height:200px;object-fit:contain;display:none;" />
                                        </div>

                                    </div>

                                    @* ── Security No & Work ID No ── *@
                                    <div class="row g-2 mt-3 pt-2 border-top">
                                        <div class="col-6">
                                            <p class="text-muted mb-0" style="font-size:9px;">SECURITY NO.</p>
                                            <p class="fw-semibold small mb-0" id="agentNin@(i)"></p>
                                        </div>
                                        <div class="col-6">
                                            <p class="text-muted mb-0" style="font-size:9px;">WORK ID NO.</p>
                                            <p class="fw-semibold small mb-0" id="agentWorkId@(i)"></p>
                                        </div>
                                    </div>
                                </div>

                                @* ── Signature ── *@
                                <div class="px-3 pt-2 pb-3 border-top bg-light">
                                    <p class="text-muted mb-1" style="font-size:9px;">SIGNATURE</p>
                                    <div class="bg-white border rounded-2 d-flex align-items-center justify-content-center p-2"
                                         style="height:56px;">
                                        <img id="agentSignatureScan@(i)"
                                             src="" alt="Signature"
                                             class="img-fluid"
                                             style="max-height:44px;display:none;" />
                                    </div>
                                    <p class="text-muted small mt-1 mb-0" id="agentSignatureName@(i)"></p>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>