@model VMSService.Core.Models.WithdrawalRequests.BouWithdrawalRequestDetailsViewModel

<div class="card border-start border-top-0 border-end-0 border-bottom-0 border-4 shadow-sm rounded-start-0"
     style="border-color:#791F1F!important;">
    <div class="card-body d-flex flex-column gap-3">
        <div class="d-flex justify-content-between align-items-center">
            <p class="text-uppercase text-muted fw-bold mb-3">
                <i class="ti ti-cash me-1"></i>
                @(Model.IsPostApprovalView ? "Denomination Details" : "Commercial Bank Denominations")
            </p>
            @if (!Model.IsPostApprovalView)
            {
                <span class="badge rounded-pill bg-danger text-white p-2 text-muted border small">
                    <i class="ti ti-eye me-1"></i>Read-only &middot; Awaiting Commercial Bank Approval
                </span>
            }
            @if (Model.CanEditDispatch)
            {
                <button type="button" class="btn btn-sm btn-outline-success"
                        data-bs-toggle="modal" data-bs-target="#editDispatchModal">
                    <i class="ti ti-edit me-1"></i>Edit Dispatch
                </button>
            }
        </div>
        <hr class="my-0" />

        @if (Model.IsLumpSum)
        {
            <div class="border rounded-3 overflow-hidden">
                <div class="px-3 py-2 border-bottom d-flex align-items-center gap-2">
                    <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-semibold"
                          style="width:16px;height:16px;font-size:9px;background:#fff3e0;color:#e65100;">L</span>
                    <span class="text-uppercase fw-semibold small" style="letter-spacing:.05em;">Lump Sum Amount</span>
                </div>
                <div class="d-flex justify-content-between align-items-center px-3 py-3">
                    <span class="text-muted small">Total Amount (UGX)</span>
                    <span class="fw-semibold">UGX @Model.TotalAmount.ToString("N0")</span>
                </div>
            </div>
        }
        else
        {
            @if (Model.Notes.Any())
            {
                <div class="border rounded-3 overflow-hidden">
                    <div class="px-3 py-2 border-bottom d-flex align-items-center gap-2">
                        <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-semibold"
                              style="width:16px;height:16px;font-size:9px;background:#fff3e0;color:#e65100;">N</span>
                        <span class="text-uppercase fw-semibold small" style="letter-spacing:.05em;">Banknotes</span>
                    </div>
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr class="fw-bolder">
                                <th class="ps-3" style="font-size:10px;">DENOMINATION</th>
                                <th class="text-end" style="font-size:10px;">BUNDLES</th>
                                <th class="text-end pe-3" style="font-size:10px;">AMOUNT</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @foreach (var note in Model.Notes)
                            {
                                <tr>
                                    <td class="ps-3">@note.DenominationLabel</td>
                                    <td class="text-end">@note.Bundles?.ToString("N0")</td>
                                    <td class="text-end pe-3 text-primary">UGX @note.Amount.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="small">
                            <tr class="fw-semibold">
                                <th class="ps-3 text-uppercase" colspan="2">Total Banknotes</th>
                                <th class="text-end pe-3 text-primary">UGX @Model.TotalNotesAmount.ToString("N0")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }

            @if (Model.Coins.Any())
            {
                <div class="border rounded-3 overflow-hidden">
                    <div class="px-3 py-2 border-bottom d-flex align-items-center gap-2">
                        <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-semibold"
                              style="width:16px;height:16px;font-size:9px;background:#faeeda;color:#BA7517;">C</span>
                        <span class="text-uppercase fw-semibold small" style="letter-spacing:.05em;">Coins</span>
                    </div>
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr class="fw-bolder">
                                <th class="ps-3" style="font-size:10px;">DENOMINATION</th>
                                <th class="text-end" style="font-size:10px;">BOXES</th>
                                <th class="text-end pe-3" style="font-size:10px;">AMOUNT</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @foreach (var coin in Model.Coins)
                            {
                                <tr>
                                    <td class="ps-3">@coin.DenominationLabel</td>
                                    <td class="text-end">@coin.Boxes?.ToString("N0")</td>
                                    <td class="text-end pe-3 text-warning">UGX @coin.Amount.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="small">
                            <tr class="fw-semibold">
                                <th class="ps-3 text-uppercase" colspan="2">Total Coins</th>
                                <th class="text-end pe-3 text-warning">UGX @Model.TotalCoinsAmount.ToString("N0")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }

            @if (Model.Notes.Any() && Model.Coins.Any())
            {
                <div class="border rounded-3 overflow-hidden">
                    <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                        <div class="d-flex align-items-center gap-2 fw-semibold text-secondary">
                            <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-semibold"
                                  style="width:16px;height:16px;font-size:9px;background:#fff3e0;color:#e65100;">N</span>
                            Total Banknotes
                        </div>
                        <span class="fw-semibold text-primary">UGX @Model.TotalNotesAmount.ToString("N0")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center px-3 py-2">
                        <div class="d-flex align-items-center gap-2 fw-semibold text-secondary">
                            <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-semibold"
                                  style="width:16px;height:16px;font-size:9px;background:#faeeda;color:#BA7517;">C</span>
                            Total Coins
                        </div>
                        <span class="fw-semibold text-warning">UGX @Model.TotalCoinsAmount.ToString("N0")</span>
                    </div>
                </div>
            }
        }

        <div class="rounded-3 px-4 py-3" style="background:#b31b34;">
            <div class="d-flex justify-content-between align-items-baseline mb-1">
                <span class="text-uppercase small text-white opacity-75" style="letter-spacing:.07em;">
                    @(Model.IsPostApprovalView ? "Grand Total" : "Wishlist Total")
                </span>
                <span class="fw-medium text-white" style="font-size:22px;">UGX @Model.TotalAmount.ToString("N0")</span>
            </div>
            <div class="text-end fst-italic text-white opacity-50 small" id="bou-denom-words"></div>
        </div>
    </div>
</div>