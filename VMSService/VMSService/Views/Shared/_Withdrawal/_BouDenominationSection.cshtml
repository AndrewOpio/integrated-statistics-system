@model VMSService.Core.Models.WithdrawalRequests.BouWithdrawalRequestDetailsViewModel


<div class="card border-start border-top-0 border-end-0 border-bottom-0 border-4 shadow-sm rounded-start-0"
     style="border-color:#791F1F!important;">
    <div class="card-body d-flex flex-column gap-3">

        @* ── Header ── *@
        <div class="d-flex justify-content-between align-items-center">
            <p class="text-uppercase text-muted fw-bold mb-0">
                <i class="ti ti-cash me-1"></i>
                @* @(Model.IsPostApprovalView ? "Denomination Details" : "Commercial Bank Denominations") *@
                @{
                    var heading = (Model.IsPostApprovalView, Model.IsLumpSum) switch
                    {
                        (true, _) => "Denomination Details",
                        (false, true) => "Withdrawal Request",
                        (false, false) => "Commercial Bank Denominations"
                    };
                }
                @heading
            </p>
            @if (!Model.IsPostApprovalView)
            {
                <span class="badge rounded-pill bg-danger text-white p-2 small">
                    <i class="ti ti-eye me-1"></i>Read-only · Awaiting Commercial Bank Approval
                </span>
            }
        </div>
        <hr class="my-0" />

        @if (Model.IsLumpSum)
        {
            <div class="border rounded-3 overflow-hidden">
                <div class="px-3 py-2 border-bottom d-flex align-items-center gap-2">
                    <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold"
                          style="width:16px;height:16px;font-size:9px;background:#fff3e0;color:#e65100;">L</span>
                    <span class="text-uppercase fw-bold small" style="letter-spacing:.05em;">Commercial Bank Lump Sum Request</span>
                </div>
                <div class="d-flex justify-content-between align-items-center px-3 py-3">
                    <span class="text-muted small">Total Amount (UGX)</span>
                    <span class="fw-bold">UGX @Model.TotalAmount.ToString("N0")</span>
                </div>
            </div>
        }
        @if (Model.CbDenominations.Any())
        {
            @* ─────────────────────────────────────────────────────────────
               Table 1: Company Request (CB wishlist)
               ───────────────────────────────────────────────────────────── *@
            <div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <p class="text-uppercase text-muted fw-bolder mb-0">
                        <i class="ti ti-building-bank me-1"></i>
                        Commercial Bank Request
                    </p>
                    <span class="badge bg-secondary rounded-pill px-3 py-2">
                        Total: UGX @Model.TotalAmount.ToString("N0")
                    </span>
                </div>
                <div class="border rounded-3 overflow-hidden">
                    <table class="cbtable table table-sm align-middle mb-0 rounded">
                        <thead class="thead-light" style="border-style: none !important;">
                            <tr>
                                <th class="ps-3" style="font-size:14px;">DENOMINATION</th>
                                <th style="font-size:14px;">QUANTITY</th>
                                <th class="text-end" style="font-size:14px;">AMOUNT (UGX)</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @foreach (var note in Model.Notes)
                            {
                                <tr class="text-info">
                                    <td class="ps-3">@note.DenominationLabel</td>
                                    <td>@note.Bundles?.ToString("N0") bundles</td>
                                    <td class="text-end">@note.Amount.ToString("N0")</td>
                                </tr>
                            }
                            @foreach (var coin in Model.Coins)
                            {
                                <tr class="text-secondary">
                                    <td class="ps-3">@coin.DenominationLabel</td>
                                    <td>@coin.Boxes?.ToString("N0") boxes</td>
                                    <td class="text-end">@coin.Amount.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot style="border-style: none !important;">
                            @if (Model.Notes.Any())
                            {
                                <tr class="fw-bold text-info" style="background: #e5e7eb;">
                                    <td class="ps-3 text-uppercase">
                                        <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold"
                                              style="width:16px;height:16px;font-size:9px;background:#fff3e0;color:#2361ce;">N</span>
                                        Total BankNotes
                                    </td>
                                    <td></td>
                                    <td class="text-end">@Model.TotalNotesAmount.ToString("N0")</td>
                                </tr>
                            }
                            @if (Model.Coins.Any())
                            {
                                <tr class="fw-bold text-secondary" style="background: #e5e7eb;">
                                    <td class="ps-3 text-uppercase">
                                        <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold"
                                              style="width:16px;height:16px;font-size:9px;background:#faeeda;color:#BA7517;">C</span>
                                        Total Coins
                                    </td>
                                    <td></td>
                                    <td class="text-end">@Model.TotalCoinsAmount.ToString("N0")</td>
                                </tr>
                            }
                            <tr class="fw-bold" style="font-size:14px; background-color: #1f2937 !important;">
                                <td class="ps-3 text-white text-uppercase">Withdrawal Request Total</td>
                                <td></td>
                                <td class="text-end text-white">@Model.TotalAmount.ToString("N0")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

        }
        @* ─────────────────────────────────────────────────────────────
               Table 2: Bank Dispatch (what the bank actually gave)
               ───────────────────────────────────────────────────────────── *@
        
        @{
            var hasNew = Model.DispatchedNewBanknotes?.Any() ?? false;
            var hasReissue = Model.DispatchedReissueBanknotes?.Any() ?? false;
            var hasCoins = Model.DispatchedCoins?.Any() ?? false;
            var hasDispatch = hasNew || hasReissue || hasCoins;

            var dispatchNewTotal = Model.DispatchedNewBanknotes?.Sum(r => r.Amount) ?? 0m;
            var dispatchReissueTotal = Model.DispatchedReissueBanknotes?.Sum(r => r.Amount) ?? 0m;
            var dispatchCoinsTotal = Model.DispatchedCoins?.Sum(r => r.Amount) ?? 0m;
            var dispatchGrandTotal = dispatchNewTotal + dispatchReissueTotal + dispatchCoinsTotal;
            var dispatchVariance = dispatchGrandTotal - Model.TotalAmount;
        }

        <div>

            <div class="d-flex justify-content-between align-items-center mb-3 mt-3">
                <p class="text-uppercase text-muted fw-bolder mb-0">
                    <i class="ti ti-truck-delivery me-1"></i>
                    BOU Dispatch
                </p>
                <div class="d-flex align-items-center gap-2">
                    @if (hasDispatch)
                    {
                        if (dispatchVariance == 0)
                        {
                            <span class="badge bg-success rounded-pill px-3 py-2">
                                <i class="ti ti-circle-check me-1"></i>Matched
                            </span>
                        }
                        else
                        {
                            var varianceLabel = dispatchVariance > 0 ? "Over by" : "Short by";
                            <span class="badge bg-danger rounded-pill px-3 py-2">
                                <i class="ti ti-alert-triangle me-1"></i>@varianceLabel UGX @Math.Abs(dispatchVariance).ToString("N0")
                            </span>
                        }
                    }
                    @if (Model.CanEditDispatch)
                    {
                        <button type="button" class="btn btn-sm btn-outline-success"
                                data-bs-toggle="modal" data-bs-target="#editDispatchModal">
                            <i class="ti ti-edit me-1"></i>Edit Dispatch
                        </button>
                    }
                </div>
            </div>

            <hr />

            @if (!hasDispatch)
            {
                <div class="border rounded-3 p-4 text-center bg-body-tertiary">
                    <i class="ti ti-package-off fs-3 text-muted d-block mb-2"></i>
                    <div class="fw-bold text-muted">Nothing dispatched yet</div>
                    <div class="small text-muted">
                        The bank has not recorded a dispatch for this request.
                    </div>
                </div>
            }
            else
            {

                <div class="border overflow-hidden">
                    <table class="table table-sm table-nowrap ">
                        <thead class="thead-light">
                            <tr>
                                <th style="font-size:14px; width:20%;">DENOMINATION</th>
                                <th style="font-size:14px; width:40%;">DETAILS</th>
                                <th class="text-end" style="font-size:14px; width:15%;">QUANTITY</th>
                                <th class="text-end pe-3" style="font-size:14px;width:25%;">AMOUNT (UGX)</th>
                            </tr>
                        </thead>
                        <tbody class="small">

                            @* ── New Banknotes (Full + Partial) ── *@
                            @foreach (var r in (Model.DispatchedNewBanknotes ?? new())
                                                    .OrderByDescending(r => r.IsFull)
                                                    .ThenByDescending(r => r.Denomination)
                                                    .ThenBy(r => r.StartBox))
                            {
                                <!-- DEBUG: prefix='@r.SerialPrefix' start=@r.SerialStart end=@r.SerialEnd -->
                                var boxCount = r.EndBox - r.StartBox + 1;
                                var boxLabel = r.StartBox == r.EndBox
                                ? r.StartBox.ToString()
                                : $"{r.StartBox}–{r.EndBox}";
                                var bundles = r.IsFull ? boxCount * 50 : (r.Bundles);

                                <tr class="text-info">
                                    <td>@r.Denomination.ToString("N0")</td>
                                    <td>
                                        @if (r.IsFull)
                                        {
                                            <span class="badge bg-primary-subtle text-primary">N · Full</span>
                                            <span style="font-family:var(--bs-font-monospace);font-weight:600;">
                                                Box@(boxCount == 1 ? "" : "es") @boxLabel
                                            </span>
                                            <span class="text-muted">· @boxCount full box@(boxCount == 1 ? "" : "es")</span>
                                            <br />
                                            <div class="text-muted small" style="font-family:var(--bs-font-monospace);font-weight:600;">
                                                serials @r.SerialPrefix@r.SerialStart.ToString("000000")–@r.SerialPrefix@r.SerialEnd.ToString("000000")
                                            </div>
                                        }
                                        @*@if (r.IsFull)
                                        {
                                           
                                        }
                                        else
                                        {
                                            
                                        } else
                                        {
                                        
                                            <span style="font-family:var(--bs-font-monospace);font-weight:600;">
                                                Box @r.StartBox
                                            </span>
                                            <span class="text-muted">· serials @r.SerialStart.ToString("N0")–@r.SerialEnd.ToString("N0")</span>
                                            
                                        } *@
                                        else
                                        {
                                            <span class="badge" style="background:#faeeda;color:#2361ce;">N</span>
                                            <span class="badge bg-warning-subtle text-warning">· Partial</span>
                                            <span style="font-family:var(--bs-font-monospace);font-weight:600;">
                                                Box @r.StartBox
                                            </span>
                                            <br />
                                            <span class="text-muted" style="font-family:var(--bs-font-monospace);font-weight:600;">
                                                serials @r.SerialPrefix@r.SerialStart.ToString("000000")–@r.SerialPrefix@r.SerialEnd.ToString("000000")
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">@bundles.ToString("N0") bundles</td>
                                    <td class="text-end pe-3">@r.Amount.ToString("N0")</td>
                                </tr>
                            }

                            @* ── Reissue Banknotes ── *@
                            @foreach (var r in (Model.DispatchedReissueBanknotes ?? new())
                                                    .OrderByDescending(r => r.Denomination))
                            {
                                <tr class="text-info">
                                    @* <td class="ps-3">
                                        
                                    </td> *@
                                    <td>@r.Denomination.ToString("N0")</td>
                                    <td>
                                        <span class="badge" style="background:#faeeda;color:#2361ce;">R</span>
                                        <span class="text-muted">Reissue</span>
                                        </td>
                                    <td class="text-end">@r.Quantity.ToString("N0") bundles</td>
                                    <td class="text-end pe-3">@r.Amount.ToString("N0")</td>
                                </tr>
                            }

                            @* ── Coins ── *@
                            @foreach (var r in (Model.DispatchedCoins ?? new())
                                                    .OrderByDescending(r => r.Denomination))
                            {
                                <tr class="text-secondary">
                                   @*  <td class="ps-3">
                                        
                                    </td> *@
                                    <td>@r.Denomination.ToString("N0")</td>
                                    <td><span class="badge" style="background:#faeeda;color:#BA7517;">C</span>
                                        <span class="text-muted">Coins</span>
                                        </td>
                                    <td class="text-end">@r.Quantity.ToString("N0") boxes</td>
                                    <td class="text-end pe-3">@r.Amount.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot style="border-style: none !important;">
                            @if (hasNew)
                            {
                                <tr class="fw-bold text-info" style="background: #e5e7eb;">
                                    <td colspan="3" class="ps-3 text-uppercase" style="font-size: 12px;">
                                        <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold"
                                              style="width:16px;height:16px;font-size:9px;background:#fff3e0;color:#2361ce;">N</span>
                                        Total New Banknotes
                                    </td>
                                    <td class="text-end pe-3">@dispatchNewTotal.ToString("N0")</td>
                                </tr>
                            }
                            @if (hasReissue)
                            {
                                <tr class="fw-bold text-info" style="background: #e5e7eb;">
                                    <td colspan="3" class="ps-3 text-uppercase" style="font-size: 12px;">
                                        <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold"
                                              style="width:16px;height:16px;font-size:9px;background:#fff3e0;color:#2361ce;">R</span>
                                        Total Reissue Banknotes
                                    </td>
                                    <td class="text-end pe-3">@dispatchReissueTotal.ToString("N0")</td>
                                </tr>
                            }
                            @if (hasCoins)
                            {
                                <tr class="fw-bold text-secondary" style="background: #e5e7eb;">
                                    <td colspan="3" class="ps-3 text-uppercase" style="font-size: 12px;">
                                        <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold"
                                              style="width:16px;height:16px;font-size:9px;background:#faeeda;color:#e65100;">C</span>
                                        Total Coins Dispatched
                                    </td>
                                    <td class="text-end pe-3">@dispatchCoinsTotal.ToString("N0")</td>
                                </tr>
                            }
                           @*  <tr class="fw-bold" style="font-size:14px; background-color: #1f2937 !important;">
                                <td colspan="3" class="ps-3 text-white text-uppercase">Bank Dispatch Total (UGX)</td>
                                <td class="text-end pe-3 text-white">@dispatchGrandTotal.ToString("N0")</td>
                            </tr> *@
                        </tfoot>
                    </table>
                </div>
            }
        </div>


    </div>
</div>
@*<div class="card border-start border-top-0 border-end-0 border-bottom-0 border-4 shadow-sm rounded-start-0"
     style="border-color:#791F1F!important;">
    <div class="card-body d-flex flex-column gap-3">
        <div class="d-flex justify-content-between align-items-center">
            <p class="text-uppercase text-muted fw-bold mb-3">
                <i class="ti ti-cash me-1"></i>
                @(Model.IsPostApprovalView ? "Denomination Details" : "Commercial Bank Denominations")
            </p>
            @if (!Model.IsPostApprovalView)
            {
                <span class="badge rounded-pill bg-danger text-white p-2 text-muted border small">
                    <i class="ti ti-eye me-1"></i>Read-only &middot; Awaiting Commercial Bank Approval
                </span>
            }
            @if (Model.CanEditDispatch)
            {
                <button type="button" class="btn btn-sm btn-outline-success"
