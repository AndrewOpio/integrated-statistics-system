@model VMSService.Core.Models.CbRequests.FromToSelectionViewModel

<div class="card mb-4 border-top-0 border-end-0 border-bottom-0 border-4 border-warning shadow-sm">
    <div class="card-body">
        <div class="d-flex align-items-center mb-3 justify-content-between">
            <div class="d-flex align-items-center gap-2 fw-bolder">
                <i class="ti ti-replace"></i>
                <span class="text-uppercase mb-0">Sender & Receiver Details</span>
            </div>
            <hr />
            <div class="d-flex gap-2">
                <span class="badge text-bg-danger-lt text-danger border border-danger-subtle small">
                    * Required
                </span>
            </div>
        </div>
        <div class="row g-4 align-items-end">

            @* ── Cb Branch ── *@
            <div class="col-md-6">

                <div class="text-uppercase text-muted small mb-1">
                    FROM — SENDER
                </div>

                <div id="cbBranchCard">
                    <div class="d-flex align-items-stretch rounded-3 overflow-hidden border border-danger">
                        <div class="d-flex align-items-center justify-content-center px-3 bg-danger bg-opacity-10">
                            <i class="ti ti ti-circle-arrow-up-right-filled text-danger fs-4"></i>
                        </div>
                        <div class="flex-grow-1 px-3 py-2">
                            <p class="text-muted mb-0" style="font-size:9px;">FROM COMMERCIAL BANK</p>
                            <p class="fw-bold mb-0">@Model.Cb.Name</p>
                            <p class="mb-0">@Model.Cb.Code</p>
                            <p class="mb-0" id="cbCode">@Model.Cb.CBCode</p>
                        </div>
                        <div class="d-flex align-items-center pe-3">
                            <span class="badge bg-danger">
                                <i class="ti ti-toggle-left"></i>
                                Sender
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            @* ── Bou Branch ── *@
            <div class="col-md-6">
                <select id="BouBranchSelect"
                        name="BouBranchId"
                        class="form-select mb-3"
                        onchange="onBouBranchSelected(this.value); loadBranchDetails('bou', this.value)">
                    <option value="">— Select BOU Branch —</option>
                    @foreach (var branch in Model.BouBranches)
                    {
                        <option value="@branch.Id"
                                selected="@(Model.SelectedBouBranchId != 0 && branch.Id == Model.SelectedBouBranchId)">
                            @branch.Name
                        </option>
                    }
                </select>

                <div id="bouBranchCard" style="display:none;">
                    <div class="text-uppercase text-muted small mb-1">
                        TO — RECIEVER
                    </div>
                    <div class="d-flex align-items-stretch rounded-3 overflow-hidden border border-success">
                        <div class="d-flex align-items-center justify-content-center px-3 bg-success bg-opacity-10">
                            <i class="ti ti-building-bank text-success fs-4"></i>
                        </div>
                        <div class="flex-grow-1 px-3 py-2">
                            <p class="text-muted mb-0" style="font-size:9px;">TO BRANCH</p>
                            <p class="fw-bold mb-0">Bank of Uganda</p>
                            <p class="mb-0" id="bouBranchName"></p>
                            <p class="text-muted fw-light mb-0" id="bouBranchCode"></p>
                        </div>
                        <div class="d-flex align-items-center pe-3">
                            <span class="badge bg-success">
                                <i class="ti ti-toggle-right-filled"></i>
                                Receiver
                            </span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        @* <div class="row g-4 my-1">
            <div class="col-md-6">
                <label class="form-label text-uppercase text-muted small mb-1">
                    Collection Date <span class="text-danger">*</span>
                </label>
                <input type="date"
                       id="collectionDate"
                       class="form-control"
                       onchange="formState.collectionDate = this.value || null;
                 checkSpecialApproval();
                 document.getElementById('rtgsDate').min = this.value || new Date().toISOString().split('T')[0];" />
                <small class="text-muted">Date the cash will be withdrawn</small>
            </div>
        </div> *@
        <div class="row g-4 my-1">
            <div class="col-md-6">
                <label class="form-label text-uppercase text-muted small mb-1">
                    Collection Date <span class="text-danger">*</span>
                </label>
                <input type="date"
                       id="collectionDate"
                       class="form-control"
                       value="@(Model.IsEdit? Model.CollectionDate.ToString("yyyy-MM-dd") : "")"
                       onchange="onCollectionDateChanged(this.value);" />
                <small class="text-muted">Date the cash will be withdrawn</small>
            </div>
            <div class="col-md-6">
                <label class="form-label text-uppercase text-muted small mb-1">
                    Submission Date
                </label>
                <p class="fw-bold mb-0">
                    @(Model.SubmissionDate.HasValue? Model.SubmissionDate.Value.ToString("dd MMM yyyy HH:mm") : "—")
                </p>
                <small class="text-muted">Date CB approval was granted</small>
            </div>
            <div id="sameDayMakerWarning"
                 class="col-md-12 alert alert-warning align-items-start gap-2 mb-0
                        @(Model.IsEdit ? (Model.RequiresSpecialApproval ? "d-flex" : "d-none") : "d-none")">
                <i class="ti ti-alert-triangle text-warning fs-5 flex-shrink-0 mt-1"></i>
                <div class="w-100">
                    <p class="fw-bold mb-1">Same-Day Collection</p>
                    <p class="mb-0 small">
                        Today is selected as the collection date. If your approver approves this request today,
                        it will be flagged for exceptional approval. Consider selecting a future date if possible.
                    </p>
                    <div id="sameDayReasonDisplay"
                         class="mt-2 pt-2 border-top border-warning
                                @(Model.IsEdit && !string.IsNullOrWhiteSpace(Model.SpecialApprovalReason) ? "" : "d-none")">
                        <p class="small text-muted mb-1">Reason for same-day collection:</p>
                        <p class="small fw-semibold mb-2" id="sameDayReasonText">@Model.SpecialApprovalReason</p>
                        <button type="button"
                                class="btn btn-sm btn-outline-warning"
                                onclick="openSameDayReasonModal()">
                            <i class="ti ti-edit me-1"></i> Edit Reason
                        </button>
                    </div>
                </div>
            </div>
            <div id="gracePeriodIndicator"
                 class="col-md-12 alert alert-info align-items-start gap-2 mb-0 d-none">
                <i class="ti ti-info-circle text-info fs-5 flex-shrink-0 mt-1"></i>
                <div class="w-100">
                    <p class="fw-bold mb-1">Grace Period Active</p>
                    <p class="mb-0 small">
                        Same-day collection does not require exceptional approval today — <span id="gracePeriodReasonText"></span>.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Same-Day Collection Reason Modal -->
<div class="modal fade"
     id="sameDayReasonModal"
     tabindex="-1"
     aria-labelledby="sameDayReasonModalLabel"
     aria-modal="true"
     data-bs-backdrop="static"
     data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-warning" style="background-color: #fff8e1;">
                <div class="d-flex align-items-center gap-2">
                    <i class="ti ti-alert-triangle text-warning fs-4"></i>
                    <h5 class="modal-title fw-bold mb-0" id="sameDayReasonModalLabel">Same-Day Collection</h5>
                </div>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">
                    Today is selected as the collection date. This request will require
                    <strong>exceptional approval</strong>. Please provide a reason for the same-day collection.
                </p>
                <label for="sameDayReasonInput" class="form-label">
                    Reason <span class="text-danger">*</span>
                </label>
                <textarea id="sameDayReasonInput"
                          class="form-control"
                          rows="3"
                          maxlength="500"
                          placeholder="e.g. Urgent liquidity requirement due to..."></textarea>
                <small class="text-muted d-block mt-1">Minimum @WithdrawConstants.ReasonRules.MinLength characters.</small>
                <div id="sameDayReasonError" class="text-danger small mt-1" style="display:none;">
                    <i class="ti ti-alert-circle me-1"></i><span id="sameDayReasonErrorText">Please enter a reason before continuing.</span>
                </div>
                <div class="text-muted small text-end mt-1">
                    <span id="sameDayReasonCount">0</span> / 500
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" id="sameDayReasonCancelBtn">
                    <i class="ti ti-x me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-warning" id="sameDayReasonConfirmBtn">
                    <i class="ti ti-check me-1"></i> Confirm &amp; Continue
                </button>
            </div>
        </div>
    </div>
</div>