@model VMSService.Core.Models.WithdrawalRequests.WithdrawalHistoryTrailViewModel

@* ── History trail — one pill per status the request actually passed through ── *@
<div class="d-flex flex-wrap align-items-center gap-2 mb-3" style="row-gap:8px;">
    @for (int i = 0; i < Model.Steps.Count; i++)
    {
        var step = Model.Steps[i];
        <span class="badge rounded-pill px-3 py-2 @(step.IsCurrent ? "bg-warning text-dark" : "bg-white bg-opacity-25 text-white")"
              style="font-size:11px;" title="@(step.ChangedBy) &middot; @(step.ChangedAt.ToString("dd MMM yyyy HH:mm"))">
            @if (!step.IsCurrent)
            {
                <i class="ti ti-check me-1"></i>
            }
            @step.StatusName
        </span>
        if (i < Model.Steps.Count - 1)
        {
            <i class="ti ti-chevron-right text-white opacity-50" style="font-size:12px;"></i>
        }
    }
</div>

@* ── Who owns it next ── *@
@if (Model.IsClosed)
{
    <div class="d-flex align-items-center gap-2 text-success mb-3" style="font-size:13px;">
        <i class="ti ti-circle-check"></i>
        <span>This request is closed.</span>
    </div>
}
else if (!string.IsNullOrEmpty(Model.NextActor))
{
    <div class="d-flex align-items-center gap-2 text-warning mb-3" style="font-size:13px;">
        <i class="ti ti-user-exclamation"></i>
        <span>Awaiting action from: <strong>@Model.NextActor</strong></span>
    </div>
}
