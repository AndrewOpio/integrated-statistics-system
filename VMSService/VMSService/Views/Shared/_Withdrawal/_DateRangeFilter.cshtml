@model VMSService.Core.Models.WithdrawalRequests.DateRangeFilterViewModel
<div>
    <label class="form-label small text-muted mb-1" for="from">From</label>
    <input type="date" id="from" name="from" class="form-control form-control-sm"
           value="@Model.From.ToString("yyyy-MM-dd")" min="@(Model.MinFrom == DateOnly.MinValue ? null : Model.MinFrom.ToString("yyyy-MM-dd"))" max="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" />
</div>
<div>
    <label class="form-label small text-muted mb-1" for="to">To</label>
    <input type="date" id="to" name="to" class="form-control form-control-sm"
           value="@Model.To.ToString("yyyy-MM-dd")" min="@(Model.MinFrom == DateOnly.MinValue ? null : Model.MinFrom.ToString("yyyy-MM-dd"))" max="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" />
</div>
<button type="submit" class="btn btn-sm btn-outline-secondary">Apply</button>
