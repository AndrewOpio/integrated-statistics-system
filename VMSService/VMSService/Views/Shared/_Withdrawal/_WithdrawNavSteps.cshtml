@model VMSService.Core.Models.CbRequests.WithdrawalStepViewModel

<div class="dash-hero mb-4">

    @if (Model.IsInProgress)
    {
        <div class="d-flex align-items-center gap-2 text-light mb-3">
            <i class="ti ti-clock-hour-4 fs-5"></i>
            <span>Your request has been submitted and is currently being processed by the BOU.</span>
        </div>
    }
    @if (Model.IsApproved)
    {
        <div class="d-flex align-items-center gap-2 mb-3" style="color: aquamarine;">
            <i class="ti ti-circle-check fs-5"></i>
            <span>Your withdrawal request has been approved.</span>
        </div>
    }

    <div class="d-flex align-items-center flex-wrap gap-3">
        @{
            var visibleSteps = Model.Steps.Where(s => s.IsVisible).ToList();
        }
        @for (int i = 0; i < visibleSteps.Count; i++)
        {
            var step = visibleSteps[i];

            @if (i > 0)
            {
                <div class="step-arrow @(step.IsConnectorDone ? "done" : "")">
                    <i class="ti ti-chevron-right fs-4 @(step.IsConnectorDone ? "" : "opacity-50")"></i>
                </div>
            }

            @* Progress indicator only — not interactive. There's no tab content on this page
               (or on Create/Edit) for a step to switch to. *@
            <div class="step-pill @step.CssState" style="cursor:default;" title="@step.Label — @step.SubLabel">

                <div class="sp-icon">
                    @if (step.ShowCheckIcon)
                    {
                        <i class="ti ti-circle-check"></i>
                    }
                    else
                    {
                        <i class="ti @step.Icon"></i>
                    }
                </div>

                <div class="d-none d-sm-block">
                    <div class="text-white">@step.Label</div>
                    <div class="text-white-50">@step.SubLabel</div>
                </div>

            </div>
        }


        @if (Model.IsInProgress)
        {
            <div class="step-arrow">
                <i class="ti ti-chevron-right fs-4 opacity-50"></i>
            </div>
            <div class="step-pill wait" title="Being Handled by BOU">
                <div class="sp-icon">
                    <i class="ti ti-clock-hour-4"></i>
                </div>
                <div class="d-none d-sm-block">
                    <div class="text-white">In Progress</div>
                    <div class="text-white-50">BOU Handling</div>
                </div>
            </div>
        }
    </div>

</div>
