@* @model VMSService.Core.Models.CbWithdrawRequest.de *@

<div class="card mb-4 border-top-0 border-end-0 border-bottom-0 border-4 shadow-sm" style="border-color: #b31b34">

    <div class="card-body">
        @* ── Card Header ── *@

        <div class="d-flex align-items-center mb-3 justify-content-between">
            <div class="d-flex align-items-center gap-2 fw-bolder">
                <i class="ti ti-cash"></i>
                <span class="text-uppercase mb-0">Denomination Details</span>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1"
                        onclick="denomAddRow('notes')">
                    <i class="ti ti-circle-letter-n-filled"></i>Add Banknote
                </button>
                <button type="button" class="btn btn-sm btn-outline-warning d-inline-flex align-items-center gap-1"
                        onclick="denomAddRow('coins')">
                    <i class="ti ti-circle-letter-c-filled"></i>Add Coin
                </button>

            </div>
        </div>

        @* ── Banknotes ── *@
        <div class="denom-sec">
            <div class="d-flex align-items-center justify-content-between px-4 py-2 bg-light">
                <div class="d-flex align-items-center gap-2 text-uppercase fw-bold">
                    <i class="ti ti-circle-letter-n-filled text-primary"></i>Banknotes
                </div>
                <span class="denom-amt-note fw-bold small text-primary" id="denom-note-sub">UGX 0</span>
            </div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <colgroup>
                        <col style="width:30%">
                        <col style="width:25%">
                        <col style="width:30%">
                        <col style="width:15%">
                    </colgroup>
                    <thead class="small text-muted">
                        <tr>
                            <th class="px-4 py-2">DENOMINATIONS</th>
                            <th class="px-4 py-2 text-end">NO. OF BUNDLES</th>
                            <th class="px-4 py-2 text-end">AMOUNT</th>
                            <th class="text-center">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody id="denom-notes-body">
                        <tr class="denom-empty-row">
                            <td colspan="4" class="text-center py-3 text-muted small">No banknotes added</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        @* ── Coins ── *@
        <div class="denom-sec">
            <div class="d-flex align-items-center justify-content-between mt-3 px-4 py-2 bg-light">
                <div class="d-flex align-items-center gap-2 text-uppercase fw-bold">
                    <i class="ti ti-circle-letter-c-filled text-warning"></i> Coins
                </div>
                <span class="denom-amt-coin fw-bold small text-warning" id="denom-coin-sub">UGX 0</span>
            </div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <colgroup>
                        <col style="width:30%">
                        <col style="width:25%">
                        <col style="width:30%">
                        <col style="width:15%">
                    </colgroup>
                    <thead class="small text-secondary">
                        <tr>
                            <th class="px-4 py-2">DENOMINATION</th>
                            <th class="px-4 py-2 text-end">NO. OF BOXES</th>
                            <th class="px-4 py-2 text-end">AMOUNT</th>
                            <th class="text-center">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody id="denom-coins-body">
                        <tr class="denom-empty-row">
                            <td colspan="4" class="text-center py-3 text-muted small">No coins added</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        @* ── Totals ── *@
        <div class="mt-3">
            <div class="d-flex justify-content-between align-items-center px-4 py-2 border-bottom">
                <span class="d-flex align-items-center gap-2 small fw-semibold text-primary">
                    <i class="ti ti-circle-letter-n-filled"></i> Total Banknotes
                </span>
                <span class="denom-amt-note fw-bold text-primary" id="denom-t-notes">UGX 0</span>
            </div>
            <div class="d-flex justify-content-between align-items-center px-4 py-2">
                <span class="d-flex align-items-center gap-2 small fw-semibold text-warning">
                    <i class="ti ti-circle-letter-c-filled"></i> Total Coins
                </span>
                <span class="denom-amt-coin fw-bold text-warning" id="denom-t-coins">UGX 0</span>
            </div>
        </div>

        @* ── Grand Total ── *@
        <div class="denom-grand rounded px-4 py-3">
            <div class="d-flex justify-content-between align-items-baseline mb-2">
                <span class="text-uppercase fw-bold text-white fs-6 opacity-75 "
                      style="letter-spacing:.07em;">Grand Total</span>
                <span class="fw-bold text-white" style="font-size:20px;" id="denom-g-val">UGX 0</span>
            </div>
            <div class="border-top pt-2 fs-6 fst-italic text-end text-white opacity-75" style="border-color:rgba(255,255,255,.2)!important;">
                <span id="denom-g-words">Zero shillings only</span>
            </div>
        </div>

    </div>
</div>
