<div class="mb-4">

    @* ── Banknotes ── *@
    <div class="mb-3">
        <div class="d-flex align-items-center gap-2 mb-2">
            <i class="ti ti-notes text-primary"></i>
            <span class="text-uppercase text-muted small fw-semibold">Banknotes (UGX)</span>
            <span class="badge rounded-pill bg-primary-subtle text-primary ms-auto" id="dt-notes-badge">UGX 0</span>
        </div>
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Denomination</th>
                            <th>Bundles</th>
                            <th class="text-end pe-3">Amount</th>
                        </tr>
                    </thead>
                    <tbody id="dt-list-notes"></tbody>
                </table>
            </div>
        </div>
    </div>

    @* ── Coins ── *@
    <div class="mb-3">
        <div class="d-flex align-items-center gap-2 mb-2">
            <i class="ti ti-coin text-warning"></i>
            <span class="text-uppercase text-muted small fw-semibold">Coins (UGX)</span>
            <span class="badge rounded-pill bg-warning-subtle text-warning ms-auto" id="dt-coins-badge">UGX 0</span>
        </div>
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Denomination</th>
                            <th>Bundles</th>
                            <th class="text-end pe-3">Amount</th>
                        </tr>
                    </thead>
                    <tbody id="dt-list-coins"></tbody>
                </table>
            </div>
        </div>
    </div>

    @* ── Totals ── *@
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <ul class="list-group list-group-flush">
            <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-3">
                <div>
                    <span class="fw-semibold">Banknotes Total</span>
                    <div class="text-muted small" id="dt-notes-breakdown">No notes selected</div>
                </div>
                <span class="fw-bold text-primary" id="dt-notes-total">UGX 0</span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-3">
                <div>
                    <span class="fw-semibold">Coins Total</span>
                    <div class="text-muted small" id="dt-coins-breakdown">No coins selected</div>
                </div>
                <span class="fw-bold text-warning" id="dt-coins-total">UGX 0</span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-3 bg-danger text-white">
                <div>
                    <span class="fw-bold fs-6">Grand Total</span>
                    <div class="small opacity-75" id="dt-grand-words">Zero shillings only</div>
                </div>
                <span class="fw-bold fs-5" id="dt-grand-total">UGX 0</span>
            </li>
        </ul>
    </div>

    <div class="invalid-feedback d-block mt-1" id="dt-err-notes" style="display:none!important;">
        Please add at least one denomination.
    </div>

</div>