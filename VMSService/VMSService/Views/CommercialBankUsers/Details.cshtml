@model VMSService.Core.Models.CommercialBankUser.CommercialBankUserViewModel

@{
    ViewData["Title"] = "Commercial Bank User Details";
}

<div class="row">
    <div class="col-12 col-lg-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header pb-4">
                <div class="d-flex flex-column">
                    <span class="text-muted small mb-2">Commercial Bank User Profile</span>
                    <h2 class="fs-4 fw-bold mb-3">@Model.UserFullName</h2>
                    @if (Model.CommercialBank != null && !string.IsNullOrEmpty(Model.CommercialBank.Name))
                    {
                        <div class="d-inline-flex align-items-center gap-2" style="width: fit-content;">
                            <span class="badge bg-primary">
                                <i class="ti ti-building me-1"></i>@Model.CommercialBank.Name
                            </span>
                        </div>
                    }
                </div>
            </div>

            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.UserName))
                {
                    <div class="field mb-4">
                        <span class="d-block text-muted small mb-2 text-uppercase">User Name</span>
                        <span class="d-block fw-normal">@Model.UserName</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.UserFullName))
                {
                    <div class="field mb-4">
                        <span class="d-block text-muted small mb-2 text-uppercase">Full Name</span>
                        <span class="d-block fw-normal">@Model.UserFullName</span>
                    </div>
                }

                @if (Model.CommercialBankId > 0)
                {
                    <div class="field">
                        <span class="d-block text-muted small mb-2 text-uppercase">Commercial Bank</span>
                        <span class="d-block fw-normal">@Model.CommercialBank?.Name</span>
                    </div>
                }
            </div>

            <div class="card-footer bg-transparent border-top pt-3">
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="ti ti-pencil me-1"></i>Edit
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="ti ti-arrow-left me-1"></i>Back
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>