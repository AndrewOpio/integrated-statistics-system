@model VMSService.Core.Models.CommercialBankUser.CommercialBankUserViewModel

@{
    ViewData["Title"] = "Create Commercial Bank User";
}

<div class="row">
    <div class="col-12 col-lg-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <h2 class="fs-5 fw-bold mb-0">Create New Commercial Bank User</h2>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert">
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label class="form-label" asp-for="UserId">User <span class="text-danger">*</span></label>
                        <select class="form-select" asp-for="UserId" id="userSelect" required>
                            <option value="">-- Search and Select User --</option>
                            @if (Model.NonStaffUserList != null)
                            {
                                @foreach (var user in Model.NonStaffUserList)
                                {
                                    <option value="@user.Id">@user.UserName - @user.FirstName @user.MiddleName @user.LastName</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="UserId" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="CommercialBankId">Commercial Bank <span class="text-danger">*</span></label>
                        <select class="form-select" asp-for="CommercialBankId" asp-items="@Model.CommercialBankList" required>
                        </select>
                        <span asp-validation-for="CommercialBankId" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-check me-1"></i>Save
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="ti ti-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#userSelect').select2({
                theme: 'bootstrap-5',
                placeholder: '-- Search and Select User --',
                allowClear: true
            });
        });
    </script>
}