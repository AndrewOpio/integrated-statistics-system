@model List<VMSService.Core.Models.BagMovements.BagMovementViewModel>

@{
    ViewData["Title"] = "Bag Movements";
    bool isVerificationOfficer = ViewBag.IsVerificationOfficer ?? false;
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h2 class="fs-5 fw-bold mb-0">Bag Movements</h2>
                        <p class="text-muted small mb-0 mt-1">Requests to move bags between vault sections</p>
                    </div>
                    @if (isVerificationOfficer)
                    {
                        <div class="col-auto">
                            <a asp-action="Create" class="btn btn-primary btn-sm">
                                <i class="ti ti-plus me-1"></i>New Movement Request
                            </a>
                        </div>
                    }
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-centered table-nowrap mb-0 rounded" id="bagMovementsTable">
                        <thead class="thead-light">
                            <tr>
                                <th class="border-0 rounded-start">#</th>
                                <th class="border-0">Bags</th>
                                <th class="border-0">To</th>
                                <th class="border-0">Status</th>
                                <th class="border-0">Created By</th>
                                <th class="border-0">Created Date</th>
                                <th class="border-0 rounded-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowNumber = 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><span class="text-primary fw-bold">@rowNumber</span></td>
                                    <td class="fw-bold" title="@string.Join(", ", item.Bags.Select(b => b.ReferenceNumber))">@item.BagSummary</td>
                                    <td>
                                        <span class="badge bg-purple bg-opacity-10 text-purple border border-purple border-opacity-25">
                                            <i class="ti ti-building me-1"></i>@(item.NewVaultName != null ? $"{item.NewVaultName} — {item.NewVaultSectionName}" : item.NewVaultSectionName ?? "-")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info"><i class="ti ti-badge me-1"></i>@(item.CurrentStatusName ?? "-")</span>
                                    </td>
                                    <td>@item.CreatedBy</td>
                                    <td>@item.CreatedDate.ToString("dd MMM yyyy HH:mm")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="ti ti-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                    @{ rowNumber++; }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#bagMovementsTable').DataTable({ order: [] });
        });
    </script>
}
