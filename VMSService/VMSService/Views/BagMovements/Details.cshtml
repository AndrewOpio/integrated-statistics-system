@using VMSService.Core.Models.BagMovements
@using VMSService.Core.Models.Shared
@model BagMovementDetailsViewModel

@{
    ViewData["Title"] = "Bag Movement Details";
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-3">
            <div class="card-header pb-4 bg-light">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="d-flex flex-column">
                        <span class="text-muted small mb-2">Bag Movement &mdash; @Model.Bags.Count bag@(Model.Bags.Count == 1 ? "" : "s")</span>
                        <h2 class="fs-4 fw-bold mb-3">Movement Request #@Model.Id</h2>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="badge bg-info">
                                <i class="ti ti-badge me-1"></i>@(string.IsNullOrEmpty(Model.CurrentStatusName) ? "-" : Model.CurrentStatusName)
                            </span>
                        </div>
                    </div>
                    <!-- Action Buttons -->
                    <div class="d-flex gap-2 flex-row align-items-end">
                        @if (Model.CanEdit)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
                                <i class="ti ti-edit me-1"></i>Edit
                            </a>
                        }
                        <a asp-action="Index" class="btn btn-secondary btn-sm">
                            <i class="ti ti-arrow-left me-1"></i>Back to List
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="field mb-4">
                            <span class="d-block text-muted small mb-2 text-uppercase">Branch</span>
                            <span class="badge bg-brown text-brown bg-opacity-10 rounded-pill">
                                <i class="ti ti-building-bank me-1"></i>@(Model.BranchName ?? "-")
                            </span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="field mb-4">
                            <span class="d-block text-muted small mb-2 text-uppercase">To</span>
                            <span class="badge bg-primary text-primary bg-opacity-10 rounded-pill">
                                <i class="ti ti-building me-1"></i>@(Model.NewVaultName != null ? $"{Model.NewVaultName} — {Model.NewVaultSectionName}" : Model.NewVaultSectionName ?? "-")
                            </span>
                        </div>
                    </div>
                </div>

                <div class="field mb-4">
                    <span class="d-block text-muted small mb-2 text-uppercase">Bags</span>
                    <div class="table-responsive">
                        <table class="table table-centered table-nowrap mb-0 rounded">
                            <thead class="thead-light">
                                <tr>
                                    <th class="border-0 rounded-start">Bag Reference</th>
                                    <th class="border-0 rounded-end">From</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bag in Model.Bags)
                                {
                                    <tr>
                                        <td class="fw-bold">@bag.ReferenceNumber</td>
                                        <td>
                                            <span class="badge bg-purple bg-opacity-10 text-purple border border-purple border-opacity-25">
                                                <i class="ti ti-building me-1"></i>@(bag.VaultName != null ? $"{bag.VaultName} — {bag.VaultSectionName}" : bag.VaultSectionName ?? "-")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="field">
                    <span class="d-block text-muted small mb-2 text-uppercase">Submitted</span>
                    <span class="d-block fw-normal">@Model.CreatedDate.ToString("dd MMM yyyy HH:mm") by @Model.CreatedBy</span>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Workflow Attachments ───────────────────────────────────────── *@
@await Html.PartialAsync("_WorkflowAttachments", Model.AllAttachments)

@* ── Workflow Comments ──────────────────────────────────────────── *@
@await Html.PartialAsync("_WorkflowComments", Model.StatusHistory)

@* ── Workflow Actions ───────────────────────────────────────────── *@
@{
    var workflowActionsViewModel = new WorkflowActionsViewModel
    {
        EntityId = Model.Id,
        ControllerName = "BagMovements",
        AvailableTransitions = Model.AvailableTransitions ?? new List<WorkflowService.Client.Dto.WorkflowTransitionDto>(),
        IsValid = true
    };
}
@await Html.PartialAsync("_WorkflowActions", workflowActionsViewModel)

@section Scripts {
    @await Html.PartialAsync("_WorkflowActionsScript")
}
