@using ConfigurationsService.Client
@using VMSService.Core.Models.StockLedgers
@using VMSService.Core.Services.Stocks.StockEntities
@model StockLedgerCreateViewModel

@{
    ViewData["Title"] = "Add To Ledger";

    var branches = ViewBag.Branches as List<BranchDto> ?? new List<BranchDto>();
    var denominations = ViewBag.Denominations as List<Denomination> ?? new List<Denomination>();
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var subCategories = ViewBag.SubCategories as List<SubCategoryOption> ?? new List<SubCategoryOption>();
    var counterPartyTypes = ViewBag.CounterPartyTypes as List<CounterPartyType> ?? new List<CounterPartyType>();
    var counterParties = ViewBag.CounterParties as List<CounterPartyOption> ?? new List<CounterPartyOption>();
}

<style>
    .ledger-card-header {
        background: #fff;
        border-top: 3px solid #31316A;
        border-radius: .5rem .5rem 0 0;
    }
    .ledger-section-label {
        font-size: .68rem;
        font-weight: 600;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: #6c757d;
        margin-bottom: .25rem;
    }
    .direction-toggle input { display: none; }
    .direction-toggle label {
        flex: 1;
        text-align: center;
        padding: .5rem .75rem;
        border: 1.5px solid #dee2e6;
        cursor: pointer;
        font-size: .82rem;
        font-weight: 600;
        transition: all .15s;
        margin: 0;
        background: #fff;
        color: #6c757d;
    }
    .direction-toggle label:first-of-type { border-radius: .4rem 0 0 .4rem; }
    .direction-toggle label:last-of-type { border-radius: 0 .4rem .4rem 0; border-left: 0; }
    .direction-toggle input:checked + label.dir-in {
        background: #e8f5e9; border-color: #2e7d32; color: #1b5e20;
    }
    .direction-toggle input:checked + label.dir-out {
        background: #fdecea; border-color: #c62828; color: #b71c1c;
    }
    #linesTable th {
        font-size: .7rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #6c757d;
        font-weight: 600;
        white-space: nowrap;
    }
    #linesTable td { vertical-align: top; }
    #linesTable .form-select, #linesTable .form-control { font-size: .82rem; }
    .line-value {
        background: #f8fafc !important;
        font-weight: 600;
        color: #31316A;
    }
    .empty-lines {
        border: 2px dashed #dee2e6;
        border-radius: .5rem;
        background: #f8fafc;
    }
    .totals-bar {
        background: #31316A;
        color: #fff;
        border-radius: .5rem;
    }
    .card .table td, .card .table th {
        padding-left: .5rem;
        padding-right: 0;
    }
</style>

@* ── Page header ─────────────────────────────────────────────── *@
<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i>Back
        </a>
        <div>
            <p class="text-muted small mb-0">Stock Ledger</p>
            <h4 class="fw-bold mb-0" style="color:#31316A;">Add To Ledger</h4>
        </div>
    </div>
    <button type="submit" form="ledgerForm" class="btn btn-primary">
        <i class="ti ti-device-floppy me-1"></i>Save Ledger Entry
    </button>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="ti ti-alert-circle me-1"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <div class="fw-semibold mb-1"><i class="ti ti-alert-circle me-1"></i>Please correct the following:</div>
        <ul class="mb-0 small">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form id="ledgerForm" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="DetailsJson" id="detailsJson" />

    @* ── Ledger header ───────────────────────────────────────── *@
    <div class="card border-0 shadow mb-4">
        <div class="card-header ledger-card-header d-flex align-items-center justify-content-between">
            <h6 class="fw-bold mb-0" style="color:#31316A;">
                <i class="ti ti-file-text me-2"></i>Ledger Details
            </h6>
        </div>
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label asp-for="ReferenceCode" class="ledger-section-label d-block"></label>
                    <input asp-for="ReferenceCode" class="form-control form-control-sm" autocomplete="off" />
                    <span asp-validation-for="ReferenceCode" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label class="ledger-section-label d-block">Direction</label>
                    <div class="d-flex direction-toggle">
                        <input type="radio" asp-for="IsIn" value="true" id="dirIn" />
                        <label for="dirIn" class="dir-in"><i class="ti ti-arrow-down-left me-1"></i>Stock In</label>
                        <input type="radio" asp-for="IsIn" value="false" id="dirOut" />
                        <label for="dirOut" class="dir-out"><i class="ti ti-arrow-up-right me-1"></i>Stock Out</label>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="StoreId" class="ledger-section-label d-block"></label>
                    <select asp-for="StoreId" class="form-select form-select-sm">
                        <option value="0">— Select Branch —</option>
                        @foreach (var branch in branches)
                        {
                            <option value="@branch.Id">@branch.Name</option>
                        }
                    </select>
                    <span asp-validation-for="StoreId" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="CounterPartyTypeId" class="ledger-section-label d-block"></label>
                    <select asp-for="CounterPartyTypeId" class="form-select form-select-sm" id="counterPartyTypeSelect">
                        <option value="0">— Select Type —</option>
                        @foreach (var type in counterPartyTypes)
                        {
                            <option value="@type.Id">@type.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CounterPartyTypeId" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="CounterPartyId" class="ledger-section-label d-block"></label>
                    <select asp-for="CounterPartyId" class="form-select form-select-sm" id="counterPartySelect">
                        <option value="0">— Select Counter Party Type first —</option>
                    </select>
                    <input type="number" class="form-control form-control-sm d-none" id="counterPartyFallback"
                           min="0" placeholder="Counter party id" />
                    <span asp-validation-for="CounterPartyId" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="Notes" class="ledger-section-label d-block"></label>
                    <input asp-for="Notes" class="form-control form-control-sm" placeholder="Optional" autocomplete="off" />
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    @* ── Ledger lines ────────────────────────────────────────── *@
    <div class="card border-0 shadow mb-4">
        <div class="card-header ledger-card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <h6 class="fw-bold mb-0" style="color:#31316A;">
                <i class="ti ti-list-details me-2"></i>Ledger Lines
                <span class="badge bg-secondary ms-2" id="lineCount">0</span>
            </h6>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addLine()">
                <i class="ti ti-plus me-1"></i>Add Line
            </button>
        </div>
        <div class="card-body p-3">
            <div id="emptyLines" class="empty-lines text-center py-4">
                <i class="ti ti-list-details d-block mb-2 text-secondary" style="font-size:2rem;opacity:.4;"></i>
                <p class="text-muted small mb-0">No lines captured yet — click <strong>Add Line</strong> to begin.</p>
            </div>

            <div id="linesWrapper" class="table-responsive d-none">
                <table class="table table-sm align-middle mb-0" id="linesTable">
                    <thead>
                        <tr>
                            <th style="min-width:150px;">Denomination</th>
                            <th style="min-width:150px;">Category</th>
                            <th style="min-width:150px;">Sub-Category</th>
                            <th style="min-width:100px;">Pieces</th>
                            <th style="min-width:100px;">Bundles</th>
                            <th style="min-width:100px;">Boxes</th>
                            <th style="min-width:140px;">Value (UGX)</th>
                            <th style="width:40px;"></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

            <div class="totals-bar d-flex justify-content-between align-items-center px-3 py-2 mt-3 d-none" id="totalsBar">
                <span class="small fw-semibold text-uppercase" style="letter-spacing:.06em;opacity:.85;">Total Value</span>
                <span class="fw-bold fs-5" id="grandTotal">UGX 0</span>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const DENOMINATIONS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            denominations.Select(d => new { id = d.Id, name = d.Name, value = d.Value })));
        const CATEGORIES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            categories.Select(c => new { id = c.Id, name = c.Name })));
        const SUBCATEGORIES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            subCategories.Select(sc => new { id = sc.Id, categoryId = sc.CategoryId, name = sc.Name })));
        const COUNTERPARTIES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            counterParties.Select(cp => new { typeId = cp.CounterPartyTypeId, id = cp.Id, name = cp.Name })));
        const EXISTING_LINES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Details.Select(d => new {
                denominationId = d.DenominationId,
                categoryId = d.CategoryId,
                subCategoryId = d.SubCategoryId,
                numberOfPieces = d.NumberOfPieces,
                numberOfBundles = d.NumberOfBundles,
                numberOfBoxes = d.NumberOfBoxes,
                value = d.Value
            })));

        const fmt = n => 'UGX ' + (n || 0).toLocaleString('en-US', { maximumFractionDigits: 0 });

        // Comma-groups a quantity/value input to whole numbers, keeping the caret where the user
        // left it so typing mid-number doesn't jump to the end.
        function ledgerFormatValue(input) {
            const caret = input.selectionStart;
            const commasBefore = (input.value.slice(0, caret).match(/,/g) || []).length;
            const digits = input.value.replace(/[^0-9]/g, '');
            input.value = digits === '' ? '' : parseInt(digits, 10).toLocaleString('en-US');
            const commasAfter = (input.value.slice(0, caret).match(/,/g) || []).length;
            const shift = commasAfter - commasBefore;
            input.setSelectionRange(caret + shift, caret + shift);

            const tr = input.closest('tr');
            if (!tr) return;
            if (input.classList.contains('line-value')) {
                tr.dataset.valueEdited = '1';
                refreshTotals();
            } else if (input.classList.contains('line-pieces')) {
                autoValue(tr);
            }
        }

        // Reads a comma-formatted input back as a number.
        const numVal = el => parseInt((el.value || '').replace(/[^0-9]/g, ''), 10) || 0;

        // Writes a number into a comma-formatted input.
        const setNum = (el, n) => { el.value = Math.round(n || 0).toLocaleString('en-US'); };

        function optionList(items, placeholder) {
            return '<option value="0">' + placeholder + '</option>' +
                items.map(i => '<option value="' + i.id + '">' + i.name + '</option>').join('');
        }

        // ── Counter party cascade ────────────────────────────────────
        // CounterPartyId points at a different table per type, so the options are swapped
        // wholesale. Types with no known source fall back to a plain numeric input.
        function refreshCounterParties(preselectId) {
            const typeId = +document.getElementById('counterPartyTypeSelect').value || 0;
            const select = document.getElementById('counterPartySelect');
            const fallback = document.getElementById('counterPartyFallback');
            const matches = COUNTERPARTIES.filter(cp => cp.typeId === typeId);

            if (!typeId) {
                select.innerHTML = '<option value="0">— Select Counter Party Type first —</option>';
                select.classList.remove('d-none');
                fallback.classList.add('d-none');
                return;
            }

            if (matches.length === 0) {
                // Unknown source for this type — let the user type the id directly.
                select.classList.add('d-none');
                fallback.classList.remove('d-none');
                fallback.value = preselectId || '';
                syncFallback();
                return;
            }

            fallback.classList.add('d-none');
            select.classList.remove('d-none');
            select.innerHTML = optionList(matches, '— Select Counter Party —');
            if (preselectId) select.value = preselectId;
        }

        // The fallback input feeds the real CounterPartyId field, which stays a <select>.
        function syncFallback() {
            const fallback = document.getElementById('counterPartyFallback');
            const select = document.getElementById('counterPartySelect');
            const val = +fallback.value || 0;
            select.innerHTML = '<option value="' + val + '" selected>' + val + '</option>';
        }

        // ── Ledger lines ─────────────────────────────────────────────
        function addLine(seed) {
            const tbody = document.querySelector('#linesTable tbody');
            const tr = document.createElement('tr');
            tr.innerHTML =
                '<td><select class="form-select form-select-sm line-denom">' +
                    optionList(DENOMINATIONS, '— Select —') + '</select></td>' +
                '<td><select class="form-select form-select-sm line-category">' +
                    optionList(CATEGORIES, '— Select —') + '</select></td>' +
                '<td><select class="form-select form-select-sm line-subcategory">' +
                    '<option value="0">— Select Category first —</option></select></td>' +
                '<td><input type="text" inputmode="numeric" class="form-control form-control-sm line-pieces" ' +
                    'value="0" oninput="ledgerFormatValue(this)" /></td>' +
                '<td><input type="text" inputmode="numeric" class="form-control form-control-sm line-bundles" ' +
                    'value="0" oninput="ledgerFormatValue(this)" /></td>' +
                '<td><input type="text" inputmode="numeric" class="form-control form-control-sm line-boxes" ' +
                    'value="0" oninput="ledgerFormatValue(this)" /></td>' +
                '<td><input type="text" inputmode="numeric" class="form-control form-control-sm line-value" ' +
                    'value="0" oninput="ledgerFormatValue(this)" /></td>' +
                '<td class="text-center">' +
                    '<button type="button" class="btn btn-sm btn-link text-danger p-0" title="Remove line" ' +
                        'onclick="removeLine(this)"><i class="ti ti-trash"></i></button></td>';
            tbody.appendChild(tr);

            const denom = tr.querySelector('.line-denom');
            const category = tr.querySelector('.line-category');
            const pieces = tr.querySelector('.line-pieces');

            category.addEventListener('change', () => refreshSubCategories(tr));
            // Value is auto-filled from pieces x denomination value as a convenience, but stays
            // editable — some postings (e.g. CFB adjustments) do not follow that relationship.
            // Pieces and Value re-run through ledgerFormatValue on input, which drives the rest.
            denom.addEventListener('change', () => autoValue(tr));

            if (seed) {
                denom.value = seed.denominationId || 0;
                category.value = seed.categoryId || 0;
                refreshSubCategories(tr);
                tr.querySelector('.line-subcategory').value = seed.subCategoryId || 0;
                setNum(pieces, seed.numberOfPieces);
                setNum(tr.querySelector('.line-bundles'), seed.numberOfBundles);
                setNum(tr.querySelector('.line-boxes'), seed.numberOfBoxes);
                setNum(tr.querySelector('.line-value'), seed.value);
                tr.dataset.valueEdited = '1';
            }

            refreshTotals();
        }

        function removeLine(btn) {
            btn.closest('tr').remove();
            refreshTotals();
        }

        function refreshSubCategories(tr) {
            const categoryId = +tr.querySelector('.line-category').value || 0;
            const select = tr.querySelector('.line-subcategory');
            const matches = SUBCATEGORIES.filter(sc => sc.categoryId === categoryId);

            select.innerHTML = categoryId === 0
                ? '<option value="0">— Select Category first —</option>'
                : (matches.length === 0
                    ? '<option value="0">— None available —</option>'
                    : optionList(matches, '— Select —'));

            autoValue(tr);
        }

        function autoValue(tr) {
            if (tr.dataset.valueEdited === '1') return;
            const denomId = +tr.querySelector('.line-denom').value || 0;
            const denom = DENOMINATIONS.find(d => d.id === denomId);
            const pieces = numVal(tr.querySelector('.line-pieces'));
            if (denom) setNum(tr.querySelector('.line-value'), denom.value * pieces);
            refreshTotals();
        }

        function refreshTotals() {
            const rows = document.querySelectorAll('#linesTable tbody tr');
            const total = Array.from(rows)
                .reduce((sum, tr) => sum + numVal(tr.querySelector('.line-value')), 0);

            document.getElementById('lineCount').textContent = rows.length;
            document.getElementById('grandTotal').textContent = fmt(total);
            document.getElementById('emptyLines').classList.toggle('d-none', rows.length > 0);
            document.getElementById('linesWrapper').classList.toggle('d-none', rows.length === 0);
            document.getElementById('totalsBar').classList.toggle('d-none', rows.length === 0);
        }

        function collectLines() {
            return Array.from(document.querySelectorAll('#linesTable tbody tr')).map(tr => ({
                denominationId: +tr.querySelector('.line-denom').value || 0,
                categoryId: +tr.querySelector('.line-category').value || 0,
                subCategoryId: +tr.querySelector('.line-subcategory').value || 0,
                numberOfPieces: numVal(tr.querySelector('.line-pieces')),
                numberOfBundles: numVal(tr.querySelector('.line-bundles')),
                numberOfBoxes: numVal(tr.querySelector('.line-boxes')),
                value: numVal(tr.querySelector('.line-value'))
            }));
        }

        // ── Wire-up ──────────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('counterPartyTypeSelect')
                .addEventListener('change', () => refreshCounterParties(0));
            document.getElementById('counterPartyFallback')
                .addEventListener('input', syncFallback);

            refreshCounterParties(@Model.CounterPartyId);

            EXISTING_LINES.forEach(addLine);
            refreshTotals();

            document.getElementById('ledgerForm').addEventListener('submit', function (e) {
                const lines = collectLines();
                if (lines.length === 0) {
                    e.preventDefault();
                    alert('Add at least one ledger line before saving.');
                    return;
                }

                const bad = lines.findIndex(l => !l.denominationId || !l.categoryId || l.value <= 0);
                if (bad !== -1) {
                    e.preventDefault();
                    alert('Line ' + (bad + 1) + ': select a denomination and category, and enter a value greater than zero.');
                    return;
                }

                document.getElementById('detailsJson').value = JSON.stringify(lines);
            });
        });
    </script>
}
