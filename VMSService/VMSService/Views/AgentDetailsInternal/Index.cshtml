@model List<VMSService.Core.Models.AgentDetails.AgentDetailViewModel>

@{
    ViewData["Title"] = "Agent Details";
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h2 class="fs-5 fw-bold mb-0">Agent Details</h2>
                    </div>
                    <div class="col text-end">
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-centered table-nowrap mb-0 rounded datatable">
                        <thead class="thead-light">
                            <tr>
                                <th class="border-0 rounded-start">#</th>
                                <th class="border-0">Photo</th>
                                <th class="border-0">Agent Names</th>
                                @* <th class="border-0">NIN</th>
                                <th class="border-0">Phone Number</th> *@
                                <th class="border-0">Commercial Bank</th>
                                <th class="border-0">BOU Branch</th>
                                <th class="border-0">Status</th>
                                <th class="border-0 rounded-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowNumber = 1;
                            }

                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><span class="text-primary fw-bold">@rowNumber</span></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.PassportPhoto))
                                        {
                                            <img src="@FileUrlHelper.ToWebPath(item.PassportPhoto)" alt="Passport Photo" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                <i class="ti ti-user text-white"></i>
                                            </div>
                                        }
                                    </td>
                                    <td class="fw-bold">@item.AgentNames</td>
                                    @* <td>@item.NIN</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.PhoneNumber))
                                        {
                                            @item.PhoneNumber
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td> *@
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.CommercialBankName))
                                        {
                                            <span class="badge bg-info">
                                                <i class="ti ti-building me-1"></i>@item.CommercialBankName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-inline-flex align-items-center gap-2" style="width: fit-content;">
                                            <span class="badge bg-primary">
                                                <i class="ti ti-building-bank me-1"></i>@item.BranchName
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-inline-flex align-items-center gap-2" style="width: fit-content;">
                                            <span class="badge bg-purple">
                                                <i class="ti ti-badge me-1"></i>@item.CurrentStatusName
                                            </span>
                                            @{
                                                if (item.CurrentStatusName == StatusConstants.AgentDetail.Approved)
                                                {
                                                    <span class="badge @(item.IsActive ? "bg-active" : "bg-inactive")">
                                                        <i class="ti @(item.IsActive ? "ti-check" : "ti-x") me-1"></i>@(item.IsActive ? "Active" : "Inactive")
                                                    </span>
                                                }
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="ti ti-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                    @{
                                        rowNumber++;
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>