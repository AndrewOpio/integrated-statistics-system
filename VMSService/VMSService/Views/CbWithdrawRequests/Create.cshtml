
@{
    Layout = "_CbLayout";
    ViewData["Title"] = "Submit Withdraw Request";

    var currentRole = "requestor";

    var req = new
    {
        Id = "WR-002",
        Name = "Okello Brian",
        idNo = "1234",
        Date = "2026-03-11",
        Amount = 320000,
        Status = "pending_supervisor",
        Purpose = "Workshop supplies procurement",
        Notes = "Smaller notes preferred for ease of distribution.",
        Denoms = new Dictionary<int, int> { [20000] = 10, [10000] = 10, [5000] = 4 }
    };
}

@await Html.PartialAsync("~/Views/Shared/_Withdrawal/_WithdrawNavSteps.cshtml")

<div class="role-panel @(currentRole == "requestor" ? "active" : "")" id="panel-requestor">
    <div class="card border-0 shadow mb-3">
        <div class="card-body d-flex align-items-center gap-3">
            <div class="rounded-2 bg-danger bg-opacity-10 text-primary d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:46px;height:46px">
                <i class="ti ti-circle-arrow-up-right-filled text-danger fs-4"></i>
            </div>
            <div>
                <h6 class="mb-0 fw-semibold text-danger">Withdrawal Request </h6>
                <p class="mb-0 text-muted small">Fill in your details and the denominations you need.</p>
            </div>
        </div>
    </div>
    <div class="card mb-3">
        <!-- Header -->
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <h5 class="card-title mb-0">Sender & Receiver</h5>
            </div>
        </div>

        <!-- Body -->
        <div class="card-body">
            <div class="row g-4">

                <!-- Sender -->
                <div class="col-md-6">
                    <div class="text-muted mb-2 d-flex align-items-center gap-2">
                        <i class="ti ti-user"></i>
                        <span>From — sender</span>
                    </div>

                    <div class="fw-bold">DFCU BANK : UGDFCUXXXX</div>
                    <div class="text-muted">
                        14 Nakivubo Road Branch<br>
                        Kampala, Uganda<br>
                        +256 700 123 456
                    </div>
                </div>

                <!-- Receiver -->
                <div class="col-md-6">
                    <div class="text-muted mb-2 d-flex align-items-center gap-2">
                        <i class="ti ti-currency-dollar"></i>
                        <span>To — receiver</span>
                    </div>

                    <div class="fw-bold">BANK OF UGANDA : UGBAUGKAXXX</div>
                    <div class="text-muted">
                        Kampala Road Branch<br>
                        Kampala, Uganda<br>
                        +256 414 306 000
                    </div>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="Index" method="post">
        @Html.AntiForgeryToken()

        <div class="card shadow-sm mb-4 border-0 rounded-3">
            <div class="card-body p-4">

                <!-- Header -->
                <div class="d-flex align-items-center mb-3">
                    <i class="ti ti-file-text text-primary fs-3 me-2 text-danger"></i>
                    <div>
                        <h5 class="fw-semibold mb-0">Agent Details</h5>
                        <small class="text-muted">AUTHORISED STAFF</small>
                    </div>
                </div>

                <!-- Form Fields -->
                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">1. Agent Full Name</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light">
                                <i class="ti ti-user"></i>
                            </span>
                            <input name="RequestorName" type="text" class="form-control" value="@req.Name" placeholder="Full name">
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Valid ID Number</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light">
                                <i class="ti ti-id-badge"></i>
                            </span>
                            <input name="ID Number" type="text" class="form-control" value="@req.idNo" placeholder="ID Number">
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">2. Agent Full Name</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light">
                                <i class="ti ti-user"></i>
                            </span>
                            <input name="RequestorName" type="text" class="form-control" value="@req.Name" placeholder="Full name">
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Valid ID Number</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light">
                                <i class="ti ti-id-badge"></i>
                            </span>
                            <input name="ID Number" type="text" class="form-control" value="@req.idNo" placeholder="ID Number">
                        </div>
                    </div>

                    <!-- Date Needed -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Collection Date</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light">
                                <i class="ti ti-calendar"></i>
                            </span>
                            <input name="DateNeeded" type="date" class="form-control" value="@req.Date">
                        </div>
                    </div>

                    <!-- Comment -->
                    @* <div class="col-md-6">
                        <label class="form-label fw-semibold small">Purpose</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light">
                                <i class="ti ti-tag"></i>
                            </span>
                            <input name="Purpose" type="text" class="form-control" value="@req.Purpose" placeholder="e.g. Field allowances">
                        </div>
                    </div> *@

                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-end mt-4">
                    <a href="#" class="btn btn-outline-secondary btn-sm me-2">
                        <i class="ti ti-x me-1"></i> Edit Details
                    </a>
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="ti ti-device-floppy me-1"></i> Save Agent
                    </button>
                </div>

            </div>
        </div>
    </form>

    <form asp-action="Index" method="post">
        @Html.AntiForgeryToken()

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <!-- Header -->
                <div class="d-flex align-items-center mb-3">
                    <i class="ti ti-cash text-primary fs-3 me-2 text-danger"></i>
                    <div>
                        <h5 class="fw-semibold mb-0">Denomination Breakdown</h5>
                        <small class="text-muted">Enter the quantity for each note or coin. Total calculates automatically.</small>
                    </div>
                </div>
                @await Html.PartialAsync("~/Views/Shared/_Withdrawal/_DenomTable.cshtml",
                (object)new ViewDataDictionary(ViewData) {
                                { "Mode", "input" }, { "FieldPrefix", "Denoms" },
                                { "Denoms", new Dictionary<int,int>() }
                                })
                
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-send me-1"></i>Submit 
                    </button>
                    <button type="reset" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Clear
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>
