@using System.Security.Claims
@model VMSService.Core.Models.CbWithdrawRequest.EditWithdrawViewModel
@{
    Layout = "_CbLayout";
    ViewData["Title"] = "Edit Withdraw Request";
}

@await Html.PartialAsync("~/Views/Shared/_Withdrawal/_WithdrawNavSteps.cshtml", Model.Steps)

@if (TempData["Errors"] is List<string> errors && errors.Any())
{
    <div class="alert alert-danger mb-4">
        <ul class="mb-0">
            @foreach (var error in errors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

<div class="">
    <h5 class="mb-1 text-danger">Withdrawal Request - @User.FindFirst("cbName")?.Value</h5>
    <p class="text-muted mb-3">
        Fill in your withdrawal request details and the denominations required.
    </p>
</div>


<div id="withdrawalForm">

    @* ── Branch Selection ── *@

    @await Html.PartialAsync("~/Views/Shared/_Withdrawal/_BranchSelection.cshtml", Model.Branches)


    @* <div class="role-panel @(currentRole == "requestor" ? "active" : "")" id="panel-requestor"> *@

        @* ── Agent Selection ── *@

        @await Html.PartialAsync("~/Views/Shared/_Withdrawal/_AgentSelection.cshtml", Model.Agents)

        @* ── Denomination Selection ── *@

        @await Html.PartialAsync("~/Views/Shared/_Withdrawal/_DenomTable.cshtml", Model.Denoms)

    @* </div> *@

    @* ── Collection Date ── *@
    @* <div class="card mb-3">
        <div class="card-header bg-white d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="ti ti-clock-12 "></i>
                <span class="text-uppercase mb-0">Collection Details</span>
            </div>
        </div>
        <div class="card-body">
        </div>
    </div> *@

    @* ── RTGS Details ── *@
    <div class="card mb-4 border-top-0 border-end-0 border-bottom-0 border-4 shadow-sm" style="border-color: #541010">
        <div class="card-body">
            <div class="d-flex align-items-center mb-3 justify-content-between">
                <div class="d-flex align-items-center gap-2 fw-bolder">
                    <i class="ti ti-clock-bolt"></i>
                    <span class="text-uppercase mb-0">RTGS Details</span>
                </div>
                <span class="badge bg-success bg-opacity-10 text-uppercase text-success small">
                    Final step before submission
                </span>
            </div>
            <div class="alert alert-warning d-flex align-items-start gap-2 py-2 mb-3">
                <i class="ti ti-info-circle text-warning mt-1 flex-shrink-0"></i>
                <small>
                    Enter the RTGS reference code for verification.
                    Fund settlement value date is the same as the collection date.
                </small>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Fund Settlement Value Date</label>
                    <input type="hidden" name="rtgsDate" value="@Model.Request.FundSettlementValueDate?.ToString("yyyy-MM-dd")" />
                    <p id="rtgsDateDisplay" class="fw-semibold fw-bold mb-1">@Model.Request.FundSettlementValueDate?.ToString("dd MMM yyyy")</p>
                    <small class="text-muted small">Same as collection date</small>
                </div>

                <div class="col-md-6">
                    <label class="form-label">RTGS Code</label>
                    <input type="text"
                           id="rtgsCode"
                           class="form-control"
                           placeholder="e.g. RTGS-2026-001"
                           oninput="formState.rtgsCode = this.value || null" />
                    <small id="rtgsCodeHint" class="text-warning d-none">
                        <i class="ti ti-alert-triangle me-1"></i>Required for same-day collection requests.
                    </small>
                </div>
            </div>

        </div>
    </div>
@* ── Actions ── *@
    <div class="d-flex justify-content-between gap-2 mt-4 mb-5 ">
        <a asp-action="Details" asp-route-id="@Model.Request.Id" class="btn btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i> Back to Details
        </a>
        <button type="button"
                class="btn btn-secondary"
                onclick="submitForm('/CbWithdrawRequests/SaveDraft')">
            <i class="ti ti-device-floppy me-1"></i> Save as Draft
        </button>
    </div>
    @Html.AntiForgeryToken()
</div>

@section Scripts {

    <script src="~/js/collection-date-rules.js"></script>
    <script src="~/js/withdrawal-form.js"></script>
    <script src="~/js/branch-selection.js"></script>
    <script src="~/js/agent-selection.js"></script>
    <script src="~/js/denom-table.js"></script>

    <script>

        // ── Denomination data — must be set before DOMContentLoaded fires preFillDenoms ──
        window.savedDenoms = @Html.Raw(Json.Serialize(
            Model.Denoms.SelectedDenominations.Select(d => new {
                id      = d.DenominationId,
                bundles = d.Bundles,
                boxes   = d.Boxes
            })));

        window.denomData = {
            notes: @Html.Raw(Json.Serialize(Model.Denoms.Notes.Select(d => new {
                id     = d.Id,
                value  = d.Value,
                label  = $"UGX {d.Value:N0}",
                typeId = d.DenominationTypeId
            }))),
            coins: @Html.Raw(Json.Serialize(Model.Denoms.Coins.Select(d => new {
                id     = d.Id,
                value  = d.Value,
                label  = $"UGX {d.Value:N0}",
                typeId = d.DenominationTypeId
            })))
        };

        window.publicHolidayDates = @Html.Raw(Json.Serialize(Model.PublicHolidayDates.Select(h => new { date = h.Date, name = h.Name })));

        window.minWithdrawalAmount = @WithdrawConstants.AmountRules.MinimumWithdrawalAmount;
        window.withdrawalBundleMultiple = @WithdrawConstants.AmountRules.BundleMultiple;

        // ── formState — safe to set now that withdrawal-form.js has run ──────
        formState.id          = '@Model.Request.Id';
        formState.bankBranchId = @Model.Request.BouBranchId;
        formState.cbCode      = document.getElementById('cbCode')?.textContent?.trim() || null;
        formState.createdDate = '@Model.Request.CreatedDate.ToString("yyyy-MM-dd")';

        formState.collectionDate = '@Model.Branches.CollectionDate.ToString("yyyy-MM-dd")';
        const collectionDateInput = document.getElementById('collectionDate');
        if (collectionDateInput) collectionDateInput.min = today;

        formState.rtgsDate = '@Model.Branches.CollectionDate.ToString("yyyy-MM-dd")';
        formState.rtgsCode = @Html.Raw(string.IsNullOrEmpty(Model.Request.RtgsCode)
            ? "null"
            : $"'{Model.Request.RtgsCode}'");

        if (formState.rtgsCode) {
            const el = document.getElementById('rtgsCode');
            if (el) el.value = formState.rtgsCode;
        }

        // If collection date is today and RTGS is not yet filled, mark it required on page load.
        if (formState.collectionDate === today && !formState.rtgsCode) {
            const rtgsCodeInput = document.getElementById('rtgsCode');
            if (rtgsCodeInput) rtgsCodeInput.required = true;
            const rtgsCodeHint = document.getElementById('rtgsCodeHint');
            if (rtgsCodeHint) rtgsCodeHint.classList.remove('d-none');
        }

        formState.requiresSpecialApproval = @Html.Raw(Model.Request.RequiresSpecialApproval ? "true" : "false");
        formState.specialApprovalReason   = @Html.Raw(string.IsNullOrEmpty(Model.Request.SpecialApprovalReason)
            ? "null"
            : $"'{Model.Request.SpecialApprovalReason.Replace("'", "\\'")}'");

        // Pre-fill the unified modal textarea with the saved reason.
        const _reasonInput = document.getElementById('sameDayReasonInput');
        if (_reasonInput && formState.specialApprovalReason)
            _reasonInput.value = formState.specialApprovalReason;

        // Seed lump sum mode if request was saved as lump sum
        document.addEventListener('DOMContentLoaded', () => {
        @if (Model.Denoms.IsLumpSum)
        {
            <text>
            window.setDenomMode('lumpsum');
            const inp = document.getElementById('lumpSumInput');
            if (inp) {
                inp.value = '@Model.Denoms.LumpSumAmount';
                window.onLumpSumInput(inp.value);
            }
            </text>
        }
        else
        {
            <text>
            window.setDenomMode('breakdown');
            </text>
        }
    });

    </script>
}
