@using System.Security.Claims
@model VMSService.Core.Models.CbWithdrawRequest.WithdrawalRequestDetailsViewModel
@{
    Layout = "_CbLayout";
    ViewData["Title"] = "Withdrawal Request Details";
}

@await Html.PartialAsync("~/Views/Shared/_Withdrawal/_WithdrawNavSteps.cshtml", Model.Steps)

@* ── Alerts ── *@
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
        <i class="ti ti-circle-check fs-5"></i>
        <span>@success</span>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
        <i class="ti ti-alert-circle fs-5"></i>
        <span>@error</span>
    </div>
}

@* ── Header Card ── *@
<div class="card border-0 shadow mb-3">
    <div class="card-body d-flex align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-2 bg-danger bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:46px;height:46px">
                <i class="ti ti-circle-arrow-up-right-filled text-danger fs-4"></i>
            </div>
            <div>
                <h6 class="mb-0 fw-semibold text-danger">
                    Withdrawal Request
                    @if (!string.IsNullOrEmpty(Model.ReferenceNumber))
                    {
                        <span class="text-muted fw-normal">— @Model.ReferenceNumber</span>
                    }
                </h6>
                <p class="mb-0 text-muted small">@User.FindFirst("cbName")?.Value</p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary-lt px-3 py-2">
                <i class="ti ti-refresh me-1"></i>@Model.StatusName
            </span>
            @if (Model.RequiresSpecialApproval)
            {
                <span class="badge bg-warning-lt px-3 py-2">
                    <i class="ti ti-star me-1"></i>Special Approval Required
                </span>
            }
        </div>
    </div>
</div>

@* ── Branch Details ── *@
<p class="text-uppercase text-muted small fw-semibold mb-3">Sender & Receiver Branch Details</p>
<div class="card mb-3">
    <div class="card-body">
        <div class="row g-4">

            @* Sender *@
            <div class="col-md-6">
                <div class="text-primary mb-2 d-flex align-items-center gap-2">
                    <i class="ti ti-user"></i>
                    <span class="fw-semibold">From — Sender</span>
                </div>
                <div class="rounded-3 p-3 text-primary">
                    <div class="mb-2">
                        <p class="text-muted mb-0" style="font-size:9px;">SENDER</p>
                        <p class="fw-bold mb-0">@Model.CbName</p>
                    </div>
                    <div class="mb-2">
                        <p class="text-muted mb-0" style="font-size:9px;">BRANCH NAME</p>
                        <p class="fw-bold mb-0">@Model.CbBranchName</p>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <p class="text-muted mb-0" style="font-size:9px;">LOCATION</p>
                            <p class="fw-semibold small mb-0">@Model.CbBranchLocation</p>
                        </div>
                        <div class="col-6">
                            <p class="text-muted mb-0" style="font-size:9px;">DISTRICT</p>
                            <p class="fw-semibold small mb-0">@Model.CbBranchDistrinct</p>
                        </div>
                    </div>
                </div>
            </div>

            @* Receiver *@
            <div class="col-md-6">
                <div class="text-success mb-2 d-flex align-items-center gap-2">
                    <i class="ti ti-building-bank"></i>
                    <span class="fw-semibold">To — Receiver</span>
                </div>
                <div class="rounded-3 p-3 bg-success bg-opacity-10">
                    <div class="mb-2">
                        <p class="text-muted mb-0" style="font-size:9px;">RECEIVER</p>
                        <p class="fw-bold mb-0">BANK OF UGANDA</p>
                    </div>
                    <div class="mb-2">
                        <p class="text-muted mb-0" style="font-size:9px;">BRANCH NAME</p>
                        <p class="fw-bold mb-0">@Model.BouBranchName</p>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <p class="text-muted mb-0" style="font-size:9px;">BRANCH CODE</p>
                            <p class="fw-semibold small mb-0">@Model.BouBranchCode</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Collection Details ── *@
<p class="text-uppercase text-muted small fw-semibold mb-3">Collection Details</p>
<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <p class="text-muted mb-0" style="font-size:9px;">COLLECTION DATE</p>
                <p class="fw-semibold mb-0">@Model.CollectionDate.ToString("dd MMM yyyy")</p>
            </div>
            <div class="col-md-4">
                <p class="text-muted mb-0" style="font-size:9px;">RTGS DATE</p>
                <p class="fw-semibold mb-0">
                    @(Model.RtgsDate.HasValue? Model.RtgsDate.Value.ToString("dd MMM yyyy") : "—")
                </p>
            </div>
            <div class="col-md-4">
                <p class="text-muted mb-0" style="font-size:9px;">RTGS CODE</p>
                <p class="fw-semibold mb-0">@(string.IsNullOrEmpty(Model.RtgsCode) ? "—" : Model.RtgsCode)</p>
            </div>
        </div>
    </div>
</div>

@* ── Agents ── *@
<p class="text-uppercase text-muted small fw-semibold mb-3">Agents / Collectors</p>
<div class="card mb-3">
    <div class="card-body">
        <div class="row g-4">
            @foreach (var agent in Model.WithdrawAgents)
            {
                <div class="col-md-6">
                    <div class="rounded-3 border p-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="ti ti-user-check text-primary"></i>
                            <p class="fw-bold mb-0">@agent.AgentNames</p>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <p class="text-muted mb-0" style="font-size:9px;">NIN</p>
                                <p class="fw-semibold small mb-0">@agent.NIN</p>
                            </div>
                            <div class="col-6">
                                <p class="text-muted mb-0" style="font-size:9px;">PHONE</p>
                                <p class="fw-semibold small mb-0">@agent.PhoneNumber</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@* ── Denominations ── *@
<p class="text-uppercase text-muted small fw-semibold mb-3">Denominations Requested</p>
<div class="card mb-3">
    <div class="card-body">

        @* Notes *@
        @if (Model.Notes.Any())
        {
            <p class="text-muted small fw-semibold mb-2">
                <i class="ti ti-notes me-1"></i>NOTES
            </p>
            <div class="table-responsive mb-4">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Denomination</th>
                            <th class="text-center">Bundles</th>
                            <th class="text-end">Amount (UGX)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var note in Model.Notes)
                        {
                            <tr>
                                <td>@note.DenominationLabel</td>
                                <td class="text-center">@note.Bundles</td>
                                <td class="text-end">@note.Amount.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="2">Total Notes</th>
                            <th class="text-end">@Model.TotalNotesAmount.ToString("N0")</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }

        @* Coins *@
        @if (Model.Coins.Any())
        {
            <p class="text-muted small fw-semibold mb-2">
                <i class="ti ti-coin me-1"></i>COINS
            </p>
            <div class="table-responsive mb-3">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Denomination</th>
                            <th class="text-center">Boxes</th>
                            <th class="text-end">Amount (UGX)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var coin in Model.Coins)
                        {
                            <tr>
                                <td>@coin.DenominationLabel</td>
                                <td class="text-center">@coin.Boxes</td>
                                <td class="text-end">@coin.Amount.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="2">Total Coins</th>
                            <th class="text-end">@Model.TotalCoinsAmount.ToString("N0")</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }

        @* Grand Total *@
        <div class="d-flex justify-content-end">
            <div class="rounded-3 bg-primary bg-opacity-10 px-4 py-3 text-end">
                <p class="text-muted mb-0" style="font-size:9px;">GRAND TOTAL</p>
                <p class="fw-bold fs-5 text-primary mb-0">UGX @Model.TotalAmount.ToString("N0")</p>
            </div>
        </div>

    </div>
</div>

@* ── Workflow Actions ── *@
@if (Model.AvailableTransitions.Any())
{
    <div class="card border-0 bg-light mb-3 shadow-sm">
        <div class="card-header bg-white border-bottom">
            <h6 class="card-title mb-0">
                <i class="ti ti-checkbox me-2 text-primary"></i>Available Actions
            </h6>
        </div>
        <div class="card-body">
            <form method="post" asp-action="ExecuteAction" asp-route-id="@Model.Id" id="workflowForm">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label">Action <span class="text-danger">*</span></label>
                    <select id="actionSelect" name="actionName" class="form-select" required
                            onchange="onActionSelected(this)">
                        <option value="">— Select an action —</option>
                        @foreach (var transition in Model.AvailableTransitions)
                        {
                            <option value="@transition.ActionName"
                                    data-requires-comments="@transition.RequiresComments.ToString().ToLower()"
                                    data-button-class="@transition.ButtonClass"
                                    data-display-label="@transition.DisplayLabel">
                                @transition.DisplayLabel
                            </option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">
                        Comments
                        <span id="commentRequired" class="text-danger" style="display:none;">*</span>
                    </label>
                    <textarea id="remarksTextarea"
                          class="form-control"
                          name="remarks"
                          rows="3"
                          placeholder="Enter your comments..."></textarea>
                    <small id="commentHint" class="text-muted d-block mt-1"></small>
                </div>
                <button type="submit" id="submitBtn" class="btn btn-primary text-white" disabled>
                    <i class="ti ti-check me-1"></i>
                    <span id="submitBtnLabel">Submit</span>
                </button>
            </form>
        </div>
    </div>
}

@* ── Status History ── *@
@if (Model.StatusHistory != null && Model.StatusHistory.Any())
{
    <p class="text-uppercase text-muted small fw-semibold mb-3">Status History</p>
    <div class="card mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>From</th>
                            <th>To</th>
                            <th>Changed By</th>
                            <th>Date</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.StatusHistory)
                        {
                            <tr>
                                <td><span class="badge bg-secondary-lt">@h.OldStatusName</span></td>
                                <td><span class="badge bg-primary-lt">@h.NewStatusName</span></td>
                                <td>@h.ChangedBy</td>
                                <td>@h.ChangedAt.ToString("dd MMM yyyy HH:mm")</td>
                                <td class="text-muted small">@(string.IsNullOrEmpty(h.Remarks) ? "—" : h.Remarks)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@* ── Actions ── *@
<div class="d-flex justify-content-between mb-5">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i> Back to List
    </a>
    @if (Model.CanEdit)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="ti ti-edit me-1"></i> Edit Request
        </a>
    }
</div>

@section Scripts {
    <script>
        function onActionSelected(select) {
            const opt = select.options[select.selectedIndex];
            const requiresComments = opt.dataset.requiresComments === 'true';
            const label = opt.dataset.displayLabel || 'Submit';
            const btnClass = opt.dataset.buttonClass || 'btn-primary';

            const btn = document.getElementById('submitBtn');
            const hint = document.getElementById('commentHint');
            const required = document.getElementById('commentRequired');

            btn.disabled = !select.value;
            btn.className = `btn text-white ${btnClass}`;
            document.getElementById('submitBtnLabel').textContent = label;

            required.style.display = requiresComments ? 'inline' : 'none';
            hint.textContent = requiresComments
                ? 'Comments are required for this action.'
                : '';
        }
    </script>
}