@using System.Security.Claims
@using static VMSService.Core.Static.WithdrawConstants
@model VMSService.Core.Models.CbWithdrawRequest.WithdrawalRequestDetailsViewModel
@{
    Layout = "_CbLayout";
    ViewData["Title"] = "Withdrawal Request Details";
}

<a asp-action="Index" asp-controller="CbRequests" class="d-inline-flex align-items-center gap-1 mb-3 text-muted text-decoration-none fw-bold">
    <i class="ti ti-arrow-left"></i> Back to List
</a>

@await Html.PartialAsync("~/Views/Shared/_Withdrawal/_WithdrawNavSteps.cshtml", Model.Steps)


@* ── Header ── *@
<div class="card border-0 shadow mb-3">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between gap-3 mb-1">
            <div class="d-flex align-items-center gap-2">
                <div class="rounded-2 bg-danger bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:46px;height:46px">
                    <i class="ti ti-circle-arrow-up-right-filled text-danger fs-4"></i>
                </div>
                <h5 class="fw-bold mb-0 text-danger">
                    @(string.IsNullOrEmpty(Model.TransactionRefNumber) ? "Not Generated" : Model.TransactionRefNumber)
                </h5>
                <span class="badge bg-info more-rounded px-3 py-2">
                    @Model.CurrentStatusName
                </span>
                @if (Model.RequiresSpecialApproval)
                {
                    <span class="badge bg-warning text-brown more-rounded bg-opacity-10 px-3 py-2">
                        <i class="ti ti-star me-1"></i>Exceptional Approval Required
                    </span>
                }
            </div>
            <div class="d-flex gap-2">
                @if (Model.CanEdit)
                {
                    @if(Model.CollectionDate >= DateOnly.FromDateTime(DateTime.Today)){
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">
                            <i class="ti ti-edit me-1"></i> Edit Request
                        </a>
                    }
                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteModal">
                        <i class="ti ti-trash me-1"></i> Delete
                    </button>
                }
                @if ((Model.StatusName == WithdrawalStatusNames.PendingApproval || Model.StatusName == WithdrawalStatusNames.Approved) && !Model.FundsNotIssued)
                {
                    <a asp-action="PrintRequest" asp-route-id="@Model.Id"
                       target="_blank" class="btn btn-sm btn-outline-dark">
                        <i class="ti ti-file-text me-1"></i> Print Slip
                    </a>
                }
                
            </div>
        </div>
        <p class="text-muted small mb-0 ps-1">
            Withdrawal Request &middot; @Model.CbName
        </p>
    </div>
</div>

@* ── Two Column Layout ── *@
<div class="row g-3">

    @* ── Left Column ── *@
    <div class="col-md-8">

        @* Special Approval Reason *@
        @if (Model.RequiresSpecialApproval && !string.IsNullOrEmpty(Model.ExceptionalApprovalReason))
        {
            <div class="alert alert-warning d-flex align-items-start gap-3 mb-3">
                <i class="ti ti-alert-triangle fs-4 text-warning flex-shrink-0 mt-1"></i>
                <div class="flex-grow-1">
                    <p class="fw-bold mb-1">Exceptional Approval Required</p>
                    <p class="mb-0 text-muted" style="font-size:9px;">REASON PROVIDED</p>
                    <p class="mb-0 fw-semibold">@Model.ExceptionalApprovalReason</p>
                </div>
                @if (Model.CanEditSameDayReason)
                {
                    <button type="button"
                            class="btn btn-sm btn-outline-warning flex-shrink-0"
                            data-bs-toggle="modal"
                            data-bs-target="#editReasonModal">
                        <i class="ti ti-edit me-1"></i> Edit
                    </button>
                }
            </div>
        }

        

        @* Grace period active — same-day collection, but no exceptional approval needed *@
        @if (!string.IsNullOrEmpty(Model.GracePeriodReason))
        {
            <div class="alert alert-info d-flex align-items-start gap-2 py-2 mb-3">
                <i class="ti ti-info-circle text-info fs-5 flex-shrink-0 mt-1"></i>
                <div>
                    <p class="fw-bold mb-1">Grace Period Active</p>
                    <p class="mb-0 small">
                        Same-day collection does not require exceptional approval today — @Model.GracePeriodReason.
                    </p>
                </div>
            </div>
        }

        @if (Model.IsStalePreSubmission)
        {
            <div class="alert alert-danger d-flex align-items-start gap-2 py-2 mb-3">
                <i class="ti ti-calendar-exclamation text-danger fs-5 flex-shrink-0 mt-1"></i>
                <div>
                    <p class="fw-bold mb-1">Collection Date Has Passed</p>
                    <p class="mb-0 small">
                        This request's collection date is in the past and it hasn't been submitted to BOU yet.
                        Update the collection date before proceeding.
                    </p>
                </div>
            </div>
        }

        @* ── Sender & Receiver ── *@

        <div class="card mb-3 border-top-0 border-end-0 border-bottom-0 border-4 border-warning shadow-sm">

            <div class="card-body">
                <p class="text-uppercase fw-bold mb-3">
                    <i class="ti ti-replace text-muted"></i>
                    Sender & Receiver Details
                </p>
                <hr />
                <div class="row g-3 align-items-center">
                    <div class="col">
                        <div class="rounded-3 p-3 bg-warning bg-opacity-10 border">
                            <p class="text-muted mb-1" style="font-size:9px;">FROM</p>
                            <p class="fw-bold mb-1">@Model.CbName</p>
                            <span class="badge bg-warning text-white">Sender</span>
                        </div>
                    </div>
                    <div class="col-auto text-muted">
                        <i class="ti ti-arrow-right fs-4"></i>
                    </div>
                    <div class="col">
                        <div class="rounded-3 p-3 bg-success bg-opacity-10 border">
                            <p class="text-muted mb-1" style="font-size:9px;">TO</p>
                            <p class="fw-bold mb-1">
                                @Model.BouBranchName
                                <span class="text-muted fw-normal small mb-0 mt-1">- @Model.BouBranchCode</span>
                            </p>
                            <span class="badge bg-success text-white">Receiver</span>
                        </div>
                    </div>
                </div>

                @* Collection Details — date row *@
                <div class="row g-3 mt-2 pt-2 border-top">
                    <div class="col-md-4">
                        <p class="text-muted mb-0" style="font-size:9px;">SUBMISSION DATE</p>
                        <p class="fw-semibold small mb-0">
                            @(Model.SubmissionDate.HasValue ? Model.SubmissionDate.Value.ToString("dd MMM yyyy HH:mm") : "—")
                        </p>
                    </div>
                    <div class="col-md-4">
                        <p class="text-muted mb-0" style="font-size:9px;">COLLECTION DATE</p>
                        <p class="fw-semibold small mb-0">
                            @Model.CollectionDate.ToString("dd MMM yyyy")
                        </p>
                    </div>
                    <div class="col-md-4">
                        <p class="text-muted mb-0" style="font-size:9px;">FUND SETTLEMENT VALUE DATE</p>
                        <p class="fw-semibold small mb-0">
                            @(Model.FundSettlementValueDate.HasValue ? Model.FundSettlementValueDate.Value.ToString("dd MMM yyyy") : "—")
                        </p>
                    </div>
                </div>

                @* RTGS row *@
                @if (Model.CanEditRtgs)
                {
                    <form method="post" asp-action="UpdateRtgs" asp-route-id="@Model.Id">
                        @Html.AntiForgeryToken()
                        <div class="row g-3 mt-2 pt-2 border-top align-items-end">
                            <div class="col-md-4">
                                <input type="hidden" name="rtgsDate" value="@Model.FundSettlementValueDate?.ToString("yyyy-MM-dd")" />
                                <label class="text-muted mb-1" style="font-size:9px;">RTGS CODE</label>
                                <input type="text" name="rtgsCode" class="form-control form-control-sm"
                                       value="@Model.RtgsCode" placeholder="Enter RTGS code" />
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-sm btn-primary">
                                    <i class="ti ti-check me-1"></i> Save RTGS
                                </button>
                            </div>
                        </div>
                    </form>
                }
                else
                {
                    <div class="row g-3 mt-2 pt-2 border-top">
                        <div class="col-md-4">
                            <p class="text-muted mb-0" style="font-size:9px;">RTGS CODE</p>
                            <p class="fw-semibold small mb-0">
                                @(string.IsNullOrEmpty(Model.RtgsCode) ? "—" : Model.RtgsCode)
                            </p>
                        </div>
                    </div>
                }

                @if (Model.RecallRtgsDate.HasValue)
                {
                    <div class="row g-3 mt-2 pt-2 border-top">
                        <div class="col-md-12">
                            <p class="text-uppercase text-muted fw-semibold mb-2" style="font-size:9px;">RECALL RTGS</p>
                            <div class="d-flex align-items-center gap-3">
                                <span class="badge bg-success rounded-pill px-3 py-2">
                                    <i class="ti ti-circle-check me-1"></i> Reverse RTGS Completed
                                </span>
                                <span class="small text-muted">
                                    @Model.RecallRtgsDate.Value.ToString("dd MMM yyyy") — @Model.RecallRtgsCode
                                </span>
                            </div>
                        </div>
                    </div>
                }
                else if (Model.RecallRtgsPending)
                {
                    <div class="row g-3 mt-2 pt-2 border-top">
                        <div class="col-md-12">
                            <p class="text-uppercase text-muted fw-semibold mb-2" style="font-size:9px;">RECALL RTGS</p>
                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                                <i class="ti ti-clock me-1"></i> Reverse RTGS Pending
                            </span>
                        </div>
                    </div>
                }

                @* Return RTGS (Reject / Exceptional Reject) — same completed-vs-pending badge as
                   Recall RTGS above, keyed off ReturnRtgsDate the same way WithdrawalRequests'
                   BOU-side Details.cshtml does, since this ViewModel doesn't carry ReturnRtgsPending
                   itself. *@
                @{
                    var isReturnPending = !Model.ReturnRtgsDate.HasValue &&
                        (Model.StatusName == WithdrawalStatusNames.Rejected ||
                         Model.StatusName == WithdrawalStatusNames.RejectExceptionalApproval);
                }
                @if (Model.ReturnRtgsDate.HasValue)
                {
                    <div class="row g-3 mt-2 pt-2 border-top">
                        <div class="col-md-12">
                            <p class="text-uppercase text-muted fw-semibold mb-2" style="font-size:9px;">RETURN RTGS</p>
                            <div class="d-flex align-items-center gap-3">
                                <span class="badge bg-success rounded-pill px-3 py-2">
                                    <i class="ti ti-circle-check me-1"></i> Reverse RTGS Completed
                                </span>
                                <span class="small text-muted">
                                    @Model.ReturnRtgsDate.Value.ToString("dd MMM yyyy") — @Model.ReturnRtgsCode
                                </span>
                            </div>
                        </div>
                    </div>
                }
                else if (isReturnPending)
                {
                    <div class="row g-3 mt-2 pt-2 border-top">
                        <div class="col-md-12">
                            <p class="text-uppercase text-muted fw-semibold mb-2" style="font-size:9px;">RETURN RTGS</p>
                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                                <i class="ti ti-clock me-1"></i> Reverse RTGS Pending
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* ── Agents ── *@
        <div class="card mb-3 border-top-0 border-end-0 border-bottom-0 border-4 shadow-sm" style="border-color: #D4500A">
            <div class="card-body">
                <p class="text-uppercase fw-bold mb-3">
                    <i class="ti ti-friends text-muted"></i>
                    Agent Details
                </p>
                <hr />
                <div class="row g-4">
                    @foreach (var (agent, index) in Model.WithdrawAgents.Select((a, i) => (a, i + 1)))
                    {
                        <div class="col-md-6">
                            <div class="border rounded-3 p-3">
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <span class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center fw-bold"
                                          style="width:24px;height:24px;font-size:11px;">@index</span>
                                    <span class="text-uppercase text-muted small fw-semibold">Collector @index</span>
                                </div>

                                @* Photo + Details *@
                                <div class="d-flex gap-3 mb-3">
                                    <div class="flex-shrink-0">
                                        @if (!string.IsNullOrEmpty(agent.PassportPhoto))
                                        {
                                            <img src="@FileUrlHelper.ToWebPath(agent.PassportPhoto)" alt="Photo"
                                                 class="rounded-2 border"
                                                 style="width:80px;height:100px;object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <div class="border rounded-2 bg-light d-flex align-items-center justify-content-center"
                                                 style="width:80px;height:100px;">
                                                <i class="ti ti-user text-muted fs-2"></i>
                                            </div>
                                        }
                                    </div>
                                    <div class="flex-grow-1">
                                        <p class="fw-bold mb-2">@agent.AgentNames</p>
                                        <div class="mb-1">
                                            <p class="text-muted mb-0" style="font-size:9px;">NIN</p>
                                            <p class="fw-semibold small mb-0">@agent.NIN</p>
                                        </div>
                                       @*  <div class="mb-1">
                                            <p class="text-muted mb-0" style="font-size:9px;">WORK ID</p>
                                            <p class="fw-semibold small mb-0">@agent.WorkIdScan</p>
                                        </div> *@
                                        <div>
                                            <p class="text-muted mb-0" style="font-size:9px;">PHONE</p>
                                            <p class="fw-semibold small mb-0 text-primary">@agent.PhoneNumber</p>
                                        </div>
                                    </div>
                                </div>

                                @* Work ID Scan *@
                                <div class="mb-2">
                                    <p class="text-muted mb-1" style="font-size:9px;">WORK ID SCAN</p>
                                    @if (!string.IsNullOrEmpty(agent.WorkIdScan))
                                    {
                                        <img src="@FileUrlHelper.ToWebPath(agent.WorkIdScan)" alt="Work ID"
                                             class="rounded-2 border w-100"
                                             style="max-height:120px;object-fit:contain;" />
                                    }
                                    else
                                    {
                                        <div class="border rounded-2 bg-light d-flex align-items-center justify-content-center"
                                             style="height:70px;">
                                            <span class="text-muted small">No scan uploaded</span>
                                        </div>
                                    }
                                </div>

                                @* Signature *@
                                <div>
                                    <p class="text-muted mb-1" style="font-size:9px;">SIGNATURE</p>
                                    @if (!string.IsNullOrEmpty(agent.SignatureScan))
                                    {
                                        <img src="@FileUrlHelper.ToWebPath(agent.SignatureScan)" alt="Signature"
                                             class="rounded-2 border w-100"
                                             style="max-height:56px;object-fit:contain;" />
                                    }
                                    else
                                    {
                                        <div class="border rounded-2 bg-light d-flex align-items-center justify-content-center"
                                             style="height:56px;">
                                            <span class="text-muted small">No signature uploaded</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── Denominations ── *@
        <div class="card mb-3 border-top-0 border-end-0 border-bottom-0 border-4 shadow-sm" style="border-color: #b31b34">
            <div class="card-body d-flex flex-column gap-3">

                <div>
                    <p class="text-uppercase fw-bold mb-3">
                        <i class="ti ti-cash text-muted"></i>
                        Denomination Details
                    </p>
                    <hr />
                </div>

                @if (Model.FundsNotIssued)
                {
                    <div class="border border-danger rounded-3 p-3 bg-danger bg-opacity-10">
                        <div class="d-flex align-items-center gap-2">
                            <i class="ti ti-ban text-danger"></i>
                            <span class="fw-bold text-danger text-uppercase small">Funds Not Issued</span>
                        </div>
                        <p class="text-muted small mb-0 mt-1">
                            The bank has confirmed that no funds were dispatched for this request.
                        </p>
                    </div>
                }

                @if (Model.IsLumpSum)
                {
                    @* ── Lump Sum Display ── *@
                    <div class="overflow-hidden">
                        <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom">
                            <div class="d-flex align-items-center gap-2 text-uppercase fw-bold small">
                                <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold"
                                      style="width:18px;height:18px;font-size:9px;background:#fff3e0;color:#e65100;">L</span>
                                Lump Sum Amount
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center px-3 py-3">
                            <span class="fs-6 text-muted">Total Amount (UGX)</span>
                            <span class="fw-bold fs-6">UGX @Model.TotalAmount.ToString("N0")</span>
                        </div>
                    </div>
                    @* <div class="border rounded-3 overflow-hidden">
                        <div class="d-flex align-items-center gap-2 px-3 py-2 border-bottom">
                            <i class="ti ti-sum text-muted"></i>
                            <span class="text-uppercase fw-bold small">Lump Sum Amount</span>
                        </div>
                    </div> *@
                }
                else
                {
                    @* ── Banknotes ── *@
                    @if (Model.Notes.Any())
                    {
                        <div class="border rounded-3 overflow-hidden">
                            <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom">
                                <div class="d-flex align-items-center gap-2 text-uppercase fw-bold small">
                                    <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold"
                                          style="width:18px;height:18px;font-size:9px;background:#fff3e0;color:#e65100;">N</span>
                                    Banknotes
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead>
                                        <tr style="background:#fafafa;">
                                            <th class="ps-3 text-muted fw-semibold" style="font-size:10px;letter-spacing:.05em;">DENOMINATION</th>
                                            <th class="text-end text-muted fw-semibold" style="font-size:10px;letter-spacing:.05em;">BUNDLES</th>
                                            <th class="text-end pe-3 text-muted fw-semibold" style="font-size:10px;letter-spacing:.05em;">AMOUNT</th>
                                        </tr>
                                    </thead>
                                    <tbody class="small">
                                        @foreach (var note in Model.Notes)
                                        {
                                            <tr class="border-bottom">
                                                <td class="ps-3">@note.DenominationLabel</td>
                                                <td class="text-end">@note.Bundles?.ToString("N0")</td>
                                                <td class="text-end pe-3 text-primary">UGX @note.Amount.ToString("N0")</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="fw-bold small">
                                            <th class="ps-3 text-uppercase" colspan="2">Total Banknotes</th>
                                            <th class="text-end pe-3 text-primary">UGX @Model.TotalNotesAmount.ToString("N0")</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    }

                    @* ── Coins ── *@
                    @if (Model.Coins.Any())
                    {
                        <div class="border rounded-3 overflow-hidden">
                            <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom">
                                <div class="d-flex align-items-center gap-2 text-uppercase fw-bold small">
                                    <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold"
                                          style="width:18px;height:18px;font-size:9px;background:#faeeda;color:#BA7517;">C</span>
                                    Coins
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead>
                                        <tr style="background:#fafafa;">
                                            <th class="ps-3 text-muted fw-semibold" style="font-size:10px;letter-spacing:.05em;">DENOMINATION</th>
                                            <th class="text-end text-muted fw-semibold" style="font-size:10px;letter-spacing:.05em;">BOXES</th>
                                            <th class="text-end pe-3 text-muted fw-semibold" style="font-size:10px;letter-spacing:.05em;">AMOUNT</th>
                                        </tr>
                                    </thead>
                                    <tbody class="small">
                                        @foreach (var coin in Model.Coins)
                                        {
                                            <tr class="border-bottom">
                                                <td class="ps-3">@coin.DenominationLabel</td>
                                                <td class="text-end">@coin.Boxes?.ToString("N0")</td>
                                                <td class="text-end pe-3 text-warning">UGX @coin.Amount.ToString("N0")</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="fw-bold small">
                                            <th class="ps-3 text-uppercase" colspan="2">Total Coins</th>
                                            <th class="text-end pe-3 text-warning">UGX @Model.TotalCoinsAmount.ToString("N0")</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    }

                    @* ── Notes + Coins subtotals (only shown when both exist) ── *@
                    @if (Model.Notes.Any() && Model.Coins.Any())
                    {
                        <div class="border rounded-3 overflow-hidden">
                            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                                <div class="d-flex align-items-center gap-2 small fw-semibold text-secondary">
                                    <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold"
                                          style="width:18px;height:18px;font-size:9px;background:#fff3e0;color:#e65100;">N</span>
                                    Total Banknotes
                                </div>
                                <span class="fw-bold text-primary">UGX @Model.TotalNotesAmount.ToString("N0")</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center px-3 py-2">
                                <div class="d-flex align-items-center gap-2 small fw-semibold text-secondary">
                                    <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold"
                                          style="width:18px;height:18px;font-size:9px;background:#faeeda;color:#BA7517;">C</span>
                                    Total Coins
                                </div>
                                <span class="fw-bold text-warning">UGX @Model.TotalCoinsAmount.ToString("N0")</span>
                            </div>
                        </div>
                    }
                }

                @* ── Grand Total — always shown ── *@
                <div class="denom-grand rounded px-4 py-3">
                    <div class="d-flex justify-content-between align-items-baseline mb-2">
                        <span class="text-uppercase fw-bold text-white fs-6 opacity-75"
                              style="letter-spacing:.07em;">Grand Total</span>
                        <span class="fw-bold text-white" style="font-size:18px;">UGX @Model.TotalAmount.ToString("N0")</span>
                    </div>
                    <div class="border-top pt-2 fs-6 fst-italic text-end text-white opacity-75"
                         style="border-color:rgba(255,255,255,.2)!important;">
                        <span id="denom-g-words"></span>
                    </div>
                </div>

            </div>
        </div>

        @* ── Penalties (read-only — CB can see charges but cannot manage them) ── *@
        @if (Model.AppliedPenalties.Any())
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center gap-2 fw-bolder">
                            <i class="ti ti-gavel"></i>
                            <span class="text-uppercase">Penalties</span>
                        </div>
                        <span class="badge bg-danger rounded-pill px-3 py-2">
                            Total Applied: UGX @Model.AppliedPenalties.Sum(a => a.ChargeValue).ToString("N0")
                        </span>
                    </div>
                    @await Html.PartialAsync("~/Views/Shared/_Withdrawal/_AppliedPenaltiesTable.cshtml", Model.AppliedPenalties)
                </div>
            </div>
        }

        @* ── Comments / Status History ── *@
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 fw-bolder mb-3">
                    <i class="ti ti-message"></i>
                    <span class="text-uppercase">Comments</span>
                </div>
                @if (Model.StatusHistory != null && Model.StatusHistory.Any())
                {
                    <div class="timeline">
                        @foreach (var history in Model.StatusHistory)
                        {
                            <div class="timeline-item mb-4">
                                <div class="d-flex gap-3">
                                    <div class="timeline-marker">
                                        <i class="ti ti-circle-check text-success"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h6 class="mb-1 small">
                                                    <strong>@history.OldStatusName</strong>
                                                    <i class="ti ti-arrow-right text-muted"></i>
                                                    <strong>@history.NewStatusName</strong>
                                                </h6>
                                                <small class="text-muted">
                                                    By: <strong>@history.ChangedBy</strong>
                                                </small>
                                            </div>
                                            <small class="text-muted">
                                                @history.ChangedAt.ToString("dd/MMM/yyyy HH:mm:ss")
                                            </small>
                                        </div>
                                        @if (!string.IsNullOrEmpty(history.Remarks))
                                        {
                                            <div class="mt-2 p-2 bg-white rounded border">
                                                <span class="d-block">@history.Remarks</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted text-center">
                        <i class="ti ti-inbox me-2"></i>No comments yet.
                    </p>
                }
            </div>
        </div>

        @* ── Delete Confirmation Modal ── *@
        <div class="modal fade" id="deleteModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-2 bg-danger bg-opacity-10 d-flex align-items-center justify-content-center"
                                 style="width:36px;height:36px;">
                                <i class="ti ti-trash text-danger fs-5"></i>
                            </div>
                            <div>
                                <h5 class="modal-title mb-0 fw-bold">Delete Request</h5>
                                <p class="text-muted small mb-0">This action cannot be undone</p>
                            </div>
                        </div>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-danger d-flex gap-2 py-2 mb-0">
                            <i class="ti ti-info-circle flex-shrink-0 mt-1"></i>
                            <small>
                                Are you sure you want to delete this withdrawal request?
                                It will be permanently removed from the system.
                            </small>
                        </div>
                    </div>
                    <div class="modal-footer border-top">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            <i class="ti ti-x me-1"></i> Cancel
                        </button>
                        <form method="post"
                              asp-action="Delete"
                              asp-route-id="@Model.Id">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">
                                <i class="ti ti-trash me-1"></i> Yes, Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.CanEditSameDayReason)
        {
            @* ── Edit Reason Modal ── *@
            <div class="modal fade" id="editReasonModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <form method="post" asp-action="SetSameDayReason" asp-route-id="@Model.Id">
                            @Html.AntiForgeryToken()
                            <div class="modal-header border-bottom">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-2 bg-warning bg-opacity-10 d-flex align-items-center justify-content-center"
                                         style="width:36px;height:36px;">
                                        <i class="ti ti-alert-triangle text-warning fs-5"></i>
                                    </div>
                                    <h5 class="modal-title mb-0 fw-bold">Edit Exceptional Approval Reason</h5>
                                </div>
                            </div>
                            <div class="modal-body">
                                <label for="reason" class="form-label">Reason</label>
                                <textarea name="reason" id="reason" class="form-control" rows="3"
                                          maxlength="500">@Model.ExceptionalApprovalReason</textarea>
                            </div>
                            <div class="modal-footer border-top">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                    <i class="ti ti-x me-1"></i> Cancel
                                </button>
                                <button type="submit" class="btn btn-warning">
                                    <i class="ti ti-check me-1"></i> Save Reason
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }

        @* ── Bottom Actions ── *@
        <div class="d-flex justify-content-between mb-5">
            <a asp-action="Index" asp-controller="CbRequests" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1"></i> Back to List
            </a>
            @if (Model.CanEdit && Model.CollectionDate >= DateOnly.FromDateTime(DateTime.Today))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="ti ti-edit me-1"></i> Edit Request
                </a>
            }
        </div>

    </div>

    @* ── Right Column — Sticky Action Panel ── *@
    <div class="col-md-4">
        <div class="sticky-top" style="top:80px;">

            @* Summary Card *@
            <div class="card mb-3 border-danger">
                <div class="card-header text-white d-flex align-items-center gap-2"
                     style="background:#b71c1c;">
                    <i class="ti ti-circle-arrow-up-right-filled fs-4"></i>
                    <div>
                        <p class="fw-bold small mb-0 text-uppercase">
                            @(Model.AvailableTransitions.Any() ? "Action Required" : "Withdrawal Request Summary")
                        </p>
                        <p class="mb-0 text-white-50" style="font-size:11px;">
                            @(Model.AvailableTransitions.Any() ? "Review the request and take action" : "Overview of Withdrawal request")
                        </p>
                    </div>
                </div>
                <div class="card-body">

                    @if (Model.StatusName == WithdrawalStatusNames.Expired)
                    {
                        var expiryEntry = Model.StatusHistory.LastOrDefault(h => h.NewStatusName == WithdrawalStatusNames.Expired);
                        if (expiryEntry != null && !string.IsNullOrWhiteSpace(expiryEntry.Remarks))
                        {
                            <div class="alert alert-danger d-flex align-items-start gap-2 py-2 mb-3">
                                <i class="ti ti-clock-x text-danger fs-5 flex-shrink-0 mt-1"></i>
                                <div>
                                    <p class="fw-bold mb-1">Request Expired</p>
                                    <p class="mb-0 small">@expiryEntry.Remarks</p>
                                </div>
                            </div>
                        }
                    }

                    @* Summary rows *@
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted small">Request ID</span>
                        <span class="fw-semibold small">
                            @(string.IsNullOrEmpty(Model.TransactionRefNumber) ? "Not Generated" : Model.TransactionRefNumber)
                        </span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted small">Amount</span>
                        <span class="fw-bold text-danger">UGX @Model.TotalAmount.ToString("N0")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted small">From</span>
                        <span class="fw-semibold small">@Model.CbName</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted small">To</span>
                        <span class="fw-semibold small">@Model.BouBranchName</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted small">Collection</span>
                        <span class="fw-semibold small">@Model.CollectionDate.ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted small">Submission Date</span>
                        <span class="fw-semibold small">
                            @(Model.SubmissionDate.HasValue ? Model.SubmissionDate.Value.ToString("dd MMM yyyy HH:mm") : "—")
                        </span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted small">Status</span>
                        <span class="badge bg-info p-2 more-rounded">@Model.CurrentStatusName</span>
                    </div>

                    @* Attachments *@
                    @if (Model.AllAttachments.Any())
                    {
                        <div class="border-top pt-3 mt-1">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <h6 class="mb-0 fw-bold text-uppercase small">
                                    <i class="ti ti-paperclip me-1"></i>Attachments
                                </h6>
                                <span class="badge bg-secondary bg-opacity-10 text-secondary">
                                    @Model.AllAttachments.Count()
                                </span>
                            </div>
                            <div class="d-flex flex-column gap-2">
                                @foreach (var attachment in Model.AllAttachments.OrderByDescending(a => a.UploadedDate))
                                {
                                    <div class="border rounded p-2 bg-light">
                                        <div class="d-flex align-items-start gap-2 mb-2">
                                            <i class="ti @attachment.FileIcon @attachment.FileColor fs-4 flex-shrink-0"></i>
                                            <div class="flex-grow-1 overflow-hidden">
                                                <p class="mb-0 small fw-semibold text-truncate" title="@attachment.FileName">
                                                    @attachment.FileName
                                                </p>
                                                <small class="text-muted d-block">@attachment.FileSizeFormatted</small>
                                                <small class="text-muted d-block">@attachment.UploadedDate.ToString("dd MMM yyyy HH:mm")</small>
                                            </div>
                                        </div>
                                        <div class="d-flex gap-1">
                                            @if (attachment.IsPreviewable)
                                            {
                                                <a href="/@attachment.FilePath" target="_blank"
                                                   class="btn btn-sm btn-outline-info flex-fill">
                                                    <i class="ti ti-external-link me-1"></i>
                                                    @(attachment.IsPdf ? "Open PDF" : "Open")
                                                </a>
                                            }
                                            <a href="@FileUrlHelper.ToWebPath(attachment.FilePath)" download="@attachment.FileName" target="_blank"
                                               class="btn btn-sm btn-outline-primary flex-fill">
                                                <i class="ti ti-download me-1"></i>Download
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* Workflow Actions *@
                    @if (Model.CanEditRtgs && Model.StatusName == WithdrawalStatusNames.PendingRTGSVerification)
                    {
                        <div class="border-top mt-2 pt-3">
                            <div class="alert alert-warning mb-0">
                                <i class="ti ti-alert-triangle me-1"></i>
                                Please enter RTGS Code above before proceeding.
                            </div>
                        </div>
                    }
                    else if (Model.AvailableTransitions.Any() && Model.AvailableTransitions.All(t => t.ActionName == WithdrawalStatusActionNames.RequestRecall))
                    {
                        <div class="border-top mt-2 pt-3">
                            <div class="d-grid mb-2">
                                <button type="button" class="btn btn-sm btn-warning"
                                        onclick="document.getElementById('recallSection').style.display =
                                                 document.getElementById('recallSection').style.display === 'none' ? 'block' : 'none'">
                                    <i class="ti ti-arrow-back-up me-1"></i> Request Recall
                                </button>
                            </div>
                            <div id="recallSection" style="display:none;">
                                @{var recall = Model.AvailableTransitions.First();}
                                <form method="post"
                                      asp-action="ExecuteAction"
                                      asp-route-id="@Model.Id">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="actionName" value="@recall.ActionName" />
                                    <div class="mb-3">
                                        <label class="form-label small text-uppercase text-muted fw-semibold">
                                            Reason for Recall <span class="text-danger">*</span>
                                        </label>
                                        <textarea name="remarks" class="form-control form-control-sm" rows="3"
                                                  placeholder="Please explain why you are recalling this request..." required></textarea>
                                    </div>
                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-warning btn-sm">
                                            <i class="ti ti-arrow-back-up me-1"></i> Submit Recall Request
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    }
                    else if (Model.AvailableTransitions.Any())
                    {
                        <div class="border-top mt-2 pt-3">
                            @if (Model.ShowExceptionalApprovalWarning)
                            {
                                <div class="alert alert-warning d-flex align-items-start gap-2 py-2 mb-3">
                                    <i class="ti ti-alert-triangle text-warning fs-5 flex-shrink-0 mt-1"></i>
                                    <div>
                                        <p class="fw-bold mb-1">Same-Day Exceptional Approval</p>
                                        <p class="mb-0 small">
                                            The collection date is today. Approving this request will flag it for
                                            exceptional review. You must provide a reason in the comment below.
                                        </p>
                                    </div>
                                </div>
                            }
                            <form method="post"
                                  asp-action="ExecuteAction"
                                  asp-route-id="@Model.Id"
                                  id="workflowForm">
                                @* CB Maker same-day notice *@
                                @if (Model.ShowSameDayMakerWarning)
                                {
                                    <div class="alert alert-warning d-flex align-items-start gap-2 py-2 mb-3">
                                        <i class="ti ti-alert-triangle text-warning fs-5 flex-shrink-0 mt-1"></i>
                                        <div>
                                            <p class="fw-bold mb-1">Same-Day Collection</p>
                                            <p class="mb-0 small">
                                                The collection date is today. If this request is approved today, it will be
                                                flagged as a same-day exceptional request.
                                                @if (Model.CanEdit)
                                                {
                                                    <span>Consider editing the request to select a future date if possible.</span>
                                                }
                                            </p>
                                        </div>
                                    </div>
                                }

                                <div class="mb-3">
                                    <label class="form-label small text-uppercase text-muted fw-semibold">
                                        Comment <span id="commentRequired" class="text-danger" @(Model.ShowExceptionalApprovalWarning ? "" : "style=\"display:none;\"")>*</span>
                                    </label>
                                    <textarea id="remarksTextarea"
                                              class="form-control form-control-sm"
                                              name="remarks"
                                              rows="5"
                                              style="min-height:150px;"
                                              placeholder="@(Model.ShowExceptionalApprovalWarning ? "Provide a reason for same-day exceptional approval ..." : "Add a comment ...")"
                                              @(Model.ShowExceptionalApprovalWarning ? "required" : "")></textarea>
                                    <small id="commentHint" class="text-muted d-block mt-1"></small>
                                </div>

                                @if (Model.AvailableTransitions.Count == 1)
                                {
                                    var t = Model.AvailableTransitions.First();
                                    <input name="actionName" id="soloActionName" value="@t.ActionName"
                                           data-requires-comments="@t.RequiresComments.ToString().ToLower()" hidden />
                                    <div class="d-grid gap-2">
                                        <button type="submit" id="submitBtn" class="btn @t.ButtonClass text-white">
                                            <i class="ti ti-check me-1"></i>
                                            <span id="submitBtnLabel">@t.DisplayLabel</span>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="mb-3">
                                        <label class="form-label small text-uppercase text-muted fw-semibold">
                                            Select Action <span class="text-danger">*</span>
                                        </label>
                                        <select id="actionSelect" name="actionName" class="form-select form-select-sm" required>
                                            <option value="">— Choose an action —</option>
                                            @foreach (var transition in Model.AvailableTransitions)
                                            {
                                                <option value="@transition.ActionName"
                                                        data-requires-comments="@transition.RequiresComments.ToString().ToLower()"
                                                        data-button-class="@transition.ButtonClass"
                                                        data-display-label="@transition.DisplayLabel">
                                                    @transition.DisplayLabel
                                                </option>
                                            }
                                        </select>
                                    </div>
                                    <div class="d-grid">
                                        <button type="submit" id="submitBtn" class="btn btn-primary" disabled>
                                            <i class="ti ti-check me-1"></i>
                                            <span id="submitBtnLabel">Confirm Action</span>
                                        </button>
                                    </div>
                                }

                                @Html.AntiForgeryToken()
                            </form>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {

    <script src="~/js/withdrawal-form.js"></script>

    <script>
        document.getElementById('denom-g-words').textContent = toWords(@Model.TotalAmount);

        document.addEventListener('DOMContentLoaded', function () {
            const actionSelect    = document.getElementById('actionSelect');
            const remarksTextarea = document.getElementById('remarksTextarea');
            const commentRequired = document.getElementById('commentRequired');
            const commentHint     = document.getElementById('commentHint');
            const submitBtn       = document.getElementById('submitBtn');
            const submitBtnLabel  = document.getElementById('submitBtnLabel');
            const workflowForm    = document.getElementById('workflowForm');
            const soloActionName  = document.getElementById('soloActionName');

            // Wire up comment requirement for single-transition case
            if (soloActionName) {
                if (soloActionName.dataset.requiresComments === 'true') {
                    commentRequired.style.display = 'inline';
                    remarksTextarea.required = true;
                }
            }

            // Wire up action select for multi-transition case
            if (actionSelect && workflowForm) {
                actionSelect.addEventListener('change', function () {
                    const opt = this.options[this.selectedIndex];
                    const requiresComments = opt.dataset.requiresComments === 'true';
                    const actionName = opt.value;

                    if (actionName) {
                        commentRequired.style.display = requiresComments ? 'inline' : 'none';
                        remarksTextarea.required = requiresComments;
                        submitBtn.disabled = false;
                        submitBtnLabel.textContent = opt.dataset.displayLabel;
                        submitBtn.className = `text-white btn ${opt.dataset.buttonClass}`;
                    } else {
                        commentRequired.style.display = 'none';
                        remarksTextarea.required = false;
                        commentHint.textContent = '';
                        submitBtn.disabled = true;
                        submitBtnLabel.textContent = 'Confirm Action';
                        submitBtn.className = 'text-white btn btn-primary';
                    }
                });

                workflowForm.addEventListener('submit', function (e) {
                    const opt = actionSelect.options[actionSelect.selectedIndex];
                    if (opt.dataset.requiresComments === 'true' && !remarksTextarea.value.trim()) {
                        e.preventDefault();
                        commentHint.textContent = 'Comments are required for this action.';
                        commentHint.className = 'text-danger d-block mt-1';
                        remarksTextarea.focus();
                    }
                });
            }
        });
    </script>
}