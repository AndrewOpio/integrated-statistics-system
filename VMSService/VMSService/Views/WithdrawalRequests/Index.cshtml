@model VMSService.Core.Models.WithdrawalRequests.BouWithdrawalRequestViewModel
@{
    ViewData["Title"] = "Withdraw Requests";

}

@* ── Page Header ── *@
<div class="mb-3">
    <h5 class="fw-bold mb-0">Withdrawal Requests</h5>
    <p class="text-muted small mb-0">Cash Operations · @DateTime.Now.ToString("dddd d MMMM yyyy")</p>
</div>

@* ── Metric Cards ── *@
@* ── Location Filter Pills ── *@
<div class="d-flex align-items-center gap-2 flex-wrap mb-3">

    @if (Model.CanViewAllLocations)
    {
        <div class="position-relative pill-wrap">
            <a href="@Url.Action("Index")"
               class="location-pill @(Model.SelectedBranch == null ? "active" : "")"
               title="All locations">
                ALL
            </a>
            <div class="pill-tooltip">All locations</div>
        </div>
    }

    @foreach (var branch in Model.BouBranches)
    {
        <div class="position-relative pill-wrap">
            <a href="@Url.Action("Index", new { branchCode = branch.BranchCode })"
               class="location-pill @(Model.SelectedBranch == branch.BranchCode ? "active" : "")"
               title="@branch.Name">
                @branch.BranchCode
            </a>
            <div class="pill-tooltip">@branch.Name</div>
        </div>
    }

</div>

@* ── Hero Cards ── *@
<div class="row g-3 mb-3" id="metric-cards">
    <div class="col-md-3">
        <div class="card-hover rounded-3 p-3 text-white" style="background:#b31b34">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="small fw-semibold opacity-75 text-uppercase" style="font-size:11px;">Pending CB Action</span>
                <div class="rounded-2 d-flex align-items-center justify-content-center"
                     style="width:28px;height:28px;background:rgba(255,255,255,0.15)">
                    <i class="ti ti-clock-hour-4" style="font-size:14px;"></i>
                </div>
            </div>
            <div class="fw-bold mb-1" style="font-size:26px;">@Model.PendingCbCount</div>
            <div class="opacity-75" style="font-size:11px;">Awaiting internal approval</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-hover rounded-3 p-3 text-white" style="background:#c44a1a">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="small fw-semibold opacity-75 text-uppercase" style="font-size:11px;">Under BOU Processing</span>
                <div class="rounded-2 d-flex align-items-center justify-content-center"
                     style="width:28px;height:28px;background:rgba(255,255,255,0.15)">
                    <i class="ti ti-settings" style="font-size:14px;"></i>
                </div>
            </div>
            <div class="fw-bold mb-1" style="font-size:26px;">@Model.UnderBouProcessing</div>
            <div class="opacity-75" style="font-size:11px;">Verification, recommendation & approval</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-hover rounded-3 p-3 text-white" style="background:#BA7517">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="small fw-semibold opacity-75 text-uppercase" style="font-size:11px;">Recalls</span>
                <div class="rounded-2 d-flex align-items-center justify-content-center"
                     style="width:28px;height:28px;background:rgba(255,255,255,0.15)">
                    <i class="ti ti-arrow-back-up" style="font-size:14px;"></i>
                </div>
            </div>
            <div class="fw-bold mb-1" style="font-size:26px;">@Model.RecallCount</div>
            <div class="opacity-75" style="font-size:11px;">Requested & recalled</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-hover rounded-3 p-3 text-white" style="background:#EF9F27">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="small fw-semibold opacity-75 text-uppercase" style="font-size:11px;">Total Processed</span>
                <div class="rounded-2 d-flex align-items-center justify-content-center"
                     style="width:28px;height:28px;background:rgba(255,255,255,0.15)">
                    <i class="ti ti-check" style="font-size:14px;"></i>
                </div>
            </div>
            <div class="fw-bold mb-1" style="font-size:22px;">UGX @Model.TotalProcessed.ToString("N0")</div>
            <div class="opacity-75" style="font-size:11px;">Confirmed withdrawals</div>
        </div>
    </div>
</div>

@* ── Status Breakdown Pills ── *@
<div class="d-flex flex-wrap gap-2 mb-4" id="statusPillGroup">
    <span class="badge rounded-pill bg-tertiary text-dark border px-3 py-2 status-pill" style="font-size:12px; cursor:pointer;"
          role="button" data-status="Pending RTGS Code" onclick="filterByStatus(this)">
        <i class="ti ti-clock-bolt me-1 text-muted" style="font-size:11px;"></i>Pending RTGS Code
        <span class="fw-bold text-danger ms-1">@Model.PendingRtgsVerificationCount</span>
    </span>
    <span class="badge rounded-pill bg-tertiary text-dark border px-3 py-2 status-pill" style="font-size:12px; cursor:pointer;"
          role="button" data-status="Pending RTGS Confirmation" onclick="filterByStatus(this)">
        <i class="ti ti-file-check me-1 text-muted" style="font-size:11px;"></i>Pending RTGS Confirmation
        <span class="fw-bold text-danger ms-1">@Model.PendingWithdrawalConfirmationCount</span>
    </span>
    <span class="badge rounded-pill bg-tertiary text-dark border px-3 py-2 status-pill" style="font-size:12px; cursor:pointer;"
          role="button" data-status="Pending Exceptional Approval" onclick="filterByStatus(this)">
        <i class="ti ti-star me-1 text-muted" style="font-size:11px;"></i>Pending Exceptional Approval
        <span class="fw-bold text-danger ms-1">@Model.PendingExceptionalApprovalCount</span>
    </span>
    <span class="badge rounded-pill bg-tertiary text-dark border px-3 py-2 status-pill" style="font-size:12px; cursor:pointer;"
          role="button" data-status="Pending Verification" onclick="filterByStatus(this)">
        <i class="ti ti-thumb-up me-1 text-muted" style="font-size:11px;"></i>Pending Recommendation
        <span class="fw-bold text-danger ms-1">@Model.PendingRecommendationCount</span>
    </span>
    <span class="badge rounded-pill bg-tertiary text-dark border px-3 py-2 status-pill" style="font-size:12px; cursor:pointer;"
          role="button" data-status="Pending Approval" onclick="filterByStatus(this)">
        <i class="ti ti-checkbox me-1 text-muted" style="font-size:11px;"></i>Pending Approval
        <span class="fw-bold text-danger ms-1">@Model.PendingConfirmationCount</span>
    </span>
    <span class="badge rounded-pill bg-tertiary text-dark border px-3 py-2 status-pill" style="font-size:12px; cursor:pointer;"
          role="button" data-status="Recall Requested" onclick="filterByStatus(this)">
        <i class="ti ti-alert-triangle me-1 text-muted" style="font-size:11px;"></i>Recall Requested
        <span class="fw-bold text-warning ms-1">@Model.RecallRequestedCount</span>
    </span>
</div>

@* ── Requests Table ── *@
<div class="">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex align-items-center gap-2 py-2">
            <i class="ti ti-layout-list text-muted"></i>
            <span class="fw-semibold text-uppercase">Requests</span>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table id="requestsTable" class="table align-middle mb-0">
                    <thead>
                        <tr style="background:linear-gradient(90deg,#b31b34,#c44a1a,#BA7517)">
                            <th class="text-white fw-semibold " style="font-size:11px;">Transaction Ref no.</th>
                            <th class="text-white fw-semibold" style="font-size:11px;">CB</th>
                            <th class="text-white fw-semibold" style="font-size:11px;">BOU Branch</th>
                            <th class="text-white fw-semibold" style="font-size:11px;">Collection date</th>
                            <th class="text-white fw-semibold" style="font-size:11px;">Amount (UGX)</th>
                            <th class="text-white fw-semibold" style="font-size:11px;">Status</th>
                            <th class="text-white fw-semibold" style="font-size:11px;">Special</th>
                            <th class="text-white" style="font-size:11px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Requests)
                        {
                            <tr class="border-bottom @(row.CollectionDate < DateOnly.FromDateTime(DateTime.Today) ? "table-warning" : "")">
                                <td>
                                    @row.TransactionRefNumber
                                </td>
                                <td>
                                    @row.CbName
                                </td>
                                <td>
                                    @row.BouBranchCode
                                </td>
                                <td class="small" data-order="@row.CollectionDate.ToString("yyyy-MM-dd")">@row.CollectionDate.ToString("dd MMM yyyy")</td>
                                <td class="fw-semibold small">@row.Amount.ToString("N0")</td>
                                <td>
                                    <span class="badge bg-info rounded-pill px-2 py-1">
                                        @row.StatusTypeName
                                    </span>
                                    @if (row.ReturnRtgsPending)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-2 py-1 ms-1">
                                            <i class="ti ti-arrow-return-left me-1"></i>Return RTGS Pending
                                        </span>
                                    }
                                    @if (row.IsAbandoned)
                                    {
                                        <span class="badge bg-danger rounded-pill px-2 py-1 ms-1">
                                            <i class="ti ti-package-off me-1"></i>Boxes Held
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (row.RequiresSpecialApproval)
                                    {
                                        <span class="badge rounded-pill bg-danger px-2 py-1">
                                            <i class="ti ti-star me-1"></i>Yes
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@row.Id"
                                       class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1"
                                       style="font-size:11px;">
                                        <i class="ti ti-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Requests.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4 small">
                                    <i class="ti ti-inbox me-1"></i> No requests found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .status-pill.active {
            background-color: #b31b34 !important;
            border-color: #b31b34 !important;
            color: #fff !important;
        }

        .status-pill.active .text-muted,
        .status-pill.active .text-danger,
        .status-pill.active .text-warning {
            color: #fff !important;
        }
    </style>
    <script>

        let requestsTable = null;

        if ($('#requestsTable tbody tr').length > 0 && !$('#requestsTable tbody tr td[colspan]').length) {
            requestsTable = $('#requestsTable').DataTable({
                order: [[3, 'desc']],
                pageLength: 25,
                columnDefs: [
                    { orderable: false, targets: [1, 5, 6] }
                ]
            });
        }

        // Status column (index 5) filtering driven by the status breakdown pills.
        // Clicking an already-active pill clears the filter and shows every row again.
        function filterByStatus(el) {
            if (!requestsTable) return;

            const status = el.dataset.status;
            const isActive = el.classList.contains('active');

            document.querySelectorAll('#statusPillGroup .status-pill').forEach(p => p.classList.remove('active'));

            if (isActive) {
                requestsTable.column(5).search('').draw();
            } else {
                el.classList.add('active');
                requestsTable.column(5).search(status, false, false).draw();
            }
        }

    </script>
}