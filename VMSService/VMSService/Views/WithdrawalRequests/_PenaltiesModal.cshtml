@model VMSService.Core.Models.WithdrawalRequests.BouWithdrawalRequestDetailsViewModel

<div class="modal fade" id="penaltiesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Manage Penalties</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="penaltiesForm" method="post" asp-action="ApplyPenalties" asp-route-id="@Model.Id">
                    @Html.AntiForgeryToken()
                    <p class="text-muted small mb-2">Check the penalties that apply to this request.</p>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var penalty in Model.ApplicablePenalties)
                        {
                            <div class="form-check border rounded-3 p-3">
                                <input class="form-check-input" type="checkbox" name="penaltyIds"
                                       value="@penalty.Id" id="penalty_@penalty.Id"
                                       checked="@penalty.IsChecked">
                                <label class="form-check-label w-100" for="penalty_@penalty.Id">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <p class="fw-semibold mb-0">@penalty.Name</p>
                                            @if (!string.IsNullOrEmpty(penalty.Description))
                                            {
                                                <p class="text-muted small mb-0">@penalty.Description</p>
                                            }
                                        </div>
                                        <span class="fw-semibold text-danger text-nowrap ms-2">
                                            UGX @(penalty.PenaltyValue?.ToString("N0") ?? "-")
                                        </span>
                                    </div>
                                </label>
                            </div>
                        }
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="penaltiesForm" class="btn btn-danger" title="Save">
                    <i class="ti ti-device-floppy"></i> Save
                </button>
            </div>
        </div>
    </div>
</div>
