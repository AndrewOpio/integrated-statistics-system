@model VMSService.Core.Models.WithdrawalRequests.BouWithdrawalRequestDetailsViewModel

@if (Model.ApplicablePenalties.Any() || Model.AppliedPenalties.Any())
{
    <div class="card mb-3 border-top-0 border-end-0 border-bottom-0 border-4 border-danger shadow-sm">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <p class="text-uppercase text-muted fw-bold mb-0">
                    <i class="ti ti-gavel text-muted"></i>
                    Penalties
                </p>
                <div class="d-flex align-items-center gap-2">
                    @if (Model.AppliedPenalties.Any())
                    {
                        <span class="badge bg-danger rounded-pill px-3 py-2">
                            Total Applied: UGX @Model.AppliedPenalties.Sum(a => a.ChargeValue).ToString("N0")
                        </span>
                    }
                    @if (Model.ApplicablePenalties.Any())
                    {
                        var checkedCount = Model.ApplicablePenalties.Count(p => p.IsChecked);
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal" data-bs-target="#penaltiesModal">
                            <i class="ti ti-edit me-1"></i>Manage Penalties
                            @if (checkedCount > 0)
                            {
                                <span class="badge bg-danger ms-1">@checkedCount</span>
                            }
                        </button>
                    }
                </div>
            </div>
            <hr />

            @if (Model.AppliedPenalties.Any())
            {
                <div>
                    <p class="text-uppercase text-muted small fw-semibold mb-2">Applied Penalties</p>
                    @await Html.PartialAsync("~/Views/Shared/_Withdrawal/_AppliedPenaltiesTable.cshtml", Model.AppliedPenalties)
                </div>
            }
        </div>
    </div>
}
