@using System.Security.Claims
@using static VMSService.Core.Static.WithdrawStatuses
@model VMSService.Core.Models.WithdrawalRequests.BouWithdrawalRequestDetailsViewModel
@{
    // Layout = "_CbLayout";
    ViewData["Title"] = "BOU Withdrawal Request Details";

}

@* ── Hero Header ── *@
<div class="rounded-2 p-4 mb-3" style="background:linear-gradient(135deg, #b31b34 15%, #c9973a 100%);">

    @* Top row: ref + amount *@
    <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-3">
        <div>
            <p class="text-uppercase mb-1 fs-6" style="letter-spacing:.08em;color:#e8e8f0;">
                @if (Model.RequiresSpecialApproval)
                {
                    <span>Exceptional Approval &middot;</span>
                }
                Cash Withdrawal Request
            </p>
            <h2 class="fw-medium mb-1 text-white">
                @(string.IsNullOrEmpty(Model.TransactionRefNumber) ? "Not Generated" : Model.TransactionRefNumber)
            </h2>
            <p class="small" style="color:#e8e8f0;">
                Submitted by @Model.CbName
                &middot; Collection @Model.CollectionDate.ToString("dddd dd MMM yyyy")
            </p>
            <span class="badge bg-primary rounded-pill px-3 py-2 mt-1 bg-opacity-50">
                <i class="ti ti-badge me-1"></i>@Model.CurrentStatusName
            </span>
            @if (Model.RequiresSpecialApproval)
            {
                <span class="badge rounded-pill bg-secondary px-3 py-2 mt-1 ms-1 bg-opacity-50"
                      style="font-size:11px;">
                    <i class="ti ti-star me-1"></i>Exceptional Approval Required
                </span>
            }
        </div>
        <div class="text-end">
            <p class="text-uppercase mb-1" style="color:#e8e8f0;">Request Amount</p>
            <h3 class="fw-medium mb-1 text-white">
                UGX @Model.TotalAmount.ToString("N0")
            </h3>
            <p style="font-size:12px;color:#e8e8f0;" id="hero-words"></p>
        </div>
    </div>

    @* Stepper *@

    @await Html.PartialAsync("~/Views/Shared/_Withdrawal/_BouWithdrawNavSteps.cshtml", Model.Steps)
</div>
@* ── Two Column Layout ── *@
<div class="row g-3">

    @* ── Left Column ── *@
    <div class="col-md-8 d-flex flex-column gap-3">

        @* ── Flag Alert && !string.IsNullOrEmpty(Model.SpecialApprovalReason) ── *@
        @if (Model.RequiresSpecialApproval)
        {
            <div class="rounded-3 p-3" style="background:#fdf6e3;border:0.5px solid #c8a96e;">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="text-uppercase fw-semibold" style="font-size:10px;letter-spacing:.1em;color:#9a6a1f;">
                        Exceptional Approval Reason
                    </span>
                </div>
                <div class="ps-3" style="border-left:3px solid #c8a96e;">
                    <p class="fw-semibold mb-1" style="font-size:13px;color:#5c3a00;">Exceptional Approval Required</p>
                    <p class="mb-2" style="font-size:12px;color:#7a4f10;line-height:1.6;">@Model.SpecialApprovalReason</p>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="rounded-pill px-3 py-1" style="font-size:11px;color:#7a4f10;border:1px solid #c8a96e;">Same Submission and Collection Dates</span>

                        <span class="badge rounded-pill bg-danger px-3 py-2 mt-1 ms-1"
                              style="font-size:11px;">
                            <i class="ti ti-star me-1"></i>Exceptional approval required
                        </span>
                    </div>
                </div>
            </div>
        }

        @* ── Sender & Receiver ── *@

        <div class="card mb-3 border-top-0 border-end-0 border-bottom-0 border-4 border-warning shadow-sm">

            <div class="card-body">
                <p class="text-uppercase text-muted fw-bold mb-3">
                    <i class="ti ti-replace text-muted"></i>
                    Sender & Receiver Details
                </p>
                <hr />
                <div class="row g-3 align-items-center">
                    <div class="col">
                        <div class="rounded-3 p-3 bg-warning bg-opacity-10 border">
                            <p class="text-muted mb-1" style="font-size:9px;">FROM</p>
                            <p class="fw-bold mb-1">@Model.CbName</p>
                            <span class="badge bg-warning text-white">Sender</span>
                        </div>
                    </div>
                    <div class="col-auto text-muted">
                        <i class="ti ti-arrow-right fs-4"></i>
                    </div>
                    <div class="col">
                        <div class="rounded-3 p-3 bg-success bg-opacity-10 border">
                            <p class="text-muted mb-1" style="font-size:9px;">TO</p>
                            <p class="fw-bold mb-1">
                                @Model.BouBranchName
                                <span class="text-muted fw-normal small mb-0 mt-1">- @Model.BouBranchCode</span>
                            </p>
                            <span class="badge bg-success text-white">Receiver</span>
                        </div>
                    </div>
                </div>

                @* Collection Details *@
                <div class="row g-3 mt-2 pt-2 border-top">
                    <div class="col-md-4">
                        <p class="text-muted mb-0" style="font-size:9px;">COLLECTION DATE</p>
                        <p class="fw-semibold small mb-0">
                            @Model.CollectionDate.ToString("dd MMM yyyy")
                        </p>
                    </div>
                    <div class="col-md-4">
                        <p class="text-muted mb-0" style="font-size:9px;">RTGS DATE</p>
                        <p class="fw-semibold small mb-0">
                            @(Model.RtgsDate.HasValue? Model.RtgsDate.Value.ToString("dd MMM yyyy") : "—")
                        </p>
                    </div>
                    <div class="col-md-4">
                        <p class="text-muted mb-0" style="font-size:9px;">RTGS CODE</p>
                        <p class="fw-semibold small mb-0">
                            @(string.IsNullOrEmpty(Model.RtgsCode) ? "—" : Model.RtgsCode)
                        </p>
                    </div>
                </div>

                @* RTGS Verification *@
                @if (Model.RtgsDate.HasValue && !string.IsNullOrEmpty(Model.RtgsCode))
                {
                    <div class="row mt-2 pt-2 border-top">
                        <div class="col-md-12">
                            <p class="text-muted mb-1" style="font-size:9px;">RTGS VERIFICATION</p>
                            @switch (Model.RtgsVerificationStatus)
                            {
                                case WithdrawStatuses.RtgsVerification.Confirmed:
                                    <span class="badge bg-success rounded-pill px-3 py-2">
                                        <i class="ti ti-circle-check me-1"></i> Verified
                                    </span>
                                    break;
                                case WithdrawStatuses.RtgsVerification.DateMismatch:
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-success rounded-pill px-3 py-2">
                                            <i class="ti ti-circle-check me-1"></i> Verified (Date Corrected)
                                        </span>
                                        <span class="small text-muted">
                                            CB submitted: @(Model.RtgsDate?.ToString("dd MMM yyyy") ?? "—") —
                                            Actual: @(Model.RtgsVerifiedDate?.ToString("dd MMM yyyy") ?? "—")
                                        </span>
                                    </div>
                                    break;
                                case WithdrawStatuses.RtgsVerification.AmountMismatch:
                                    <span class="badge bg-danger rounded-pill px-3 py-2">
                                        <i class="ti ti-alert-circle me-1"></i> Amount Mismatch
                                    </span>
                                    break;
                                case WithdrawStatuses.RtgsVerification.NotFound:
                                    <span class="badge bg-danger rounded-pill px-3 py-2">
                                        <i class="ti ti-x me-1"></i> Not Found
                                    </span>
                                    break;
                                default:
                                    <span class="badge bg-secondary rounded-pill px-3 py-2 mb-2">
                                        <i class="ti ti-clock me-1"></i> Pending Verification
                                    </span>
                                    @if (Model.CanVerifyRtgs)
                                    {
                                        <form method="post" asp-action="VerifyRtgs" asp-route-id="@Model.Id" class="mt-2">
                                            @Html.AntiForgeryToken()
                                            <div class="row g-3 align-items-end">
                                                <div class="col-md-3">
                                                    <label class="text-muted mb-1" style="font-size:9px;">VERIFICATION RESULT</label>
                                                    <select name="verificationStatus" class="form-select form-select-sm" required
                                                            onchange="document.getElementById('dateMismatchField').style.display = this.value === 'DateMismatch' ? 'block' : 'none'">
                                                        <option value="">— Select —</option>
                                                        <option value="Confirmed">Confirmed</option>
                                                        <option value="DateMismatch">Date Mismatch</option>
                                                        <option value="AmountMismatch">Amount Mismatch</option>
                                                        <option value="NotFound">Not Found</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-3" id="dateMismatchField" style="display:none;">
                                                    <label class="text-muted mb-1" style="font-size:9px;">CORRECT RTGS DATE</label>
                                                    <input type="date" name="rtgsVerifiedDate" class="form-control form-control-sm" />
                                                </div>
                                                <div class="col-md-3">
                                                    <button type="submit" class="btn btn-sm btn-primary">
                                                        <i class="ti ti-check me-1"></i> Submit Verification
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                                    }
                                    break;
                            }
                        </div>
                    </div>
                }

                @* Recall RTGS Details *@
                @if (Model.RecallRtgsPending && !Model.RecallRtgsDate.HasValue)
                {
                    <div class="row mt-2 pt-2 border-top">
                        <div class="col-md-12">
                            <p class="text-uppercase text-muted fw-semibold mb-2" style="font-size:9px;">RECALL RTGS</p>
                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2 mb-3">
                                <i class="ti ti-clock me-1"></i> Reverse RTGS Pending
                            </span>
                            <form method="post" asp-action="CompleteRecall" asp-route-id="@Model.Id">
                                @Html.AntiForgeryToken()
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-4">
                                        <label class="text-muted mb-1" style="font-size:9px;">RECALL RTGS DATE</label>
                                        <input type="date" name="recallRtgsDate" class="form-control form-control-sm" required />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="text-muted mb-1" style="font-size:9px;">RECALL RTGS CODE</label>
                                        <input type="text" name="recallRtgsCode" class="form-control form-control-sm"
                                               placeholder="Enter RTGS code" required />
                                    </div>
                                    <div class="col-md-4">
                                        <button type="submit" class="btn btn-sm btn-success w-100">
                                            <i class="ti ti-check me-1"></i> Complete Recall
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                }
                else if (Model.RecallRtgsDate.HasValue)
                {
                    <div class="row mt-2 pt-2 border-top">
                        <div class="col-md-12">
                            <p class="text-uppercase text-muted fw-semibold mb-2" style="font-size:9px;">RECALL RTGS</p>
                            <div class="d-flex align-items-center gap-3">
                                <span class="badge bg-success rounded-pill px-3 py-2">
                                    <i class="ti ti-circle-check me-1"></i> Reverse RTGS Completed
                                </span>
                                <span class="small text-muted">
                                    @Model.RecallRtgsDate.Value.ToString("dd MMM yyyy") — @Model.RecallRtgsCode
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* ── Agents ── *@
        <div class="card mb-3 border-top-0 border-end-0 border-bottom-0 border-4 shadow-sm" style="border-color: #D4500A">
            <div class="card-body">
                <p class="text-uppercase text-muted fw-bold mb-3">
                    <i class="ti ti-friends text-muted"></i>
                    Agent Details
                </p>
                <hr />
                <div class="row g-4">
                    @foreach (var (agent, index) in Model.WithdrawAgents.Select((a, i) => (a, i + 1)))
                    {
                        <div class="col-md-6">
                            <div class="border rounded-3 p-3">
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <span class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center fw-bold"
                                          style="width:24px;height:24px;font-size:11px;">@index</span>
                                    <span class="text-uppercase text-muted small fw-semibold">Collector @index</span>
                                </div>

                                @* Photo + Details *@
                                <div class="d-flex gap-3 mb-3">
                                    <div class="flex-shrink-0">
                                        @if (!string.IsNullOrEmpty(agent.PassportPhoto))
                                        {
                                            <img src="@agent.PassportPhoto" alt="Photo"
                                                 class="rounded-2 border"
                                                 style="width:80px;height:100px;object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <div class="border rounded-2 bg-light d-flex align-items-center justify-content-center"
                                                 style="width:80px;height:100px;">
                                                <i class="ti ti-user text-muted fs-2"></i>
                                            </div>
                                        }
                                    </div>
                                    <div class="flex-grow-1">
                                        <p class="fw-bold mb-2">@agent.AgentNames</p>
                                        <div class="mb-1">
                                            <p class="text-muted mb-0" style="font-size:9px;">SECURITY NO.</p>
                                            <p class="fw-semibold small mb-0">@agent.NIN</p>
                                        </div>
                                        @* <div class="mb-1">
                                            <p class="text-muted mb-0" style="font-size:9px;">WORK ID</p>
                                            <p class="fw-semibold small mb-0">@agent.WorkIdScan</p>
                                        </div> *@
                                        <div>
                                            <p class="text-muted mb-0" style="font-size:9px;">PHONE</p>
                                            <p class="fw-semibold small mb-0 text-primary">@agent.PhoneNumber</p>
                                        </div>
                                    </div>
                                </div>

                                @* Work ID Scan *@
                                <div class="mb-2">
                                    <p class="text-muted mb-1" style="font-size:9px;">WORK ID SCAN</p>
                                    @if (!string.IsNullOrEmpty(agent.WorkIdScan))
                                    {
                                        <img src="@agent.WorkIdScan" alt="Work ID"
                                             class="rounded-2 border w-100"
                                             style="max-height:120px;object-fit:contain;" />
                                    }
                                    else
                                    {
                                        <div class="border rounded-2 bg-light d-flex align-items-center justify-content-center"
                                             style="height:70px;">
                                            <span class="text-muted small">No scan uploaded</span>
                                        </div>
                                    }
                                </div>

                                @* Signature *@
                                <div>
                                    <p class="text-muted mb-1" style="font-size:9px;">SIGNATURE</p>
                                    @if (!string.IsNullOrEmpty(agent.SignatureScan))
                                    {
                                        <img src="@agent.SignatureScan" alt="Signature"
                                             class="rounded-2 border w-100"
                                             style="max-height:56px;object-fit:contain;" />
                                    }
                                    else
                                    {
                                        <div class="border rounded-2 bg-light d-flex align-items-center justify-content-center"
                                             style="height:56px;">
                                            <span class="text-muted small">No signature uploaded</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── Denominations ── *@
        @await Html.PartialAsync("~/Views/Shared/_Withdrawal/_BouDenominationSection.cshtml", Model)

        @* ── Comments / Status History ── *@
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 fw-bolder mb-3">
                    <i class="ti ti-message"></i>
                    <span class="text-uppercase">Comments</span>
                </div>
                @if (Model.StatusHistory != null && Model.StatusHistory.Any())
                {
                    <div class="timeline">
                        @foreach (var history in Model.StatusHistory)
                        {
                            <div class="timeline-item mb-4">
                                <div class="d-flex gap-3">
                                    <div class="timeline-marker">
                                        <i class="ti ti-circle-check text-success"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h6 class="mb-1 small">
                                                    <strong>@history.OldStatusName</strong>
                                                    <i class="ti ti-arrow-right text-muted"></i>
                                                    <strong>@history.NewStatusName</strong>
                                                </h6>
                                                <small class="text-muted">
                                                    By: <strong>@history.ChangedBy</strong>
                                                </small>
                                            </div>
                                            <small class="text-muted">
                                                @history.ChangedAt.ToString("dd/MMM/yyyy HH:mm:ss")
                                            </small>
                                        </div>
                                        @if (!string.IsNullOrEmpty(history.Remarks))
                                        {
                                            <div class="mt-2 p-2 bg-white rounded border">
                                                <span class="d-block">@history.Remarks</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted text-center">
                        <i class="ti ti-inbox me-2"></i>No comments yet.
                    </p>
                }
            </div>
        </div>

        @* ── Bottom nav ── *@
        <div class="d-flex justify-content-between mb-5">
            <a asp-action="Index" asp-controller="WithdrawalRequests" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1"></i>Back to List
            </a>
            @if (Model.StatusName == WithdrawalStatusNames.Completed || Model.StatusName == WithdrawalStatusNames.Approved)
            {
                <a asp-controller="CbWithdrawRequests" asp-action="PrintRequest" asp-route-id="@Model.Id"
                   target="_blank" class="btn btn-outline-dark">
                    <i class="ti ti-file-text me-1"></i> Print Slip
                </a>
            }
        </div>

    </div>

    @* ── Right Column — Sticky Panel ── *@
    <div class="col-md-4">
        <div class="sticky-top" style="top:80px;">
            <div class="card border border-danger overflow-hidden">

                @* Panel header *@

                <div class="card-header text-white d-flex align-items-center gap-2"
                     style="background:#b31b34;">
                    <i class="ti ti-circle-arrow-up-right-filled fs-4"></i>
                    <div>
                        <p class="fw-bold small mb-0 text-uppercase">
                            @(Model.AvailableTransitions.Any() ? "Action Required" : "Withdrawal Request Summary")
                        </p>
                        <p class="mb-0 text-white-50" style="font-size:11px;">
                            @(Model.AvailableTransitions.Any() ? "Review the request and take action" : "Overview of Withdrawal request")
                        </p>
                    </div>
                </div>

                @* Summary rows *@
                <div class="card-body pb-0">
                    <div class="d-flex justify-content-between py-2 border-bottom small">
                        <span class="text-muted">Request ID</span>
                        <span class="fw-semibold">
                            @(string.IsNullOrEmpty(Model.TransactionRefNumber) ? "Not Generated" : Model.TransactionRefNumber)
                        </span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom small">
                        <span class="text-muted">Amount</span>
                        <span class="fw-semibold text-danger">UGX @Model.TotalAmount.ToString("N0")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom small">
                        <span class="text-muted">From</span>
                        <span class="fw-semibold">@Model.CbName</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom small">
                        <span class="text-muted">To</span>
                        <span class="fw-semibold">@Model.BouBranchName</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom small">
                        <span class="text-muted">Collection</span>
                        <span class="fw-semibold">@Model.CollectionDate.ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 small">
                        <span class="text-muted">Status</span>
                        <span class="badge bg-primary rounded-pill px-3 py-2">
                            <i class="ti ti-badge me-1"></i>@Model.CurrentStatusName
                        </span>
                    </div>
                </div>

                @* Workflow actions *@
                @if (Model.RecallRtgsPending)
                {
                    @* Hide transitions while recall RTGS is pending — the CompleteRecall form above is the action *@
                }
                else if (Model.AvailableTransitions.Any())
                {
                    <div class="card-body border-top pt-3">
                        @if (string.IsNullOrEmpty(Model.RtgsCode) || !Model.RtgsDate.HasValue)
                        {
                            <div class="alert alert-warning d-flex gap-2 py-2 mb-0 small">
                                <i class="ti ti-alert-triangle flex-shrink-0 mt-1"></i>
                                Please provide the RTGS code and date before proceeding.
                            </div>
                        }
                        else if (string.IsNullOrEmpty(Model.RtgsVerificationStatus) || Model.RtgsVerificationStatus == WithdrawStatuses.RtgsVerification.Pending)
                        {
                            <div class="alert alert-warning d-flex gap-2 py-2 mb-0 small">
                                <i class="ti ti-alert-triangle flex-shrink-0 mt-1"></i>
                                RTGS details must be verified before proceeding. Verify above or wait for automatic verification.
                            </div>
                        }
                        else if (!Model.HasDispatchData
                                 && (Model.StatusName == WithdrawStatuses.WithdrawalStatusNames.PendingVerification
                        || Model.StatusName == WithdrawStatuses.WithdrawalStatusNames.ReturnedForRevision))
                        {
                            <div class="alert alert-info d-flex gap-2 py-2 mb-0 small">
                                <i class="ti ti-packages flex-shrink-0 mt-1"></i>
                                Dispatch details must be entered before proceeding.
                            </div>
                        }
                        else
                        {
                            @* Your decision context box *@
                            @*  <div class="rounded-3 p-3 bg-body-secondary mb-3">
                                <p class="text-uppercase text-muted mb-1" style="font-size:9px;letter-spacing:.06em;">Your Decision</p>
                                <p class="fw-medium mb-0" style="font-size:18px;">UGX @Model.TotalAmount.ToString("N0")</p>
                                <p class="text-muted small mb-0">
                                    @Model.CbName → @Model.BouBranchName &middot; @Model.CollectionDate.ToString("dd MMM yyyy")
                                </p>
                            </div> *@

                            <form method="post"
                                  asp-action="ExecuteAction"
                                  asp-route-id="@Model.Id"
                                  id="workflowForm"
                                  enctype="multipart/form-data">
                                @Html.AntiForgeryToken()

                                <label class="form-label text-uppercase text-muted fw-semibold" style="font-size:10px;">
                                    Comment
                                    <span id="commentRequired" class="text-danger" style="display:none;">*</span>
                                </label>
                                <textarea id="remarksTextarea"
                                  class="form-control form-control-sm mb-3"
                                  name="remarks"
                                  rows="4"
                                  placeholder="Add a comment..."></textarea>
                                <small id="commentHint" class="text-muted d-block mb-2"></small>

                                @* Attachments Section *@
                                <div id="attachmentsSection" style="display: none;">
                                    <div class="border-top pt-3 mb-3">
                                        <label class="form-label text-uppercase text-muted fw-semibold d-flex align-items-center gap-2" style="font-size:10px;">
                                            <i class="ti ti-paperclip"></i>
                                            Required Attachments
                                            <span class="text-danger">*</span>
                                        </label>
                                        <small class="text-muted d-block mb-3">Please upload all required documents before submitting</small>
                                        <div id="attachmentsList" class="d-flex flex-column gap-3"></div>
                                    </div>
                                </div>

                                @if (Model.AvailableTransitions.Count == 1)
                                {
                                    var t = Model.AvailableTransitions.First();
                                    <input name="actionName" id="soloActionName" value="@t.ActionName"
                                           data-requires-comments="@t.RequiresComments.ToString().ToLower()"
                                           data-requires-attachments="@t.RequiresAttachments.ToString().ToLower()"
                                           data-attachment-requirements='@System.Text.Json.JsonSerializer.Serialize(t.AttachmentRequirements)'
                                           hidden />
                                    <div class="d-grid">
                                        <button type="submit"
                                                id="submitBtn"
                                                class="btn @t.ButtonClass text-white">
                                            <i class="ti ti-check me-1"></i><span id="submitBtnLabel">@t.DisplayLabel</span>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <label class="form-label text-uppercase text-muted fw-semibold" style="font-size:10px;">
                                        Select Action <span class="text-danger">*</span>
                                    </label>
                                    <select id="actionSelect" name="actionName" class="form-select form-select-sm mb-3" required>
                                        <option value="">— Choose an action —</option>
                                        @foreach (var transition in Model.AvailableTransitions)
                                        {
                                            <option value="@transition.ActionName"
                                                    data-requires-comments="@transition.RequiresComments.ToString().ToLower()"
                                                    data-requires-attachments="@transition.RequiresAttachments.ToString().ToLower()"
                                                    data-attachment-requirements='@System.Text.Json.JsonSerializer.Serialize(transition.AttachmentRequirements)'
                                                    data-button-class="@transition.ButtonClass"
                                                    data-display-label="@transition.DisplayLabel">
                                                @transition.DisplayLabel
                                            </option>
                                        }
                                    </select>
                                    <div class="d-grid">
                                        <button type="submit"
                                                id="submitBtn"
                                                class="btn btn-primary"
                                                disabled>
                                            <i class="ti ti-check me-1"></i><span id="submitBtnLabel">Confirm Action</span>
                                        </button>
                                    </div>
                                }
                            </form>
                        }
                    </div>
                }

            </div>
        </div>
    </div>

</div>

