@if (Model.CanEditDispatch)
{
    @await Html.PartialAsync("~/Views/Shared/_Withdrawal/_BouDenominationEditModal.cshtml", Model)
}


@section Scripts {
    <script src="~/js/withdrawal-form.js"></script>
    <script>
         // Denomination catalog
        window.denomData = {
               notes: @Html.Raw(Json.Serialize(Model.Denoms.Notes.Select(d => new { id = d.Id, value = d.Value, label = $"UGX {d.Value:N0}", typeId = d.DenominationTypeId }))),
               coins: @Html.Raw(Json.Serialize(Model.Denoms.Coins.Select(d => new { id = d.Id, value = d.Value, label = $"UGX {d.Value:N0}", typeId = d.DenominationTypeId })))
           };

        document.getElementById('hero-words').textContent  = toWords(@Model.TotalAmount);
        var bouDenomWords = document.getElementById('bou-denom-words');
        if (bouDenomWords) bouDenomWords.textContent = toWords(@Model.TotalAmount);

        document.addEventListener('DOMContentLoaded', function () {
            const actionSelect = document.getElementById('actionSelect');
            const remarksTextarea = document.getElementById('remarksTextarea');
            const commentRequired = document.getElementById('commentRequired');
            const commentHint = document.getElementById('commentHint');
            const submitBtn = document.getElementById('submitBtn');
            const submitBtnLabel = document.getElementById('submitBtnLabel');
            const workflowForm = document.getElementById('workflowForm');
            const soloActionName = document.getElementById('soloActionName');
            const attachmentsSection = document.getElementById('attachmentsSection');
            const attachmentsList = document.getElementById('attachmentsList');

            let uploadedFiles = {};

            if (soloActionName) {
                const requiresComments = soloActionName.dataset.requiresComments === 'true';
                const requiresAttachments = soloActionName.dataset.requiresAttachments === 'true';
                const attachmentRequirements = JSON.parse(soloActionName.dataset.attachmentRequirements || '[]');

                if (requiresComments) {
                    commentRequired.style.display = 'inline';
                    remarksTextarea.required = true;
                }

                if (requiresAttachments && attachmentRequirements.length > 0) {
                    displayAttachmentFields(attachmentRequirements);
                }
            }

            if (actionSelect && workflowForm) {
                actionSelect.addEventListener('change', function () {
                    const selectedOption = this.options[this.selectedIndex];
                    const requiresComments = selectedOption.dataset.requiresComments === 'true';
                    const requiresAttachments = selectedOption.dataset.requiresAttachments === 'true';
                    const attachmentRequirements = JSON.parse(selectedOption.dataset.attachmentRequirements || '[]');
                    const actionName = selectedOption.value;
                    const displayLabel = selectedOption.dataset.displayLabel;
                    const buttonClass = selectedOption.dataset.buttonClass;

                    if (actionName) {
                        if (requiresComments) {
                            commentRequired.style.display = 'inline';
                            remarksTextarea.required = true;
                        } else {
                            commentRequired.style.display = 'none';
                            remarksTextarea.required = false;
                        }

                        if (requiresAttachments && attachmentRequirements.length > 0) {
                            displayAttachmentFields(attachmentRequirements);
                        } else {
                            attachmentsSection.style.display = 'none';
                            attachmentsList.innerHTML = '';
                            uploadedFiles = {};
                        }

                        submitBtn.disabled = false;
                        submitBtnLabel.textContent = displayLabel;
                        submitBtn.className = `text-white btn ${buttonClass}`;
                    } else {
                        commentRequired.style.display = 'none';
                        remarksTextarea.required = false;
                        commentHint.textContent = '';
                        attachmentsSection.style.display = 'none';
                        attachmentsList.innerHTML = '';
                        uploadedFiles = {};
                        submitBtn.disabled = true;
                        submitBtnLabel.textContent = 'Confirm Action';
                        submitBtn.className = 'text-white btn btn-primary';
                    }
                });

                workflowForm.addEventListener('submit', function (e) {
                    const selectedOption = actionSelect ? actionSelect.options[actionSelect.selectedIndex] : null;
                    const requiresComments = selectedOption ? selectedOption.dataset.requiresComments === 'true' :
                                           soloActionName ? soloActionName.dataset.requiresComments === 'true' : false;
                    const requiresAttachments = selectedOption ? selectedOption.dataset.requiresAttachments === 'true' :
                                              soloActionName ? soloActionName.dataset.requiresAttachments === 'true' : false;
                    const attachmentRequirements = selectedOption ? JSON.parse(selectedOption.dataset.attachmentRequirements || '[]') :
                                                 soloActionName ? JSON.parse(soloActionName.dataset.attachmentRequirements || '[]') : [];
                    const remarksValue = remarksTextarea.value.trim();

                    if (requiresComments && !remarksValue) {
                        e.preventDefault();
                        alert('Comments are required for this action.');
                        remarksTextarea.focus();
                        return false;
                    }

                    if (requiresAttachments) {
                        const requiredAttachments = attachmentRequirements.filter(req => req.isRequired);
                        const missingAttachments = [];
                        requiredAttachments.forEach(req => {
                            const fileInput = document.getElementById(`attachment_${req.id}`);
                            if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
                                missingAttachments.push(req.attachmentName);
                            }
                        });
                        if (missingAttachments.length > 0) {
                            e.preventDefault();
                            alert('Please upload the following required attachments:\n- ' + missingAttachments.join('\n- '));
                            return false;
                        }
                    }
                });
            }

            function displayAttachmentFields(requirements) {
                attachmentsSection.style.display = 'block';
                attachmentsList.innerHTML = '';
                uploadedFiles = {};
                const sortedRequirements = [...requirements].sort((a, b) => a.displayOrder - b.displayOrder);
                sortedRequirements.forEach(req => {
                    attachmentsList.appendChild(createAttachmentCard(req));
                });
            }

            function createAttachmentCard(requirement) {
                const card = document.createElement('div');
                card.className = 'card border';
                card.style.cssText = 'background: #f8f9fa;';
                const allowedFormats = requirement.AllowedFormats || 'pdf,docx,xlsx,png,jpg';
                const allowedFormatsArray = allowedFormats.split(',').map(f => f.trim());
                const acceptAttribute = allowedFormatsArray.map(format => {
                    const formatMap = { 'pdf':'.pdf','excel':'.xls,.xlsx','docx':'.doc,.docx','word':'.doc,.docx','png':'.png','jpg':'.jpg,.jpeg','jpeg':'.jpg,.jpeg' };
                    return formatMap[format.toLowerCase()] || '.' + format;
                }).join(',');

                card.innerHTML = `
                    <div class="card-body p-3">
                        <div class="d-flex align-items-start justify-content-between mb-2">
                            <div class="flex-grow-1">
                                <label class="form-label fw-semibold mb-1 d-flex align-items-center gap-2">
                                    <i class="ti ti-file-text text-primary"></i>
                                    ${requirement.AttachmentName || 'Attachment'}
                                    ${requirement.IsRequired ? '<span class="text-danger">*</span>' : '<span class="badge bg-secondary bg-opacity-10 text-secondary small">Optional</span>'}
                                </label>
                                <small class="text-muted d-block mb-2">
                                    <i class="ti ti-info-circle"></i>
                                    Allowed formats: <strong class="text-info">${allowedFormatsArray.join(', ').toUpperCase()}</strong>
                                </small>
                            </div>
                        </div>
                        <div class="position-relative">
                            <input type="file" class="form-control form-control-sm"
                                   id="attachment_${requirement.Id}" name="attachments_${requirement.Id}"
                                   accept="${acceptAttribute}" ${requirement.IsRequired ? 'required' : ''}
                                   data-attachment-id="${requirement.Id}" data-attachment-name="${requirement.AttachmentName || 'Attachment'}">
                            <div id="preview_${requirement.Id}" class="mt-2" style="display: none;">
                                <div class="alert alert-success py-2 mb-0 d-flex align-items-center gap-2">
                                    <i class="ti ti-circle-check"></i>
                                    <span class="small flex-grow-1" id="fileName_${requirement.Id}"></span>
                                    <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="clearFile(${requirement.Id})"><i class="ti ti-x"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>`;

                card.querySelector(`#attachment_${requirement.Id}`).addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    const preview = document.getElementById(`preview_${requirement.Id}`);
                    const fileNameSpan = document.getElementById(`fileName_${requirement.Id}`);
                    if (file) {
                        const fileSizeKB = (file.size / 1024).toFixed(2);
                        fileNameSpan.textContent = `${file.name} (${fileSizeKB} KB)`;
                        preview.style.display = 'block';
                        uploadedFiles[requirement.Id] = file;
                    } else {
                        preview.style.display = 'none';
                        delete uploadedFiles[requirement.Id];
                    }
                });
                return card;
            }

            window.clearFile = function(attachmentId) {
                const fileInput = document.getElementById(`attachment_${attachmentId}`);
                const preview = document.getElementById(`preview_${attachmentId}`);
                if (fileInput) { fileInput.value = ''; preview.style.display = 'none'; delete uploadedFiles[attachmentId]; }
            };
        });

    </script>

    <script src="~/js/bou-denomination-edit.js"></script>

       
}


