@model VMSService.Data.Entities.CfbReport

@using ConfigurationsService.Client

@{
    ViewData["Title"] = "Edit CFB Report";
    var branches = ViewBag.Branches as List<BranchDto> ?? new();
}

<div class="row">
    <div class="col-12 col-lg-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header pb-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="d-flex flex-column">
                        <span class="text-muted small mb-2">Cash Flow Balancing</span>
                        <h2 class="fs-4 fw-bold mb-0">Edit CFB Report</h2>
                    </div>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                        <i class="ti ti-arrow-left me-1"></i> Back to Details
                    </a>
                </div>
            </div>

            <div class="card-body">
                <div id="formAlerts"></div>

                <form id="cfbReportForm">
                    <div class="row mb-3">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Reference Number <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="referenceNumber" value="@Model.ReferenceNumber" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Branch <span class="text-danger">*</span></label>
                            <select class="form-select" id="branchId">
                                <option value="">-- Select Branch --</option>
                                @foreach (var b in branches)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Period Start <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="periodStart" value="@Model.PeriodStart.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Period End <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="periodEnd" value="@Model.PeriodEnd.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Remarks</label>
                        <textarea class="form-control" id="remarks" rows="2">@Model.Remarks</textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                        <button type="button" class="btn btn-primary" onclick="submitForm()">
                            <i class="ti ti-device-floppy me-1"></i>Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('branchId').value = '@Model.BranchId';

    function submitForm() {
        const referenceNumber = document.getElementById('referenceNumber').value.trim();
        const branchId        = parseInt(document.getElementById('branchId').value);
        const periodStart     = document.getElementById('periodStart').value;
        const periodEnd       = document.getElementById('periodEnd').value;
        const remarks         = document.getElementById('remarks').value.trim();

        if (!referenceNumber || !branchId || !periodStart || !periodEnd) {
            showAlert('danger', 'Please fill in all required fields.');
            return;
        }

        fetch('@Url.Action("Edit")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: @Model.Id, referenceNumber, branchId, periodStart, periodEnd, remarks: remarks || null })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) window.location.href = data.redirectUrl;
            else showAlert('danger', data.message ?? 'An error occurred.');
        })
        .catch(() => showAlert('danger', 'Network error. Please try again.'));
    }

    function showAlert(type, message) {
        document.getElementById('formAlerts').innerHTML =
            `<div class="alert alert-${type} alert-dismissible fade show">
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
             </div>`;
    }
</script>
}
