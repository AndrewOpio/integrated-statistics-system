@model VMSService.Data.Entities.DestructionAuthorization

@using ConfigurationsService.Client
@{
    ViewData["Title"] = "Edit Destruction Authorization";
}

<div class="row">
    <div class="col-12 col-lg-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header pb-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="d-flex flex-column">
                        <span class="text-muted small mb-2">Destruction Management</span>
                        <h2 class="fs-4 fw-bold mb-0">Edit — @Model.ReferenceNumber</h2>
                    </div>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                        <i class="ti ti-arrow-left me-1"></i> Back to Details
                    </a>
                </div>
            </div>

            <div class="card-body">
                <div id="formAlerts"></div>

                <form id="editAuthorizationForm">
                    <input type="hidden" id="authorizationId" value="@Model.Id" />

                    <div class="row mb-3">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Branch <span class="text-danger">*</span></label>
                            <select class="form-select" id="branchId">
                                <option value="">-- Select Branch --</option>
                                @foreach (var b in (ViewBag.Branches as List<BranchDto> ?? new()))
                                {
                                    <option value="@b.Id" selected="@(b.Id == Model.BranchId ? "selected" : null)">@b.Name</option>
                                }
                            </select>
                            <div class="form-text text-muted" id="branchHint"></div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Reference Number <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="referenceNumber" value="@Model.ReferenceNumber" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="authorizationDate" value="@Model.Date.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Denomination Details</label>
                        <table class="table table-bordered" id="denominationTable">
                            <thead>
                                <tr>
                                    <th>Denomination</th>
                                    <th>Number of Bags</th>
                                    <th>Amount</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                            <tfoot style="background-color: #f8f9fa;">
                                <tr>
                                    <td colspan="2" class="text-end align-middle">Grand Total Amount</td>
                                    <td style="min-width: 160px;">
                                        <input type="text" class="form-control text-end" id="grandTotalAmount" readonly placeholder="0" />
                                    </td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                        <div class="d-flex justify-content-end mt-3">
                            <button type="button" class="btn btn-success btn-sm" id="addDenominationRow">
                                <i class="ti ti-plus"></i> Add Row
                            </button>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary" id="submitBtn">
                            <i class="ti ti-check me-1"></i>Update
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                            <i class="ti ti-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
$(document).ready(function () {

    const denominationOptions = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
        ViewBag.Denominations != null
            ? ((List<VMSService.Core.Services.Stocks.StockEntities.Denomination>)ViewBag.Denominations)
                .Select(d => new { id = d.Id, name = d.Name, value = d.Value, piecesInBox = d.NumberOfPiecesInABox })
            : Enumerable.Empty<object>()
    ));

    let denominationRows = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
        Model.DestructionAuthorizationDenominations != null
            ? Model.DestructionAuthorizationDenominations.Select(d => new {
                denominationId = d.DenominationId.ToString(),
                numberOfBags   = d.NumberOfBags ?? "",
                amount         = d.Amount
              })
            : Enumerable.Empty<object>()
    ));

    if (!denominationRows.length) {
        denominationRows = [{ denominationId: '', numberOfBags: '', amount: '' }];
    }

    // Bags available per denomination in the Cancelled category for the currently selected branch.
    let availableBagsByDenom = {};

    function availableBagsFor(denominationId) {
        if (!denominationId || availableBagsByDenom[denominationId] === undefined) return null;
        return availableBagsByDenom[denominationId];
    }

    function loadAvailableBags(branchId, thenRender) {
        availableBagsByDenom = {};
        $('#branchHint').text('');
        if (!branchId) { if (thenRender) renderDenominationTable(); return; }

        $('#branchHint').text('Loading available Cancelled-category stock…');
        $.get('@Url.Action("GetAvailableCancelledBags", "DestructionAuthorizations")', { branchId: branchId })
            .done(function (resp) {
                availableBagsByDenom = (resp && resp.bags) || {};
                $('#branchHint').text(resp && resp.error ? resp.error : '');
                if (thenRender) renderDenominationTable();
            })
            .fail(function () {
                $('#branchHint').text('Could not load available stock for this branch.');
            });
    }

    $('#branchId').on('change', function () {
        loadAvailableBags(parseInt($(this).val()) || 0, true);
    });

    function buildDenomOptions(selectedId) {
        let html = '<option value="">-- Select Denomination --</option>';
        denominationOptions.forEach(d => {
            html += `<option value="${d.id}" data-value="${d.value}" data-pieces="${d.piecesInBox}" ${String(d.id) === String(selectedId) ? 'selected' : ''}>${d.name} (${Number(d.value).toLocaleString()})</option>`;
        });
        return html;
    }

    function formatAmount(val) {
        const n = parseFloat(val);
        if (isNaN(n)) return '';
        return n.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    }

    function recalculateGrandTotal() {
        const grand = denominationRows.reduce((sum, r) => sum + (parseFloat(r.amount) || 0), 0);
        $('#grandTotalAmount').val(formatAmount(grand));
    }

    function updateBagsAvailabilityUI(idx) {
        const row  = denominationRows[idx];
        const $row = $(`#denominationTable tbody tr[data-idx="${idx}"]`);
        if (!$row.length) return;

        const available = availableBagsFor(row.denominationId);
        const bagsQty   = parseInt(row.numberOfBags) || 0;
        const isOver    = available !== null && bagsQty > available;

        $row.find('.denom-bags').toggleClass('is-invalid', isOver);
        const $hint = $row.find('.form-text');
        if (available !== null) {
            $hint.text(`Available: ${Number(available).toLocaleString()} bag(s) in Cancelled`)
                 .toggleClass('text-danger', isOver)
                 .toggleClass('text-muted', !isOver);
        }
    }

    function calculateDenomRow(idx) {
        const row  = denominationRows[idx];
        const $row = $(`#denominationTable tbody tr[data-idx="${idx}"]`);
        if (!$row.length) return;
        const denom = denominationOptions.find(d => String(d.id) === String(row.denominationId));
        const bags  = parseInt(row.numberOfBags) || 0;

        updateBagsAvailabilityUI(idx);

        if (!denom || bags === 0) {
            denominationRows[idx].amount = '';
            $row.find('.denom-amount').val('');
            return;
        }
        const amount = denom.piecesInBox * denom.value * bags;
        denominationRows[idx].amount = amount;
        $row.find('.denom-amount').val(formatAmount(amount));
    }

    function renderDenominationTable() {
        const $tbody = $('#denominationTable tbody');
        $tbody.empty();
        denominationRows.forEach((row, idx) => {
            const available = availableBagsFor(row.denominationId);
            const bagsQty   = parseInt(row.numberOfBags) || 0;
            const isOver    = available !== null && bagsQty > available;
            $tbody.append(`
                <tr data-idx="${idx}">
                    <td><select class="form-select denom-id">${buildDenomOptions(row.denominationId)}</select></td>
                    <td>
                        <input type="text" class="form-control denom-bags ${isOver ? 'is-invalid' : ''}" value="${row.numberOfBags}" placeholder="e.g. 5" />
                        ${available !== null ? `<div class="form-text ${isOver ? 'text-danger' : 'text-muted'}">Available: ${Number(available).toLocaleString()} bag(s) in Cancelled</div>` : ''}
                    </td>
                    <td><input type="text" class="form-control text-end denom-amount" value="${formatAmount(row.amount)}" placeholder="0" readonly /></td>
                    <td class="text-center align-middle">
                        <button type="button" class="btn btn-danger btn-sm remove-denom-row"><i class="ti ti-trash"></i></button>
                    </td>
                </tr>
            `);
        });
        recalculateGrandTotal();
    }

    $('#denominationTable').on('change', '.denom-id', function () {
        const idx = $(this).closest('tr').data('idx');
        denominationRows[idx].denominationId = $(this).val();
        calculateDenomRow(idx);
        renderDenominationTable();
    });

    $('#denominationTable').on('input', '.denom-bags', function () {
        const idx = $(this).closest('tr').data('idx');
        denominationRows[idx].numberOfBags = $(this).val();
        calculateDenomRow(idx);
        recalculateGrandTotal();
    });

    $('#addDenominationRow').on('click', function () {
        denominationRows.push({ denominationId: '', numberOfBags: '', amount: '' });
        renderDenominationTable();
    });

    $('#denominationTable').on('click', '.remove-denom-row', function () {
        const idx = $(this).closest('tr').data('idx');
        if (denominationRows.length > 1) { denominationRows.splice(idx, 1); renderDenominationTable(); }
    });

    $('#editAuthorizationForm').on('submit', function (e) {
        e.preventDefault();
        const $btn = $('#submitBtn');

        const branchId = parseInt($('#branchId').val()) || 0;
        const validDenoms = denominationRows.filter(r => r.denominationId !== '');

        const errors = [];
        if (!branchId) errors.push('Please select a Branch.');
        for (const row of validDenoms) {
            const available = availableBagsFor(row.denominationId);
            if (available !== null && (parseInt(row.numberOfBags) || 0) > available) {
                errors.push(`Number of bags for a denomination exceeds the ${available.toLocaleString()} bag(s) available in the Cancelled category for this branch.`);
                break;
            }
        }

        if (errors.length) {
            $('#formAlerts').html(
                '<div class="alert alert-danger alert-dismissible fade show"><ul class="mb-0">' +
                errors.map(e => `<li>${e}</li>`).join('') +
                '</ul><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>'
            );
            return;
        }

        const payload = {
            Id:              parseInt($('#authorizationId').val()),
            BranchId:        branchId,
            ReferenceNumber: $('#referenceNumber').val().trim(),
            Date:            $('#authorizationDate').val(),
            Denominations:   validDenoms
                .map(r => ({
                    DenominationId: parseInt(r.denominationId) || 0,
                    NumberOfBags:   r.numberOfBags || null,
                    Amount:         parseFloat(r.amount) || 0
                }))
        };

        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Saving...');
        $('#formAlerts').empty();

        $.ajax({
            url:         '@Url.Action("Edit")',
            type:        'POST',
            contentType: 'application/json',
            data:        JSON.stringify(payload),
            success: function (response) {
                if (response && response.redirectUrl) {
                    window.location.href = response.redirectUrl;
                }
            },
            error: function (xhr) {
                let msg = 'An unexpected error occurred.';
                if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                $('#formAlerts').html(
                    `<div class="alert alert-danger alert-dismissible fade show">
                        <i class="ti ti-alert-triangle me-1"></i>${msg}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>`
                );
            },
            complete: function () {
                $btn.prop('disabled', false).html('<i class="ti ti-check me-1"></i>Update');
            }
        });
    });

    const initialBranchId = parseInt($('#branchId').val()) || 0;
    if (initialBranchId) {
        loadAvailableBags(initialBranchId, true);
    } else {
        renderDenominationTable();
    }
});
</script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
