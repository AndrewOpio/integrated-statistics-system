@using ConfigurationsService.Client
@using VMSService.Core.Models.Vaults
@model List<VMSService.Core.Models.Bags.BagViewModel>

@{
    ViewData["Title"] = "Bagging Management";
    var branches = ViewBag.Branches as ICollection<BranchDto> ?? new List<BranchDto>();
    int? selectedBranchId = ViewBag.SelectedBranchId as int?;
    var selectedBranch = branches.FirstOrDefault(b => b.Id == selectedBranchId);

    var denomOptions = Model.Select(b => b.DenominationName)
        .Where(d => !string.IsNullOrEmpty(d))
        .Distinct().OrderBy(d => d).ToList();

    var bankOptions = Model.SelectMany(b => b.CommercialBankNames)
        .Distinct().OrderBy(b => b).ToList();

    var vaultOptions = Model
        .Where(b => b.VaultId.HasValue && !string.IsNullOrEmpty(b.VaultName))
        .GroupBy(b => b.VaultId)
        .Select(g => new { g.First().VaultId, g.First().VaultName })
        .OrderBy(v => v.VaultName)
        .ToList();

    var vaultSectionOptions = Model
        .Where(b => b.VaultSectionId.HasValue && !string.IsNullOrEmpty(b.VaultSectionName))
        .GroupBy(b => b.VaultSectionId)
        .Select(g => new { g.First().VaultSectionId, g.First().VaultSectionName, g.First().VaultId })
        .OrderBy(vs => vs.VaultSectionName)
        .ToList();

    var categoryOptions = Model
        .Where(b => !string.IsNullOrEmpty(b.CategoryName))
        .Select(b => b.CategoryName!)
        .Distinct().OrderBy(c => c).ToList();

    var subCategoryOptions = Model
        .Where(b => !string.IsNullOrEmpty(b.SubCategoryName))
        .Select(b => b.SubCategoryName!)
        .Distinct().OrderBy(sc => sc).ToList();
}

<style>
    .branch-pill {
        display: inline-flex;
        align-items: center;
        padding: .25rem .75rem;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 600;
        letter-spacing: .04em;
        text-decoration: none;
        border: 1.5px solid #dee2e6;
        background: #fff;
        color: #495057;
        transition: background .15s, color .15s, border-color .15s;
    }
    .branch-pill:hover {
        background: #f0f4ff;
        border-color: #31316A;
        color: #31316A;
    }
    .branch-pill.active {
        background: #31316A;
        border-color: #31316A;
        color: #fff;
    }
</style>

@* Branch Filter Pills *@
<div class="d-flex align-items-center gap-2 flex-wrap mb-3">
    <span class="small text-muted fw-semibold me-1">
        <i class="ti ti-filter me-1"></i>Branch:
    </span>

     @* <a asp-action="Index"
       class="branch-pill @(selectedBranchId == null ? "active" : "")"
       title="All branches">
        ALL
    </a> *@

    @foreach (var branch in branches.OrderBy(b => b.Name))
    {
        <a asp-action="Index" asp-route-branchId="@branch.Id"
           class="branch-pill @(selectedBranchId == branch.Id ? "active" : "")"
           title="@branch.Name">
            @(string.IsNullOrWhiteSpace(branch.BranchCode) ? branch.Name : branch.BranchCode)
        </a>
    }
</div>

@* Table Filters *@
<div class="card border-0 shadow mb-3">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end mb-2">
            <div class="col-sm-6 col-md-3">
                <label class="form-label small fw-semibold mb-1">Denomination</label>
                <select id="filterDenomination" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (var d in denomOptions)
                    {
                        <option value="@d">@d</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label small fw-semibold mb-1">Commercial Bank</label>
                <select id="filterBank" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (var b in bankOptions)
                    {
                        <option value="@b">@b</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label small fw-semibold mb-1">Vault</label>
                <select id="filterVault" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (var v in vaultOptions)
                    {
                        <option value="@v.VaultId">@v.VaultName</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label small fw-semibold mb-1">Vault Section</label>
                <select id="filterVaultSection" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (var vs in vaultSectionOptions)
                    {
                        <option value="@vs.VaultSectionId" data-vault-id="@vs.VaultId">@vs.VaultSectionName</option>
                    }
                </select>
            </div>
        </div>
        <div class="row g-2 align-items-end">
            <div class="col-sm-6 col-md-3">
                <label class="form-label small fw-semibold mb-1">Category</label>
                <select id="filterCategory" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (var c in categoryOptions)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label small fw-semibold mb-1">Sub-Category</label>
                <select id="filterSubCategory" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (var sc in subCategoryOptions)
                    {
                        <option value="@sc">@sc</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-md-2">
                <label class="form-label small fw-semibold mb-1">Start Date (Deposit Date)</label>
                <input type="date" id="filterStartDate" class="form-control form-control-sm" />
            </div>
            <div class="col-sm-6 col-md-2">
                <label class="form-label small fw-semibold mb-1">End Date (Deposit Date)</label>
                <input type="date" id="filterEndDate" class="form-control form-control-sm" />
            </div>
            <div class="col-sm-6 col-md-auto">
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" role="switch" id="filterPartial" />
                    <label class="form-check-label small fw-semibold" for="filterPartial">Partial</label>
                </div>
            </div>
            <div class="col-sm-12 col-md-auto d-flex gap-2">
                <button id="btnFilter" class="btn btn-sm btn-tertiary">
                    <i class="ti ti-filter me-1"></i>Filter
                </button>
                <button id="btnClearFilter" class="btn btn-sm btn-outline-secondary">
                    <i class="ti ti-x me-1"></i>Clear
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow mb-4">
    <div class="card-header">
        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center">
            <div class="d-block mb-4 mb-md-0">
                <h2 class="h4 text-tertiary">Bagging Management</h2>
                <p class="mb-0 d-flex align-items-center gap-2">
                    Manage bags and organize deposit request denominations
                    @if (selectedBranch != null)
                    {
                        <span class="badge bg-tertiary bg-opacity-10 text-tertiary border border-tertiary border-opacity-25">
                            <i class="ti ti-map-pin me-1"></i>@selectedBranch.Name
                        </span>
                    }
                </p>
            </div>
            <div class="btn-toolbar mb-2 mb-md-0 d-flex gap-2 align-items-center">
                <a asp-action="Create" asp-route-branchId="@selectedBranchId" class="btn btn-sm btn-tertiary d-inline-flex align-items-center">
                    <i class="ti ti-plus me-2"></i>Create New Empty Bag
                </a>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-centered table-nowrap mb-0 rounded" id="bagsTable">
                <thead class="thead-light">
                    <tr>
                        <th class="border-0 rounded-start p-1 pe-4">Bag Reference Number</th>
                        <th class="border-0 p-1 pe-4">Denomination</th>
                        <th class="border-0 p-1 pe-4">Bundles/ Boxes</th>
                        <th class="border-0 p-1 pe-4">Amount in Bag (UGX)</th>
                        <th class="border-0 p-1 pe-4">Commercial Bank</th>
                        <th class="border-0 p-1 pe-4">Sub-Category</th>
                        <th class="border-0 p-1 pe-4">Deposit/ Create Date</th>
                        <th class="border-0 rounded-end p-1 pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bag in Model)
                    {
                        <tr data-denomination="@bag.DenominationName"
                            data-bank-names="@string.Join(",", bag.CommercialBankNames)"
                            data-vault-id="@bag.VaultId"
                            data-vault-section-id="@bag.VaultSectionId"
                            data-category-name="@bag.CategoryName"
                            data-subcategory-name="@bag.SubCategoryName"
                            data-is-partial="@((bag.TotalBundles < VaultBagViewModel.MaxBundles).ToString().ToLower())"
                            data-created-date="@bag.CreatedDate.ToString("yyyy-MM-dd")">
                            <td>
                                <a asp-action="Details" asp-route-id="@bag.Id" class="fw-bold text-nowrap">
                                    @bag.ReferenceNumber
                                </a>
                            </td>
                            <td>
                                <span class="badge" style="background-color:#e7f5ff;color:#0b5394;font-size:0.9em;">
                                    <i class="ti ti-coins me-1"></i>@bag.DenominationName
                                </span>
                            </td>
                            <td>@bag.TotalBundles</td>
                            <td>@bag.TotalAmount.ToString("N0")</td>
                            <td>
                                @if (bag.CommercialBankNames.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var bankName in bag.CommercialBankNames)
                                        {
                                            <span class="badge bg-info">
                                                <i class="ti ti-building me-1"></i>@bankName
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(bag.SubCategoryName))
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">@bag.SubCategoryName</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>@bag.CreatedDate.ToString("dd MMM yyyy HH:mm")</td>
                            <td>
                                <form asp-action="Delete" asp-route-id="@bag.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this bag? All items will be released.');">
                                    @Html.AntiForgeryToken()
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@bag.Id" class="btn btn-sm btn-outline-tertiary" title="View Details">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                        @*<a asp-action="AddItems" asp-route-id="@bag.Id" class="btn btn-sm btn-outline-success" title="Add Items">
                                            <i class="ti ti-plus"></i>
                                        </a>*@
                                        @if (!bag.Items.Any(bd => !bd.IsDeleted) && !bag.HasNestedBags)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Bag">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            // Build vault-id → [{val, text}] map from the initial options
            var vaultSectionMap = {};
            $('#filterVaultSection option[data-vault-id]').each(function () {
                var vaultId = String($(this).data('vault-id'));
                if (!vaultSectionMap[vaultId]) vaultSectionMap[vaultId] = [];
                vaultSectionMap[vaultId].push({ val: $(this).val(), text: $(this).text(), vaultId: vaultId });
            });

            // Custom row-level filter registered with DataTables
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                if (settings.nTable.id !== 'bagsTable') return true;

                var api = new $.fn.dataTable.Api(settings);
                var $row = $(api.row(dataIndex).node());

                var denom = $('#filterDenomination').val();
                var bank = $('#filterBank').val();
                var vaultId = $('#filterVault').val();
                var vaultSectionId = $('#filterVaultSection').val();
                var category = $('#filterCategory').val();
                var subCategory = $('#filterSubCategory').val();
                var partialOnly = $('#filterPartial').is(':checked');
                var startDate = $('#filterStartDate').val();
                var endDate = $('#filterEndDate').val();

                if (denom && $row.data('denomination') !== denom) return false;

                if (bank) {
                    var banks = String($row.data('bank-names') || '').split(',').map(function (s) { return s.trim(); });
                    if (banks.indexOf(bank) === -1) return false;
                }

                if (vaultId && String($row.data('vault-id')) !== vaultId) return false;
                if (vaultSectionId && String($row.data('vault-section-id')) !== vaultSectionId) return false;
                if (category && $row.data('category-name') !== category) return false;
                if (subCategory && $row.data('subcategory-name') !== subCategory) return false;
                if (partialOnly && $row.data('is-partial') !== true) return false;

                if (startDate || endDate) {
                    var rowDate = String($row.data('created-date') || '');
                    if (startDate && rowDate < startDate) return false;
                    if (endDate && rowDate > endDate) return false;
                }

                return true;
            });

            var table = $('#bagsTable').DataTable({
                order: [[5, 'desc']]
            });

            // Apply filter on button click
            $('#btnFilter').on('click', function () {
                table.draw();
            });

            // Clear all filters
            $('#btnClearFilter').on('click', function () {
                $('#filterDenomination, #filterBank, #filterVault, #filterCategory, #filterSubCategory').val('');
                $('#filterPartial').prop('checked', false);
                $('#filterStartDate, #filterEndDate').val('');
                populateVaultSections('');
                table.draw();
            });

            // Vault → VaultSection dependency
            function populateVaultSections(selectedVaultId) {
                var $vs = $('#filterVaultSection');
                $vs.empty().append('<option value="">All</option>');
                if (!selectedVaultId) {
                    $.each(vaultSectionMap, function (vaultId, sections) {
                        $.each(sections, function (i, s) {
                            $vs.append('<option value="' + s.val + '" data-vault-id="' + s.vaultId + '">' + s.text + '</option>');
                        });
                    });
                } else {
                    var sections = vaultSectionMap[selectedVaultId] || [];
                    $.each(sections, function (i, s) {
                        $vs.append('<option value="' + s.val + '">' + s.text + '</option>');
                    });
                }
            }

            $('#filterVault').on('change', function () {
                populateVaultSections($(this).val());
            });
        });
    </script>
}
