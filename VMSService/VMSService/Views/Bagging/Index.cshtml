@model List<VMSService.Core.Models.Bags.BagViewModel>

@{
    ViewData["Title"] = "Bagging Management";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center py-4">
    <div class="d-block mb-4 mb-md-0">
        <h2 class="h4">Bagging Management</h2>
        <p class="mb-0">Manage bags and organize deposit request denominations</p>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a asp-action="Create" class="btn btn-sm btn-primary d-inline-flex align-items-center">
            <i class="ti ti-plus me-2"></i>
            Create New Bag
        </a>
    </div>
</div>

<div class="card border-0 shadow mb-4">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-centered table-nowrap mb-0 rounded" id="bagsTable">
                <thead class="thead-light">
                    <tr>
                        <th class="border-0 rounded-start">#</th>
                        <th class="border-0">Reference Number</th>
                        <th class="border-0">Denomination</th>
                        <th class="border-0">Items Count</th>
                        <th class="border-0">Total Amount</th>
                        <th class="border-0">Created By</th>
                        <th class="border-0">Created Date</th>
                        <th class="border-0 rounded-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bag in Model)
                        {
                            <tr>
                                <td>@bag.Id</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@bag.Id" class="fw-bold">
                                        @bag.ReferenceNumber
                                    </a>
                                </td>
                                <td>@bag.DenominationName (@bag.DenominationValue.ToString("N2"))</td>
                                <td>
                                    <span class="badge bg-primary">@bag.ItemCount items</span>
                                </td>
                                <td>@bag.TotalAmount.ToString("N2")</td>
                                <td>@bag.CreatedBy</td>
                                <td>@bag.CreatedDate.ToString("dd MMM yyyy HH:mm")</td>
                                <td>
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@bag.Id" class="btn btn-sm btn-primary" title="View Details">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                        <a asp-action="AddItems" asp-route-id="@bag.Id" class="btn btn-sm btn-success" title="Add Items">
                                            <i class="ti ti-plus"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@bag.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this bag?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#bagsTable').DataTable({
                order: [[6, 'desc']]
            });
        });
    </script>
}