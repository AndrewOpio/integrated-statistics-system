@model VMSService.Core.Models.AgentDetails.AgentDetailViewModel

@{
    Layout = "_CbLayoutOther";
    ViewData["Title"] = "Edit Agent";
}

<div class="row">
    <div class="col-12 col-lg-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header pb-4 bg-white">
                <div class="d-flex justify-content-between">
                    <div>
                        <span class="text-muted small mb-2">Edit Agent</span>
                        <h2 class="fs-4 fw-bold mb-0">@Model.AgentNames</h2>
                    </div>
                    <div>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-yellow">
                            <i class="ti ti-arrow-left me-1"></i>Back
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert">
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <div class="alert alert-light border d-flex align-items-center gap-2 py-2 px-3" role="note">
                    <i class="ti ti-shield-check text-success"></i>
                    <span class="small mb-0">
                        Replacement attachments are scanned for viruses before they are saved.
                        A file found to be malicious is rejected and the current attachment is kept.
                    </span>
                </div>
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id">
                    <input type="hidden" asp-for="PassportPhoto">
                    <input type="hidden" asp-for="WorkIdScan">
                    <input type="hidden" asp-for="SignatureScan">
                    <input type="hidden" asp-for="ApprovalAttachment">
                    <div class="row">
                        <div class="col-md-6">
                            <!-- Passport Photo -->
                            <div class="mb-3">
                                <label class="form-label" asp-for="PassportPhotoFile">Passport Photo</label>
                                @if (!string.IsNullOrEmpty(Model.PassportPhoto))
                                {
                                    <div class="border rounded-2 p-3 bg-light d-flex align-items-center gap-3 mb-2">
                                        <img src="@FileUrlHelper.ToWebPath(Model.PassportPhoto)" alt="Current Photo" class="rounded" style="width: 48px; height: 48px; object-fit: cover; flex-shrink: 0;">
                                        <div class="flex-grow-1">
                                            <span class="d-block fw-semibold small">Current Passport Photo</span>
                                            <span class="d-block text-muted" style="font-size: 11px;">Uploaded attachment</span>
                                        </div>
                                        <a href="@FileUrlHelper.ToWebPath(Model.PassportPhoto)" target="_blank" class="btn btn-sm btn-outline-secondary" title="View full size">
                                            <i class="ti ti-external-link"></i>
                                        </a>
                                    </div>
                                }
                                <input type="file" class="form-control" id="PassportPhotoFile" name="PassportPhotoFile" accept="image/*">
                                <small class="text-muted">Leave empty to keep current photo</small>
                                <span asp-validation-for="PassportPhotoFile" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" asp-for="AgentNames">Agent Names <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" asp-for="AgentNames" required placeholder="Enter agent names as per work ID">
                                <small class="text-muted">Exactly as they appear in their work-issued identity cards</small>
                                <span asp-validation-for="AgentNames" class="text-danger small d-block mt-1"></span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" asp-for="NIN">National Identification Number (NIN) <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" asp-for="NIN" required placeholder="Enter NIN">
                                <span asp-validation-for="NIN" class="text-danger small d-block mt-1"></span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" asp-for="PhoneNumber">Phone Number</label>
                                <div class="input-group">
                                    <span class="input-group-text fw-semibold">+256</span>
                                    <input type="tel" class="form-control" asp-for="PhoneNumber"
                                           placeholder="712345678" maxlength="9"
                                           pattern="\d{9}" title="Enter 9 digits after +256">
                                </div>
                                <small class="text-muted">Enter the 9 digits after the country code</small>
                                <span asp-validation-for="PhoneNumber" class="text-danger small d-block mt-1"></span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" asp-for="BranchId">BOU Branch <span class="text-danger">*</span></label>
                                <select class="form-select" asp-for="BranchId" asp-items="@Model.BranchList" required>
                                </select>
                                <small class="text-muted">The BOU branch they will be transacting at</small>
                                <span asp-validation-for="BranchId" class="text-danger small d-block mt-1"></span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" asp-for="CommercialBankBranchId">Commercial Bank Branch <span class="text-danger">*</span></label>
                                <select class="form-select" asp-for="CommercialBankBranchId" asp-items="@Model.CommercialBankBranchList" required>
                                    <option value="">-- Select Branch --</option>
                                </select>
                                <span asp-validation-for="CommercialBankBranchId" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            

                            <!-- Work ID Scan -->
                            <div class="mb-3">
                                <label class="form-label" asp-for="WorkIdScanFile">Work ID Scan</label>
                                @if (!string.IsNullOrEmpty(Model.WorkIdScan))
                                {
                                    <div class="border rounded-2 p-3 bg-light d-flex align-items-center gap-3 mb-2">
                                        <div class="d-flex align-items-center justify-content-center rounded-2 bg-white" style="width: 48px; height: 48px; flex-shrink: 0;">
                                            <i class="ti ti-id text-primary fs-4"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <span class="d-block fw-semibold small">Current Work ID Scan</span>
                                            <span class="d-block text-muted" style="font-size: 11px;">Uploaded attachment</span>
                                        </div>
                                        <a href="@FileUrlHelper.ToWebPath(Model.WorkIdScan)" target="_blank" class="btn btn-sm btn-outline-secondary" title="View document">
                                            <i class="ti ti-external-link"></i>
                                        </a>
                                    </div>
                                }
                                <input type="file" class="form-control" id="WorkIdScanFile" name="WorkIdScanFile" accept="image/*,.pdf">
                                <small class="text-muted">Leave empty to keep current file</small>
                                <span asp-validation-for="WorkIdScanFile" class="text-danger small d-block mt-1"></span>
                            </div>

                            <!-- Signature Scan -->
                            <div class="mb-3">
                                <label class="form-label" asp-for="SignatureScanFile">Signature Scan</label>
                                @if (!string.IsNullOrEmpty(Model.SignatureScan))
                                {
                                    <div class="border rounded-2 p-3 bg-light d-flex align-items-center gap-3 mb-2">
                                        <div class="d-flex align-items-center justify-content-center rounded-2 bg-white" style="width: 48px; height: 48px; flex-shrink: 0;">
                                            <i class="ti ti-signature text-success fs-4"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <span class="d-block fw-semibold small">Current Signature Scan</span>
                                            <span class="d-block text-muted" style="font-size: 11px;">Uploaded attachment</span>
                                        </div>
                                        <a href="@FileUrlHelper.ToWebPath(Model.SignatureScan)" target="_blank" class="btn btn-sm btn-outline-secondary" title="View document">
                                            <i class="ti ti-external-link"></i>
                                        </a>
                                    </div>
                                }
                                <input type="file" class="form-control" id="SignatureScanFile" name="SignatureScanFile" accept="image/*,.pdf">
                                <small class="text-muted">Leave empty to keep current file</small>
                                <span asp-validation-for="SignatureScanFile" class="text-danger small d-block mt-1"></span>
                            </div>

                            <!-- MD Approval Attachment -->
                            <div class="mb-3">
                                <label class="form-label" asp-for="ApprovalAttachmentFile">MD Approval Attachment</label>
                                @if (!string.IsNullOrEmpty(Model.ApprovalAttachment))
                                {
                                    <div class="border rounded-2 p-3 bg-light d-flex align-items-center gap-3 mb-2">
                                        <div class="d-flex align-items-center justify-content-center rounded-2 bg-white" style="width: 48px; height: 48px; flex-shrink: 0;">
                                            <i class="ti ti-file-certificate text-purple fs-4"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <span class="d-block fw-semibold small">Current MD Approval</span>
                                            <span class="d-block text-muted" style="font-size: 11px;">Uploaded attachment</span>
                                        </div>
                                        <a href="@FileUrlHelper.ToWebPath(Model.ApprovalAttachment)" target="_blank" class="btn btn-sm btn-outline-secondary" title="View document">
                                            <i class="ti ti-external-link"></i>
                                        </a>
                                    </div>
                                }
                                <input type="file" class="form-control" id="ApprovalAttachmentFile" name="ApprovalAttachmentFile" accept="image/*,.pdf">
                                <small class="text-muted">Leave empty to keep current file</small>
                                <span asp-validation-for="ApprovalAttachmentFile" class="text-danger small d-block mt-1"></span>
                            </div>

                            <!-- IsActive toggle switch -->
                            <div class="form-group mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="form-check form-switch d-flex align-items-center">
                                        <input class="form-check-input cursor-pointer" type="checkbox" asp-for="IsActive" role="switch"
                                               id="flexSwitchIsActive" style="width: 3em; height: 1.5em;">
                                        <label class="form-check-label ms-1 fw-medium" asp-for="IsActive">
                                            <span id="statusText" class="ms-1">
                                                <span id="activeText">Active</span>
                                                <span class="text-danger d-none" id="inactiveText">Inactive</span>
                                            </span>
                                        </label>
                                    </div>
                                </div>
                                <span asp-validation-for="IsActive" class="text-danger d-block mt-1"></span>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-brown">
                            <i class="ti ti-check me-1"></i>Update
                        </button>
                        <a asp-action="Index" class="btn btn-yellow">
                            <i class="ti ti-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const phoneInput = document.getElementById('PhoneNumberInput');
            const phoneHidden = document.getElementById('PhoneNumberHidden');

            // Only allow digits
            phoneInput.addEventListener('input', function () {
                this.value = this.value.replace(/\D/g, '').substring(0, 9);
                syncHiddenField();
            });

            // Sync hidden field on any change
            phoneInput.addEventListener('change', function () {
                syncHiddenField();
            });

            function syncHiddenField() {
                const digits = phoneInput.value.replace(/\D/g, '');
                phoneHidden.value = digits;
            }

            // Sync on page load (for Edit with existing value)
            syncHiddenField();

            // Intercept form submission to ensure sync
            phoneInput.closest('form').addEventListener('submit', function () {
                syncHiddenField();
            });
        });
    </script>
}