@model VMSService.Core.Models.AgentDetails.AgentDetailViewModel

@{
    ViewData["Title"] = "Delete Agent";
}

<div class="row">
    <div class="col-12 col-lg-12">
        <div class="card border-0 shadow mb-4 border-danger border-2">
            <div class="card-header pb-4 bg-light">
                <div class="d-flex flex-column">
                    <span class="text-danger small mb-2">
                        <i class="ti ti-alert-triangle me-1"></i>Delete Agent
                    </span>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        @if (!string.IsNullOrEmpty(Model.PassportPhoto))
                        {
                            <img src="@Model.PassportPhoto" alt="Passport Photo" class="rounded-circle" style="width: 60px; height: 60px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                <i class="ti ti-user text-white fs-4"></i>
                            </div>
                        }
                        <h2 class="fs-4 fw-bold mb-0">@Model.AgentNames</h2>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.BranchName))
                    {
                        <div class="d-inline-flex align-items-center gap-2" style="width: fit-content;">
                            <span class="badge bg-danger">
                                <i class="ti ti-building-bank me-1"></i>@Model.BranchName
                            </span>
                        </div>
                    }
                </div>
            </div>

            <div class="card-body">
                <div class="alert alert-warning mb-4" role="alert">
                    <i class="ti ti-alert-triangle me-2"></i>
                    <strong>Warning!</strong> This action cannot be undone. Please confirm you want to permanently delete this record.
                </div>

                <div class="field mb-4">
                    <span class="d-block text-muted small mb-2 text-uppercase">National Identification Number (NIN)</span>
                    <span class="d-block fw-normal">@Model.NIN</span>
                </div>

                @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                {
                    <div class="field mb-4">
                        <span class="d-block text-muted small mb-2 text-uppercase">Phone Number</span>
                        <span class="d-block fw-normal">@Model.PhoneNumber</span>
                    </div>
                }
            </div>

            <div class="card-footer bg-transparent border-top pt-3">
                <form asp-action="Delete" method="post" class="d-inline">
                    <input type="hidden" asp-for="Id">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="ti ti-trash me-1"></i>Confirm Delete
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="ti ti-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>