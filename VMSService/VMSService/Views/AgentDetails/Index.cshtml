@model List<VMSService.Core.Models.AgentDetails.AgentDetailViewModel>

@{
    Layout = "_CbLayoutOther";
    ViewData["Title"] = "Agent Details";
    var userRoles = string.Join(", ", User.FindAll("appRole").Where(c => c.Value.StartsWith("VMS:")).Select(c => c.Value.Split(":")[1]).ToList());
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white p-3">
                <div class="row align-items-center">
                    <div class="col">
                        <h2 class="fs-5 fw-bold mb-0">Agent Details</h2>
                    </div>
                    <div class="col text-end">
                        <a asp-action="Create" class="btn btn-sm btn-brown">
                            <i class="ti ti-plus me-1"></i>Add Agent
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-centered table-nowrap mb-0 rounded datatable" id="agentDetailsTable">
                        <thead class="thead-light">
                            <tr>
                                <th class="border-0 bg-light rounded-start">#</th>
                                <th class="border-0 bg-light">Photo</th>
                                <th class="border-0 bg-light">Agent Names</th>
                                <th class="border-0 bg-light">NIN</th>
                                <th class="border-0 bg-light">Phone Number</th>
                                <th class="border-0 bg-light">BOU Branch</th>
                                <th class="border-0 bg-light">Status</th>
                                <th class="border-0 bg-light rounded-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowNumber = 1;
                            }

                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><span>@rowNumber</span></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.PassportPhoto))
                                        {
                                            <img src="@item.PassportPhoto" alt="Passport Photo" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                <i class="ti ti-user text-white"></i>
                                            </div>
                                        }
                                    </td>
                                    <td class="fw-bold">@item.AgentNames</td>
                                    <td>@item.NIN</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.PhoneNumber))
                                        {
                                            @item.PhoneNumber
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-inline-flex align-items-center gap-2" style="width: fit-content;">
                                            <span class="badge bg-brown">
                                                <i class="ti ti-building-bank me-1"></i>@item.BranchName
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-inline-flex align-items-center gap-2" style="width: fit-content;">
                                            <span class="badge bg-purple">
                                                <i class="ti ti-badge me-1"></i>@item.CurrentStatusName
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-brown" title="View Details">
                                                <i class="ti ti-eye"></i>
                                            </a>
                                            @if (item.CurrentStatusName == StatusConstants.AgentDetail.Draft && userRoles.Contains(SystemPolicy.Roles.CbMaker))
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-brown" title="Edit">
                                                    <i class="ti ti-edit"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-brown" title="Delete">
                                                    <i class="ti ti-trash"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                    @{
                                        rowNumber++;
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>