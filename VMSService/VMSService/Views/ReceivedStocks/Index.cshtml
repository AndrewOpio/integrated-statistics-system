@model List<VMSService.Core.Models.ReceivedStocks.ReceivedStockViewModel>

@{
    ViewData["Title"] = "Received Stock";
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h2 class="fs-5 fw-bold mb-0">Received Stock</h2>
                    </div>
                    <div class="col text-end">
                        <a asp-action="Create" class="btn btn-sm btn-primary">
                            <i class="ti ti-plus me-1"></i>Add Received Stock
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <!-- Success Message -->
                @* @if (!string.IsNullOrEmpty(TempData?["Success"]?.ToString()))
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="ti ti-check-circle me-2"></i>
                        <strong>Success!</strong> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                } *@

                <!-- Error Message -->
                @* @if (!string.IsNullOrEmpty(TempData?["Error"]?.ToString()))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="ti ti-alert-circle me-2"></i>
                        <strong>Error!</strong> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                } *@

                <div class="table-responsive">
                    <table class="table table-centered table-nowrap mb-0 rounded datatable">
                        <thead class="thead-light">
                            <tr>
                                <th class="border-0 rounded-start">#</th>
                                <th class="border-0">Expected Stock Reference</th>
                                <th class="border-0">Branch</th>
                                <th class="border-0">Vendor</th>
                                <th class="border-0">Denomination</th>
                                <th class="border-0">Date Delivered</th>
                                <th class="border-0">Value (UGX)</th>
                                <th class="border-0">Status</th>
                                <th class="border-0 rounded-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowNumber = 1;
                            }
                            
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><span class="text-primary fw-bold">@rowNumber</span></td>
                                    <td class="fw-bold">@item.ExPrintMint?.ExPrintMintReference</td>
                                    <td>
                                        @if (item.ExPrintMint?.Branch != null)
                                        {
                                            @item.ExPrintMint.Branch.Name
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.ExPrintMint?.CurrencyVendor != null)
                                        {
                                            @item.ExPrintMint.CurrencyVendor.Name
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.ExPrintMint?.Denomination != null)
                                        {
                                            @item.ExPrintMint.Denomination.Name
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>@item.DateDelivered.ToString("dd/MMM/yyyy")</td>
                                    <td>
                                        <span class="fw-bold">@item.Value.ToString("N0")</span>
                                    </td>
                                    <td>
                                        <div class="d-inline-flex align-items-center gap-2" style="width: fit-content;">
                                            @if (item.CurrentStatusId > 0)
                                            {
                                                <span class="badge bg-info">
                                                    <i class="ti ti-badge me-1"></i>@item.CurrentStatus?.Name
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="ti ti-question-mark me-1"></i>Unknown
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="ti ti-eye"></i>
                                            </a>
                                            @{
                                                bool isEditable = item.CurrentStatus?.Name == StatusConstants.ReceivedStock.Draft || item.CurrentStatus?.Name == StatusConstants.ReceivedStock.Returned;
                                            }
                                            @if (isEditable)
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                                    <i class="ti ti-edit"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                                    <i class="ti ti-trash"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                    @{
                                        rowNumber++;
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}