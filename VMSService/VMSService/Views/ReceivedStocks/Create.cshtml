@model VMSService.Core.Models.ReceivedStocks.ReceivedStockViewModel

@{
    ViewData["Title"] = "Add Received Stock";
}

<div class="row">
    <div class="col-12 col-lg-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <h2 class="fs-5 fw-bold mb-0">Add New Received Stock</h2>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert">
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <form asp-action="Create" method="post" enctype="multipart/form-data" id="createForm">

                    <!-- Section 1: Expected Stock Information -->
                    <div class="form-section mb-4 shadow">
                        <div class="mb-3 pb-2 border-bottom">
                            <small class="fw-bold text-muted mb-0 text-uppercase">
                                <i class="ti ti-info-circle me-2"></i>Expected Stock Information
                            </small>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label class="form-label" asp-for="ExPrintMintId">Expected Stock <span class="text-danger">*</span></label>
                                <select class="form-select" asp-for="ExPrintMintId" id="ExPrintMintId" required>
                                    <option value="">-- Select Expected Stock --</option>
                                    @if (ViewBag.ExPrintMints != null)
                                    {
                                        @foreach (var exPrintMint in ViewBag.ExPrintMints)
                                        {
                                            <option value="@exPrintMint.Id" 
                                                    data-reference="@exPrintMint.ExPrintMintReference"
                                                    data-vendor="@exPrintMint.CurrencyVendor?.Name"
                                                    data-denomination="@exPrintMint.Denomination?.Name"
                                                    data-delivery-date="@exPrintMint.DeliveryDate.ToString("dd/MMM/yyyy")"
                                                    data-denomination-value="@exPrintMint.Denomination?.Value"
                                                    data-pieces-in-box="@exPrintMint.Denomination?.NumberOfPiecesInABox">
                                                @exPrintMint.ExPrintMintReference | @exPrintMint.DeliveryDate.ToString("dd/MMM/yyyy")
                                            </option>
                                        }
                                    }
                                </select>
                                <small class="text-muted d-block mt-1">Select the expected stock that has been received</small>
                                <span asp-validation-for="ExPrintMintId" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <!-- Expected Stock Summary Card -->
                        <div id="exPrintMintSummary" style="display: none;" class="mb-3">
                            <div class="card border-0 bg-light">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Reference</small>
                                                <p class="mb-0 fw-bold" id="summaryReference">-</p>
                                            </div>

                                            <div class="mb-3">
                                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Vendor</small>
                                                <p class="mb-0 fw-bold">
                                                    <i class="ti ti-building-bank me-1 text-success"></i><span id="vendorName">-</span>
                                                </p>
                                            </div>


                                        </div>

                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Expected Delivery Date</small>
                                                <p class="mb-0 fw-bold">
                                                    <i class="ti ti-calendar me-1 text-warning"></i><span id="deliveryDate">-</span>
                                                </p>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mt-3">
                                        <div class="col-12">
                                            <small class="text-muted text-uppercase fw-semibold d-block mb-2">Denominations in this batch</small>
                                            <div class="table-responsive">
                                                <table class="table table-sm align-middle mb-0" style="border: none;">
                                                    <thead>
                                                        <tr style="background-color: #f8f9fa; border-bottom: 1px solid #f0f0f0;">
                                                            <th style="border: none; padding: 10px 12px; font-weight: 600; font-size: 13px; color: #495057;">Denomination</th>
                                                            <th class="text-end" style="border: none; padding: 10px 12px; font-weight: 600; font-size: 13px; color: #495057;">Pieces</th>
                                                            <th class="text-end" style="border: none; padding: 10px 12px; font-weight: 600; font-size: 13px; color: #495057;">Boxes</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="summaryDenominationsTable">
                                                        <tr>
                                                            <td colspan="3" class="text-center text-muted small" style="padding: 12px; border: none;">Select an ExPrintMint to view details</td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    <!-- Section 2: Received Stock Details -->
                    <div class="form-section mb-4 shadow">
                        <div class="mb-3 pb-2 border-bottom">
                            <small class="fw-bold text-muted mb-0 text-uppercase">
                                <i class="ti ti-package me-2"></i>Received Stock Details
                            </small>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label class="form-label" for="DateDelivered">Date Delivered <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="DateDelivered" name="DateDelivered" required>
                                <small class="text-muted d-block mt-1">Select a date up to today (current date)</small>
                                <span class="text-danger small d-block mt-1" id="dateError"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="DeliveryAirline">Delivery Airline</label>
                                <input type="text" class="form-control" id="DeliveryAirline" name="DeliveryAirline" placeholder="Enter airline name">
                                <span asp-validation-for="DeliveryAirline" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="TestingFees">Testing Fees</label>
                                <input type="number" class="form-control" id="TestingFees" name="TestingFees" placeholder="0" step="0.01" min="0">
                                <span asp-validation-for="TestingFees" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="ShippingFees">Shipping Fees</label>
                                <input type="number" class="form-control" id="ShippingFees" name="ShippingFees" placeholder="0" step="0.01" min="0">
                                <span asp-validation-for="ShippingFees" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="InsuranceFees">Insurance Fees</label>
                                <input type="number" class="form-control" id="InsuranceFees" name="InsuranceFees" placeholder="0" step="0.01" min="0">
                                <span asp-validation-for="InsuranceFees" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="HandlingCharges">Handling Charges</label>
                                <input type="number" class="form-control" id="HandlingCharges" name="HandlingCharges" placeholder="0" step="0.01" min="0">
                                <span asp-validation-for="HandlingCharges" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="ClearingFees">Clearing Fees</label>
                                <input type="number" class="form-control" id="ClearingFees" name="ClearingFees" placeholder="0" step="0.01" min="0">
                                <span asp-validation-for="ClearingFees" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <!-- Partial Delivery Checkbox -->
                        <div class="row">
                            <div class="col-12">
                                <div class="form-check form-check-md">
                                    <input type="checkbox" class="form-check-input" asp-for="IsPartial" id="IsPartial">
                                    <label class="form-check-label fw-semibold" for="IsPartial">
                                        <i class="ti ti-info-circle me-1"></i>
                                        Partial Delivery
                                        <small class="text-muted d-block mt-1">
                                            Check this if this delivery is a partial fulfillment of the expected stock
                                        </small>
                                    </label>
                                </div>
                                <span asp-validation-for="IsPartial" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Section 3: Denominations & Stock Details -->
                    <div class="form-section mb-4 shadow">
                        <div class="mb-3 pb-2 border-bottom">
                            <small class="fw-bold text-muted mb-0 text-uppercase">
                                <i class="ti ti-package me-2"></i>Denominations & Stock Details
                            </small>
                        </div>

                        <div class="alert alert-info mb-3">
                            <i class="ti ti-info-circle me-2"></i>
                            Add denominations received in this delivery. This breaks down the stock by denomination.
                        </div>

                        <!-- Denominations Table -->
                        <div class="table-responsive">
                            <table class="table align-middle mb-0" id="denominations-table" style="border: none;">
                                <thead>
                                    <tr style="background-color: #f8f9fa; border-bottom: 1px solid #f0f0f0;">
                                        <th class="ps-3" style="border: none; padding: 12px 16px; font-weight: 600; font-size: 14px; color: #495057;">Denomination</th>
                                        <th style="border: none; padding: 12px 16px; font-weight: 600; font-size: 14px; color: #495057;">Start Case Number</th>
                                        <th style="border: none; padding: 12px 16px; font-weight: 600; font-size: 14px; color: #495057;">End Case Number</th>
                                        <th class="text-center" style="width: 80px; border: none; padding: 12px 16px; font-weight: 600; font-size: 14px; color: #495057;">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Details != null && Model.Details.Any())
                                    {
                                        @for (var index = 0; index < Model.Details.Count; index++)
                                        {
                                            var detail = Model.Details.ElementAt(index);
                                            <tr style="border-bottom: 1px solid #f5f5f5; transition: all 0.2s ease;">
                                                <td style="padding: 12px 16px; border: none;">
                                                    <input type="hidden" name="Details[@index].Id" value="@detail.Id" />
                                                    <select name="Details[@index].PackingListRangeId" class="form-select denomination-select" data-denomination-value="0" data-pieces-in-box="1" style="border: 1px solid #f5f5f5; border-radius: 6px; padding: 8px 12px; font-weight: 500;">
                                                        <option value="">-- Select Denomination --</option>
                                                    </select>
                                                </td>
                                                <td style="padding: 12px 16px; border: none;">
                                                    <input name="Details[@index].ReceivedStartCaseNumber" class="form-control start-case-input" type="number" value="@detail.ReceivedStartCaseNumber" placeholder="0" style="border: 1px solid #f5f5f5; border-radius: 6px; padding: 8px 12px;" />
                                                </td>
                                                <td style="padding: 12px 16px; border: none;">
                                                    <input name="Details[@index].ReceivedEndCaseNumber" class="form-control end-case-input" type="number" value="@detail.ReceivedEndCaseNumber" placeholder="0" style="border: 1px solid #f5f5f5; border-radius: 6px; padding: 8px 12px;" />
                                                </td>
                                                <td class="text-center" style="padding: 12px 16px; border: none;">
                                                    <button type="button" class="btn btn-sm btn-outline-danger remove-row" style="border-radius: 6px; border: 1.5px solid #dc3545; transition: all 0.2s ease;" title="Remove row">
                                                        <i class="ti ti-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center text-muted" style="padding: 20px; border: none;">No denominations added</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @* <div class="d-flex gap-2 mt-3 mb-3">
                            <button type="button" id="add-row" class="btn btn-outline-primary">
                                <i class="ti ti-plus me-1"></i>Add Denomination Row
                            </button>
                        </div> *@
                    </div>

                    <!-- Section 4: Box Number Details -->
                    @* <div class="form-section mb-4 shadow"> *@
                    @*     <div class="mb-3 pb-2 border-bottom"> *@
                    @*         <small class="fw-bold text-muted mb-0 text-uppercase"> *@
                    @*             <i class="ti ti-box me-2"></i>Box Number Details *@
                    @*         </small> *@
                    @*     </div> *@
                    @*     <div class="mb-3"> *@
                    @*         <label class="form-label" asp-for="BoxNumberPrefix">Box Number Prefix <span class="text-danger">*</span></label> *@
                    @*         <input type="text" class="form-control" asp-for="BoxNumberPrefix" placeholder="Enter box number prefix"> *@
                    @*         <small class="text-muted d-block mt-1">Prefix used before box numbers</small> *@
                    @*         <span asp-validation-for="BoxNumberPrefix" class="text-danger small d-block mt-1"></span> *@
                    @*     </div> *@

                    @*     <div class="row"> *@
                    @*         <div class="col-md-6 mb-3"> *@
                    @*             <label class="form-label" asp-for="BoxNumberRangeStart">Box Number Range Start <span class="text-danger">*</span></label> *@
                    @*             <input type="number" class="form-control" asp-for="BoxNumberRangeStart" placeholder="Enter start range"> *@
                    @*             <span asp-validation-for="BoxNumberRangeStart" class="text-danger small d-block mt-1"></span> *@
                    @*         </div> *@

                    @*         <div class="col-md-6 mb-3"> *@
                    @*             <label class="form-label" asp-for="BoxNumberRangeEnd">Box Number Range End <span class="text-danger">*</span></label> *@
                    @*             <input type="number" class="form-control" asp-for="BoxNumberRangeEnd" placeholder="Enter end range"> *@
                    @*             <span asp-validation-for="BoxNumberRangeEnd" class="text-danger small d-block mt-1"></span> *@
                    @*         </div> *@
                    @*     </div> *@
                    @* </div> *@

                    <!-- Section 5: Serial Number Details -->
                    @* <div class="form-section mb-4 shadow"> *@
                    @*     <div class="mb-3 pb-2 border-bottom"> *@
                    @*         <small class="fw-bold text-muted mb-0 text-uppercase"> *@
                    @*             <i class="ti ti-barcode me-2"></i>Serial Number Details *@
                    @*         </small> *@
                    @*     </div> *@

                    @*     <div class="mb-3"> *@
                    @*         <label class="form-label" asp-for="SerialNumberPrefix">Serial Number Prefix <span class="text-danger">*</span></label> *@
                    @*         <input type="text" class="form-control" asp-for="SerialNumberPrefix" placeholder="Enter serial number prefix"> *@
                    @*         <small class="text-muted d-block mt-1">Prefix used before serial numbers</small> *@
                    @*         <span asp-validation-for="SerialNumberPrefix" class="text-danger small d-block mt-1"></span> *@
                    @*     </div> *@
                    @*     <div class="row"> *@
                    @*         <div class="col-md-6 mb-3"> *@
                    @*             <label class="form-label" asp-for="SerialNumberRangeStart">Serial Number Range Start <span class="text-danger">*</span></label> *@
                    @*             <input type="number" class="form-control" asp-for="SerialNumberRangeStart" placeholder="Enter start range"> *@
                    @*             <span asp-validation-for="SerialNumberRangeStart" class="text-danger small d-block mt-1"></span> *@
                    @*         </div> *@

                    @*         <div class="col-md-6 mb-3"> *@
                    @*             <label class="form-label" asp-for="SerialNumberRangeEnd">Serial Number Range End <span class="text-danger">*</span></label> *@
                    @*             <input type="number" class="form-control" asp-for="SerialNumberRangeEnd" placeholder="Enter end range"> *@
                    @*             <span asp-validation-for="SerialNumberRangeEnd" class="text-danger small d-block mt-1"></span> *@
                    @*         </div> *@
                    @*     </div> *@
                    @* </div> *@
                    
                    <!-- Form Actions -->
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-check me-1"></i>Save
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="ti ti-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        // Set delivery date to today and set max date to today
        const today = new Date().toISOString().split('T')[0];
        const $dateDelivered = $('#DateDelivered');
        $dateDelivered.val(today);
        $dateDelivered.attr('max', today);

        const $exPrintMintSelect = $('#ExPrintMintId');
        const $summaryCard = $('#exPrintMintSummary');
        const tableElement = document.getElementById('denominations-table');
        const addRowButton = document.getElementById('add-row');

        // Handle Date Delivered change - validate it's not in the future
        $dateDelivered.on('change', function() {
            const selectedDate = new Date($(this).val());
            const todayDate = new Date(today);
            
            if (selectedDate > todayDate) {
                $('#dateError').text('Date cannot be in the future. Please select today or an earlier date.').show();
                $(this).val(today);
                $(this).focus();
            } else {
                $('#dateError').text('').hide();
            }
        });

        // Build a map of all PackingListRanges for "Add new row" dropdown
        const packingListRangesMap = {};
        @if (ViewBag.PackingListRanges != null)
        {
            @foreach (var range in ViewBag.PackingListRanges)
            {
                <text>packingListRangesMap[@range.Id] = { denominationName: '@range.DenominationName' };</text>
            }
        }

        // Handle ExPrintMint selection change
        // Build a map of ExPrintMint IDs to their details
        const exPrintMintDetails = {};
        @if (ViewBag.ExPrintMints != null)
        {
            @foreach (var exPrintMint in ViewBag.ExPrintMints)
            {
                <text>exPrintMintDetails[@exPrintMint.Id] = [</text>
                @if (exPrintMint.Details != null)
                {
                    @foreach (var detail in exPrintMint.Details)
                    {
                        <text>{
                            id: @detail.Id,
                            denominationName: '@detail.DenominationName',
                            numberOfPieces: @detail.NumberOfPieces,
                            value: @detail.Value,
                            numberOfBoxes: @detail.NumberOfBoxes
                        },</text>
                    }
                }
                <text>];</text>
            }
        }

        $exPrintMintSelect.on('change', function() {
            const selectedOption = $(this).find('option:selected');
            const selectedExPrintMintId = $(this).val();
            
            if (selectedExPrintMintId) {
                // Update summary with selected data
                $('#summaryReference').text(selectedOption.data('reference'));
                $('#vendorName').text(selectedOption.data('vendor'));
                $('#denominationName').text(selectedOption.data('denomination'));
                $('#deliveryDate').text(selectedOption.data('delivery-date'));
                
                // Populate summary denominations table
                const details = exPrintMintDetails[selectedExPrintMintId] || [];
                const $table = $('#summaryDenominationsTable');
                $table.empty();
                
                if (details.length > 0) {
                    details.forEach(detail => {
                        $table.append(`
                            <tr>
                                <td>${detail.denominationName}</td>
                                <td class="text-end">${detail.numberOfPieces.toLocaleString('en-US')}</td>
                                <td class="text-end">${detail.numberOfBoxes.toLocaleString('en-US')}</td>
                            </tr>
                        `);
                    });
                } else {
                    $table.append('<tr><td colspan="3" class="text-center text-muted small">No denominations in this batch</td></tr>');
                }
                
                // Show summary card
                $summaryCard.show();

                // Populate denomination table with ExPrintMint details
                if (details.length > 0) {
                    populateDenominationTable(details);
                } else {
                    clearDenominationTable();
                }
            } else {
                // Hide summary card if no selection
                $summaryCard.hide();
                clearDenominationTable();
            }
        });

        // Helper function to populate denomination table with ExPrintMint details
        function populateDenominationTable(details) {
            const tbody = tableElement.querySelector('tbody');
            tbody.innerHTML = ''; // Clear existing rows

            details.forEach((detail, index) => {
                // Find the PackingListRangeId from the map using the denomination name
                let packingListRangeId = 0;
                for (const [id, range] of Object.entries(packingListRangesMap)) {
                    if (range.denominationName === detail.denominationName) {
                        packingListRangeId = id;
                        break;
                    }
                }

                const row = document.createElement('tr');
                row.style.borderBottom = '1px solid #f5f5f5';
                row.style.transition = 'all 0.2s ease';
                row.innerHTML = `
                    <td style="padding: 12px 16px; border: none;">
                        <input type="hidden" name="Details[${index}].Id" value="0" />
                        <input type="hidden" name="Details[${index}].PackingListRangeId" value="${packingListRangeId}" />
                        <div class="form-control-plaintext fw-bold" style="padding: 8px 0; margin: 0;">
                            ${detail.denominationName}
                        </div>
                    </td>
                    <td style="padding: 12px 16px; border: none;">
                        <input name="Details[${index}].ReceivedStartCaseNumber" class="form-control start-case-input" type="number" value="0" placeholder="0" style="border: 1px solid #f5f5f5; border-radius: 6px; padding: 8px 12px;" />
                    </td>
                    <td style="padding: 12px 16px; border: none;">
                        <input name="Details[${index}].ReceivedEndCaseNumber" class="form-control end-case-input" type="number" value="0" placeholder="0" style="border: 1px solid #f5f5f5; border-radius: 6px; padding: 8px 12px;" />
                    </td>
                    <td class="text-center" style="padding: 12px 16px; border: none;">
                        <button type="button" class="btn btn-sm btn-outline-danger remove-row" style="border-radius: 6px; border: 1.5px solid #dc3545; transition: all 0.2s ease;" title="Remove row">
                            <i class="ti ti-trash"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(row);
            });

            // Reattach event listeners
            attachTableEventListeners();
        }

        // Helper function to clear denomination table
        function clearDenominationTable() {
            const tbody = tableElement.querySelector('tbody');
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">No denominations added</td></tr>';
        }

        // Form submission - validate denominations
        $('#createForm').on('submit', function(e) {
            const tbody = tableElement.querySelector('tbody');
            const rows = tbody.querySelectorAll('tr');
            let hasValidRow = false;

            rows.forEach(row => {
                // Check if row has a valid PackingListRangeId
                const packingListRangeInput = row.querySelector('input[name*=".PackingListRangeId"]');
                const packingListRangeSelect = row.querySelector('select[name*=".PackingListRangeId"]');
                
                const hasValidId = (packingListRangeInput && packingListRangeInput.value) || 
                                   (packingListRangeSelect && packingListRangeSelect.value);
                
                if (hasValidId) {
                    hasValidRow = true;
                }
            });

            if (!hasValidRow) {
                e.preventDefault();
                alert('Please add at least one denomination');
                return false;
            }

            // Validate date
            const dateValue = $dateDelivered.val();
            const selectedDate = new Date(dateValue);
            const todayDate = new Date(today);
            
            if (selectedDate > todayDate) {
                e.preventDefault();
                $dateDelivered.focus();
                alert('Date cannot be in the future. Please select today or an earlier date.');
                return false;
            }
        });

        // Denominations Table JavaScript
        // Use event delegation on the table itself, not the tbody
        tableElement.addEventListener('click', event => {
            const removeButton = event.target.closest('.remove-row');
            if (!removeButton) {
                return;
            }

            const tbody = tableElement.querySelector('tbody');
            const rows = tbody.querySelectorAll('tr');
            if (rows.length === 1) {
                rows[0].querySelectorAll('input, select').forEach(field => field.value = '');
                return;
            }

            removeButton.closest('tr')?.remove();
            reindexRows();
        });

        // Add new row button handler
        addRowButton.addEventListener('click', () => {
            const tbody = tableElement.querySelector('tbody');
            const rowCount = tbody.querySelectorAll('tr').length;
            
            // Build options from packingListRangesMap
