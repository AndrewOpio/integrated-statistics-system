@model VMSService.Core.Models.ReceivedStocks.ReceivedStockViewModel

@{
    ViewData["Title"] = "Edit Received Stock";
}

<div class="row">
    <div class="col-12 col-lg-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header pb-4">
                <div class="d-flex flex-column">
                    <span class="text-muted small mb-2">Edit Received Stock</span>
                    <h2 class="fs-4 fw-bold mb-0">Received Stock - @Model.ExPrintMint.ExPrintMintReference</h2>
                </div>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert">
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <form asp-action="Edit" method="post" enctype="multipart/form-data" id="editForm">
                    <input type="hidden" asp-for="Id">
                    <input type="hidden" asp-for="CurrentStatusId">

                    <!-- Section 1: Expected Stock Information -->
                    <div class="form-section mb-4 shadow">
                        <div class="mb-3 pb-2 border-bottom">
                            <small class="fw-bold text-muted mb-0 text-uppercase">
                                <i class="ti ti-info-circle me-2"></i>Expected Stock Information
                            </small>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label class="form-label" asp-for="ExPrintMintId">Expected Stock <span class="text-danger">*</span></label>
                                <select class="form-select" asp-for="ExPrintMintId" id="ExPrintMintId" required>
                                    <option value="">-- Select Expected Stock --</option>
                                    @if (ViewBag.ExPrintMints != null)
                                    {
                                        @foreach (var exPrintMint in ViewBag.ExPrintMints)
                                        {
                                            <option value="@exPrintMint.Id" 
                                                    data-reference="@exPrintMint.ExPrintMintReference"
                                                    data-vendor="@exPrintMint.CurrencyVendor?.Name"
                                                    data-denomination="@exPrintMint.Denomination?.Name"
                                                    data-delivery-date="@exPrintMint.DeliveryDate.ToString("dd/MMM/yyyy")"
                                                    data-number-of-pieces="@exPrintMint.NumberOfPieces.ToString("N0")"
                                                    data-value="@exPrintMint.Value.ToString("N0")"
                                                    data-denomination-value="@exPrintMint.Denomination?.Value"
                                                    data-pieces-in-box="@exPrintMint.Denomination?.NumberOfPiecesInABox">
                                                @exPrintMint.ExPrintMintReference | @exPrintMint.Value.ToString("N0")/= | @exPrintMint.DeliveryDate.ToString("dd/MMM/yyyy")
                                            </option>
                                        }
                                    }
                                </select>
                                <small class="text-muted d-block mt-1">Select the expected stock that has been received</small>
                                <span asp-validation-for="ExPrintMintId" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <!-- Expected Stock Summary Card -->
                        <div id="exPrintMintSummary" style="display: none;">
                            <div class="card border-0 bg-light mb-3">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Reference</small>
                                                <p class="mb-0 fw-bold" id="summaryReference">-</p>
                                            </div>

                                            <div class="mb-3">
                                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Vendor</small>
                                                <p class="mb-0 fw-bold" id="summaryVendor">
                                                    <i class="ti ti-building me-1 text-primary"></i><span id="vendorName">-</span>
                                                </p>
                                            </div>

                                            <div class="mb-3">
                                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Denomination</small>
                                                <p class="mb-0 fw-bold" id="summaryDenomination">
                                                    <i class="ti ti-cash-banknote me-1 text-info"></i><span id="denominationName">-</span>
                                                </p>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Expected Delivery Date</small>
                                                <p class="mb-0 fw-bold" id="summaryDeliveryDate">
                                                    <i class="ti ti-calendar me-1 text-warning"></i><span id="deliveryDate">-</span>
                                                </p>
                                            </div>

                                            <div class="mb-3">
                                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Expected Number of Pieces</small>
                                                <p class="mb-0 fw-bold" id="summaryNumberOfPieces">
                                                    <span id="numberOfPieces">-</span>
                                                </p>
                                            </div>

                                            <div class="mb-3">
                                                <small class="text-muted text-uppercase fw-semibold d-block mb-1">Expected Value (UGX)</small>
                                                <p class="mb-0 fw-bold" id="summaryValue">
                                                    <span id="value">-</span>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Section 2: Received Stock Details -->
                    <div class="form-section mb-4 shadow">
                        <div class="mb-3 pb-2 border-bottom">
                            <small class="fw-bold text-muted mb-0 text-uppercase">
                                <i class="ti ti-package me-2"></i>Received Stock Details
                            </small>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="DateDelivered">Date Delivered <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="DateDelivered" name="DateDelivered" required>
                                <small class="text-muted d-block mt-1">Select a date up to today (current date)</small>
                                <span class="text-danger small d-block mt-1" id="dateError"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="NumberOfBoxesText">Number of Boxes <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="NumberOfBoxesText" placeholder="Enter number of boxes" required>
                                <input type="hidden" asp-for="NumberOfBoxes" id="NumberOfBoxes">
                                <small class="text-muted d-block mt-1">Enter the number of boxes received</small>
                                <span asp-validation-for="NumberOfBoxes" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="NumberOfPiecesText">Number of Pieces (Auto-calculated) <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="NumberOfPiecesText" placeholder="0" readonly value="@Model.NumberOfPieces.ToString("N0")">
                                <input type="hidden" asp-for="NumberOfPieces" id="NumberOfPieces">
                                <small class="text-muted d-block mt-1">Automatically calculated: Boxes × Pieces per Box</small>
                                <span asp-validation-for="NumberOfPieces" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="AmountText">Amount (Auto-calculated) <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="AmountText" placeholder="0" readonly value="@Model.Value.ToString("N0")">
                                <input type="hidden" asp-for="Value" id="Value">
                                <small class="text-muted d-block mt-1">Automatically calculated: Pieces × Denomination Value</small>
                                <span asp-validation-for="Value" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <!-- Partial Delivery Checkbox -->
                        <div class="row">
                            <div class="col-12">
                                <div class="form-check form-check-md">
                                    <input type="checkbox" class="form-check-input" asp-for="IsPartial" id="IsPartial">
                                    <label class="form-check-label fw-semibold" for="IsPartial">
                                        <i class="ti ti-info-circle me-1"></i>
                                        Partial Delivery
                                        <small class="text-muted d-block mt-1">
                                            Check this if this delivery is a partial fulfillment of the expected stock
                                        </small>
                                    </label>
                                </div>
                                <span asp-validation-for="IsPartial" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Section 3: Box Number Details -->
                    <div class="form-section mb-4 shadow">
                        <div class="mb-3 pb-2 border-bottom">
                            <small class="fw-bold text-muted mb-0 text-uppercase">
                                <i class="ti ti-box me-2"></i>Box Number Details
                            </small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" asp-for="BoxNumberPrefix">Box Number Prefix <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" asp-for="BoxNumberPrefix" placeholder="Enter box number prefix">
                            <small class="text-muted d-block mt-1">Prefix used before box numbers</small>
                            <span asp-validation-for="BoxNumberPrefix" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" asp-for="BoxNumberRangeStart">Box Number Range Start <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" asp-for="BoxNumberRangeStart" placeholder="Enter start range">
                                <span asp-validation-for="BoxNumberRangeStart" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label" asp-for="BoxNumberRangeEnd">Box Number Range End <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" asp-for="BoxNumberRangeEnd" placeholder="Enter end range">
                                <span asp-validation-for="BoxNumberRangeEnd" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Section 4: Serial Number Details -->
                    <div class="form-section mb-4 shadow">
                        <div class="mb-3 pb-2 border-bottom">
                            <small class="fw-bold text-muted mb-0 text-uppercase">
                                <i class="ti ti-barcode me-2"></i>Serial Number Details
                            </small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" asp-for="SerialNumberPrefix">Serial Number Prefix <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" asp-for="SerialNumberPrefix" placeholder="Enter serial number prefix">
                            <small class="text-muted d-block mt-1">Prefix used before serial numbers</small>
                            <span asp-validation-for="SerialNumberPrefix" class="text-danger small d-block mt-1"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" asp-for="SerialNumberRangeStart">Serial Number Range Start <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" asp-for="SerialNumberRangeStart" placeholder="Enter start range">
                                <span asp-validation-for="SerialNumberRangeStart" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label" asp-for="SerialNumberRangeEnd">Serial Number Range End <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" asp-for="SerialNumberRangeEnd" placeholder="Enter end range">
                                <span asp-validation-for="SerialNumberRangeEnd" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Form Actions -->
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-check me-1"></i>Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="ti ti-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        // Set max date to today
        const today = new Date().toISOString().split('T')[0];
        const $dateDelivered = $('#DateDelivered');
        $dateDelivered.attr('max', today);

        const $exPrintMintSelect = $('#ExPrintMintId');
        const $summaryCard = $('#exPrintMintSummary');
        const $numberOfBoxesText = $('#NumberOfBoxesText');
        const $numberOfBoxes = $('#NumberOfBoxes');
        const $numberOfPiecesText = $('#NumberOfPiecesText');
        const $numberOfPieces = $('#NumberOfPieces');
        const $amountText = $('#AmountText');
        const $value = $('#Value');

        // Initialize form with current values on page load
        function initializeForm() {
            const currentExPrintMintId = $exPrintMintSelect.val();
            const currentNumberOfBoxes = $numberOfBoxes.val();
            const currentDateDelivered = $dateDelivered.val();

            if (currentExPrintMintId) {
                const selectedOption = $exPrintMintSelect.find('option:selected');
                
                // Update summary with selected data
                $('#summaryReference').text(selectedOption.data('reference'));
                $('#vendorName').text(selectedOption.data('vendor'));
                $('#denominationName').text(selectedOption.data('denomination'));
                $('#deliveryDate').text(selectedOption.data('delivery-date'));
                $('#numberOfPieces').text(selectedOption.data('number-of-pieces'));
                $('#value').text(selectedOption.data('value'));
                
                // Show summary card
                $summaryCard.show();
            }

            // Initialize NumberOfBoxes display
            if (currentNumberOfBoxes) {
                const formattedBoxes = parseInt(currentNumberOfBoxes).toLocaleString('en-US');
                $numberOfBoxesText.val(formattedBoxes);
            }

            // Initialize calculations
            calculatePiecesAndAmount();
        }

        // Handle Date Delivered change - validate it's not in the future
        $dateDelivered.on('change', function() {
            const selectedDate = new Date($(this).val());
            const todayDate = new Date(today);
            
            if (selectedDate > todayDate) {
                $('#dateError').text('Date cannot be in the future. Please select today or an earlier date.').show();
                $(this).val(today);
                $(this).focus();
            } else {
                $('#dateError').text('').hide();
            }
        });

        // Handle ExPrintMint selection change
        $exPrintMintSelect.on('change', function() {
            const selectedOption = $(this).find('option:selected');
            
            if ($(this).val()) {
                // Update summary with selected data
                $('#summaryReference').text(selectedOption.data('reference'));
                $('#vendorName').text(selectedOption.data('vendor'));
                $('#denominationName').text(selectedOption.data('denomination'));
                $('#deliveryDate').text(selectedOption.data('delivery-date'));
                $('#numberOfPieces').text(selectedOption.data('number-of-pieces'));
                $('#value').text(selectedOption.data('value'));
                
                // Show summary card
                $summaryCard.slideDown(300);

                // Recalculate when ExPrintMint changes
                calculatePiecesAndAmount();
            } else {
                // Hide summary card if no selection
                $summaryCard.slideUp(300);
                // Clear calculations
                $numberOfBoxesText.val('');
                $numberOfBoxes.val('');
                $numberOfPiecesText.val('0');
                $numberOfPieces.val('0');
                $amountText.val('0');
                $value.val('0');
            }
        });

        // Handle Number of Boxes formatting
        $numberOfBoxesText.on('input', function() {
            let input = $(this).val();
            
            // Remove all non-numeric characters
            let sanitized = input.replace(/[^0-9]/g, '');

            const number = parseInt(sanitized);
            if (!isNaN(number) && sanitized !== "") {
                // Format with commas
                $(this).val(number.toLocaleString('en-US'));
                // Update hidden input with numeric value
                $numberOfBoxes.val(number);
            } else {
                $(this).val('');
                $numberOfBoxes.val('');
            }

            // Recalculate when boxes change
            calculatePiecesAndAmount();
        });

        // Handle paste events for Number of Boxes
        $numberOfBoxesText.on('paste', function() {
            const $this = $(this);
            setTimeout(function() {
                $this.trigger('input');
            }, 10);
        });

        // Calculate pieces and amount based on boxes and denomination
        function calculatePiecesAndAmount() {
            const selectedExPrintMintId = $exPrintMintSelect.val();
            const boxes = parseInt($numberOfBoxes.val()) || 0;

            if (selectedExPrintMintId && boxes > 0) {
                // Get the denomination data from the selected option
                const selectedOption = $exPrintMintSelect.find('option:selected');
                const denominationValue = parseFloat(selectedOption.data('denomination-value')) || 0;
                const piecesInBox = parseInt(selectedOption.data('pieces-in-box')) || 1;

                // Calculate pieces: boxes * piecesInBox
                const pieces = boxes * piecesInBox;

                // Calculate amount: pieces * denominationValue
                const amount = pieces * denominationValue;

                // Display formatted pieces
                $numberOfPiecesText.val(pieces.toLocaleString('en-US'));
                $numberOfPieces.val(pieces);

                // Display formatted amount
                $amountText.val(amount.toLocaleString('en-US', {
                    minimumFractionDigits: 0,
                    maximumFractionDigits: 0
                }));
                $value.val(amount);
            } else {
                $numberOfPiecesText.val('0');
                $numberOfPieces.val('0');
                $amountText.val('0');
                $value.val('0');
            }
        }

        // Form submission - ensure values are set
        $('#editForm').on('submit', function(e) {
            const boxes = $numberOfBoxes.val();
            
            if (!boxes || boxes === '0') {
                e.preventDefault();
                $numberOfBoxesText.focus();
                alert('Please enter a valid number of boxes');
                return false;
            }

            const amount = $value.val();
            if (!amount || amount === '0') {
                e.preventDefault();
                alert('Number of boxes must be greater than 0. Please enter a valid value');
                return false;
            }

            // Validate date
            const dateValue = $dateDelivered.val();
            const selectedDate = new Date(dateValue);
            const todayDate = new Date(today);
            
            if (selectedDate > todayDate) {
                e.preventDefault();
                $dateDelivered.focus();
                alert('Date cannot be in the future. Please select today or an earlier date.');
                return false;
            }
        });

        // Initialize form on page load
        initializeForm();
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}