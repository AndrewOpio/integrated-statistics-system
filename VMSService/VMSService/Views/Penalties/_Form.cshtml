@model VMSService.Core.Models.Penalties.PenaltyViewModel

<input type="hidden" asp-for="Id" />

<div class="mb-3">
    <label class="form-label" asp-for="Name">Name <span class="text-danger">*</span></label>
    <input type="text" class="form-control" asp-for="Name" required placeholder="Enter penalty name">
    <span asp-validation-for="Name" class="text-danger small d-block mt-1"></span>
</div>

<div class="mb-3">
    <label class="form-label" asp-for="Description">Description</label>
    <textarea class="form-control" asp-for="Description" rows="2" placeholder="Optional description"></textarea>
</div>

<div class="mb-3">
    <label class="form-label" asp-for="AppliesTo">Applies To <span class="text-danger">*</span></label>
    <select class="form-select" asp-for="AppliesTo" asp-items="@Model.AppliesToList" required>
        <option value="">-- Select --</option>
    </select>
    <span asp-validation-for="AppliesTo" class="text-danger small d-block mt-1"></span>
</div>

<div class="mb-3">
    <label class="form-label" asp-for="Unit">Unit</label>
    <input type="text" class="form-control" asp-for="Unit" placeholder="e.g. per torn package (leave blank for a flat penalty)">
</div>

<div class="mb-3">
    <label class="form-label" asp-for="CutOffTime">Cut-Off Time</label>
    <input type="time" class="form-control" asp-for="CutOffTime">
</div>

<hr />
<p class="text-muted small">Set exactly one rate option: Penalty Value, Penalty Percent (with a Percent Cut-Off), or Penalty Multiplier.</p>

<div class="row">
    <div class="col-md-4 mb-3">
        <label class="form-label" asp-for="PenaltyValue">Penalty Value</label>
        <input type="number" step="0.01" class="form-control" asp-for="PenaltyValue">
    </div>
    <div class="col-md-4 mb-3">
        <label class="form-label" asp-for="PenaltyMultiplier">Penalty Multiplier</label>
        <input type="number" step="0.01" class="form-control" asp-for="PenaltyMultiplier">
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label class="form-label" asp-for="PenaltyPercent">Penalty Percent</label>
        <input type="number" step="0.01" class="form-control" asp-for="PenaltyPercent">
    </div>
    <div class="col-md-4 mb-3">
        <label class="form-label" asp-for="PercentCutOff">Percent Cut-Off</label>
        <input type="number" step="0.01" class="form-control" asp-for="PercentCutOff">
    </div>
</div>

<div class="mb-3">
    <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" asp-for="Active" id="activeSwitch">
        <label class="form-check-label" for="activeSwitch">Active</label>
    </div>
</div>
