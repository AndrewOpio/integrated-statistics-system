@model VMSService.Core.Models.Penalties.PenaltyViewModel

@{
    ViewData["Title"] = "Penalty Details";
}

<div class="row">
    <div class="col-12 col-lg-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header pb-4">
                <div class="d-flex flex-column">
                    <span class="text-muted small mb-2">Penalty Profile</span>
                    <h2 class="fs-4 fw-bold mb-3">@Model.Name</h2>
                    <div class="d-inline-flex align-items-center gap-2" style="width: fit-content;">
                        @if (Model.Active)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                        <span class="badge bg-primary">@Model.AppliesTo</span>
                    </div>
                </div>
            </div>

            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="field mb-4">
                        <span class="d-block text-muted small mb-2 text-uppercase">Description</span>
                        <span class="d-block fw-normal">@Model.Description</span>
                    </div>
                }

                <div class="field mb-4">
                    <span class="d-block text-muted small mb-2 text-uppercase">Unit</span>
                    <span class="d-block fw-normal">@(string.IsNullOrEmpty(Model.Unit) ? "Flat penalty" : Model.Unit)</span>
                </div>

                <div class="field mb-4">
                    <span class="d-block text-muted small mb-2 text-uppercase">Cut-Off Time</span>
                    <span class="d-block fw-normal">@(Model.CutOffTime?.ToString("HH:mm") ?? "-")</span>
                </div>

                @if (Model.PenaltyValue.HasValue)
                {
                    <div class="field mb-4">
                        <span class="d-block text-muted small mb-2 text-uppercase">Penalty Value</span>
                        <span class="d-block fw-normal">@Model.PenaltyValue.Value.ToString("N2")</span>
                    </div>
                }
                @if (Model.PenaltyPercent.HasValue)
                {
                    <div class="field mb-4">
                        <span class="d-block text-muted small mb-2 text-uppercase">Penalty Percent</span>
                        <span class="d-block fw-normal">@Model.PenaltyPercent.Value.ToString("N2")% (cut-off @Model.PercentCutOff?.ToString("N2"))</span>
                    </div>
                }
                @if (Model.PenaltyMultiplier.HasValue)
                {
                    <div class="field mb-4">
                        <span class="d-block text-muted small mb-2 text-uppercase">Penalty Multiplier</span>
                        <span class="d-block fw-normal">x@(Model.PenaltyMultiplier.Value.ToString("N2"))</span>
                    </div>
                }
            </div>

            <div class="card-footer bg-transparent border-top pt-3">
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="ti ti-pencil me-1"></i>Edit
                    </a>
                    <a asp-controller="PenaltyWaivers" asp-action="Index" asp-route-penaltyId="@Model.Id" class="btn btn-outline-dark">
                        <i class="ti ti-shield-off me-1"></i>Manage Waivers
                    </a>
                    @if (Model.Active)
                    {
                        <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="ti ti-toggle-left me-1"></i>Deactivate
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Activate" asp-route-id="@Model.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-success">
                                <i class="ti ti-toggle-right me-1"></i>Activate
                            </button>
                        </form>
                    }
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="ti ti-arrow-left me-1"></i>Back
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
