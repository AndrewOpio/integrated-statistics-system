@model VMSService.Core.Models.BPSMachines.BPSMachineViewModel

@{
    ViewData["Title"] = "Create BPS Machine";
}

<div class="row">
    <div class="col-12 col-lg-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <h2 class="fs-5 fw-bold mb-0">Create New BPS Machine</h2>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert">
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label class="form-label" asp-for="Name">Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" asp-for="Name" required placeholder="Enter machine name" />
                        <span asp-validation-for="Name" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="CurrentStatusId">Status <span class="text-danger">*</span></label>
                        <select class="form-select" asp-for="CurrentStatusId" asp-items="@Model.StatusList" required>
                            <option value="">-- Select Status --</option>
                        </select>
                        <span asp-validation-for="CurrentStatusId" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-check me-1"></i>Save
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="ti ti-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
