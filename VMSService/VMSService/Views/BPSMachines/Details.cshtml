@using VMSService.Core.Models.BPSMachines
@model VMSService.Core.Models.BPSMachines.BPSMachineViewModel

@{
    ViewData["Title"] = "BPS Machine Details";
}

<div class="row">
    <div class="col-12 col-lg-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header pb-4">
                <div class="d-flex flex-column">
                    <span class="text-muted small mb-2">BPS Machine Profile</span>
                    <h2 class="fs-4 fw-bold mb-3">@Model.Name</h2>
                    <div class="d-inline-flex align-items-center gap-2" style="width: fit-content;">
                        <span class="badge bg-primary">
                            <i class="ti ti-badge me-1"></i>@BPSMachineViewModel.GetStatusName(Model.CurrentStatusId)
                        </span>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <div class="field mb-4">
                    <span class="d-block text-muted small mb-2 text-uppercase">Machine Name</span>
                    <span class="d-block fw-normal">@Model.Name</span>
                </div>
                <div class="field">
                    <span class="d-block text-muted small mb-2 text-uppercase">Current Status</span>
                    <span class="d-block fw-normal">@BPSMachineViewModel.GetStatusName(Model.CurrentStatusId)</span>
                </div>
            </div>

            <div class="card-footer bg-transparent border-top pt-3">
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="ti ti-pencil me-1"></i>Edit
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="ti ti-arrow-left me-1"></i>Back
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
