@using ConfigurationsService.Client
@model List<VMSService.Core.Models.Vaults.VaultCardViewModel>

@{
    ViewData["Title"] = "Vault Management";
    int totalBags = Model.Sum(v => v.TotalBags);
    int totalBundles = Model.Sum(v => v.TotalBundles);
    decimal totalAmount = Model.Sum(v => v.TotalAmount);
    int totalSections = Model.Sum(v => v.Sections.Count);
    var branches = ViewBag.Branches as ICollection<BranchDto> ?? new List<BranchDto>();
    int? selectedBranchId = ViewBag.SelectedBranchId as int?;
    var selectedBranch = branches.FirstOrDefault(b => b.Id == selectedBranchId);
}

<style>
    .branch-pill {
        display: inline-flex;
        align-items: center;
        padding: .25rem .75rem;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 600;
        letter-spacing: .04em;
        text-decoration: none;
        border: 1.5px solid #dee2e6;
        background: #fff;
        color: #495057;
        transition: background .15s, color .15s, border-color .15s;
    }
    .branch-pill:hover {
        background: #f0f4ff;
        border-color: #31316A;
        color: #31316A;
    }
    .branch-pill.active {
        background: #31316A;
        border-color: #31316A;
        color: #fff;
    }
    .vault-card-header {
        background: #fff;
        border-bottom: 1px solid #e9ecef;
        border-top: 3px solid #31316A;
        border-radius: .5rem .5rem 0 0;
    }
</style>

@* Branch Filter Pills *@
<div class="d-flex align-items-center gap-2 flex-wrap mb-3">
    <span class="small text-muted fw-semibold me-1">
        <i class="ti ti-filter me-1"></i>Branch:
    </span>
    @foreach (var branch in branches.OrderBy(b => b.Name))
    {
        <a asp-action="Index" asp-route-branchId="@branch.Id"
           class="branch-pill @(selectedBranchId == branch.Id ? "active" : "")"
           title="@branch.Name">
            @(string.IsNullOrWhiteSpace(branch.BranchCode) ? branch.Name : branch.BranchCode)
        </a>
    }
</div>

@* Summary Banner *@
<div class="rounded-3 p-3 mb-3" style="background:linear-gradient(135deg,#31316A 30%,#BA7517 100%);">
    <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap mb-3">
        <div>
            <p class="text-uppercase mb-1" style="font-size:10px;letter-spacing:.08em;color:rgba(255,255,255,.7);">
                <i class="ti ti-building-bank me-1"></i>Vault Management
            </p>
            <h5 class="fw-semibold text-white mb-1">@Model.Count Vault@(Model.Count == 1 ? "" : "s")</h5>
            <p class="small mb-0 d-flex align-items-center gap-2" style="color:rgba(255,255,255,.7);">
                @totalSections section@(totalSections == 1 ? "" : "s") across all vaults
                @if (selectedBranch != null)
                {
                    <span class="badge rounded-pill px-2 py-1" style="background:rgba(255,255,255,.2);color:#fff;font-size:.7rem;">
                        <i class="ti ti-map-pin me-1"></i>@selectedBranch.Name
                    </span>
                }
            </p>
        </div>
        @*<button type="button" class="btn btn-sm align-self-start"
                style="background:rgba(255,255,255,.2);color:#fff;border:1px solid rgba(255,255,255,.3);"
                data-bs-toggle="modal" data-bs-target="#createVaultModal">
            <i class="ti ti-plus me-1"></i>New Vault
        </button>*@
    </div>
    <div class="row g-2">
        <div class="col-6 col-md-4">
            <div class="rounded-3 p-2" style="background:rgba(255,255,255,.12);">
                <p class="text-uppercase mb-1" style="font-size:10px;letter-spacing:.1em;color:rgba(255,255,255,.7);">Total Bags</p>
                <p class="fw-bold mb-0 text-white">@totalBags</p>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="rounded-3 p-2" style="background:rgba(255,255,255,.12);">
                <p class="text-uppercase mb-1" style="font-size:10px;letter-spacing:.1em;color:rgba(255,255,255,.7);">Total Bundles</p>
                <p class="fw-bold mb-0 text-white">@totalBundles</p>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="rounded-3 p-2" style="background:rgba(255,255,255,.12);">
                <p class="text-uppercase mb-1" style="font-size:10px;letter-spacing:.1em;color:rgba(255,255,255,.7);">Total Amount</p>
                <p class="fw-bold mb-0 small text-white">UGX @totalAmount.ToString("N0")</p>
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow">
        <div class="card-body text-center py-5">
            <i class="ti ti-building-bank d-block mb-3 text-secondary" style="font-size:3rem;opacity:.4;"></i>
            <p class="fw-semibold text-muted mb-1">No vaults configured</p>
            <p class="text-muted small mb-3">Create a vault to get started.</p>
            <button type="button" class="btn btn-sm btn-tertiary" data-bs-toggle="modal" data-bs-target="#createVaultModal">
                <i class="ti ti-plus me-1"></i>Create First Vault
            </button>
        </div>
    </div>
}

@foreach (var vault in Model)
{
    @* Vault Container *@
    <div class="card border-0 shadow mb-4">
        <div class="vault-card-header d-flex align-items-center justify-content-between px-3 py-2">
            <div class="d-flex align-items-center gap-2">
                <div class="rounded d-flex align-items-center justify-content-center"
                     style="width:32px;height:32px;background:rgba(49,49,106,.08);flex-shrink:0;">
                    <i class="ti ti-lock" style="color:#31316A;font-size:.9rem;"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0" style="color:#31316A;">@vault.Name</h6>
                    <span class="small text-muted">
                        @vault.Sections.Count section@(vault.Sections.Count == 1 ? "" : "s")
                        &middot; @vault.TotalBags bag@(vault.TotalBags == 1 ? "" : "s")
                    </span>
                </div>
                @if (!vault.IsActive)
                {
                    <span class="badge bg-warning text-dark ms-1" style="font-size:10px;">Inactive</span>
                }
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (vault.TotalAmount > 0)
                {
                    <div class="text-end me-1 d-none d-sm-block">
                        <p class="text-uppercase mb-0" style="font-size:10px;letter-spacing:.06em;color:#6c757d;">Amount</p>
                        <p class="fw-bold mb-0 small" style="color:#31316A;">UGX @vault.TotalAmount.ToString("N0")</p>
                    </div>
                }
                @*<button type="button" class="btn btn-sm btn-outline-tertiary"
                        data-bs-toggle="modal" data-bs-target="#addSectionModal"
                        data-vault-id="@vault.Id" data-vault-name="@vault.Name"
                        title="Add section to this vault">
                    <i class="ti ti-layout-grid-add me-1"></i>Add Section
                </button>*@
                @*@if (vault.TotalBags == 0)
                {
                    <form asp-action="DeleteVault" asp-route-id="@vault.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Delete vault \'@vault.Name\'? This will also remove its empty sections.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete vault">
                            <i class="ti ti-trash"></i>
                        </button>
                    </form>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-danger" disabled
                            title="Vault has bags — remove all bags before deleting">
                        <i class="ti ti-trash"></i>
                    </button>
                }*@
            </div>
        </div>

        <div class="card-body p-3">
            @if (!vault.Sections.Any())
            {
                <div class="text-center py-4 text-muted">
                    <i class="ti ti-layout-grid-remove d-block mb-2" style="font-size:2rem;opacity:.4;"></i>
                    <p class="small mb-2">No sections in this vault</p>
                    @*<button type="button" class="btn btn-xs btn-outline-secondary"
                            style="padding:.2rem .6rem;font-size:.75rem;"
                            data-bs-toggle="modal" data-bs-target="#addSectionModal"
                            data-vault-id="@vault.Id" data-vault-name="@vault.Name">
                        <i class="ti ti-plus me-1"></i>Add First Section
                    </button>*@
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var sec in vault.Sections)
                    {
                        int fillPercent = sec.TotalBags > 0
                            ? (int)Math.Min(100, Math.Round((double)sec.TotalBundles / (sec.TotalBags * 50.0) * 100))
                            : 0;

                        string fillColor = fillPercent >= 90 ? "#dc3545"
                            : fillPercent >= 60 ? "#fd7e14"
                            : "#198754";

                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="border rounded-3 h-100" style="border-color:#e9ecef!important;">
                                @* Section Header *@
                                <div class="p-3 border-bottom d-flex align-items-center justify-content-between"
                                     style="background:#f8fafc;border-radius:1rem 1rem 0 0;">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="ti ti-archive text-tertiary"></i>
                                        <span class="fw-semibold">@sec.Name</span>
                                        @if (!sec.IsActive)
                                        {
                                            <span class="badge bg-warning text-dark ms-1" style="font-size:10px;">Inactive</span>
                                        }
                                    </div>
                                    <div class="d-flex align-items-center gap-1">
                                        <a asp-action="Section" asp-route-id="@sec.Id"
                                           class="btn btn-xs btn-outline-tertiary" style="padding:.15rem .5rem;font-size:.75rem;"
                                           title="Manage section">
                                            <i class="ti ti-external-link"></i>
                                        </a>
                                        @*@if (sec.TotalBags == 0)
                                        {
                                            <form asp-action="DeleteSection" asp-route-id="@sec.Id" method="post" class="d-inline"
                                                  onsubmit="return confirm('Delete section \'@sec.Name\'?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-xs btn-outline-danger"
                                                        style="padding:.15rem .4rem;font-size:.75rem;"
                                                        title="Delete section">
                                                    <i class="ti ti-trash"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button class="btn btn-xs btn-outline-danger" disabled
                                                    style="padding:.15rem .4rem;font-size:.75rem;"
                                                    title="Section has bags — remove them first">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        }*@
                                    </div>
                                </div>

                                @* Section Stats *@
                                <div class="px-3 pt-2 pb-1">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="small text-muted">@sec.TotalBags bag@(sec.TotalBags == 1 ? "" : "s") &middot; @sec.TotalBundles bundles</span>
                                        @if (sec.TotalAmount > 0)
                                        {
                                            <span class="small fw-semibold" style="color:#31316A;">UGX @sec.TotalAmount.ToString("N0")</span>
                                        }
                                    </div>
                                    @if (sec.TotalBundles > 0)
                                    {
                                        <div class="progress mb-2" style="height:4px;">
                                            <div class="progress-bar" role="progressbar"
                                                 style="width:@fillPercent%;background-color:@fillColor;"
                                                 aria-valuenow="@fillPercent" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    }
                                </div>

                                @* Bag List *@
                                <div class="px-3 pb-3">
                                    @if (!sec.Bags.Any())
                                    {
                                        <div class="text-center py-3">
                                            <p class="small text-muted mb-2">No bags in this section</p>
                                            @if (!VaultConstants.IsSystemManagedSectionName(sec.Name))
                                            {
                                                <a asp-action="Section" asp-route-id="@sec.Id"
                                                   class="btn btn-xs btn-outline-secondary" style="padding:.2rem .6rem;font-size:.75rem;">
                                                    <i class="ti ti-plus me-1"></i>Attach Bag
                                                </a>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-wrap gap-1 mt-1">
                                            @foreach (var bag in sec.Bags)
                                            {
                                                string bagBadgeColor = bag.FillPercent >= 90 ? "#fff3cd;color:#664d03"
                                                    : bag.FillPercent == 100 ? "#f8d7da;color:#842029"
                                                    : "#e8f5e9;color:#1b5e20";

                                                <a asp-controller="Bagging" asp-action="Details" asp-route-id="@bag.Id"
                                                   class="text-decoration-none"
                                                   title="@bag.ReferenceNumber — @bag.TotalBundles bundles@(bag.DenominationName != null ? $" ({bag.DenominationName})" : "")">
                                                    <span class="badge rounded-pill px-2 py-1 d-flex align-items-center gap-1"
                                                          style="background:@bagBadgeColor;font-size:.7rem;font-weight:600;border:1px solid rgba(0,0,0,.08);">
                                                        <i class="ti ti-package" style="font-size:.65rem;"></i>
                                                        @bag.ReferenceNumber
                                                        <span class="ms-1 opacity-75">@bag.TotalBundles</span>
                                                    </span>
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@* ── Create Vault Modal ────────────────────────────── *@
<div class="modal fade" id="createVaultModal" tabindex="-1" aria-labelledby="createVaultModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="CreateVault" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="BranchId" value="@selectedBranchId" />
                <div class="modal-header bg-white border-bottom" style="border-top:3px solid #31316A;">
                    <h5 class="modal-title fw-bold" style="color:#31316A;" id="createVaultModalLabel">
                        <i class="ti ti-building-bank me-2"></i>Create New Vault
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label for="vaultName" class="form-label fw-semibold">Vault Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="vaultName" name="Name"
                               placeholder="e.g. Main Vault, Cash Vault A" maxlength="100" required autofocus />
                        <div class="form-text">Choose a clear, descriptive name for the vault.</div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-tertiary fw-semibold">
                        <i class="ti ti-plus me-1"></i>Create Vault
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Add Section Modal ─────────────────────────────── *@
<div class="modal fade" id="addSectionModal" tabindex="-1" aria-labelledby="addSectionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="CreateSection" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="VaultId" id="modalVaultId" />
                <div class="modal-header bg-white border-bottom" style="border-top:3px solid #31316A;">
                    <h5 class="modal-title fw-bold" style="color:#31316A;" id="addSectionModalLabel">
                        <i class="ti ti-layout-grid-add me-2"></i>Add Section to <span id="modalVaultName"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label for="sectionName" class="form-label fw-semibold">Section Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="sectionName" name="Name"
                               placeholder="e.g. Section A, Row 1, Shelf 3" maxlength="100" required />
                        <div class="form-text">Identifies a physical area or compartment inside the vault.</div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-tertiary fw-semibold">
                        <i class="ti ti-plus me-1"></i>Add Section
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('addSectionModal').addEventListener('show.bs.modal', function (e) {
            var btn = e.relatedTarget;
            document.getElementById('modalVaultId').value = btn.dataset.vaultId;
            document.getElementById('modalVaultName').textContent = btn.dataset.vaultName;
            document.getElementById('sectionName').value = '';
        });

        document.getElementById('createVaultModal').addEventListener('shown.bs.modal', function () {
            document.getElementById('vaultName').focus();
        });
        document.getElementById('addSectionModal').addEventListener('shown.bs.modal', function () {
            document.getElementById('sectionName').focus();
        });
    </script>
}
