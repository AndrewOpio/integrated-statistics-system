@using VMSService.Core.Authorization
@using VMSService.Web.Extensions
@{
    ViewData["Title"] = "Access Denied";

    // Shared across the whole app — every Forbid() result lands here (JWT bearer's OnForbidden
    // hard-redirects to this one action), so it can't assume a single layout the way every other
    // view does. Same CB-role check HomeController.Index() already uses to decide where to route
    // a user, so a CB user denied on e.g. Create still sees their own CB-branded shell instead of
    // the general one.
    Layout = User.GetAppRoleNames().Any(RolePolicy.CbRoles.Contains) ? "_CbLayout" : "_Layout";
}

<div class="row">
    <div class="col-12 col-lg-12">
        <div class="card border-0 shadow mb-4 border-danger border-2">
            <div class="card-body text-center py-5">
                <i class="ti ti-lock text-danger" style="font-size: 3rem;"></i>
                <h2 class="fs-4 fw-bold mt-3 mb-2">Access Denied</h2>
                <p class="text-muted mb-4">
                    You don't have permission to view this page. If you believe this is a mistake,
                    contact your system administrator to request access.
                </p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="ti ti-arrow-left me-1"></i>Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
