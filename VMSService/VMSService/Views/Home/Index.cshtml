@model List<VMSService.Core.Models.ExPrintMints.ExPrintMintViewModel>

@{
    ViewData["Title"] = "Dashboard";
    var kampalaBranch = ViewBag.KampalaBranch;
    var categories = ViewBag.Categories;
    var denominations = ViewBag.Denominations;
    var stockMatrix = ViewBag.StockMatrix;
    var userRoles = string.Join(", ", User.FindAll("appRole").Where(c => c.Value.StartsWith("VMS:")).Select(c => c.Value.Split(":")[1]).ToList());
}

@if (userRoles.Contains(SystemPolicy.Roles.ContractManager) || userRoles.Contains(SystemPolicy.Roles.CurrencyApprover) ||
    userRoles.Contains(SystemPolicy.Roles.StockVerifier) || userRoles.Contains(SystemPolicy.Roles.StockApprover))
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow">
                <div class="card-header py-3">
                    <div class="d-flex align-items-center">
                        <i class="ti ti-truck me-3 fs-5 "></i>
                        <h5 class="mb-0 fw-bold">Pending Deliveries</h5>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-centered table-nowrap mb-0 rounded datatable">
                                <thead class="thead-light">
                                    <tr>
                                        <th class="border-0 rounded-start p-0">#</th>
                                        <th class="border-0">Reference</th>
                                        <th class="border-0">Branch</th>
                                        <th class="border-0">Vendor</th>
                                        <th class="border-0">Denomination</th>
                                        <th class="border-0">Expected Delivery Date</th>
                                        <th class="border-0">Expected Value (UGX)</th>
                                        <th class="border-0">Status</th>
                                        <th class="border-0 rounded-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int rowNumber = 1;
                                    }
                                    @foreach (var delivery in Model)
                                    {
                                        <!-- Determine status badge color -->
                                        string badgeClass = "bg-secondary";
                                        if (delivery.CurrentStatusName.Contains("Draft"))
                                        {
                                            badgeClass = "bg-warning";
                                        }
                                        else if (delivery.CurrentStatusName.Contains("Submitted"))
                                        {
                                            badgeClass = "bg-info";
                                        }
                                        else if (delivery.CurrentStatusName.Contains("Approved"))
                                        {
                                            badgeClass = "bg-success";
                                        }

                                        <tr>
                                            <td><span class="text-primary fw-bold">@rowNumber</span></td>
                                            <td class="fw-bold">@delivery.ExPrintMintReference</td>
                                            <td>
                                                @if (delivery.Branch != null)
                                                {
                                                    <span class="badge bg-primary">
                                                        <i class="ti ti-building-bank me-1"></i>@delivery.Branch.Name
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (delivery.CurrencyVendor != null)
                                                {
                                                    @delivery.CurrencyVendor.Name
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (delivery.Denomination != null)
                                                {
                                                    <div class="d-inline-flex align-items-center gap-2" style="width: fit-content;">
                                                        <span class="badge bg-info">
                                                            <i class="ti ti-cash-banknote me-1"></i>@delivery.Denomination.Name
                                                        </span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="text-muted">@delivery.DeliveryDate.ToString("dd/MMM/yyyy")</span>
                                            </td>
                                            <td>
                                                <span class="fw-bold">@delivery.Value.ToString("N0")</span>
                                            </td>
                                            <td>
                                                <div class="d-inline-flex align-items-center gap-2" style="width: fit-content;">
                                                    @if (delivery.CurrentStatusId > 0)
                                                    {
                                                        <span class="badge @badgeClass">
                                                            <i class="ti ti-badge me-1"></i>@delivery.CurrentStatusName
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">
                                                            <i class="ti ti-question-mark me-1"></i>Unknown
                                                        </span>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a asp-controller="ExPrintMints" asp-action="Details" asp-route-id="@delivery.Id"
                                                       class="btn btn-sm btn-outline-info" title="View Details">
                                                        <i class="ti ti-eye"></i>
                                                    </a>
                                                    <a asp-controller="ReceivedStocks" asp-action="Create"
                                                       class="btn btn-sm btn-outline-success" title="Receive Stock">
                                                        <i class="ti ti-check"></i>
                                                    </a>
                                                </div>
                                            </td>
                                            @{
                                                rowNumber++;
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="ti ti-inbox fs-1 text-muted mb-3 d-block"></i>
                            <p class="text-muted fw-bold">No pending deliveries at this time</p>
                            <small class="text-muted">All expected stocks have been accounted for or there are no pending deliveries.</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Dashboard Statistics Section -->
    <div class="row mb-4">
        <div class="col-md-3 col-sm-6 mb-4">
            <div class="card border-0 shadow h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <small class="text-muted text-uppercase fw-semibold">Pending Deliveries</small>
                            <h5 class="mb-0 fw-bold mt-2">@(Model?.Count ?? 0)</h5>
                        </div>
                        <div class="fs-2 text-info">
                            <i class="ti ti-truck"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6 mb-4">
            <div class="card border-0 shadow h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <small class="text-muted text-uppercase fw-semibold">Total Expected Value</small>
                            <h5 class="mb-0 fw-bold mt-2">@(Model?.Sum(d => (long)d.Value).ToString("N0") ?? "0")</h5>
                        </div>
                        <div class="fs-2 text-success">
                            <i class="ti ti-cash-banknote"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6 mb-4">
            <div class="card border-0 shadow h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <small class="text-muted text-uppercase fw-semibold">Total Pieces</small>
                            <h5 class="mb-0 fw-bold mt-2">@(Model?.Sum(d => d.NumberOfPieces).ToString("N0") ?? "0")</h5>
                        </div>
                        <div class="fs-2 text-warning">
                            <i class="ti ti-package"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6 mb-4">
            <div class="card border-0 shadow h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <small class="text-muted text-uppercase fw-semibold">Total Boxes</small>
                            <h5 class="mb-0 fw-bold mt-2">@(Model?.Sum(d => d.NumberOfBoxes).ToString("N0") ?? "0")</h5>
                        </div>
                        <div class="fs-2 text-primary">
                            <i class="ti ti-box"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

<!-- Stock Position Matrix for Kampala Branch -->
@if (kampalaBranch != null && categories != null && denominations != null && stockMatrix != null)
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow">
                <div class="card-header py-3 bg-primary text-white">
                    <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-3">
                        <div class="d-flex align-items-center flex-shrink-0">
                            <i class="ti ti-database me-3 fs-5"></i>
                            <h5 class="mb-0 fw-bold">Stock Position - <span id="selectedBranchName">@kampalaBranch.Name</span></h5>
                        </div>
                        <div class="ms-sm-auto" style="width: 100%; max-width: 250px;">
                            <select id="branchSelector" class="form-select form-select-sm w-100" onchange="loadBranchData()">
                                <option value="">-- Select Branch --</option>
                                @{
                                    var allBranches = ViewBag.AllBranches;
                                    var selectedBranchId = ViewBag.SelectedBranchId;
                                    if (allBranches != null)
                                    {
                                        foreach (var branch in allBranches)
                                        {
                                            if (branch.Id == selectedBranchId)
                                            {
                                                <option value="@branch.Id" selected>@branch.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@branch.Id">@branch.Name</option>
                                            }
                                        }
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (categories.Count > 0 && denominations.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover mb-0">
                                <thead class="table-light text-white">
                                    <tr>
                                        <th class="fw-bold text-center p-0 py-1">
                                            @* <i class="ti ti-cash-banknote me-1"></i> *@
                                            Denomination
                                        </th>
                                        @foreach (var category in categories)
                                        {
                                            <th class="fw-bold text-center p-0 py-1">
                                                @* <i class="ti ti-folder-open me-1"></i> *@
                                                @category.Name
                                            </th>
                                        }
                                        <th class="fw-bold text-center p-0 py-1">
                                            <i class="ti ti-sum me-1"></i>Total
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        decimal grandTotal = 0;
                                    }
                                    @foreach (var denomination in denominations)
                                    {
                                        <tr>
                                            <td class="fw-bold text-center bg-light p-0 py-1">
                                                <small class="text-muted d-block">@denomination.Name</small>
                                                <strong class="text-primary">UGX @denomination.Value.ToString("N0")</strong>
                                            </td>
                                            @{
                                                decimal denominationTotal = 0;
                                            }
                                            @foreach (var category in categories)
                                            {
                                                decimal cellValue = 0;
                                                if (stockMatrix.ContainsKey(denomination.Id) && 
                                                    stockMatrix[denomination.Id].ContainsKey(category.Id))
                                                    {
                                                        cellValue = stockMatrix[denomination.Id][category.Id];
                                                    }
                                                    denominationTotal += cellValue;
                                                    grandTotal += cellValue;
                                                    <td class="text-center bg-light p-0 py-1">
                                                        @cellValue.ToString("N0")
                                                    </td>
                                                }
                                                <td class="fw-bold text-center bg-light p-0 py-1">
                                                    @if (denominationTotal > 0)
                                                    {
                                                        <span class="text-success">@denominationTotal.ToString("N0")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">0</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                        <!-- Grand Total Row -->
                                        <tr class="table-info fw-bold">
                                            <td class="text-center bg-light">
                                                <i class="ti ti-sum me-1"></i>Grand Total
                                            </td>
                                            @foreach (var category in categories)
                                            {
                                                decimal categoryTotal = 0;
                                                foreach (var denomination in denominations)
                                                {
                                                    if (stockMatrix.ContainsKey(denomination.Id) &&
                                                    stockMatrix[denomination.Id].ContainsKey(category.Id))
                                                {
                                                    categoryTotal += stockMatrix[denomination.Id][category.Id];
                                                }
                                            }
                                            <td class="text-center">
                                                @if (categoryTotal > 0)
                                                {
                                                    <span class="">
                                                        @categoryTotal.ToString("N0")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="">
                                                        0
                                                    </span>
                                                }
                                            </td>
                                        }
                                        <td class="text-center bg-light text-primary">
                                            @grandTotal.ToString("N0")
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="ti ti-database-off fs-1 text-muted mb-3 d-block"></i>
                            <p class="text-muted fw-bold">No Stock Data Available</p>
                            <small class="text-muted">Stock position data will appear here once stocks are received and confirmed.</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
}

<script>
    function loadBranchData() {
        const branchSelector = document.getElementById('branchSelector');
        const branchId = branchSelector.value;
        
        if (branchId) {
            // Reload page with selected branch
            window.location.href = `@Url.Action("Index", "Home")?branchId=${branchId}`;
        }
    }
</script>
