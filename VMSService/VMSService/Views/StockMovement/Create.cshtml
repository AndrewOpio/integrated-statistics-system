@model dynamic

@using ConfigurationsService.Client
@using VMSService.Core.Services.Stocks.StockEntities
@using VMSService.Web.Controllers;
@using VMSService.Core.Static;

@{
    ViewData["Title"] = "Create Stock Movement";
    var branches = ViewBag.Branches as List<BranchDto>;
    var denominations = ViewBag.Denominations as List<Denomination>;
    var categories = ViewBag.Categories as List<Category>;
    var userRoles = ViewBag.UserRoles as List<string> ?? new List<string>();
    var isBranchManager = userRoles.Contains(SystemPolicy.Roles.BranchManager) ||
                          userRoles.Contains(SystemPolicy.Roles.AssistantBranchManager);
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small mb-1">Stock Movements</p>
                        <h2 class="fs-5 fw-bold mb-0">Add Stock Movement</h2>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i>Back to List
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div id="formAlerts"></div>
                <form id="stockMovementForm">

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Stock Movement Type <span class="text-danger">*</span></label>
                        <select class="form-select" id="movementType">
                            @foreach (var mt in StockConstants.MovementTypes)
                            {
                                @if (isBranchManager && mt.Key == StockConstants.StockMovementTypes.BranchToBranch)
                                {
                                    continue;
                                }
                                <option value="@mt.Key">@mt.Value</option>
                            }
                        </select>
                    </div>

                    @* ── Branch to Branch ── *@
                    <div id="branchSection">
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="branchDate">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Reference Number <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="branchReferenceNumber">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Dispatching Branch <span class="text-danger">*</span></label>
                                <select class="form-select" id="dispatchingBranch">
                                    <option value="">-- Select Branch --</option>
                                    @if (branches != null)
                                    {
                                        foreach (var branch in branches)
                                        {
                                            <option value="@branch.Id">@branch.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Receiving Branch <span class="text-danger">*</span></label>
                                <select class="form-select" id="receivingBranch">
                                    <option value="">-- Select Branch --</option>
                                    @if (branches != null)
                                    {
                                        foreach (var branch in branches)
                                        {
                                            <option value="@branch.Id">@branch.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="border rounded mb-4">
                            <div class="px-3 py-2 border-bottom d-flex justify-content-between align-items-center rounded-top" style="background-color:#f8fafc;">
                                <span class="fw-semibold small">Denomination Details</span>
                                <button type="button" class="btn btn-primary btn-sm" id="addDenominationRow">
                                    <i class="ti ti-plus me-1"></i>Add Row
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0" id="denominationTable">
                                    <thead style="background-color:#f8fafc;">
                                        <tr>
                                            <th style="min-width:180px">Denomination</th>
                                            <th style="min-width:150px">Category</th>
                                            <th style="min-width:120px">Container</th>
                                            <th style="min-width:110px">Qty</th>
                                            <th style="min-width:110px">Bundles</th>
                                            <th style="min-width:150px">Categorization</th>
                                            <th style="min-width:180px">Sub-total (UGX)</th>
                                            <th style="width:50px"></th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                    <tfoot>
                                        <tr style="background-color:#f8fafc;">
                                            <td colspan="6" class="text-end small text-muted pe-3">Total Bags/Boxes</td>
                                            <td><input type="text" class="form-control form-control-sm text-end fw-semibold" id="totalBagsBoxes" readonly placeholder="0"></td>
                                            <td></td>
                                        </tr>
                                        <tr style="background-color:#f8fafc;">
                                            <td colspan="6" class="text-end small text-muted pe-3 border-0">Grand Total (UGX)</td>
                                            <td class="border-0"><input type="text" class="form-control form-control-sm text-end fw-semibold" id="grandTotalValue" readonly placeholder="0"></td>
                                            <td class="border-0"></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>

                    @* ── Buffer / Operational ── *@
                    <div id="internalSection" style="display:none;">
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="internalDate">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Reference Number <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="internalReferenceNumber">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Dispatching Branch <span class="text-danger">*</span></label>
                                <select class="form-select" id="internalDispatchingBranch">
                                    <option value="">-- Select Branch --</option>
                                    @if (branches != null)
                                    {
                                        foreach (var branch in branches)
                                        {
                                            <option value="@branch.Id">@branch.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Receiving Branch <span class="text-danger">*</span></label>
                                <select class="form-select" id="internalReceivingBranch">
                                    <option value="">-- Select Branch --</option>
                                    @if (branches != null)
                                    {
                                        foreach (var branch in branches)
                                        {
                                            <option value="@branch.Id">@branch.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="border rounded mb-4">
                            <div class="px-3 py-2 border-bottom d-flex justify-content-between align-items-center rounded-top" style="background-color:#f8fafc;">
                                <span class="fw-semibold small">Denomination Details</span>
                                <button type="button" class="btn btn-primary btn-sm" id="addInternalDenominationRow">
                                    <i class="ti ti-plus me-1"></i>Add Row
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0" id="internalDenominationTable">
                                    <thead style="background-color:#f8fafc;">
                                        <tr>
                                            <th style="min-width:180px">Denomination</th>
                                            <th style="min-width:110px">No. of Boxes</th>
                                            <th style="min-width:180px">Sub-total (UGX)</th>
                                            <th style="width:50px"></th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                    <tfoot>
                                        <tr style="background-color:#f8fafc;">
                                            <td class="text-end small text-muted pe-3">Total Boxes</td>
                                            <td><input type="text" class="form-control form-control-sm text-end fw-semibold" id="internalTotalBoxes" readonly placeholder="0"></td>
                                            <td></td>
                                            <td></td>
                                        </tr>
                                        <tr style="background-color:#f8fafc;">
                                            <td class="text-end small text-muted pe-3 border-0">Grand Total (UGX)</td>
                                            <td class="border-0"></td>
                                            <td class="border-0"><input type="text" class="form-control form-control-sm text-end fw-semibold" id="internalGrandTotalValue" readonly placeholder="0"></td>
                                            <td class="border-0"></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary" id="submitBtn">
                            <i class="ti ti-check me-1"></i>Save
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="ti ti-arrow-left me-1"></i>Cancel
                        </a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).ready(function () {

    // ─── Razor data passed into JS ────────────────────────────────────────────
    const denominationOptions = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
    denominations != null
        ? denominations.Select(d => new { id = d.Id, name = d.Name, value = d.Value, piecesInBox = d.NumberOfPiecesInABox })
        : Enumerable.Empty<object>()
    ));
    const categoryOptions = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
    categories != null
        ? categories.Select(c => new { id = c.Id, name = c.Name })
        : Enumerable.Empty<object>()
    ));

    const denominationPiecesInBox = {};
    denominationOptions.forEach(d => { denominationPiecesInBox[d.id] = d.piecesInBox; });

    const categoryNames = {};
    categoryOptions.forEach(c => { categoryNames[c.id] = c.name; });

    function getContainerLabel(categoryId) {
        const name = categoryNames[categoryId];
        return (name && name.toLowerCase() === 'new') ? 'Boxes' : 'Bags';
    }

    function isNewCategory(categoryId) {
        const category = categoryOptions.find(c => String(c.id) === String(categoryId));
        return category && category.name === 'New';
    }

    // ─── State ────────────────────────────────────────────────────────────────

    let branchRows = [
        { denominationId: '', numBagsBoxes: '', containerType: 'Bag', numBundles: '', categoryId: '', subTotalValue: '', categorization: 'buffer', boxNumberRanges: [{ prefix: '', start: '', end: '' }], selectedBags: [] }
    ];

    let internalRows = [
        { denominationId: '', boxNumberRanges: [{ prefix: '', start: '', end: '' }], numBoxes: '', containerType: 'Box', subTotalValue: '' }
    ];

    // ─── Option builders ──────────────────────────────────────────────────────

    function buildDenomOptions(selectedId) {
        let html = '<option value="">-- Select Denomination --</option>';
        denominationOptions.forEach(d => {
            html += `<option value="${d.id}" ${String(d.id) === String(selectedId) ? 'selected' : ''}>${d.name} (${d.value})</option>`;
        });
        return html;
    }

    function buildCategoryOptions(selectedId) {
        let html = '<option value="">-- Select Category --</option>';
        categoryOptions.forEach(c => {
            html += `<option value="${c.id}" ${String(c.id) === String(selectedId) ? 'selected' : ''}>${c.name}</option>`;
        });
        return html;
    }

    // ─── Render branch table ──────────────────────────────────────────────────

    function renderBranchTable() {
        const $tbody = $('#denominationTable tbody');
        $tbody.empty();
        branchRows.forEach((row, idx) => {
            const defaultContainerType = getContainerLabel(row.categoryId);
            const containerType = row.containerType || defaultContainerType;
            const showBoxRanges = isNewCategory(row.categoryId);

            let rangeRowsHtml = '';
            if (showBoxRanges && row.boxNumberRanges) {
                rangeRowsHtml = row.boxNumberRanges.map((range, rangeIdx) => `
                    <tr data-range-idx="${rangeIdx}">
                        <td><input type="text" class="form-control form-control-sm branch-box-prefix" value="${range.prefix}" placeholder="Prefix" /></td>
                        <td><input type="text" class="form-control form-control-sm branch-box-start"  value="${range.start}"  placeholder="Start"  /></td>
                        <td><input type="text" class="form-control form-control-sm branch-box-end"    value="${range.end}"    placeholder="End"    /></td>
                        <td class="text-center">
                            <button type="button" class="btn btn-outline-danger btn-sm remove-branch-box-range"><i class="ti ti-trash"></i></button>
                        </td>
                    </tr>
                `).join('');
            }

            $tbody.append(`
                <tr data-idx="${idx}">
                    <td><select class="form-select form-select-sm branch-denom-id">${buildDenomOptions(row.denominationId)}</select></td>
                    <td><select class="form-select form-select-sm branch-category-id">${buildCategoryOptions(row.categoryId)}</select></td>
                    <td>
                        <select class="form-select form-select-sm branch-container-type">
                            <option value="Bag" ${containerType === 'Bag' ? 'selected' : ''}>Bag</option>
                            <option value="Box" ${containerType === 'Box' ? 'selected' : ''}>Box</option>
                        </select>
                    </td>
                    <td><input type="number" class="form-control form-control-sm branch-num-bags" value="${row.numBagsBoxes}" placeholder="0" /></td>
                    <td><input type="number" class="form-control form-control-sm branch-num-bundles bg-light" value="${row.numBundles}" placeholder="0" readonly /></td>
                    <td>
                        <select class="form-select form-select-sm branch-categorization">
                            <option value="buffer"      ${row.categorization === 'buffer'      ? 'selected' : ''}>Buffer Stocks</option>
                            <option value="operational" ${row.categorization === 'operational' ? 'selected' : ''}>Operational Stocks</option>
                        </select>
                    </td>
                    <td><input type="text" class="form-control form-control-sm text-end branch-subtotal bg-light" value="${isNaN(parseFloat(row.subTotalValue)) ? '' : parseFloat(row.subTotalValue).toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ',')}" placeholder="0" readonly /></td>
                    <td class="text-center">
                        <button type="button" class="btn btn-outline-danger btn-sm remove-branch-row"><i class="ti ti-trash"></i></button>
                    </td>
                </tr>
                ${showBoxRanges ? `
                <tr class="branch-box-ranges-row" data-idx="${idx}">
                    <td colspan="8" class="p-0">
                        <div class="mx-3 my-2 border-start border-3 border-primary ps-3 py-2 rounded-end" style="background-color:#f8fafc;">
                            <p class="small fw-semibold text-primary mb-2"><i class="ti ti-hash me-1"></i>Box Number Ranges</p>
                            <table class="table table-sm mb-2">
                                <thead style="background-color:#f8fafc;">
                                    <tr>
                                        <th class="small text-muted fw-normal">Prefix</th>
                                        <th class="small text-muted fw-normal">Start</th>
                                        <th class="small text-muted fw-normal">End</th>
                                        <th style="width:50px"></th>
                                    </tr>
                                </thead>
                                <tbody>${rangeRowsHtml}</tbody>
                            </table>
                            <button type="button" class="btn btn-outline-primary btn-sm add-branch-box-range" data-idx="${idx}">
                                <i class="ti ti-plus me-1"></i>Add Range
                            </button>
                        </div>
                    </td>
                </tr>
                ` : `
                ${row.categoryId ? `
                <tr class="branch-bag-selector-row" data-idx="${idx}">
                    <td colspan="8" class="p-0">
                        <div class="mx-3 my-2 border-start border-3 border-success ps-3 py-2 rounded-end" style="background-color:#f8fafc;">
                            <p class="small fw-semibold text-success mb-2"><i class="ti ti-briefcase me-1"></i>Bags Involved</p>
                            <div class="d-flex gap-2 mb-2">
                                <input type="text" class="form-control form-control-sm branch-bag-search" data-idx="${idx}" placeholder="Search bag by reference number..." autocomplete="off" style="max-width:320px">
                            </div>
                            <ul class="branch-bag-dropdown list-unstyled border rounded shadow-sm mb-0 bg-white d-none" data-idx="${idx}" style="min-width:320px;max-height:220px;overflow-y:auto;z-index:9999;position:fixed"></ul>
                            <div class="branch-bag-chips d-flex flex-wrap gap-1" data-idx="${idx}">
                                ${(row.selectedBags || []).map(b => `
                                    <span class="badge bg-success-subtle text-success border border-success-subtle d-flex align-items-center gap-1 px-2 py-1">
                                        <i class="ti ti-briefcase" style="font-size:11px"></i>
                                        ${b.referenceNumber}
                                        <button type="button" class="btn-close btn-close-sm ms-1 remove-branch-bag" data-idx="${idx}" data-bag-id="${b.id}" style="font-size:9px"></button>
                                    </span>
                                `).join('')}
                            </div>
                        </div>
                    </td>
                </tr>
                ` : ''}
                `}
            `);
        });

        $('#denominationTable tbody .branch-denom-id').each(function() {
            const denom = denominationOptions.find(d => d.id == $(this).val());
            if (denom) $(this).attr('data-denomination-value', denom.value);
        });

        recalculateBranchTotals();
    }

    // ─── Render internal table ────────────────────────────────────────────────

    function renderInternalTable() {
        const $tbody = $('#internalDenominationTable tbody');
        $tbody.empty();
        internalRows.forEach((row, denomIdx) => {
            let rangeRowsHtml = (row.boxNumberRanges || []).map((range, rangeIdx) => `
                <tr data-range-idx="${rangeIdx}">
                    <td><input type="text" class="form-control form-control-sm box-prefix" value="${range.prefix}" placeholder="Prefix" /></td>
                    <td><input type="text" class="form-control form-control-sm box-start"  value="${range.start}"  placeholder="Start"  /></td>
                    <td><input type="text" class="form-control form-control-sm box-end"    value="${range.end}"    placeholder="End"    /></td>
                    <td class="text-center">
                        <button type="button" class="btn btn-outline-danger btn-sm remove-box-range"><i class="ti ti-trash"></i></button>
                    </td>
                </tr>
            `).join('');

            $tbody.append(`
                <tr data-idx="${denomIdx}">
                    <td><select class="form-select form-select-sm internal-denom-id">${buildDenomOptions(row.denominationId)}</select></td>
                    <td><input type="number" class="form-control form-control-sm internal-num-boxes" value="${row.numBoxes}" placeholder="0" /></td>
                    <td><input type="text" class="form-control form-control-sm text-end internal-subtotal bg-light" value="${isNaN(parseFloat(row.subTotalValue)) ? '' : parseFloat(row.subTotalValue).toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ',')}" placeholder="0" readonly /></td>
                    <td class="text-center">
                        <button type="button" class="btn btn-outline-danger btn-sm remove-internal-row"><i class="ti ti-trash"></i></button>
                    </td>
                </tr>
                <tr class="internal-box-ranges-row" data-idx="${denomIdx}">
                    <td colspan="4" class="p-0">
                        <div class="mx-3 my-2 border-start border-3 border-primary ps-3 py-2 rounded-end" style="background-color:#f8fafc;">
                            <p class="small fw-semibold text-primary mb-2"><i class="ti ti-hash me-1"></i>Box Number Ranges</p>
                            <table class="table table-sm mb-2">
                                <thead style="background-color:#f8fafc;">
                                    <tr>
                                        <th class="small text-muted fw-normal">Prefix</th>
                                        <th class="small text-muted fw-normal">Start</th>
                                        <th class="small text-muted fw-normal">End</th>
                                        <th style="width:50px"></th>
                                    </tr>
                                </thead>
                                <tbody>${rangeRowsHtml}</tbody>
                            </table>
                            <button type="button" class="btn btn-outline-primary btn-sm add-box-range">
                                <i class="ti ti-plus me-1"></i>Add Range
                            </button>
                        </div>
                    </td>
                </tr>
            `);
        });
        recalculateInternalTotals();
    }

    // ─── Section toggle ───────────────────────────────────────────────────────

    function toggleSections() {
        if ($('#movementType').val() === '@StockConstants.StockMovementTypes.BranchToBranch') {
            $('#branchSection').show();
            $('#internalSection').hide();
        } else {
            $('#branchSection').hide();
            $('#internalSection').show();
        }
    }

    // ─── Data checks / clear ─────────────────────────────────────────────────

    function hasBranchData() {
        return $('#branchDate').val() !== '' || $('#branchReferenceNumber').val() !== '' ||
               $('#dispatchingBranch').val() !== '' || $('#receivingBranch').val() !== '' ||
               branchRows.some(r => r.denominationId !== '' || r.numBagsBoxes !== '');
    }

    function hasInternalData() {
        return $('#internalDate').val() !== '' || $('#internalReferenceNumber').val() !== '' ||
               $('#internalDispatchingBranch').val() !== '' || $('#internalReceivingBranch').val() !== '' ||
               internalRows.some(r => r.denominationId !== '' || r.numBoxes !== '');
    }

    function clearBranchForm() {
        $('#branchDate, #branchReferenceNumber').val('');
        $('#dispatchingBranch, #receivingBranch').val('');
        branchRows = [{ denominationId: '', numBagsBoxes: '', containerType: 'Bag', numBundles: '', categoryId: '', subTotalValue: '', categorization: 'buffer', boxNumberRanges: [{ prefix: '', start: '', end: '' }], selectedBags: [] }];
        renderBranchTable();
    }

    function clearInternalForm() {
        $('#internalDate, #internalReferenceNumber').val('');
        $('#internalDispatchingBranch, #internalReceivingBranch').val('');
        internalRows = [{ denominationId: '', boxNumberRanges: [{ prefix: '', start: '', end: '' }], numBoxes: '', containerType: 'Box', subTotalValue: '' }];
        renderInternalTable();
    }

    // ─── Branch events ────────────────────────────────────────────────────────

    $('#denominationTable').on('input change', '.branch-denom-id, .branch-num-bags, .branch-container-type, .branch-category-id, .branch-categorization', function () {
        const idx = $(this).closest('tr').data('idx');
        if (idx === undefined) return;
        const categoryChanged = $(this).hasClass('branch-category-id');
        if ($(this).hasClass('branch-denom-id'))       branchRows[idx].denominationId = $(this).val();
        if ($(this).hasClass('branch-num-bags'))       branchRows[idx].numBagsBoxes   = $(this).val();
        if ($(this).hasClass('branch-container-type')) branchRows[idx].containerType  = $(this).val();
        if ($(this).hasClass('branch-category-id'))    branchRows[idx].categoryId     = $(this).val();
        if ($(this).hasClass('branch-categorization')) branchRows[idx].categorization = $(this).val();
        calculateBranchRowValues(idx);
        recalculateBranchTotals();
        if (categoryChanged) renderBranchTable();
    });

    function calculateBranchRowValues(idx) {
        const row  = branchRows[idx];
        const $row = $(`#denominationTable tbody tr[data-idx="${idx}"]`);
        if (!$row.length) return;
        const denom      = denominationOptions.find(d => d.id == row.denominationId);
        const denomValue = denom ? denom.value : 0;
        const piecesInBox = denom ? denom.piecesInBox : 1;
        const numBoxes   = parseInt(row.numBagsBoxes) || 0;
        if (!denom || numBoxes === 0) {
            $row.find('.branch-num-bundles').val('');
            $row.find('.branch-subtotal').val('');
            branchRows[idx].numBundles = '';
            branchRows[idx].subTotalValue = '';
            return;
        }
        const numBundles = numBoxes * (piecesInBox / 1000);
        const subTotal   = piecesInBox * denomValue * numBoxes;
        branchRows[idx].numBundles    = numBundles;
        branchRows[idx].subTotalValue = subTotal;
        $row.find('.branch-num-bundles').val(numBundles.toFixed(0));
        $row.find('.branch-subtotal').val(subTotal.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ','));
    }

    $('#addDenominationRow').on('click', function () {
        branchRows.push({ denominationId: '', numBagsBoxes: '', containerType: 'Bag', numBundles: '', categoryId: '', subTotalValue: '', categorization: 'buffer', boxNumberRanges: [{ prefix: '', start: '', end: '' }], selectedBags: [] });
        renderBranchTable();
    });

    $('#denominationTable').on('click', '.remove-branch-row', function () {
        if (branchRows.length > 1) {
            branchRows.splice($(this).closest('tr').data('idx'), 1);
            renderBranchTable();
        }
    });

    $('#denominationTable').on('input', '.branch-box-prefix, .branch-box-start, .branch-box-end', function () {
        const denomIdx = $(this).closest('tr[data-idx]').data('idx');
        const rangeIdx = $(this).closest('tr[data-range-idx]').data('range-idx');
        if (denomIdx === undefined || rangeIdx === undefined) return;
        if ($(this).hasClass('branch-box-prefix')) branchRows[denomIdx].boxNumberRanges[rangeIdx].prefix = $(this).val();
        if ($(this).hasClass('branch-box-start'))  branchRows[denomIdx].boxNumberRanges[rangeIdx].start  = $(this).val();
        if ($(this).hasClass('branch-box-end'))    branchRows[denomIdx].boxNumberRanges[rangeIdx].end    = $(this).val();
    });

    $('#denominationTable').on('click', '.add-branch-box-range', function () {
        const idx = $(this).closest('tr[data-idx]').data('idx');
        branchRows[idx].boxNumberRanges.push({ prefix: '', start: '', end: '' });
        renderBranchTable();
    });

    $('#denominationTable').on('click', '.remove-branch-box-range', function () {
        const denomIdx = $(this).closest('tr[data-idx]').data('idx');
        const rangeIdx = $(this).closest('tr[data-range-idx]').data('range-idx');
        if (branchRows[denomIdx].boxNumberRanges.length > 1) {
            branchRows[denomIdx].boxNumberRanges.splice(rangeIdx, 1);
            renderBranchTable();
        }
    });

    // ─── Branch bag selector events ───────────────────────────────────────────

    let bagSearchTimers = {};

    function positionBagDropdown(inputEl, $dropdown) {
        const rect = inputEl.getBoundingClientRect();
        $dropdown.css({ top: rect.bottom + 4, left: rect.left, width: Math.max(rect.width, 320) });
    }

    $('#denominationTable').on('input', '.branch-bag-search', function () {
        const idx       = $(this).data('idx');
        const query     = $(this).val().trim();
        const $dropdown = $(`.branch-bag-dropdown[data-idx="${idx}"]`);

        clearTimeout(bagSearchTimers[idx]);
        if (query.length < 2) { $dropdown.addClass('d-none').empty(); return; }
        positionBagDropdown(this, $dropdown);

        bagSearchTimers[idx] = setTimeout(async () => {
            const row = branchRows[idx];
            const branchId = $('#dispatchingBranch').val();
            if (!row.denominationId || !branchId) {
                $dropdown.html('<li class="px-3 py-2 text-muted small">Select a denomination and dispatching branch first.</li>').removeClass('d-none');
                return;
            }

            $dropdown.html('<li class="px-3 py-2 text-muted small"><span class="spinner-border spinner-border-sm me-1"></span>Searching...</li>').removeClass('d-none');

            try {
                const res  = await fetch(`/StockMovement/GetAvailableBags?denominationId=${row.denominationId}&branchId=${branchId}&categoryId=${row.categoryId || ''}`);
                const bags = await res.json();
                const filtered = bags.filter(b =>
                    b.referenceNumber.toLowerCase().includes(query.toLowerCase()) &&
                    !(row.selectedBags || []).some(s => s.id === b.id)
                );

                if (filtered.length === 0) {
                    $dropdown.html('<li class="px-3 py-2 text-muted small">No matching bags found.</li>');
                } else {
                    $dropdown.empty();
                    filtered.forEach(b => {
                        $dropdown.append(`
                            <li class="px-3 py-2 bag-dropdown-item" style="cursor:pointer" data-idx="${idx}" data-bag-id="${b.id}" data-bag-ref="${b.referenceNumber}">
                                <i class="ti ti-briefcase me-1 text-success"></i>${b.referenceNumber}
                            </li>
                        `);
                    });
                }
                $dropdown.removeClass('d-none');
            } catch {
                $dropdown.html('<li class="px-3 py-2 text-danger small">Failed to load bags.</li>').removeClass('d-none');
            }
        }, 300);
    });

    $(document).on('click', '.bag-dropdown-item', function () {
        const idx    = $(this).data('idx');
        const bagId  = $(this).data('bag-id');
        const bagRef = $(this).data('bag-ref');
        if (!branchRows[idx].selectedBags) branchRows[idx].selectedBags = [];
        if (!branchRows[idx].selectedBags.some(b => b.id === bagId)) {
            branchRows[idx].selectedBags.push({ id: bagId, referenceNumber: bagRef });
        }
        $(`.branch-bag-search[data-idx="${idx}"]`).val('');
        $(`.branch-bag-dropdown[data-idx="${idx}"]`).addClass('d-none').empty();
        renderBranchTable();
    });

    $('#denominationTable').on('click', '.remove-branch-bag', function () {
        const idx   = $(this).data('idx');
        const bagId = $(this).data('bag-id');
        branchRows[idx].selectedBags = (branchRows[idx].selectedBags || []).filter(b => b.id !== bagId);
        renderBranchTable();
    });

    $(document).on('click', function (e) {
        if (!$(e.target).closest('.branch-bag-search, .branch-bag-dropdown').length) {
            $('.branch-bag-dropdown').addClass('d-none');
        }
    });

    $(window).on('scroll resize', function () {
        $('.branch-bag-dropdown:not(.d-none)').each(function () {
            const idx    = $(this).data('idx');
            const $input = $(`.branch-bag-search[data-idx="${idx}"]`);
            if ($input.length) positionBagDropdown($input[0], $(this));
        });
    });

    // ─── Internal events ──────────────────────────────────────────────────────

    $('#internalDenominationTable').on('input change', '.internal-denom-id, .internal-num-boxes', function () {
        const idx = $(this).closest('tr[data-idx]').data('idx');
        if (idx === undefined) return;
        if ($(this).hasClass('internal-denom-id'))  internalRows[idx].denominationId = $(this).val();
        if ($(this).hasClass('internal-num-boxes')) internalRows[idx].numBoxes       = $(this).val();
        calculateInternalRowValues(idx);
        recalculateInternalTotals();
    });

    function calculateInternalRowValues(idx) {
        const row  = internalRows[idx];
        const $row = $(`#internalDenominationTable tbody tr[data-idx="${idx}"]`);
        if (!$row.length) return;
        const denom      = denominationOptions.find(d => d.id == row.denominationId);
        const denomValue = denom ? denom.value : 0;
        const piecesInBox = denom ? denom.piecesInBox : 1;
        const numBoxes   = parseInt(row.numBoxes) || 0;
        if (!denom || numBoxes === 0) {
            $row.find('.internal-subtotal').val('');
            internalRows[idx].subTotalValue = '';
            return;
        }
        const subTotal = piecesInBox * denomValue * numBoxes;
        internalRows[idx].subTotalValue = subTotal;
        $row.find('.internal-subtotal').val(subTotal.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ','));
    }

    $('#internalDenominationTable').on('input', '.box-prefix, .box-start, .box-end', function () {
        const denomIdx = $(this).closest('tr[data-idx]').data('idx');
        const rangeIdx = $(this).closest('tr[data-range-idx]').data('range-idx');
        if (denomIdx === undefined || rangeIdx === undefined) return;
        if ($(this).hasClass('box-prefix')) internalRows[denomIdx].boxNumberRanges[rangeIdx].prefix = $(this).val();
        if ($(this).hasClass('box-start'))  internalRows[denomIdx].boxNumberRanges[rangeIdx].start  = $(this).val();
        if ($(this).hasClass('box-end'))    internalRows[denomIdx].boxNumberRanges[rangeIdx].end    = $(this).val();
    });

    $('#addInternalDenominationRow').on('click', function () {
        internalRows.push({ denominationId: '', boxNumberRanges: [{ prefix: '', start: '', end: '' }], numBoxes: '', containerType: 'Box', subTotalValue: '' });
        renderInternalTable();
    });

    $('#internalDenominationTable').on('click', '.remove-internal-row', function () {
        if (internalRows.length > 1) {
            internalRows.splice($(this).closest('tr[data-idx]').data('idx'), 1);
            renderInternalTable();
        }
    });

    $('#internalDenominationTable').on('click', '.add-box-range', function () {
        const idx = $(this).closest('tr[data-idx]').data('idx');
        internalRows[idx].boxNumberRanges.push({ prefix: '', start: '', end: '' });
        renderInternalTable();
    });

    $('#internalDenominationTable').on('click', '.remove-box-range', function () {
        const denomIdx = $(this).closest('tr[data-idx]').data('idx');
        const rangeIdx = $(this).closest('tr[data-range-idx]').data('range-idx');
        if (internalRows[denomIdx].boxNumberRanges.length > 1) {
            internalRows[denomIdx].boxNumberRanges.splice(rangeIdx, 1);
            renderInternalTable();
        }
    });

    // ─── Totals ───────────────────────────────────────────────────────────────

    function recalculateBranchTotals() {
        const totalBags  = branchRows.reduce((s, r) => s + (parseInt(r.numBagsBoxes)    || 0), 0);
        const grandTotal = branchRows.reduce((s, r) => s + (parseFloat(r.subTotalValue) || 0), 0);
        $('#totalBagsBoxes').val(totalBags.toFixed(0));
        $('#grandTotalValue').val(grandTotal.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ','));
    }

    function recalculateInternalTotals() {
        const totalBoxes = internalRows.reduce((s, r) => s + (parseInt(r.numBoxes)       || 0), 0);
        const grandTotal = internalRows.reduce((s, r) => s + (parseFloat(r.subTotalValue) || 0), 0);
        $('#internalTotalBoxes').val(totalBoxes.toFixed(0));
        $('#internalGrandTotalValue').val(grandTotal.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ','));
    }

    // ─── Submit ───────────────────────────────────────────────────────────────

    $('#stockMovementForm').on('submit', function (event) {
        event.preventDefault();

        const $submitBtn = $('#submitBtn');
        const isBranch   = $('#movementType').val() === '@StockConstants.StockMovementTypes.BranchToBranch';
        const payload    = { MovementType: $('#movementType').val() };

        if (isBranch) {
            payload.BranchDate            = $('#branchDate').val();
            payload.BranchReferenceNumber = $('#branchReferenceNumber').val();
            payload.DispatchingBranch     = parseInt($('#dispatchingBranch').val()) || null;
            payload.ReceivingBranch       = parseInt($('#receivingBranch').val()) || null;
            payload.BranchTotalBagsBoxes  = parseInt($('#totalBagsBoxes').val().replace(/,/g,'')) || 0;
            payload.BranchGrandTotalValue = parseFloat($('#grandTotalValue').val().replace(/,/g,'')) || 0;
            payload.DenominationRows = branchRows.filter(r => r.denominationId !== '').map(r => ({
                DenominationId:  parseInt(r.denominationId) || 0,
                NumBagsBoxes:    r.numBagsBoxes !== '' ? parseInt(r.numBagsBoxes) : null,
                ContainerType:   r.containerType,
                NumBundles:      r.numBundles !== '' ? parseFloat(r.numBundles) : null,
                CategoryId:      r.categoryId ? parseInt(r.categoryId) : null,
                SubTotalValue:   parseFloat(r.subTotalValue) || 0,
                Categorization:  r.categorization ?? 'buffer',
                BoxNumberRanges: (r.boxNumberRanges || []).filter(s => s.prefix !== '' || s.start !== '' || s.end !== ''),
                SelectedBagIds: (r.selectedBags || []).map(b => parseInt(b.id))
            }));
        } else {
            payload.InternalDate            = $('#internalDate').val();
            payload.InternalReferenceNumber = $('#internalReferenceNumber').val();
            payload.DispatchingBranch       = parseInt($('#internalDispatchingBranch').val()) || null;
            payload.ReceivingBranch         = parseInt($('#internalReceivingBranch').val()) || null;
            payload.InternalTotalBoxes      = parseInt($('#internalTotalBoxes').val().replace(/,/g,'')) || 0;
            payload.InternalGrandTotalValue = parseFloat($('#internalGrandTotalValue').val().replace(/,/g,'')) || 0;
            payload.InternalDenominationRows = internalRows.filter(r => r.denominationId !== '').map(r => ({
                DenominationId:  parseInt(r.denominationId) || 0,
                NumBoxes:        r.numBoxes !== '' ? parseInt(r.numBoxes) : null,
                ContainerType:   r.containerType,
                SubTotalValue:   parseFloat(r.subTotalValue) || 0,
                BoxNumberRanges: (r.boxNumberRanges || []).filter(s => s.prefix !== '' || s.start !== '' || s.end !== '')
            }));
        }

        $submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Saving...');
        $('#formAlerts').empty();

        $.ajax({
            url:         '@Url.Action("Create")',
            type:        'POST',
            contentType: 'application/json',
            data:        JSON.stringify(payload),
            success: function (response) {
                if (response && response.redirectUrl) { window.location.href = response.redirectUrl; return; }
                if (response && response.success === true) {
                    $('#formAlerts').html('<div class="alert alert-success alert-dismissible fade show"><i class="ti ti-check me-1"></i>Stock movement saved successfully.<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
                    branchRows   = [{ denominationId: '', numBagsBoxes: '', containerType: 'Bag', numBundles: '', categoryId: '', subTotalValue: '', boxNumberRanges: [{ prefix: '', start: '', end: '' }] }];
                    internalRows = [{ denominationId: '', boxNumberRanges: [{ prefix: '', start: '', end: '' }], numBoxes: '', containerType: 'Box', subTotalValue: '' }];
                    renderBranchTable();
                    renderInternalTable();
                    return;
                }
                if (response && response.errors) {
                    let html = '<div class="alert alert-danger alert-dismissible fade show"><ul class="mb-0">';
                    Object.values(response.errors).forEach(msg => { html += `<li>${msg}</li>`; });
                    html += '</ul><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>';
                    $('#formAlerts').html(html);
                }
            },
            error: function (xhr) {
                console.error('Create submission error:', xhr.status, xhr.statusText, xhr.responseText);
                let html = '<div class="alert alert-danger alert-dismissible fade show"><ul class="mb-0">';
                if (xhr.responseJSON) {
                    const errors = xhr.responseJSON;
                    if (errors.message) {
                        html += `<li>${errors.message}</li>`;
                    } else if (errors.errors) {
                        for (let key in errors.errors) {
                            if (errors.errors[key]?.length) errors.errors[key].forEach(e => { html += `<li>${e}</li>`; });
                        }
                    } else {
                        for (let key in errors) {
                            if (Array.isArray(errors[key])) errors[key].forEach(e => { html += `<li>${e}</li>`; });
                            else if (typeof errors[key] === 'string') html += `<li>${errors[key]}</li>`;
                        }
                    }
                } else {
                    html += `<li>Unexpected error: ${xhr.status} ${xhr.statusText}</li>`;
                }
                html += '</ul><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>';
                $('#formAlerts').html(html);
            },
            complete: function () {
                $submitBtn.prop('disabled', false).html('<i class="ti ti-check me-1"></i>Save');
            }
        });
    });

    // ─── Init ─────────────────────────────────────────────────────────────────

    let previousMovementType = $('#movementType').val();

    $('#movementType').on('change', function () {
        const newType         = $(this).val();
        const switchingToBranch = newType === '@StockConstants.StockMovementTypes.BranchToBranch';
        const hasData         = switchingToBranch ? hasInternalData() : hasBranchData();

        if (hasData) {
            const fromType = switchingToBranch ? 'Buffer to Operational' : 'Branch to Branch';
            const toType   = switchingToBranch ? 'Branch to Branch'      : 'Buffer to Operational';
            if (!confirm(`You have entered data for "${fromType}". Switching to "${toType}" will clear that data. Continue?`)) {
                $(this).val(previousMovementType);
                return;
            }
            switchingToBranch ? clearInternalForm() : clearBranchForm();
        }

        previousMovementType = newType;
        toggleSections();
    });

    toggleSections();
    renderBranchTable();
    renderInternalTable();
});
</script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
