@model dynamic

@using VMSService.Core.Services.Stocks.StockEntities
@using VMSService.Web.Controllers;
@using VMSService.Core.Static;

@{
    ViewData["Title"] = "Create Stock Movement";
    var branches = ViewBag.Branches as List<Branch>;
    var denominations = ViewBag.Denominations as List<Denomination>;
    var categories = ViewBag.Categories as List<Category>;
    var userRoles = ViewBag.UserRoles as List<string> ?? new List<string>();
    var isBranchManager = userRoles.Contains(SystemPolicy.Roles.BranchManager) || 
                          userRoles.Contains(SystemPolicy.Roles.AssistantBranchManager);
}

<div class="row">
    <div class="col-12 col-lg-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header pb-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="d-flex flex-column">
                        <span class="text-muted small mb-2">Create New Stock Movement</span>
                        <h2 class="fs-4 fw-bold mb-0">Add Stock Movement</h2>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="ti ti-arrow-left me-1"></i> Back to List
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div id="formAlerts"></div>
                <form id="stockMovementForm">
                    <div class="mb-3">
                        <label class="form-label">Stock Movement Type <span class="text-danger">*</span></label>
                        @using VMSService.Core.Static;
                        <select class="form-select" id="movementType">
                            @foreach (var mt in StockConstants.MovementTypes)
                            {
                                @if (isBranchManager && mt.Key == StockConstants.StockMovementTypes.BranchToBranch)
                                {
                                    continue;
                                }
                                <option value="@mt.Key">@mt.Value</option>
                            }
                        </select>
                    </div>

                    <!-- Branch to Branch Section -->
                    <div id="branchSection">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="branchDate">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Reference Number <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="branchReferenceNumber">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Dispatching Branch <span class="text-danger">*</span></label>
                                <select class="form-select" id="dispatchingBranch">
                                    <option value="">-- Select Branch --</option>
                                    @if (branches != null)
                                    {
                                        foreach (var branch in branches)
                                        {
                                            <option value="@branch.Id">@branch.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Receiving Branch <span class="text-danger">*</span></label>
                                <select class="form-select" id="receivingBranch">
                                    <option value="">-- Select Branch --</option>
                                    @if (branches != null)
                                    {
                                        foreach (var branch in branches)
                                        {
                                            <option value="@branch.Id">@branch.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <!-- Categorization moved to each denomination row below -->
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Denomination Details</label>
                            <table class="table table-bordered" id="denominationTable">
                                <thead>
                                    <tr>
                                        <th>Denomination</th>
                                        <th>Currency Category</th>
                                        <th>Container Type</th>
                                        <th>Number of Bags/Boxes</th>
                                        <th>Number of Bundles</th>
                                        <th>Categorization</th>
                                        <th>Sub-total Value</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                                <tfoot style="background-color: #f8f9fa;">
                                    <tr>
                                        <td colspan="5"></td>
                                        <td class="text-end align-middle">Total Bags/Boxes</td>
                                        <td style="min-width: 140px;"><input type="text" class="form-control text-end" id="totalBagsBoxes" readonly placeholder="0"></td>
                                    </tr>
                                    <tr>
                                        <td colspan="5"></td>
                                        <td class="text-end align-middle">Grand Total Value</td>
                                        <td style="min-width: 140px;"><input type="text" class="form-control text-end" id="grandTotalValue" readonly placeholder="0"></td>
                                    </tr>
                                </tfoot>
                            </table>
                            <div class="d-flex justify-content-end mt-3">
                                <button type="button" class="btn btn-success btn-sm" id="addDenominationRow">
                                    <i class="ti ti-plus"></i> Add Row
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Buffer to Operational Section -->
                    <div id="internalSection" style="display:none;">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="internalDate">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Reference Number <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="internalReferenceNumber">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Dispatching Branch <span class="text-danger">*</span></label>
                                <select class="form-select" id="internalDispatchingBranch">
                                    <option value="">-- Select Branch --</option>
                                    @if (branches != null)
                                    {
                                        foreach (var branch in branches)
                                        {
                                            <option value="@branch.Id">@branch.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Receiving Branch <span class="text-danger">*</span></label>
                                <select class="form-select" id="internalReceivingBranch">
                                    <option value="">-- Select Branch --</option>
                                    @if (branches != null)
                                    {
                                        foreach (var branch in branches)
                                        {
                                            <option value="@branch.Id">@branch.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Denomination Details</label>
                            <table class="table table-bordered" id="internalDenominationTable">
                                <thead>
                                    <tr>
                                        <th>Denomination</th>
                                        <th>Serial Number Range</th>
                                        <th>Number of Boxes</th>
                                        <th>Sub-total Value</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                                <tfoot style="background-color: #f8f9fa;">
                                    <tr>
                                        <td colspan="2"></td>
                                        <td class="text-end align-middle">Total Boxes</td>
                                        <td style="min-width: 140px;"><input type="text" class="form-control text-end" id="internalTotalBoxes" readonly placeholder="0"></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td colspan="2"></td>
                                        <td class="text-end align-middle">Grand Total Value</td>
                                        <td style="min-width: 140px;"><input type="text" class="form-control text-end" id="internalGrandTotalValue" readonly placeholder="0"></td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                            <div class="d-flex justify-content-end mt-3">
                                <button type="button" class="btn btn-success btn-sm" id="addInternalDenominationRow">
                                    <i class="ti ti-plus"></i> Add Row
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary" id="submitBtn">
                            <i class="ti ti-check me-1"></i>Save
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="ti ti-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).ready(function () {

    // ─── Razor data passed into JS ────────────────────────────────────────────
    const denominationOptions = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
    denominations != null
        ? denominations.Select(d => new { id = d.Id, name = d.Name, value = d.Value, piecesInBox = d.NumberOfPiecesInABox })
        : Enumerable.Empty<object>()
    ));
    const categoryOptions = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
    categories != null
        ? categories.Select(c => new { id = c.Id, name = c.Name })
        : Enumerable.Empty<object>()
    ));

    // Build a map of denomination ID to pieces in box for quick lookup
    const denominationPiecesInBox = {};
    denominationOptions.forEach(d => {
        denominationPiecesInBox[d.id] = d.piecesInBox;
    });

    // Build a map of category ID to name for determining Bags vs Boxes
    const categoryNames = {};
    categoryOptions.forEach(c => {
        categoryNames[c.id] = c.name;
    });

    // Helper to get container label based on category name
    // "New" category uses Boxes, all others use Bags
    function getContainerLabel(categoryId) {
        const name = categoryNames[categoryId];
        if (name && name.toLowerCase() === 'new') {
            return 'Boxes';
        }
        return 'Bags';
    }

    // ─── State — single source of truth ──────────────────────────────────────

    let branchRows = [
        { denominationId: '', numBagsBoxes: '', containerType: 'Bag', numBundles: '', categoryId: '', subTotalValue: '', categorization: 'buffer' }
    ];

    let internalRows = [
        { denominationId: '', serialRanges: [{ prefix: '', start: '', end: '' }], numBoxes: '', containerType: 'Box', subTotalValue: '' }
    ];

    // ─── Option builders ──────────────────────────────────────────────────────

    function buildDenomOptions(selectedId) {
        let html = '<option value="">-- Select Denomination --</option>';
        denominationOptions.forEach(d => {
            html += `<option value="${d.id}" ${String(d.id) === String(selectedId) ? 'selected' : ''}>${d.name} (${d.value})</option>`;
        });
        return html;
    }

    function buildCategoryOptions(selectedId) {
        let html = '<option value="">-- Select Category --</option>';
        categoryOptions.forEach(c => {
            html += `<option value="${c.id}" ${String(c.id) === String(selectedId) ? 'selected' : ''}>${c.name}</option>`;
        });
        return html;
    }

    // ─── Render branch table ──────────────────────────────────────────────────

    function renderBranchTable() {
        const $tbody = $('#denominationTable tbody');
        $tbody.empty();
        branchRows.forEach((row, idx) => {
            const defaultContainerType = getContainerLabel(row.categoryId);
            const containerType = row.containerType || defaultContainerType;
            $tbody.append(`
                <tr data-idx="${idx}">
                    <td><select class="form-select branch-denom-id" data-pieces-in-box="0">${buildDenomOptions(row.denominationId)}</select></td>
                    <td><select class="form-select branch-category-id">${buildCategoryOptions(row.categoryId)}</select></td>
                    <td>
                        <select class="form-select branch-container-type">
                            <option value="Bag" ${containerType === 'Bag' ? 'selected' : ''}>Bag</option>
                            <option value="Box" ${containerType === 'Box' ? 'selected' : ''}>Box</option>
                        </select>
                    </td>
                    <td><input type="number" class="form-control branch-num-bags" value="${row.numBagsBoxes}" placeholder="0" /></td>
                    <td><input type="number" class="form-control branch-num-bundles" value="${row.numBundles}" placeholder="0" readonly /></td>
                    <td>
                        <select class="form-select branch-categorization">
                            <option value="buffer" ${row.categorization === 'buffer' ? 'selected' : ''}>Buffer Stocks</option>
                            <option value="operational" ${row.categorization === 'operational' ? 'selected' : ''}>Operational Stocks</option>
                        </select>
                    </td>
                    <td><input type="text" class="form-control branch-subtotal" value="${isNaN(parseFloat(row.subTotalValue)) ? '' : parseFloat(row.subTotalValue).toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ',')}" placeholder="0" readonly /></td>
                    <td><button type="button" class="btn btn-danger btn-sm remove-branch-row"><i class="ti ti-trash"></i></button></td>
                </tr>
            `);
        });
        
        // Update denomination select with pieces-in-box data
        $('#denominationTable tbody .branch-denom-id').each(function() {
            const denomId = $(this).val();
            const denom = denominationOptions.find(d => d.id == denomId);
            if (denom) {
                $(this).attr('data-denomination-value', denom.value);
            }
        });
        
        recalculateBranchTotals();
    }

    // ─── Render internal table ────────────────────────────────────────────────

    function renderInternalTable() {
        const $tbody = $('#internalDenominationTable tbody');
        $tbody.empty();
        internalRows.forEach((row, denomIdx) => {
            let serialRowsHtml = '';
            row.serialRanges.forEach((range, rangeIdx) => {
                serialRowsHtml += `
                    <tr data-range-idx="${rangeIdx}">
                        <td><input type="text" class="form-control serial-prefix" value="${range.prefix}" placeholder="Prefix" /></td>
                        <td><input type="text" class="form-control serial-start"  value="${range.start}"  placeholder="Start"  /></td>
                        <td><input type="text" class="form-control serial-end"    value="${range.end}"    placeholder="End"    /></td>
                        <td><button type="button" class="btn btn-danger btn-sm remove-serial-range"><i class="ti ti-trash"></i></button></td>
                    </tr>
                `;
            });
            $tbody.append(`
                <tr data-idx="${denomIdx}">
                    <td><select class="form-select internal-denom-id">${buildDenomOptions(row.denominationId)}</select></td>
                    <td>
                        <table class="table table-sm mb-0">
                            <tbody>${serialRowsHtml}</tbody>
                        </table>
                        <div class="d-flex justify-content-end mt-1">
                            <button type="button" class="btn btn-success btn-sm add-serial-range">
                                <i class="ti ti-plus"></i> Add Range
                            </button>
                        </div>
                    </td>
                    <td><input type="number" class="form-control internal-num-boxes" value="${row.numBoxes}" placeholder="0" /></td>
                    <td><input type="text" class="form-control internal-subtotal"  value="${isNaN(parseFloat(row.subTotalValue)) ? '' : parseFloat(row.subTotalValue).toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ',')}" placeholder="0" readonly /></td>
                    <td><button type="button" class="btn btn-danger btn-sm remove-internal-row"><i class="ti ti-trash"></i></button></td>
                </tr>
            `);
        });
        recalculateInternalTotals();
    }

    // ─── Formatting ───────────────────────────────────────────────────────────────
    
    function formatNumber(value) {
        // Remove decimals and add thousand separators
        return Math.round(value).toLocaleString('en-US');
    }

    // ─── Section toggle ───────────────────────────────────────────────────────

    function toggleSections() {
        if ($('#movementType').val() === '@StockConstants.StockMovementTypes.BranchToBranch') {
            $('#branchSection').show();
            $('#internalSection').hide();
        } else {
            $('#branchSection').hide();
            $('#internalSection').show();
        }
    }

    // ─── Check if form has data ───────────────────────────────────────────────

    function hasBranchData() {
        return $('#branchDate').val() !== '' ||
               $('#branchReferenceNumber').val() !== '' ||
               $('#dispatchingBranch').val() !== '' ||
               $('#receivingBranch').val() !== '' ||
               branchRows.some(r => r.denominationId !== '' || r.numBagsBoxes !== '');
    }

    function hasInternalData() {
        return $('#internalDate').val() !== '' ||
               $('#internalReferenceNumber').val() !== '' ||
               $('#internalDispatchingBranch').val() !== '' ||
               $('#internalReceivingBranch').val() !== '' ||
               internalRows.some(r => r.denominationId !== '' || r.numBoxes !== '');
    }

    function clearBranchForm() {
        $('#branchDate').val('');
        $('#branchReferenceNumber').val('');
        $('#dispatchingBranch').val('');
        $('#receivingBranch').val('');
        branchRows = [{ denominationId: '', numBagsBoxes: '', containerType: 'Bag', numBundles: '', categoryId: '', subTotalValue: '', categorization: 'buffer' }];
        renderBranchTable();
    }

    function clearInternalForm() {
        $('#internalDate').val('');
        $('#internalReferenceNumber').val('');
        $('#internalDispatchingBranch').val('');
        $('#internalReceivingBranch').val('');
        internalRows = [{ denominationId: '', serialRanges: [{ prefix: '', start: '', end: '' }], numBoxes: '', subTotalValue: '' }];
        renderInternalTable();
    }

    // ─── Branch events ────────────────────────────────────────────────────────

    $('#denominationTable').on('input change', '.branch-denom-id, .branch-num-bags, .branch-container-type, .branch-category-id, .branch-categorization', function () {
        const idx = $(this).closest('tr').data('idx');
        if (idx === undefined) return;
        if ($(this).hasClass('branch-denom-id'))      branchRows[idx].denominationId = $(this).val();
        if ($(this).hasClass('branch-num-bags'))      branchRows[idx].numBagsBoxes   = $(this).val();
        if ($(this).hasClass('branch-container-type')) branchRows[idx].containerType  = $(this).val();
        if ($(this).hasClass('branch-category-id'))   branchRows[idx].categoryId     = $(this).val();
        if ($(this).hasClass('branch-categorization')) branchRows[idx].categorization = $(this).val();
        // Auto-calculate bundles and subtotal
        calculateBranchRowValues(idx);
        recalculateBranchTotals();
    });

    function calculateBranchRowValues(idx) {
        const row = branchRows[idx];
        const $row = $(`#denominationTable tbody tr[data-idx="${idx}"]`);
        
        if (!$row.length) return; // Early exit if row not found
        
        // Get denomination value and pieces in box
        const denom = denominationOptions.find(d => d.id == row.denominationId);
        const denomValue = denom ? denom.value : 0;
        const piecesInBox = denom ? denom.piecesInBox : 1;
        const numBoxes = parseInt(row.numBagsBoxes) || 0;
        
        // Only calculate if we have valid denomination and number of boxes
        if (!denom || numBoxes === 0) {
            $row.find('.branch-num-bundles').val('');
            $row.find('.branch-subtotal').val('');
            branchRows[idx].numBundles = '';
            branchRows[idx].subTotalValue = '';
            return;
        }
        
        // Formula: number of bundles = (Number of Boxes) × (NumberOfPiecesInABox / 100)
        const numBundles = numBoxes * (piecesInBox / 1000);
        
        // Calculate subtotal: piecesInBox * denomination value * number of boxes
        const subTotal = piecesInBox * denomValue * numBoxes;
        
        // Update state and DOM
        branchRows[idx].numBundles = numBundles;
        branchRows[idx].subTotalValue = subTotal;
        
        $row.find('.branch-num-bundles').val(numBundles.toFixed(0));
        $row.find('.branch-subtotal').val(subTotal.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ','));
    }

    $('#addDenominationRow').on('click', function () {
        branchRows.push({ denominationId: '', numBagsBoxes: '', containerType: 'Bag', numBundles: '', categoryId: '', subTotalValue: '', categorization: 'buffer' });
        renderBranchTable();
    });

    $('#denominationTable').on('click', '.remove-branch-row', function () {
        if (branchRows.length > 1) {
            branchRows.splice($(this).closest('tr').data('idx'), 1);
            renderBranchTable();
        }
    });

    // ─── Internal events ──────────────────────────────────────────────────────

    $('#internalDenominationTable').on('input change', '.internal-denom-id, .internal-num-boxes', function () {
        const idx = $(this).closest('tr[data-idx]').data('idx');
        if (idx === undefined) return;
        if ($(this).hasClass('internal-denom-id')) internalRows[idx].denominationId = $(this).val();
        if ($(this).hasClass('internal-num-boxes')) internalRows[idx].numBoxes = $(this).val();
        
        // Auto-calculate subtotal
        calculateInternalRowValues(idx);
        recalculateInternalTotals();
    });

    function calculateInternalRowValues(idx) {
        const row = internalRows[idx];
        const $row = $(`#internalDenominationTable tbody tr[data-idx="${idx}"]`);
        
        if (!$row.length) return; // Early exit if row not found
        
        // Get denomination value and pieces in box
        const denom = denominationOptions.find(d => d.id == row.denominationId);
        const denomValue = denom ? denom.value : 0;
        const piecesInBox = denom ? denom.piecesInBox : 1;
        const numBoxes = parseInt(row.numBoxes) || 0;
        
        // Only calculate if we have valid denomination and number of boxes
        if (!denom || numBoxes === 0) {
            $row.find('.internal-subtotal').val('');
            internalRows[idx].subTotalValue = '';
            return;
        }
        
        // Calculate subtotal: piecesInBox * denomination value * number of boxes
        const subTotal = piecesInBox * denomValue * numBoxes;
        
        // Update state and DOM
        internalRows[idx].subTotalValue = subTotal;
        
        $row.find('.internal-subtotal').val(subTotal.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ','));
    }

    // Serial range input — update state in real time
    $('#internalDenominationTable').on('input', '.serial-prefix, .serial-start, .serial-end', function () {
        const denomIdx = $(this).closest('tr[data-idx]').data('idx');
        const rangeIdx = $(this).closest('tr[data-range-idx]').data('range-idx');
        if (denomIdx === undefined || rangeIdx === undefined) return;
        if ($(this).hasClass('serial-prefix')) internalRows[denomIdx].serialRanges[rangeIdx].prefix = $(this).val();
        if ($(this).hasClass('serial-start'))  internalRows[denomIdx].serialRanges[rangeIdx].start  = $(this).val();
        if ($(this).hasClass('serial-end'))    internalRows[denomIdx].serialRanges[rangeIdx].end    = $(this).val();
    });

    $('#addInternalDenominationRow').on('click', function () {
        internalRows.push({ denominationId: '', serialRanges: [{ prefix: '', start: '', end: '' }], numBoxes: '', containerType: 'Box', subTotalValue: '' });
        renderInternalTable();
    });

    $('#internalDenominationTable').on('click', '.remove-internal-row', function () {
        if (internalRows.length > 1) {
            internalRows.splice($(this).closest('tr[data-idx]').data('idx'), 1);
            renderInternalTable();
        }
    });

    $('#internalDenominationTable').on('click', '.add-serial-range', function () {
        const idx = $(this).closest('tr[data-idx]').data('idx');
        internalRows[idx].serialRanges.push({ prefix: '', start: '', end: '' });
        renderInternalTable();
    });

    $('#internalDenominationTable').on('click', '.remove-serial-range', function () {
        const denomIdx = $(this).closest('tr[data-idx]').data('idx');
        const rangeIdx = $(this).closest('tr[data-range-idx]').data('range-idx');
        if (internalRows[denomIdx].serialRanges.length > 1) {
            internalRows[denomIdx].serialRanges.splice(rangeIdx, 1);
            renderInternalTable();
        }
    });

    // ─── Totals ───────────────────────────────────────────────────────────────

    function recalculateBranchTotals() {
        const totalBags  = branchRows.reduce((s, r) => s + (parseInt(r.numBagsBoxes)    || 0), 0);
        const grandTotal = branchRows.reduce((s, r) => s + (parseFloat(r.subTotalValue) || 0), 0);
        $('#totalBagsBoxes').val(totalBags.toFixed(0));
        $('#grandTotalValue').val(grandTotal.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ','));
    }

    function recalculateInternalTotals() {
        const totalBoxes = internalRows.reduce((s, r) => s + (parseInt(r.numBoxes)       || 0), 0);
        const grandTotal = internalRows.reduce((s, r) => s + (parseFloat(r.subTotalValue) || 0), 0);
        $('#internalTotalBoxes').val(totalBoxes.toFixed(0));
        $('#internalGrandTotalValue').val(grandTotal.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ','));
    }

    // ─── AJAX Submit ──────────────────────────────────────────────────────────

    $('#stockMovementForm').on('submit', function (event) {
        event.preventDefault();

        const $submitBtn = $('#submitBtn');
        const isBranch   = $('#movementType').val() === '@StockConstants.StockMovementTypes.BranchToBranch';

        // Build payload directly from state — no DOM scraping needed
        const payload = { MovementType: $('#movementType').val() };

        if (isBranch) {
            payload.BranchDate            = $('#branchDate').val();
            payload.BranchReferenceNumber = $('#branchReferenceNumber').val();
            payload.DispatchingBranch     = $('#dispatchingBranch').val();
            payload.ReceivingBranch       = $('#receivingBranch').val();
            payload.BranchTotalBagsBoxes =
                parseInt($('#totalBagsBoxes').val().replace(/,/g,'')) || 0;

            payload.BranchGrandTotalValue =
                parseFloat($('#grandTotalValue').val().replace(/,/g,'')) || 0;
            payload.DenominationRows = branchRows.filter(r => r.denominationId !== '').map(r => ({
                DenominationId: r.denominationId,
                NumBagsBoxes: r.numBagsBoxes,
                ContainerType: r.containerType,
                NumBundles: r.numBundles,
                CategoryId: r.categoryId ? parseInt(r.categoryId) : null,
                SubTotalValue: r.subTotalValue,
                Categorization: r.categorization ?? 'buffer'
            }));
        } else {
            payload.InternalDate            = $('#internalDate').val();
            payload.InternalReferenceNumber = $('#internalReferenceNumber').val();
            payload.DispatchingBranch       = $('#internalDispatchingBranch').val();
            payload.ReceivingBranch         = $('#internalReceivingBranch').val();
                payload.InternalTotalBoxes =
            parseInt($('#internalTotalBoxes').val().replace(/,/g,'')) || 0;

        payload.InternalGrandTotalValue =
            parseFloat($('#internalGrandTotalValue').val().replace(/,/g,'')) || 0;           
            payload.InternalDenominationRows = internalRows
                .filter(r => r.denominationId !== '')
                .map(r => ({
                    ...r,
                    serialRanges: r.serialRanges.filter(s => s.prefix !== '' || s.start !== '' || s.end !== '')
                }));
        }

        $submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Saving...');
        $('#formAlerts').empty();

        $.ajax({
            url:         '@Url.Action("Create")',
            type:        'POST',
            contentType: 'application/json',
            data:        JSON.stringify(payload),
            success: function (response) {
                if (response && response.redirectUrl) {
                    window.location.href = response.redirectUrl;
                    return;
                }
                if (response && response.success === true) {
                    $('#formAlerts').html(
                        '<div class="alert alert-success alert-dismissible fade show">' +
                        '<i class="ti ti-check me-1"></i>Stock movement saved successfully.' +
                        '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>'
                    );
                    // Reset state
                    branchRows   = [{ denominationId: '', numBagsBoxes: '', containerType: 'Bag', numBundles: '', categoryId: '', subTotalValue: '' }];
                    internalRows = [{ denominationId: '', serialRanges: [{ prefix: '', start: '', end: '' }], numBoxes: '', containerType: 'Box', subTotalValue: '' }];
                    renderBranchTable();
                    renderInternalTable();
                    return;
                }
                if (response && response.errors) {
                    let html = '<div class="alert alert-danger alert-dismissible fade show"><ul class="mb-0">';
                    Object.values(response.errors).forEach(msg => { html += `<li>${msg}</li>`; });
                    html += '</ul><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>';
                    $('#formAlerts').html(html);
                }
            },
            // error: function (xhr) {
            //     let msg = 'An unexpected error occurred. Please try again.';
            //     if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
            //     else if (xhr.status === 400) msg = 'Validation failed. Please check your inputs.';
            //     else if (xhr.status === 500) msg = 'Server error. Please contact support.';
            //     $('#formAlerts').html(
            //         '<div class="alert alert-danger alert-dismissible fade show">' +
            //         '<i class="ti ti-alert-circle me-1"></i>' + msg +
            //         '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>'
            //     );
            // },
            error: function (xhr) {

                if (xhr.responseJSON) {

                    let errors = xhr.responseJSON;
                    let html = '<div class="alert alert-danger"><ul>';

                    for (let key in errors) {
                        if (errors[key] && errors[key].length) {
                            errors[key].forEach(e => {
                                html += `<li>${e}</li>`;
                            });
                        }
                    }

                    html += '</ul></div>';
                    $('#formAlerts').html(html);

                } else {

                    $('#formAlerts').html(
                        '<div class="alert alert-danger">Unexpected error occurred</div>'
                    );

                }
            },
            complete: function () {
                $submitBtn.prop('disabled', false).html('<i class="ti ti-check me-1"></i>Save');
            }
        });
    });

    // ─── Init ─────────────────────────────────────────────────────────────────

    let previousMovementType = $('#movementType').val();

    $('#movementType').on('change', function() {
        const newType = $(this).val();
        const switchingToBranch = newType === 'branch';
        const hasData = switchingToBranch ? hasInternalData() : hasBranchData();

        if (hasData) {
            const fromType = switchingToBranch ? 'Buffer to Operational' : 'Branch to Branch';
            const toType = switchingToBranch ? 'Branch to Branch' : 'Buffer to Operational';
            
            if (!confirm(`You have entered data for "${fromType}". Switching to "${toType}" will clear that data. Continue?`)) {
                // Revert the selection
                $(this).val(previousMovementType);
                return;
            }
            
            // Clear the previous form's data
            if (switchingToBranch) {
                clearInternalForm();
            } else {
                clearBranchForm();
            }
        }

        previousMovementType = newType;
        toggleSections();
    });

    toggleSections();
    renderBranchTable();
    renderInternalTable();

});
</script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
