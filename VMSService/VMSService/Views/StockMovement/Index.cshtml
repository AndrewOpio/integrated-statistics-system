@model IEnumerable<VMSService.Data.Entities.StockMovement>

@{
    ViewData["Title"] = "Stock Movement";
    var userRoles = string.Join(", ", User.FindAll("appRole").Where(c => c.Value.StartsWith("VMS:")).Select(c => c.Value.Split(":")[1]).ToList());
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h2 class="fs-5 fw-bold mb-0">Stock Movement</h2>
                    </div>
                    @if (userRoles.Contains(SystemPolicy.Roles.BranchManager) || userRoles.Contains(SystemPolicy.Roles.RemittancesOfficer))
                    {
                        <div class="col text-end">
                            <a asp-action="Create" class="btn btn-sm btn-primary">
                                <i class="ti ti-plus me-1"></i>Add Movement
                            </a>
                        </div>
                    }
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-centered table-nowrap mb-0 rounded datatable">
                        <thead class="thead-light">
                            <tr>
                                <th class="border-0 rounded-start">#</th>
                                <th class="border-0">Movement Type</th>
                                <th class="border-0">Date</th>
                                <th class="border-0">Reference Number</th>
                                <th class="border-0">Status</th>
                                <th class="border-0">Discrepancy Status</th>
                                <th class="border-0">Grand Total Value</th>
                                <th class="border-0 rounded-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowNumber = 1;
                            }
                            
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><span class="text-primary fw-bold">@rowNumber</span></td>
                                    <td class="fw-bold">@item.MovementType?.ToUpperInvariant()</td>
                                    <td>@item.Date.ToString("dd/MMM/yyyy")</td>
                                    <td>@item.ReferenceNumber</td>
                                    <td>
                                        @if (item.CurrentStatus != null)
                                        {
                                            <span class="badge bg-secondary">@item.CurrentStatus.Name</span>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var discrepancy = item.StockMovementDiscrepancies?.FirstOrDefault();
                                            if (discrepancy != null && discrepancy.CurrentStatus != null)
                                            {
                                                <span class="badge bg-warning">@discrepancy.CurrentStatus.Name</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        }
                                    </td>
                                    <td>@item.GrandTotalValue?.ToString("N2")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="ti ti-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                                <i class="ti ti-edit"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                rowNumber++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        // await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}