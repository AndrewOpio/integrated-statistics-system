@using System.Security.Claims
@using VMSService.Core.Models.StockProcessingSessions
@using VMSService.Core.Models.Shared
@model StockProcessingSessionDetailsViewModel

@{
    ViewData["Title"] = "Session Details";
    var statusColor = Model.CurrentStatusName switch
    {
        "Draft"         => "info",
        "Issued To Board" => "info",
        "Open"          => "danger",
        "Closed"        => "success",
        _               => "secondary"
    };
    var userRoles = string.Join(", ", User.FindAll("appRole").Where(c => c.Value.StartsWith($"{SystemPolicy.SystemSettings.AppAcronym}:")).Select(c => c.Value.Split(":")[1]).ToList());
    var userId = User.FindFirstValue(ClaimTypes.Name);
}

<style>
    .session-stat-card {
        border: 1.5px solid #e9ecef;
        border-radius: .75rem;
        padding: 1rem 1.25rem;
        background: #fff;
        transition: box-shadow .15s;
    }
    .session-stat-card:hover { box-shadow: 0 2px 8px rgba(49,49,106,.08); }
    .stat-label {
        font-size: .68rem;
        font-weight: 600;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: #6c757d;
        margin-bottom: .25rem;
    }
    .stat-value {
        font-size: 1rem;
        font-weight: 700;
        color: #31316A;
    }
    .stat-sub { font-size: .75rem; color: #6c757d; }
    .bag-chip {
        display: inline-flex; flex-direction: column;
        padding: .25rem .6rem; border-radius: .4rem;
        font-size: .72rem; background: #e3f2fd;
        color: #0d47a1; border: 1.5px solid #90caf9;
        vertical-align: top;
    }
    .bag-chip-ref { font-weight: 700; font-size: .73rem; }
    .bag-chip-meta { font-size: .63rem; opacity: .8; }
    .section-card {
        border: 0;
        border-radius: .75rem;
        box-shadow: 0 1px 6px rgba(0,0,0,.07);
    }
    .section-icon {
        width: 32px; height: 32px;
        background: rgba(49,49,106,.08);
        border-radius: .4rem;
        display: inline-flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
</style>

@* ── Page Header ─────────────────────────────────────────────────── *@
<div class="d-flex align-items-start justify-content-between mb-4 gap-3 flex-wrap">
    <div class="d-flex align-items-center gap-3">
        @* <a asp-controller="StockProcessingPlan" asp-action="Details" asp-route-id="@Model.StockProcessingPlanId"
           class="btn btn-sm btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i>Back to Plan
        </a> *@
        <div>
            <p class="text-muted small mb-0">Processing Session</p>
            <h4 class="fw-bold mb-0" style="color:#31316A;">@Model.ReferenceNumber</h4>
        </div>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        @if (Model.CurrentStatusName == StatusConstants.StockProcessingSession.Open && !Model.SurplusShortages.Any())
        {
            <a asp-action="SendCfbRequest" asp-route-sessionId="@Model.Id" class="btn btn-sm btn-outline-tertiary">
                <i class="ti ti-send me-1"></i>New CFB Request
            </a>
        }
        <span class="badge bg-@statusColor px-3 py-2 rounded-pill fs-small">
            <i class="ti ti-circle-filled me-1"></i>@Model.CurrentStatusName
        </span>
        @if (Model.IsCompleted)
        {
            <span class="badge bg-success px-3 py-2 rounded-pill fs-small">
                <i class="ti ti-circle-check me-1"></i>Completed
            </span>
        }
        else
        {
            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fs-small">
                <i class="ti ti-clock me-1"></i>Incomplete
            </span>
        }
        @if (Model.IsManual)
        {
            <span class="badge bg-light border text-secondary px-3 py-2 rounded-pill fs-small">
                <i class="ti ti-hand me-1"></i>Manual
            </span>
        }
        else
        {
            <span class="badge bg-light border text-secondary px-3 py-2 rounded-pill fs-small">
                <span><i class="ti ti-cpu me-1"></i>Machine</span>
                <span class="badge bg-light" style="color:#31316A;border-color:#dee2e6!important;">
                    @Model.MachineName
                </span>
            </span>
        }
    </div>
</div>

@* ── Summary Stats ──────────────────────────────────────────────── *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="session-stat-card">
            <div class="stat-label">Processing Board</div>
            <div class="stat-value">@(Model.ProcessingBoardName ?? "—")</div>
            @if (!string.IsNullOrEmpty(Model.CountingRoomName))
            {
                <div class="stat-sub"><i class="ti ti-door me-1"></i>@Model.CountingRoomName</div>
            }
            @if (!string.IsNullOrEmpty(Model.SupervisorName))
            {
                <div class="stat-sub mt-1">
                    <i class="ti ti-user-check me-1"></i>
                    <span class="fw-semibold" style="color:#31316A;">@Model.SupervisorName</span>
                </div>
            }
            else
            {
                <div class="stat-sub mt-1 text-danger">
                    <i class="ti ti-user-x me-1"></i>No supervisor assigned
                </div>
            }
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="session-stat-card">
            <div class="stat-label">Commercial Bank</div>
            <div class="stat-value">@(Model.CommercialBankName ?? "—")</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="session-stat-card">
            <div class="stat-label">Denomination</div>
            <div class="stat-value">
                @if (Model.DenominationValue > 0)
                {
                    <text>UGX @Model.DenominationValue.ToString("N0")</text>
                }
                else
                {
                    <text>—</text>
                }
            </div>
            @if (!string.IsNullOrEmpty(Model.DenominationName))
            {
                <div class="stat-sub">@Model.DenominationName</div>
            }
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="session-stat-card">
            <div class="stat-label">Total Issued Value</div>
            <div class="stat-value">
                @if (Model.TotalIssuedValue > 0)
                {
                    <text>UGX @Model.TotalIssuedValue.ToString("N0")</text>
                }
                else
                {
                    <text>—</text>
                }
            </div>
            <div class="stat-sub">@Model.Bags.Count bag@(Model.Bags.Count == 1 ? "" : "s") assigned</div>
        </div>
    </div>
</div>

@* ── Assigned Bags ──────────────────────────────────────────────── *@
<div class="card section-card mb-4">
    <div class="p-4 d-flex align-items-center gap-2 py-2">
        <span class="section-icon"><i class="ti ti-packages" style="color:#31316A;font-size:.9rem;"></i></span>
        <div>
            <h6 class="fw-bold mb-0" style="color:#31316A;">Assigned Bags</h6>
            <span class="small text-muted">@Model.Bags.Count bag@(Model.Bags.Count == 1 ? "" : "s") in this session</span>
        </div>
    </div>
    <div class="card-body p-0">
        @if (!Model.Bags.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="ti ti-package-off d-block mb-2" style="font-size:2.5rem;opacity:.35;"></i>
                <p class="small mb-0">No bags assigned to this session</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover small mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th class="ps-4 py-2 text-muted fw-semibold" style="font-size:.72rem;letter-spacing:.04em;">BAG REFERENCE</th>
                            <th class="py-2 text-muted fw-semibold" style="font-size:.72rem;letter-spacing:.04em;">SUB-CATEGORY</th>
                            <th class="py-2 text-muted fw-semibold" style="font-size:.72rem;letter-spacing:.04em;">DENOMINATION</th>
                            <th class="py-2 text-muted fw-semibold" style="font-size:.72rem;letter-spacing:.04em;">BUNDLES</th>
                            <th class="py-2 pe-4 text-muted fw-semibold text-end" style="font-size:.72rem;letter-spacing:.04em;">TOTAL VALUE</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bag in Model.Bags)
                        {
                            <tr>
                                <td class="ps-4 py-2">
                                    <span
                                       class="fw-semibold text-decoration-none" style="color:#31316A;">
                                        <i class="ti ti-package me-1 text-muted" style="font-size:.7rem;"></i>@bag.ReferenceNumber
                                    </span>
                                </td>
                                <td class="py-2">
                                    @if (!string.IsNullOrEmpty(bag.SubCategoryName))
                                    {
                                        <span class="badge bg-purple border text-purple bg-opacity-10 border-purple">@bag.SubCategoryName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="py-2">
                                    @if (bag.DenominationValue > 0)
                                    {
                                        <span class="fw-semibold">UGX @bag.DenominationValue.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="py-2">@bag.TotalBundles</td>
                                <td class="py-2 pe-4 text-end fw-semibold">
                                    @if (bag.TotalAmount > 0)
                                    {
                                        <text>@bag.TotalAmount.ToString("N0")</text>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot style="background:#f8fafc;border-top:2px solid #dee2e6;">
                        <tr>
                            <td colspan="3" class="ps-4 py-2 fw-semibold text-muted" style="font-size:.8rem;">TOTALS</td>
                            <td class="py-2 fw-bold" style="color:#31316A;">@Model.Bags.Sum(b => b.TotalBundles) bdls</td>
                            <td class="py-2 pe-4 text-end fw-bold" style="color:#31316A;">
                                UGX @Model.Bags.Sum(b => b.TotalAmount).ToString("N0")
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>

@* ── Processing Results ─────────────────────────────────────────── *@
@{
    bool hasUnverified = Model.Results.Any(r => !r.IsVerified);
}
<div class="card section-card mb-4">
    <div class="card-header d-flex align-items-center gap-2 py-2">
        <span class="section-icon"><i class="ti ti-report-analytics" style="color:#31316A;font-size:.9rem;"></i></span>
        <div class="flex-grow-1">
            <h6 class="fw-bold mb-0">Processing Results</h6>
            <span class="small text-muted">@Model.Results.Count result@(Model.Results.Count == 1 ? "" : "s") submitted</span>
        </div>
    </div>

    <div class="card-body p-0">
        @if (TempData["ResultSuccess"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mx-3 mt-3 mb-3" role="alert">
                <i class="ti ti-circle-check me-2"></i>@TempData["ResultSuccess"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ResultErrors"] is string resultErrorsJson)
        {
            var resultErrors = System.Text.Json.JsonSerializer.Deserialize<List<string>>(resultErrorsJson);
            if (resultErrors?.Count > 0)
            {
                <div class="alert alert-danger alert-dismissible fade show mx-3 mt-3 mb-3" role="alert">
                    <div class="d-flex align-items-start gap-2">
                        <i class="ti ti-alert-triangle flex-shrink-0 mt-1"></i>
                        <div>
                            <strong class="d-block mb-1">Please correct the following errors:</strong>
                            <ul class="mb-0 ps-3">
                                @foreach (var err in resultErrors)
                                {
                                    <li>@err</li>
                                }
                            </ul>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
        }

        @* ── Submitted results table ── *@
        @if (Model.Results.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover small mb-0">
                    <thead style="background:#f8fafc;">
                        <tr>
                            <th class="ps-4 py-2 text-muted fw-semibold" style="font-size:.7rem;letter-spacing:.05em;">#</th>
                            @* <th class="py-2 text-muted fw-semibold" style="font-size:.7rem;letter-spacing:.05em;">COUNT</th> *@
                            <th class="py-2 text-muted fw-semibold" style="font-size:.7rem;letter-spacing:.05em;">REISSUE VALUE</th>
                            <th class="py-2 text-muted fw-semibold" style="font-size:.7rem;letter-spacing:.05em;">CANCELED VALUE</th>
                            <th class="py-2 text-muted fw-semibold" style="font-size:.7rem;letter-spacing:.05em;">MONEY WITH BOARD</th>
                            <th class="py-2 text-muted fw-semibold" style="font-size:.7rem;letter-spacing:.05em;">VERIFIED</th>
                            <th class="py-2 pe-4 text-muted fw-semibold" style="font-size:.7rem;letter-spacing:.05em;width:60px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rn = 1; }
                        @foreach (VMSService.Core.Models.StockProcessingResults.StockProcessingResultViewModel r in Model.Results)
                        {
                            <tr>
                                <td class="ps-4 py-2 text-muted">@rn</td>
                                @* <td class="py-2 fw-semibold">@r.Count.ToString("N0")</td> *@
                                <td class="py-2">
                                    @if (r.ReissueValue > 0) { <text>UGX @r.ReissueValue.ToString("N0")</text> } else { <span class="text-muted">—</span> }
                                </td>
                                <td class="py-2">
                                    @if (r.CanceledValue > 0)
                                    {
                                        <text>UGX @r.CanceledValue.ToString("N0")</text>
                                    }
                                    else
                                    {

                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="py-2">
                                    @if (r.UnProcessedValue > 0)
                                    {
                                        <span class="fw-semibold text-warning-emphasis">UGX @r.UnProcessedValue.ToString("N0")</span>
                                    }
                                    else
                                    {

                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="py-2">
                                    @if (r.IsVerified)
                                    {
                                        <span class="badge bg-success border border-success-subtle" style="font-size:.68rem;">
                                            <i class="ti ti-circle-check me-1"></i>Verified
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-warning-emphasis border border-warning-subtle" style="font-size:.68rem;">
                                            <i class="ti ti-clock me-1"></i>Pending
                                        </span>
                                    }
                                </td>
                                <td class="py-2 pe-4">
                                    @if (!r.IsVerified && Model.BoardSupervisorUserId == userId && userRoles.Contains(SystemPolicy.Roles.BoardSupervisor)
                                    && Model.CurrentStatusName == StatusConstants.StockProcessingSession.Open)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary btn-edit-result"
                                                title="Edit result"
                                                data-bs-toggle="modal" data-bs-target="#editResultModal"
                                                data-id="@r.Id"
                                                data-fit="@r.FitValue.ToString("F0")"
                                                data-unfitshred="@r.UnFitShredValue.ToString("F0")"
                                                data-fitshred="@r.FitShredValue.ToString("F0")"
                                                data-canceled="@r.CanceledValue.ToString("F0")"
                                                data-reissue="@r.ReissueValue.ToString("F0")">
                                            <i class="ti ti-pencil"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                            rn++;
                        }
                    </tbody>
                </table>
            </div>
        } else
        {
            <div class="text-center py-4 text-muted">
                <i class="ti ti-exchange-off d-block mb-2" style="font-size:2rem;opacity:.3;"></i>
                <p class="small mb-0">No results recorded for this session</p>
            </div>
        }

        @* ── Save result form (hidden when a pending/unverified result exists) ── *@
        @*@if (hasUnverified)
        {
            <div class="px-4 py-3 border-top d-flex align-items-center gap-3">
                <div class="rounded d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:32px;height:32px;background:rgba(255,193,7,.12);">
                    <i class="ti ti-lock" style="color:#997404;font-size:.9rem;"></i>
                </div>
                <div>
                    <p class="fw-semibold mb-0 small" style="color:#997404;">New result submission is locked</p>
                    <p class="text-muted mb-0 small">A pending result already exists. Edit it above or wait for it to be verified before submitting a new one.</p>
                </div>
            </div>
        }*@
        @if (!hasUnverified && Model.BoardSupervisorUserId == userId && userRoles.Contains(SystemPolicy.Roles.BoardSupervisor)
                && Model.CurrentStatusName == StatusConstants.StockProcessingSession.Open)
        {
            <div class="p-4 @(Model.Results.Any() ? "border-top" : "")">
                <div class="d-flex align-items-center gap-2 mb-3 border-top pt-3">
                    <i class="ti ti-plus-circle" style="color:#31316A;font-size:1.1rem;"></i>
                    <h6 class="fw-bold mb-0" style="color:#31316A;">Save New Result</h6>
                </div>

                <form asp-action="SaveResult" asp-controller="StockProcessingSession" method="post" id="resultForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="SessionId" value="@Model.Id" />

                    <div class="row g-3">
                        @* <div class="col-12">
                            <p class="small fw-semibold mb-0" style="color:#31316A;">
                                <i class="ti ti-@(Model.IsManual ? "hand" : "cpu") me-1"></i>@(Model.IsManual ? "Manual" : "Machine") Processing Fields
                                @if (!Model.IsManual && !string.IsNullOrEmpty(Model.MachineName))
                                {
                                    <span class="text-muted fw-normal">— @Model.MachineName</span>
                                }
                            </p>
                        </div> *@
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold small" style="color:#31316A;">Reissue Value</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light" style="font-size:.72rem;font-weight:600;">UGX</span>
                                <input type="text" inputmode="numeric" class="form-control num-input calc-source" data-role="reissue" name="ReissueValue" autocomplete="off" />
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold small" style="color:#31316A;">Cancelled Value</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light" style="font-size:.72rem;font-weight:600;">UGX</span>
                                <input type="text" inputmode="numeric" class="form-control num-input calc-source" data-role="canceled" name="CanceledValue" autocomplete="off" />
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold small text-muted">
                                Unprocessed Value
                                <span class="badge bg-secondary-subtle text-secondary border ms-1" style="font-size:.6rem;">Money With Boards · Auto-calculated</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light" style="font-size:.72rem;font-weight:600;">UGX</span>
                                <input type="text" class="form-control bg-light" data-role="calc-unprocessed" readonly value="0" tabindex="-1" />
                            </div>
                            <div class="form-text text-danger d-none" data-role="negative-warning">
                                <i class="ti ti-alert-triangle me-1"></i>Cannot exceed Total Issued Value — Unprocessed Value cannot be less than 0.
                            </div>
                        </div>

                        @if (!Model.IsManual)
                        {
                            <div class="col-12">
                                <hr class="my-1" />
                            </div>

                            <p class="small fw-semibold mb-0" style="color:#31316A;">
                                <i class="ti ti-@(Model.IsManual ? "hand" : "cpu") me-1"></i>Machine Processing Fields
                                @if (!string.IsNullOrEmpty(Model.MachineName))
                                {
                                    <span class="text-muted fw-normal">— @Model.MachineName</span>
                                }
                            </p>

                            @* Import machine results straight off the BPS drop folder — optional; the
                               three value fields below stay keyable when nothing is imported. *@
                            <div class="col-12">
                                @await Html.PartialAsync("_BpsXmlImportPanel", "save")
                            </div>

                            @* Machine-only fields, four across one line *@
                            <div class="col-12 col-md-3">
                                <label class="form-label fw-semibold small text-muted">
                                    Count
                                    <span class="badge bg-secondary-subtle text-secondary border ms-1" style="font-size:.6rem;">Auto</span>
                                </label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light"><i class="ti ti-hash"></i></span>
                                    <input type="text" class="form-control bg-light" data-role="calc-count" readonly value="0" tabindex="-1" />
                                </div>
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label fw-semibold small" style="color:#31316A;">Fit Value</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text" style="background:#e3f2fd;font-size:.72rem;font-weight:600;color:#1565c0;">UGX</span>
                                    <input type="text" inputmode="numeric" class="form-control num-input calc-source" data-role="fit" name="FitValue" placeholder="0" value="0" autocomplete="off" />
                                </div>
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label fw-semibold small" style="color:#31316A;">UnFit Shred Value</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text" style="background:#e3f2fd;font-size:.72rem;font-weight:600;color:#1565c0;">UGX</span>
                                    <input type="text" inputmode="numeric" class="form-control num-input calc-source" data-role="unfitshred" name="UnFitShredValue" placeholder="0" value="0" autocomplete="off" />
                                </div>
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label fw-semibold small" style="color:#31316A;">Fit / Shred Value</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text" style="background:#e3f2fd;font-size:.72rem;font-weight:600;color:#1565c0;">UGX</span>
                                    <input type="text" inputmode="numeric" class="form-control num-input calc-source" data-role="fitshred" name="FitShredValue" placeholder="0" value="0" autocomplete="off" />
                                </div>
                            </div>
                        }

                        <div class="col-12">
                            <hr class="my-2" />
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <p class="small fw-semibold mb-0" style="color:#31316A;">
                                    <i class="ti ti-exchange me-1"></i>Different Denominations Found
                                    <span class="text-muted fw-normal small ms-1">(optional)</span>
                                </p>
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="addSaveDenomRowBtn">
                                    <i class="ti ti-plus me-1"></i>Add Row
                                </button>
                            </div>
                            <div id="saveDenomRows"></div>
                        </div>

                        <div class="col-12">
                            <hr class="my-2" />
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <p class="small fw-semibold mb-0" style="color:#31316A;">
                                    <i class="ti ti-users me-1"></i>Note Examiners
                                    <span class="text-danger">*</span>
                                    <span class="text-muted fw-normal small ms-1">
                                        @(Model.IsManual ? "who worked this board, and bundles each processed — required" : "who worked this board — required")
                                    </span>
                                </p>
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="addSaveNoteExaminerRowBtn">
                                    <i class="ti ti-plus me-1"></i>Add Examiner
                                </button>
                            </div>
                            @if (!Model.AvailableNoteExaminers.Any())
                            {
                                <div class="alert alert-warning py-2 px-3 small mb-0">
                                    <i class="ti ti-alert-triangle me-1"></i>No Note Examiners are configured for this branch. Contact an administrator.
                                </div>
                            }
                            <div id="saveNoteExaminerRows"></div>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 pt-1">
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="resultResetBtn">
                                <i class="ti ti-refresh me-1"></i>Reset
                            </button>
                            <button type="submit" class="btn btn-sm btn-primary fw-semibold" data-role="submit-result">
                                <i class="ti ti-send me-1"></i>Save Result
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        }
    </div>
</div>

@* ── Edit Result Modal ──────────────────────────────────────────── *@
<div class="modal fade" id="editResultModal" tabindex="-1" aria-labelledby="editResultModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header" style="border-top:3px solid #31316A;border-radius:.5rem .5rem 0 0;">
                <div class="d-flex align-items-center gap-2">
                    <span class="section-icon"><i class="ti ti-pencil" style="color:#31316A;font-size:.9rem;"></i></span>
                    <div>
                        <h6 class="fw-bold mb-0" style="color:#31316A;" id="editResultModalLabel">Edit Processing Result</h6>
                        <p class="text-muted mb-0 small">Changes will overwrite the existing pending result.</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form asp-action="EditResult" asp-controller="StockProcessingSession" method="post" id="editResultForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editResultId" />
                <input type="hidden" name="SessionId" value="@Model.Id" />

                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <p class="small fw-semibold mb-0" style="color:#31316A;">
                                <i class="ti ti-@(Model.IsManual ? "hand" : "cpu") me-1"></i>@(Model.IsManual ? "Manual" : "Machine") Processing Fields
                                @if (!Model.IsManual && !string.IsNullOrEmpty(Model.MachineName))
                                {
                                    <span class="text-muted fw-normal">— @Model.MachineName</span>
                                }
                            </p>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold small" style="color:#31316A;">Reissue Value</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light" style="font-size:.72rem;font-weight:600;">UGX</span>
                                <input type="text" inputmode="numeric" class="form-control num-input-modal calc-source" data-role="reissue" id="editReissue" name="ReissueValue" placeholder="0" autocomplete="off" />
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold small" style="color:#31316A;">Canceled Value</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light" style="font-size:.72rem;font-weight:600;">UGX</span>
                                <input type="text" inputmode="numeric" class="form-control num-input-modal calc-source" data-role="canceled" id="editCanceled" name="CanceledValue" placeholder="0" autocomplete="off" />
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold small text-muted">
                                Unprocessed Value
                                <span class="badge bg-secondary-subtle text-secondary border ms-1" style="font-size:.6rem;">Money With Boards</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light" style="font-size:.72rem;font-weight:600;">UGX</span>
                                <input type="text" class="form-control bg-light" data-role="calc-unprocessed" readonly value="0" tabindex="-1" />
                            </div>
                            <div class="form-text text-danger d-none" data-role="negative-warning">
                                <i class="ti ti-alert-triangle me-1"></i>Cannot exceed Total Issued Value — Unprocessed Value cannot be less than 0.
                            </div>
                        </div>

                        @if (!Model.IsManual)
                        {
                            <div class="col-12">
                                <hr class="my-1" />
                            </div>

                            <p class="small fw-semibold mb-0" style="color:#31316A;">
                                <i class="ti ti-cpu me-1"></i>Machine Processing Fields
                                @if (!string.IsNullOrEmpty(Model.MachineName))
                                {
                                    <span class="text-muted fw-normal">— @Model.MachineName</span>
                                }
                            </p>

                            @* Import machine results straight off the BPS drop folder — optional; the
                               three value fields below stay keyable when nothing is imported. *@
                            <div class="col-12">
                                @await Html.PartialAsync("_BpsXmlImportPanel", "edit")
                            </div>

                            @* Machine-only fields, four across one line *@
                            <div class="col-12 col-md-3">
                                <label class="form-label fw-semibold small text-muted">
                                    Count
                                    <span class="badge bg-secondary-subtle text-secondary border ms-1" style="font-size:.6rem;">Auto-calculated</span>
                                </label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light"><i class="ti ti-hash"></i></span>
                                    <input type="text" class="form-control bg-light" data-role="calc-count" readonly value="0" tabindex="-1" />
                                </div>
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label fw-semibold small" style="color:#31316A;">Fit Value</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text" style="background:#e3f2fd;font-size:.72rem;font-weight:600;color:#1565c0;">UGX</span>
                                    <input type="text" inputmode="numeric" class="form-control num-input-modal calc-source" data-role="fit" id="editFit" name="FitValue" placeholder="0" autocomplete="off" />
                                </div>
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label fw-semibold small" style="color:#31316A;">UnFit Shred Value</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text" style="background:#e3f2fd;font-size:.72rem;font-weight:600;color:#1565c0;">UGX</span>
                                    <input type="text" inputmode="numeric" class="form-control num-input-modal calc-source" data-role="unfitshred" id="editUnFitShred" name="UnFitShredValue" placeholder="0" autocomplete="off" />
                                </div>
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label fw-semibold small" style="color:#31316A;">Fit / Shred Value</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text" style="background:#e3f2fd;font-size:.72rem;font-weight:600;color:#1565c0;">UGX</span>
                                    <input type="text" inputmode="numeric" class="form-control num-input-modal calc-source" data-role="fitshred" id="editFitShred" name="FitShredValue" placeholder="0" autocomplete="off" />
                                </div>
                            </div>
                        }

                        <div class="col-12">
                            <hr class="my-2" />
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <p class="small fw-semibold mb-0" style="color:#31316A;">
                                    <i class="ti ti-exchange me-1"></i>Different Denominations Found
                                    <span class="text-muted fw-normal small ms-1">(optional)</span>
                                </p>
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="addEditDenomRowBtn">
                                    <i class="ti ti-plus me-1"></i>Add Row
                                </button>
                            </div>
                            <div id="editDenomRows"></div>
                        </div>

                        <div class="col-12">
                            <hr class="my-2" />
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <p class="small fw-semibold mb-0" style="color:#31316A;">
                                    <i class="ti ti-users me-1"></i>Note Examiners
                                    <span class="text-danger">*</span>
                                    <span class="text-muted fw-normal small ms-1">
                                        @(Model.IsManual ? "who worked this board, and bundles each processed — required" : "who worked this board — required")
                                    </span>
                                </p>
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="addEditNoteExaminerRowBtn">
                                    <i class="ti ti-plus me-1"></i>Add Examiner
                                </button>
                            </div>
                            @if (!Model.AvailableNoteExaminers.Any())
                            {
                                <div class="alert alert-warning py-2 px-3 small mb-0">
                                    <i class="ti ti-alert-triangle me-1"></i>No Note Examiners are configured for this branch. Contact an administrator.
                                </div>
                            }
                            <div id="editNoteExaminerRows"></div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light border-top">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="ti ti-x me-1"></i>Cancel
                    </button>
                    <button type="submit" class="btn btn-sm btn-primary fw-semibold" data-role="submit-result">
                        <i class="ti ti-device-floppy me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Machine Result File Picker ─────────────────────────────────────
   Deliberately a sibling of the Edit Result modal rather than nested inside it, so the two stack
   cleanly when the picker is opened from within the edit form. *@
@if (!Model.IsManual)
{
    <div class="modal fade" id="xmlImportModal" tabindex="-1" aria-labelledby="xmlImportModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-header" style="border-top:3px solid #31316A;border-radius:.5rem .5rem 0 0;">
                    <div class="d-flex align-items-center gap-2">
                        <span class="section-icon"><i class="ti ti-file-import" style="color:#31316A;font-size:.9rem;"></i></span>
                        <div>
                            <h6 class="fw-bold mb-0" style="color:#31316A;" id="xmlImportModalLabel">Machine Result Files</h6>
                            <p class="text-muted mb-0 small" id="xmlImportSubtitle">
