@using VMSService.Core.Models.StockProcessingSessions
@using VMSService.Core.Models.Shared
@model StockProcessingSessionDetailsViewModel

@{
    ViewData["Title"] = "Session Details";
    var statusColor = Model.CurrentStatusName switch
    {
        "Draft"         => "info",
        "Issued To Board" => "primary",
        "Open"          => "warning",
        "Closed"        => "success",
        _               => "secondary"
    };
}

<style>
    .session-stat-card {
        border: 1.5px solid #e9ecef;
        border-radius: .75rem;
        padding: 1rem 1.25rem;
        background: #fff;
        transition: box-shadow .15s;
    }
    .session-stat-card:hover { box-shadow: 0 2px 8px rgba(49,49,106,.08); }
    .stat-label {
        font-size: .68rem;
        font-weight: 600;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: #6c757d;
        margin-bottom: .25rem;
    }
    .stat-value {
        font-size: 1rem;
        font-weight: 700;
        color: #31316A;
    }
    .stat-sub { font-size: .75rem; color: #6c757d; }
    .bag-chip {
        display: inline-flex; flex-direction: column;
        padding: .25rem .6rem; border-radius: .4rem;
        font-size: .72rem; background: #e3f2fd;
        color: #0d47a1; border: 1.5px solid #90caf9;
        vertical-align: top;
    }
    .bag-chip-ref { font-weight: 700; font-size: .73rem; }
    .bag-chip-meta { font-size: .63rem; opacity: .8; }
    .section-card {
        border: 0;
        border-radius: .75rem;
        box-shadow: 0 1px 6px rgba(0,0,0,.07);
    }
    .section-card-header {
        background: #fff;
        border-bottom: 1px solid #e9ecef;
        border-top: 3px solid #31316A;
        border-radius: .75rem .75rem 0 0;
        padding: .75rem 1.25rem;
    }
    .section-icon {
        width: 32px; height: 32px;
        background: rgba(49,49,106,.08);
        border-radius: .4rem;
        display: inline-flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
</style>

@* ── Page Header ─────────────────────────────────────────────────── *@
<div class="d-flex align-items-start justify-content-between mb-4 gap-3 flex-wrap">
    <div class="d-flex align-items-center gap-3">
        <a asp-controller="StockProcessingPlan" asp-action="Details" asp-route-id="@Model.StockProcessingPlanId"
           class="btn btn-sm btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i>Back to Plan
        </a>
        <div>
            <p class="text-muted small mb-0">Processing Session</p>
            <h4 class="fw-bold mb-0" style="color:#31316A;">@Model.ReferenceNumber</h4>
        </div>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="badge bg-@statusColor px-3 py-2 rounded-pill fs-small">
            <i class="ti ti-badge me-1"></i>@Model.CurrentStatusName
        </span>
        @if (Model.IsCompleted)
        {
            <span class="badge bg-success px-3 py-2 rounded-pill fs-small">
                <i class="ti ti-circle-check me-1"></i>Completed
            </span>
        }
        else
        {
            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fs-small">
                <i class="ti ti-clock me-1"></i>Incomplete
            </span>
        }
        @if (Model.IsManual)
        {
            <span class="badge bg-light border text-secondary px-3 py-2 rounded-pill fs-small">
                <i class="ti ti-hand me-1"></i>Manual
            </span>
        }
        else
        {
            <span class="badge bg-light border text-secondary px-3 py-2 rounded-pill fs-small">
                <span><i class="ti ti-cpu me-1"></i>Machine</span>
                <span class="badge bg-light" style="color:#31316A;border-color:#dee2e6!important;">
                    @Model.MachineName
                </span>
            </span>
        }
    </div>
</div>

@* ── Summary Stats ──────────────────────────────────────────────── *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="session-stat-card">
            <div class="stat-label">Processing Board</div>
            <div class="stat-value">@(Model.ProcessingBoardName ?? "—")</div>
            @if (!string.IsNullOrEmpty(Model.CountingRoomName))
            {
                <div class="stat-sub"><i class="ti ti-door me-1"></i>@Model.CountingRoomName</div>
            }
            @if (!string.IsNullOrEmpty(Model.SupervisorName))
            {
                <div class="stat-sub mt-1">
                    <i class="ti ti-user-check me-1"></i>
                    <span class="fw-semibold" style="color:#31316A;">@Model.SupervisorName</span>
                </div>
            }
            else
            {
                <div class="stat-sub mt-1 text-danger">
                    <i class="ti ti-user-x me-1"></i>No supervisor assigned
                </div>
            }
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="session-stat-card">
            <div class="stat-label">Commercial Bank</div>
            <div class="stat-value">@(Model.CommercialBankName ?? "—")</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="session-stat-card">
            <div class="stat-label">Denomination</div>
            <div class="stat-value">
                @if (Model.DenominationValue > 0)
                {
                    <text>UGX @Model.DenominationValue.ToString("N0")</text>
                }
                else
                {
                    <text>—</text>
                }
            </div>
            @if (!string.IsNullOrEmpty(Model.DenominationName))
            {
                <div class="stat-sub">@Model.DenominationName</div>
            }
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="session-stat-card">
            <div class="stat-label">Total Issued Value</div>
            <div class="stat-value">
                @if (Model.TotalIssuedValue > 0)
                {
                    <text>UGX @Model.TotalIssuedValue.ToString("N0")</text>
                }
                else
                {
                    <text>—</text>
                }
            </div>
            <div class="stat-sub">@Model.Bags.Count bag@(Model.Bags.Count == 1 ? "" : "s") assigned</div>
        </div>
    </div>
</div>

@* ── Assigned Bags ──────────────────────────────────────────────── *@
<div class="card section-card mb-4">
    <div class="card-header d-flex align-items-center gap-2 py-2">
        <span class="section-icon"><i class="ti ti-packages" style="color:#31316A;font-size:.9rem;"></i></span>
        <div>
            <h6 class="fw-bold mb-0" style="color:#31316A;">Assigned Bags</h6>
            <span class="small text-muted">@Model.Bags.Count bag@(Model.Bags.Count == 1 ? "" : "s") in this session</span>
        </div>
    </div>
    <div class="card-body p-0">
        @if (!Model.Bags.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="ti ti-package-off d-block mb-2" style="font-size:2.5rem;opacity:.35;"></i>
                <p class="small mb-0">No bags assigned to this session</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover small mb-0">
                    <thead style="background:#f8fafc;">
                        <tr>
                            <th class="ps-4 py-2 text-muted fw-semibold" style="font-size:.72rem;letter-spacing:.04em;">BAG REFERENCE</th>
                            <th class="py-2 text-muted fw-semibold" style="font-size:.72rem;letter-spacing:.04em;">SUB-CATEGORY</th>
                            <th class="py-2 text-muted fw-semibold" style="font-size:.72rem;letter-spacing:.04em;">DENOMINATION</th>
                            <th class="py-2 text-muted fw-semibold" style="font-size:.72rem;letter-spacing:.04em;">BUNDLES</th>
                            <th class="py-2 pe-4 text-muted fw-semibold text-end" style="font-size:.72rem;letter-spacing:.04em;">TOTAL VALUE</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bag in Model.Bags)
                        {
                            <tr>
                                <td class="ps-4 py-2">
                                    <a asp-controller="Bagging" asp-action="Details" asp-route-id="@bag.BagId"
                                       class="fw-semibold text-decoration-none" style="color:#31316A;">
                                        <i class="ti ti-package me-1 text-muted" style="font-size:.7rem;"></i>@bag.ReferenceNumber
                                    </a>
                                </td>
                                <td class="py-2">
                                    @if (!string.IsNullOrEmpty(bag.SubCategoryName))
                                    {
                                        <span class="badge bg-light border text-secondary">@bag.SubCategoryName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="py-2">
                                    @if (bag.DenominationValue > 0)
                                    {
                                        <span class="fw-semibold">UGX @bag.DenominationValue.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="py-2">@bag.TotalBundles</td>
                                <td class="py-2 pe-4 text-end fw-semibold">
                                    @if (bag.TotalAmount > 0)
                                    {
                                        <text>@bag.TotalAmount.ToString("N0")</text>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot style="background:#f8fafc;border-top:2px solid #dee2e6;">
                        <tr>
                            <td colspan="3" class="ps-4 py-2 fw-semibold text-muted" style="font-size:.8rem;">TOTALS</td>
                            <td class="py-2 fw-bold" style="color:#31316A;">@Model.Bags.Sum(b => b.TotalBundles) bdls</td>
                            <td class="py-2 pe-4 text-end fw-bold" style="color:#31316A;">
                                UGX @Model.Bags.Sum(b => b.TotalAmount).ToString("N0")
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>

@* ── Workflow Attachments ───────────────────────────────────────── *@
@await Html.PartialAsync("_WorkflowAttachments", Model.AllAttachments)

@* ── Workflow Comments ──────────────────────────────────────────── *@
@{
    var statusHistoryViewModel = Model.StatusHistory?.Select(h => new StatusHistoryViewModel
    {
        OldStatusName = h.OldStatusName,
        NewStatusName = h.NewStatusName,
        ChangedBy = h.ChangedBy,
        ChangedAt = h.ChangedAt,
        Remarks = h.Remarks,
        Attachments = h.AttachmentFiles ?? new List<VMSService.Core.Models.Attachments.AttachmentViewModel>()
    }).ToList() ?? new List<StatusHistoryViewModel>();
}
@await Html.PartialAsync("_WorkflowComments", statusHistoryViewModel)

@* ── Workflow Actions ───────────────────────────────────────────── *@
@{
    var workflowActionsViewModel = new WorkflowActionsViewModel
    {
        EntityId = Model.Id,
        ControllerName = "StockProcessingSession",
        AvailableTransitions = Model.AvailableTransitions ?? new List<WorkflowService.Client.Dto.WorkflowTransitionDto>(),
        IsValid = true
    };
}
@await Html.PartialAsync("_WorkflowActions", workflowActionsViewModel)

@section Scripts {
    @await Html.PartialAsync("_WorkflowActionsScript")
}
