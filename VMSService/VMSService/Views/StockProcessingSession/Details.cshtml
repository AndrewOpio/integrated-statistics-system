@* ── Different Denominations ────────────────────────────────────── *@
@{
    var denominations = ViewBag.Denominations as IEnumerable<VMSService.Core.Services.Stocks.StockEntities.Denomination>
                        ?? Enumerable.Empty<VMSService.Core.Services.Stocks.StockEntities.Denomination>();
    var denomJson = System.Text.Json.JsonSerializer.Serialize(
        denominations.Select(d => new { d.Id, d.Name, d.Value }));
}
@if (Model.DifferentDenoms.Any())
{
    <div class="card section-card mb-4">
        <div class="p-4 d-flex align-items-center gap-2 py-2">
            <span class="section-icon"><i class="ti ti-exchange" style="color:#31316A;font-size:.9rem;"></i></span>
            <div class="flex-grow-1">
                <h6 class="fw-bold mb-0" style="color:#31316A;">Different Denominations Found</h6>
                <span class="small text-muted">Unexpected denominations discovered during processing</span>
            </div>
        </div>

        <div class="card-body p-0">
            @if (TempData["DifferentDenomSuccess"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mx-3 mt-3 mb-3" role="alert">
                    <i class="ti ti-circle-check me-2"></i>@TempData["DifferentDenomSuccess"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @* ── Saved entries table ── *@
            @if (Model.DifferentDenoms.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover small mb-0">
                        <thead style="background:#f8fafc;">
                            <tr>
                                <th class="ps-4 py-2 text-muted fw-semibold" style="font-size:.7rem;letter-spacing:.05em;">#</th>
                                <th class="py-2 text-muted fw-semibold" style="font-size:.7rem;letter-spacing:.05em;">DENOMINATION</th>
                                <th class="py-2 text-muted fw-semibold" style="font-size:.7rem;letter-spacing:.05em;">PIECES</th>
                                <th class="py-2 pe-4 text-muted fw-semibold text-end" style="font-size:.7rem;letter-spacing:.05em;">TOTAL VALUE</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int ddn = 1;
                            }
                            @foreach (var dd in Model.DifferentDenoms)
                            {
                                <tr>
                                    <td class="ps-4 py-2 text-muted">@ddn</td>
                                    <td class="py-2">
                                        <span class="fw-semibold">@(dd.DenominationName ?? $"ID {dd.DenominationId}")</span>
                                        @if (dd.DenominationValue > 0)
                                        {
                                            <span class="text-muted small ms-1">(UGX @dd.DenominationValue.ToString("N0"))</span>
                                        }
                                    </td>
                                    <td class="py-2 fw-semibold">@dd.NumberOfPieces.ToString("N0")</td>
                                    <td class="py-2 pe-4 text-end fw-semibold" style="color:#31316A;">
                                        UGX @((dd.DenominationValue * dd.NumberOfPieces).ToString("N0"))
                                    </td>
                                </tr>
                                ddn++;
                            }
                        </tbody>
                        <tfoot style="background:#f8fafc;border-top:2px solid #dee2e6;">
                            <tr>
                                <td colspan="2" class="ps-4 py-2 fw-semibold text-muted" style="font-size:.8rem;">TOTAL</td>
                                <td class="py-2 fw-bold" style="color:#31316A;">@Model.DifferentDenoms.Sum(d => d.NumberOfPieces).ToString("N0")</td>
                                <td class="py-2 pe-4 text-end fw-bold" style="color:#31316A;">
                                    UGX @Model.DifferentDenoms.Sum(d => d.DenominationValue * d.NumberOfPieces).ToString("N0")
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="ti ti-exchange-off d-block mb-2" style="font-size:2rem;opacity:.3;"></i>
                    <p class="small mb-0">No different denominations recorded for this session</p>
                </div>
            }
        </div>
    </div>
}

@* ── Note Examiners ────────────────────────────────────────────── *@
@if (Model.NoteExaminers.Any())
{
    <div class="card section-card mb-4">
        <div class="p-4 d-flex align-items-center gap-2 py-2">
            <span class="section-icon"><i class="ti ti-users" style="color:#31316A;font-size:.9rem;"></i></span>
            <div class="flex-grow-1">
                <h6 class="fw-bold mb-0" style="color:#31316A;">Note Examiners</h6>
                <span class="small text-muted">Examiners who worked this board and the bundles each processed</span>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover small mb-0">
                    <thead style="background:#f8fafc;">
                        <tr>
                            <th class="ps-4 py-2 text-muted fw-semibold" style="font-size:.7rem;letter-spacing:.05em;">#</th>
                            <th class="py-2 text-muted fw-semibold" style="font-size:.7rem;letter-spacing:.05em;">NOTE EXAMINER</th>
                            @if (Model.IsManual)
                            {
                                <th class="py-2 pe-4 text-muted fw-semibold text-end" style="font-size:.7rem;letter-spacing:.05em;">BUNDLES</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int nen = 1;
                        }
                        @foreach (var ne in Model.NoteExaminers)
                        {
                            <tr>
                                <td class="ps-4 py-2 text-muted">@nen</td>
                                <td class="py-2 fw-semibold">@(ne.NoteExaminerName ?? $"Examiner {ne.NoteExaminerId}")</td>
                                @if (Model.IsManual)
                                {
                                    <td class="py-2 pe-4 text-end fw-semibold" style="color:#31316A;">@ne.NumberOfBundles.ToString("N0")</td>
                                }
                            </tr>
                            nen++;
                        }
                    </tbody>
                    <tfoot style="background:#f8fafc;border-top:2px solid #dee2e6;">
                        <tr>
                            <td colspan="2" class="ps-4 py-2 fw-semibold text-muted" style="font-size:.8rem;">TOTAL</td>
                            <td class="py-2 pe-4 text-end fw-bold" style="color:#31316A;">@Model.NoteExaminers.Sum(n => n.NumberOfBundles).ToString("N0")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}

@* ── Surplus / Shortage ─────────────────────────────────────────── *@
@if (Model.SurplusShortages.Any())
{
    <div class="card section-card mb-4">
        <div class="p-4 d-flex align-items-center gap-2 py-2">
            <span class="section-icon">
                @if (Model.SurplusShortages.Any(s => s.IsSurplus))
                {
                    <i class="ti ti-trending-up" style="color:#31316A;font-size:.9rem;"></i>
                }
                else if (Model.SurplusShortages.Any(s => !s.IsSurplus))
                {
                    <i class="ti ti-trending-down" style="color:#31316A;font-size:.9rem;"></i>
                }
                else
                {
                    <i class="ti ti-scale" style="color:#31316A;font-size:.9rem;"></i>
                }
            </span>
            <div class="flex-grow-1">
                <h6 class="fw-bold mb-0" style="color:#31316A;">Surplus / Shortage</h6>
                <span class="small text-muted">Discrepancies between processing results and issued value</span>
            </div>
            @if (Model.SurplusShortages.Any())
            {
                <span class="badge @(Model.SurplusShortages.Last().IsSurplus ? "bg-success" : "bg-danger") px-3 py-1 rounded-pill">
                    @(Model.SurplusShortages.Last().IsSurplus ? "Surplus" : "Shortage")
                </span>
            }
        </div>

        <div class="card-body p-0">
            @if (!Model.SurplusShortages.Any())
            {
                <div class="text-center py-4 text-muted">
                    <i class="ti ti-scale d-block mb-2" style="font-size:2rem;opacity:.3;"></i>
                    <p class="small mb-0">No surplus or shortage recorded — results balance with issued value</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover small mb-0">
                        <thead style="background:#f8fafc;">
                            <tr>
                                <th class="ps-4 py-2 text-muted fw-semibold" style="font-size:.7rem;letter-spacing:.05em;">#</th>
                                <th class="py-2 text-muted fw-semibold" style="font-size:.7rem;letter-spacing:.05em;">TYPE</th>
                                <th class="py-2 text-muted fw-semibold" style="font-size:.7rem;letter-spacing:.05em;">DENOMINATION</th>
                                <th class="py-2 text-muted fw-semibold" style="font-size:.7rem;letter-spacing:.05em;">COMMERCIAL BANK</th>
                                <th class="py-2 text-muted fw-semibold" style="font-size:.7rem;letter-spacing:.05em;">STATUS</th>
                                <th class="py-2 text-muted fw-semibold text-end" style="font-size:.7rem;letter-spacing:.05em;">AMOUNT</th>
                                <th class="py-2 pe-4 text-muted fw-semibold text-center" style="font-size:.7rem;letter-spacing:.05em;width:60px;">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int ssn = 1;
                            }
                            @foreach (var ss in Model.SurplusShortages)
                            {
                                <tr>
                                    <td class="ps-4 py-2 text-muted">@ssn</td>
                                    <td class="py-2">
                                        @if (ss.IsSurplus)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size:.68rem;">
                                                <i class="ti ti-trending-up me-1"></i>Surplus
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size:.68rem;">
                                                <i class="ti ti-trending-down me-1"></i>Shortage
                                            </span>
                                        }
                                    </td>
                                    <td class="py-2">
                                        <span class="fw-semibold">@(ss.DenominationName ?? $"ID {ss.DenominationId}")</span>
                                        @if (ss.DenominationValue > 0)
                                        {
                                            <span class="text-muted small ms-1">(UGX @ss.DenominationValue.ToString("N0"))</span>
                                        }
                                    </td>
                                    <td class="py-2">@(ss.CommercialBankName ?? $"Bank {ss.CommercialBankId}")</td>
                                    <td class="py-2">
                                        @if (!string.IsNullOrEmpty(ss.CurrentStatusName))
                                        {
                                            <span class="badge bg-info"><i class="ti ti-badge me-1"></i>@ss.CurrentStatusName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="py-2 text-end fw-bold" style="color:@(ss.IsSurplus ? "#198754" : "#dc3545");">
                                        UGX @ss.Amount.ToString("N0")
                                    </td>
                                    <td class="py-2 pe-4 text-center">
                                        <a asp-controller="BoardSessionSurplusShortages" asp-action="Details" asp-route-id="@ss.Id"
                                           class="btn btn-sm btn-outline-info" title="View CFB Request">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                                ssn++;
                            }
                        </tbody>
                        @if (Model.SurplusShortages.Count > 1)
                        {
                            <tfoot style="background:#f8fafc;border-top:2px solid #dee2e6;">
                                <tr>
                                    <td colspan="5" class="ps-4 py-2 fw-semibold text-muted" style="font-size:.8rem;">NET</td>
                                    <td class="py-2 text-end fw-bold" style="color:#31316A;">
                                        @{
                                            var netSurplus = Model.SurplusShortages.Where(s => s.IsSurplus).Sum(s => s.Amount);
                                            var netShortage = Model.SurplusShortages.Where(s => !s.IsSurplus).Sum(s => s.Amount);
                                            var net = netSurplus - netShortage;
                                        }
                                        @(net >= 0 ? "+" : "")UGX @net.ToString("N0")
                                    </td>
                                    <td class="pe-4"></td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            }
        </div>
    </div>
}

@* ── Penalties ──────────────────────────────────────────────────── *@
@await Html.PartialAsync("_PenaltiesSection", Model)

@* ── Workflow Attachments ───────────────────────────────────────── *@
@await Html.PartialAsync("_WorkflowAttachments", Model.AllAttachments)

@* ── Workflow Comments ──────────────────────────────────────────── *@
@{
    var statusHistoryViewModel = Model.StatusHistory?.Select(h => new StatusHistoryViewModel
    {
        OldStatusName = h.OldStatusName,
        NewStatusName = h.NewStatusName,
        ChangedBy = h.ChangedBy,
        ChangedAt = h.ChangedAt,
        Remarks = h.Remarks,
        Attachments = h.AttachmentFiles ?? new List<VMSService.Core.Models.Attachments.AttachmentViewModel>()
    }).ToList() ?? new List<StatusHistoryViewModel>();
}
@await Html.PartialAsync("_WorkflowComments", statusHistoryViewModel)

@* ── Workflow Actions ───────────────────────────────────────────── *@
@{
    var workflowActionsViewModel = new WorkflowActionsViewModel
    {
        EntityId = Model.Id,
        ControllerName = "StockProcessingSession",
        AvailableTransitions = Model.AvailableTransitions ?? new List<WorkflowService.Client.Dto.WorkflowTransitionDto>(),
        IsValid = true
    };
}
@if (Model.BoardSupervisorUserId == userId || userRoles.Contains(SystemPolicy.Roles.VerificationOfficer))
{
    @await Html.PartialAsync("_WorkflowActionsWithDisclaimer", workflowActionsViewModel)
}

@if (Model.ApplicablePenalties.Any())
{
    @await Html.PartialAsync("_PenaltiesModal", Model)
}

@section Scripts {
    @await Html.PartialAsync("_WorkflowActionsScript")
    <script>
        (function () {
            // ── Comma formatter helpers ──────────────────────────────────────
            function applyFormat(input) {
                var raw = input.value.replace(/[^0-9]/g, '');
                if (raw === '') { input.value = ''; return; }
                input.value = parseInt(raw, 10).toLocaleString('en-US');
            }

            function stripCommas(input) {
                input.value = input.value.replace(/,/g, '');
            }

            function wireNumInput(el) {
                applyFormat(el);
                el.addEventListener('input', function () {
                    var selStart = this.selectionStart;
                    var rawBefore = this.value.substring(0, selStart).replace(/,/g, '').length;
                    applyFormat(this);
                    var digits = 0, newPos = 0;
                    for (var i = 0; i < this.value.length; i++) {
                        if (this.value[i] !== ',') digits++;
                        if (digits === rawBefore) { newPos = i + 1; break; }
                    }
                    this.setSelectionRange(newPos, newPos);
                });
                el.addEventListener('keydown', function (e) {
                    var allowed = ['Backspace', 'Delete', 'ArrowLeft', 'ArrowRight', 'Home', 'End', 'Tab'];
                    if (allowed.includes(e.key) || e.ctrlKey || e.metaKey) return;
                    if (!/^[0-9]$/.test(e.key)) e.preventDefault();
                });
            }

            // ── Auto-calculated Count / Unprocessed Value ─────────────────────
            var SESSION_TOTAL_ISSUED = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TotalIssuedValue));
            var SESSION_DENOM_VALUE = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DenominationValue));
            var SESSION_IS_MANUAL = @Html.Raw(Model.IsManual ? "true" : "false");
            // Shortages count as processed (add); surpluses were over-counted in what was reported as processed (subtract).
            // Only records the CFB has confirmed as balanced are counted.
            var SESSION_SURPLUS_SHORTAGE_ADJUSTMENT = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.SurplusShortages.Where(s => !s.IsSurplus && s.CurrentStatusName == StatusConstants.BoardSessionSurplusShortage.BalancedByCFB).Sum(s => s.Amount)
                - Model.SurplusShortages.Where(s => s.IsSurplus && s.CurrentStatusName == StatusConstants.BoardSessionSurplusShortage.BalancedByCFB).Sum(s => s.Amount)));

            function parseNum(el) {
                if (!el) return 0;
                var raw = (el.value || '').replace(/,/g, '');
                var n = parseFloat(raw);
                return isNaN(n) ? 0 : n;
            }

            function formatCalc(el, value) {
                if (!el) return;
                el.value = Math.round(value).toLocaleString('en-US');
            }

            function recalcResultFields(scope) {
                var reissueEl     = scope.querySelector('[data-role="reissue"]');
                var canceledEl    = scope.querySelector('[data-role="canceled"]');
                var fitEl         = scope.querySelector('[data-role="fit"]');
                var unFitShredEl  = scope.querySelector('[data-role="unfitshred"]');
                var fitShredEl    = scope.querySelector('[data-role="fitshred"]');
                var countEl       = scope.querySelector('[data-role="calc-count"]');
                var unprocEl      = scope.querySelector('[data-role="calc-unprocessed"]');
                var warningEl     = scope.querySelector('[data-role="negative-warning"]');
                var submitEl      = scope.querySelector('[data-role="submit-result"]');

                var processedTotal = parseNum(reissueEl) + parseNum(canceledEl) + parseNum(fitShredEl);
                // Count is the machine's piece count: the fit/unfit-shred/fit-shred values over face value.
                var countTotal = parseNum(fitEl) + parseNum(unFitShredEl) + parseNum(fitShredEl);
                var count = SESSION_DENOM_VALUE > 0 ? countTotal / SESSION_DENOM_VALUE : 0;
                var unprocessed = SESSION_TOTAL_ISSUED - processedTotal;
                var isNegative = unprocessed < 0;

                formatCalc(countEl, count);
                formatCalc(unprocEl, unprocessed);

                if (unprocEl) unprocEl.classList.toggle('text-danger', isNegative);
                if (warningEl) warningEl.classList.toggle('d-none', !isNegative);
                if (submitEl) submitEl.disabled = isNegative;
            }

            // ── Shared denomination row helpers ──────────────────────────────
            var DENOMS = @Html.Raw(denomJson);
            var EXISTING_DENOMS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.DifferentDenoms.Select(d => new { d.DenominationId, d.NumberOfPieces })));
            var EXISTING_NOTE_EXAMINERS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.NoteExaminers.Select(ne => new { ne.NoteExaminerId, ne.NumberOfBundles })));

            function buildDenomOptions(selectedId) {
                return DENOMS.map(function (d) {
                    var sel = selectedId && d.Id === selectedId ? ' selected' : '';
                    return '<option value="' + d.Id + '" data-value="' + d.Value + '"' + sel + '>' + d.Name + '</option>';
                }).join('');
            }

            function recalcDenomRow(row) {
                var sel    = row.querySelector('.denom-select');
                var pieces = parseInt(row.querySelector('.pieces-input').value.replace(/,/g, ''), 10) || 0;
                var opt    = sel.options[sel.selectedIndex];
                var val    = opt ? parseFloat(opt.dataset.value || '0') : 0;
                var total  = val * pieces;
                row.querySelector('.calc-value').textContent = pieces > 0 && val > 0
                    ? 'UGX ' + total.toLocaleString('en-US') : '—';
            }

            function addDenomRow(container, namePrefix, rowIdx, preData) {
                var div = document.createElement('div');
                div.className = 'denom-row row g-2 align-items-center mb-2';
                var selectedId = preData ? preData.DenominationId : null;
                div.innerHTML =
                    '<div class="col-12 col-md-5">' +
                        '<label class="form-label fw-semibold small mb-1" style="color:#31316A;">Denomination</label>' +
                        '<select name="' + namePrefix + '[' + rowIdx + '].DenominationId" class="form-select form-select-sm denom-select" required>' +
                            '<option value="">— select denomination —</option>' +
                            buildDenomOptions(selectedId) +
                        '</select>' +
                    '</div>' +
                    '<div class="col-6 col-md-3">' +
                        '<label class="form-label fw-semibold small mb-1" style="color:#31316A;">Pieces</label>' +
                        '<input type="text" inputmode="numeric" name="' + namePrefix + '[' + rowIdx + '].NumberOfPieces" ' +
                               'class="form-control form-control-sm pieces-input" placeholder="0" required autocomplete="off" />' +
                    '</div>' +
                    '<div class="col-6 col-md-3">' +
                        '<label class="form-label fw-semibold small mb-1 text-muted">Value (auto)</label>' +
                        '<div class="form-control form-control-sm bg-light text-muted calc-value" style="font-size:.8rem;">—</div>' +
                    '</div>' +
                    '<div class="col-auto d-flex align-items-end pb-1">' +
                        '<button type="button" class="btn btn-sm btn-outline-danger remove-row-btn" title="Remove row">' +
                            '<i class="ti ti-trash"></i>' +
                        '</button>' +
                    '</div>';

                container.appendChild(div);

                if (preData && preData.NumberOfPieces) {
                    div.querySelector('.pieces-input').value =
                        parseInt(preData.NumberOfPieces, 10).toLocaleString('en-US');
                }

                recalcDenomRow(div);

                var sel    = div.querySelector('.denom-select');
                var pieces = div.querySelector('.pieces-input');

                sel.addEventListener('change', function () { recalcDenomRow(div); });

                pieces.addEventListener('input', function () {
                    var raw = this.value.replace(/[^0-9]/g, '');
                    var pos = this.selectionStart;
                    var digBefore = this.value.substring(0, pos).replace(/,/g, '').length;
                    this.value = raw ? parseInt(raw, 10).toLocaleString('en-US') : '';
                    var digits = 0, newPos = 0;
                    for (var i = 0; i < this.value.length; i++) {
                        if (this.value[i] !== ',') digits++;
                        if (digits === digBefore) { newPos = i + 1; break; }
                    }
                    this.setSelectionRange(newPos, newPos);
                    recalcDenomRow(div);
                });

                pieces.addEventListener('keydown', function (e) {
                    var nav = ['Backspace', 'Delete', 'ArrowLeft', 'ArrowRight', 'Home', 'End', 'Tab'];
                    if (nav.includes(e.key) || e.ctrlKey || e.metaKey) return;
                    if (!/^[0-9]$/.test(e.key)) e.preventDefault();
                });

                div.querySelector('.remove-row-btn').addEventListener('click', function () {
                    container.removeChild(div);
                });
            }

            // ── Note Examiner row helpers ─────────────────────────────────────
            var NOTE_EXAMINERS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.AvailableNoteExaminers.Select(ne => new { ne.Id, ne.Name })));

            function buildNoteExaminerOptions(selectedId, excludeIds) {
                return NOTE_EXAMINERS.map(function (ne) {
                    if (excludeIds && excludeIds.indexOf(ne.Id) !== -1 && ne.Id !== selectedId) return '';
                    var sel = selectedId && ne.Id === selectedId ? ' selected' : '';
                    return '<option value="' + ne.Id + '"' + sel + '>' + ne.Name + '</option>';
                }).join('');
            }

            function getSelectedNoteExaminerIds(container, exceptSelect) {
                var ids = [];
                container.querySelectorAll('.ne-examiner-select').forEach(function (sel) {
                    if (sel === exceptSelect) return;
                    var v = parseInt(sel.value, 10);
                    if (v) ids.push(v);
                });
                return ids;
            }

            function refreshNoteExaminerOptions(container) {
                container.querySelectorAll('.ne-examiner-select').forEach(function (sel) {
                    var currentVal = sel.value ? parseInt(sel.value, 10) : null;
                    var excludeIds = getSelectedNoteExaminerIds(container, sel);
                    sel.innerHTML = '<option value="">— select examiner —</option>' +
                        buildNoteExaminerOptions(currentVal, excludeIds);
                });
            }

            function addNoteExaminerRow(container, namePrefix, rowIdx, preData) {
                var div = document.createElement('div');
                // align-items-end keeps the Remove button on the same baseline as the inputs, which
                // sit below their labels — align-items-center would float it up the row instead.
                div.className = 'row g-2 align-items-end mb-2';
                var selectedId = preData ? preData.NoteExaminerId : null;
                var excludeIds = getSelectedNoteExaminerIds(container, null);

                if (SESSION_IS_MANUAL) {
                    div.innerHTML =
                        '<div class="col-12 col-md-7">' +
                            '<label class="form-label fw-semibold small mb-1" style="color:#31316A;">Note Examiner</label>' +
                            '<select name="' + namePrefix + '[' + rowIdx + '].NoteExaminerId" class="form-select form-select-sm ne-examiner-select" required>' +
                                '<option value="">— select examiner —</option>' +
                                buildNoteExaminerOptions(selectedId, excludeIds) +
                            '</select>' +
                        '</div>' +
                        '<div class="col-8 col-md-3">' +
                            '<label class="form-label fw-semibold small mb-1" style="color:#31316A;">Bundles</label>' +
                            '<input type="text" inputmode="numeric" name="' + namePrefix + '[' + rowIdx + '].NumberOfBundles" ' +
                                   'class="form-control form-control-sm ne-bundles-input" placeholder="0" required autocomplete="off" />' +
                        '</div>' +
                        '<div class="col-4 col-md-2 d-flex align-items-end mb-1">' +
                            '<button type="button" class="btn btn-sm btn-outline-danger remove-row-btn" title="Remove row">' +
                                '<i class="ti ti-trash"></i>' +
                            '</button>' +
                        '</div>';
                } else {
                    div.innerHTML =
                        '<div class="col-10 col-md-10">' +
                            '<label class="form-label fw-semibold small mb-1" style="color:#31316A;">Note Examiner</label>' +
                            '<select name="' + namePrefix + '[' + rowIdx + '].NoteExaminerId" class="form-select form-select-sm ne-examiner-select" required>' +
                                '<option value="">— select examiner —</option>' +
                                buildNoteExaminerOptions(selectedId, excludeIds) +
                            '</select>' +
                        '</div>' +
                        '<input type="hidden" name="' + namePrefix + '[' + rowIdx + '].NumberOfBundles" value="0" />' +
                        '<div class="col-2 col-md-2 d-flex align-items-end mb-1">' +
                            '<button type="button" class="btn btn-sm btn-outline-danger remove-row-btn" title="Remove row">' +
                                '<i class="ti ti-trash"></i>' +
                            '</button>' +
                        '</div>';
                }

                container.appendChild(div);

                var bundlesInput = div.querySelector('.ne-bundles-input');

                if (bundlesInput) {
                    if (preData && preData.NumberOfBundles) {
                        bundlesInput.value = parseInt(preData.NumberOfBundles, 10).toLocaleString('en-US');
                    }

                    bundlesInput.addEventListener('input', function () {
                        var raw = this.value.replace(/[^0-9]/g, '');
                        var pos = this.selectionStart;
                        var digBefore = this.value.substring(0, pos).replace(/,/g, '').length;
                        this.value = raw ? parseInt(raw, 10).toLocaleString('en-US') : '';
                        var digits = 0, newPos = 0;
                        for (var i = 0; i < this.value.length; i++) {
                            if (this.value[i] !== ',') digits++;
                            if (digits === digBefore) { newPos = i + 1; break; }
                        }
                        this.setSelectionRange(newPos, newPos);
                    });

                    bundlesInput.addEventListener('keydown', function (e) {
                        var nav = ['Backspace', 'Delete', 'ArrowLeft', 'ArrowRight', 'Home', 'End', 'Tab'];
                        if (nav.includes(e.key) || e.ctrlKey || e.metaKey) return;
                        if (!/^[0-9]$/.test(e.key)) e.preventDefault();
                    });
                }

                var examinerSelect = div.querySelector('.ne-examiner-select');
                examinerSelect.addEventListener('change', function () {
                    refreshNoteExaminerOptions(container);
                });

                div.querySelector('.remove-row-btn').addEventListener('click', function () {
                    container.removeChild(div);
                    refreshNoteExaminerOptions(container);
                });
            }

            // ── Save form ────────────────────────────────────────────────────
            var resultForm = document.getElementById('resultForm');
            if (resultForm) {
                resultForm.querySelectorAll('.num-input').forEach(wireNumInput);
                resultForm.querySelectorAll('.calc-source').forEach(function (el) {
                    el.addEventListener('input', function () { recalcResultFields(resultForm); });
                });
                recalcResultFields(resultForm);

                var saveDenomContainer = document.getElementById('saveDenomRows');
                var saveDenomRowIdx = 0;
                var addSaveDenomBtn = document.getElementById('addSaveDenomRowBtn');
                if (addSaveDenomBtn && saveDenomContainer) {
                    addSaveDenomBtn.addEventListener('click', function () {
                        addDenomRow(saveDenomContainer, 'DifferentDenomEntries', saveDenomRowIdx++, null);
                    });
                }

                var saveNoteExaminerContainer = document.getElementById('saveNoteExaminerRows');
                var saveNoteExaminerRowIdx = 0;
                var addSaveNoteExaminerBtn = document.getElementById('addSaveNoteExaminerRowBtn');
                if (addSaveNoteExaminerBtn && saveNoteExaminerContainer) {
                    addSaveNoteExaminerBtn.addEventListener('click', function () {
                        addNoteExaminerRow(saveNoteExaminerContainer, 'NoteExaminerEntries', saveNoteExaminerRowIdx++, null);
                    });
                }

                resultForm.addEventListener('submit', function (e) {
                    if (saveNoteExaminerContainer && saveNoteExaminerContainer.children.length === 0) {
                        e.preventDefault();
                        alert('Please capture at least one Note Examiner and the bundles they processed before saving.');
                        return;
                    }

                    this.querySelectorAll('.num-input').forEach(stripCommas);
                    if (saveDenomContainer) {
                        saveDenomContainer.querySelectorAll('.pieces-input').forEach(stripCommas);
                    }
                    if (saveNoteExaminerContainer) {
                        saveNoteExaminerContainer.querySelectorAll('.ne-bundles-input').forEach(stripCommas);
                    }
                });

                var resetBtn = document.getElementById('resultResetBtn');
                if (resetBtn) {
                    resetBtn.addEventListener('click', function () {
                        resultForm.querySelectorAll('.num-input').forEach(function (el) {
                            el.value = '0';
                            applyFormat(el);
                        });
                        if (saveDenomContainer) saveDenomContainer.innerHTML = '';
                        saveDenomRowIdx = 0;
                        if (saveNoteExaminerContainer) saveNoteExaminerContainer.innerHTML = '';
                        saveNoteExaminerRowIdx = 0;
                        recalcResultFields(resultForm);
                    });
                }
            }

            // ── Edit modal ───────────────────────────────────────────────────
            var editModal = document.getElementById('editResultModal');
            var editForm  = document.getElementById('editResultForm');

            if (editModal && editForm) {
                editForm.querySelectorAll('.num-input-modal').forEach(wireNumInput);
                editForm.querySelectorAll('.calc-source').forEach(function (el) {
                    el.addEventListener('input', function () { recalcResultFields(editForm); });
                });

                var editDenomContainer = document.getElementById('editDenomRows');
                var editDenomRowIdx = 0;
                var addEditDenomBtn = document.getElementById('addEditDenomRowBtn');
                if (addEditDenomBtn && editDenomContainer) {
                    addEditDenomBtn.addEventListener('click', function () {
                        addDenomRow(editDenomContainer, 'DifferentDenomEntries', editDenomRowIdx++, null);
                    });
                }

                var editNoteExaminerContainer = document.getElementById('editNoteExaminerRows');
                var editNoteExaminerRowIdx = 0;
                var addEditNoteExaminerBtn = document.getElementById('addEditNoteExaminerRowBtn');
                if (addEditNoteExaminerBtn && editNoteExaminerContainer) {
                    addEditNoteExaminerBtn.addEventListener('click', function () {
                        addNoteExaminerRow(editNoteExaminerContainer, 'NoteExaminerEntries', editNoteExaminerRowIdx++, null);
                    });
                }

                editModal.addEventListener('show.bs.modal', function (e) {
                    var btn = e.relatedTarget;
                    if (!btn) return;

                    document.getElementById('editResultId').value = btn.dataset.id;

                    var setVal = function (id, raw) {
                        var el = document.getElementById(id);
                        if (!el) return;
                        el.value = raw || '0';
                        applyFormat(el);
                    };

                    setVal('editCanceled',   btn.dataset.canceled);
                    setVal('editReissue',    btn.dataset.reissue);
                    setVal('editFit',        btn.dataset.fit);
                    setVal('editUnFitShred', btn.dataset.unfitshred);
                    setVal('editFitShred',   btn.dataset.fitshred);

                    recalcResultFields(editForm);

                    if (editDenomContainer) {
                        editDenomContainer.innerHTML = '';
                        editDenomRowIdx = 0;
                        EXISTING_DENOMS.forEach(function (d) {
                            addDenomRow(editDenomContainer, 'DifferentDenomEntries', editDenomRowIdx++, d);
                        });
                    }

                    if (editNoteExaminerContainer) {
                        editNoteExaminerContainer.innerHTML = '';
                        editNoteExaminerRowIdx = 0;
                        EXISTING_NOTE_EXAMINERS.forEach(function (ne) {
                            addNoteExaminerRow(editNoteExaminerContainer, 'NoteExaminerEntries', editNoteExaminerRowIdx++, ne);
                        });
                    }
                });

                editForm.addEventListener('submit', function (e) {
                    if (editNoteExaminerContainer && editNoteExaminerContainer.children.length === 0) {
                        e.preventDefault();
                        alert('Please capture at least one Note Examiner and the bundles they processed before saving.');
                        return;
                    }

                    this.querySelectorAll('.num-input-modal').forEach(stripCommas);
                    if (editDenomContainer) {
                        editDenomContainer.querySelectorAll('.pieces-input').forEach(stripCommas);
                    }
                    if (editNoteExaminerContainer) {
                        editNoteExaminerContainer.querySelectorAll('.ne-bundles-input').forEach(stripCommas);
                    }
                });
            }

            // ── BPS machine result import ────────────────────────────────────
            // Files picked here replace the three machine value fields and are re-read server-side
            // on submit. With nothing picked the fields stay editable and behave exactly as before.
            var xmlModalEl = document.getElementById('xmlImportModal');

            if (xmlModalEl && !SESSION_IS_MANUAL) {
                var SESSION_ID    = @Model.Id;
                var FILES_URL     = '@Url.Action("AvailableMachineFiles", "StockProcessingSession")';
                var xmlModal      = new bootstrap.Modal(xmlModalEl);
                var xmlRows       = document.getElementById('xmlImportRows');
                var xmlLoading    = document.getElementById('xmlImportLoading');
                var xmlMessage    = document.getElementById('xmlImportMessage');
                var xmlTableWrap  = document.getElementById('xmlImportTableWrap');
                var xmlApplyBtn   = document.getElementById('xmlImportApplyBtn');
                var xmlSelSummary = document.getElementById('xmlImportSelectionSummary');

                // Files currently attached, per form.
                var xmlState  = { save: [], edit: [] };
                var xmlScope  = 'save';

                function money(n) { return Math.round(n || 0).toLocaleString('en-US'); }

                function panelFor(scope) {
                    return document.querySelector('[data-role="xml-panel"][data-scope="' + scope + '"]');
                }

                function formFor(scope) {
                    return scope === 'edit' ? editForm : resultForm;
                }

                // Imported figures are authoritative, so the inputs go read-only while files are
                // attached; clearing the selection hands them back to the operator.
                function applyMachineValues(scope) {
                    var form = formFor(scope);
                    if (!form) return;

                    var files   = xmlState[scope];
                    var hasFiles = files.length > 0;
                    var sum = function (key) {
                        return files.reduce(function (t, f) { return t + (f[key] || 0); }, 0);
                    };

                    [['fit', 'fitValue'], ['unfitshred', 'unFitShredValue'], ['fitshred', 'fitShredValue']]
                        .forEach(function (pair) {
                            var el = form.querySelector('[data-role="' + pair[0] + '"]');
                            if (!el) return;

                            if (hasFiles) {
                                el.value = String(sum(pair[1]));
                                applyFormat(el);
                                el.readOnly = true;
                                el.classList.add('bg-light');
                                el.title = 'Imported from the selected machine result files';
                            } else {
                                el.readOnly = false;
                                el.classList.remove('bg-light');
                                el.removeAttribute('title');
                            }
                        });

                    recalcResultFields(form);
                }

                function renderPanel(scope) {
                    var panel = panelFor(scope);
                    if (!panel) return;

                    var files    = xmlState[scope];
                    var chips    = panel.querySelector('[data-role="xml-chips"]');
                    var inputs   = panel.querySelector('[data-role="xml-inputs"]');
                    var summary  = panel.querySelector('[data-role="xml-summary"]');
                    var totals   = panel.querySelector('[data-role="xml-totals"]');
                    var clearBtn = panel.querySelector('[data-role="xml-clear"]');

                    chips.innerHTML  = '';
                    inputs.innerHTML = '';

                    if (!files.length) {
                        summary.classList.add('d-none');
                        clearBtn.classList.add('d-none');
                        applyMachineValues(scope);
                        return;
                    }

                    files.forEach(function (f) {
                        var chip = document.createElement('span');
                        chip.className = 'badge rounded-pill text-bg-light border d-inline-flex align-items-center gap-1';
                        chip.style.fontWeight = '500';

                        var label = document.createElement('span');
                        label.innerHTML = '<i class="ti ti-file-text me-1"></i>' + f.displayName;
                        chip.appendChild(label);

                        var remove = document.createElement('button');
                        remove.type = 'button';
                        remove.className = 'btn-close ms-1';
                        remove.style.fontSize = '.5rem';
                        remove.title = 'Remove this file';
                        remove.addEventListener('click', function () {
                            xmlState[scope] = xmlState[scope].filter(function (o) {
                                return o.fileName !== f.fileName;
                            });
                            renderPanel(scope);
                        });
                        chip.appendChild(remove);

                        chips.appendChild(chip);

                        // What the form actually posts — the server re-reads these by name.
                        var hidden = document.createElement('input');
                        hidden.type  = 'hidden';
                        hidden.name  = 'SelectedXmlFiles';
                        hidden.value = f.fileName;
                        inputs.appendChild(hidden);
                    });

                    var pieces = files.reduce(function (t, f) { return t + (f.totalPieces || 0); }, 0);
                    var value  = files.reduce(function (t, f) { return t + (f.totalValue || 0); }, 0);
                    totals.innerHTML = '<i class="ti ti-calculator me-1"></i>' + files.length +
                        ' file' + (files.length === 1 ? '' : 's') + ' · ' + money(pieces) +
                        ' pieces · <strong>UGX ' + money(value) + '</strong>';

                    summary.classList.remove('d-none');
                    clearBtn.classList.remove('d-none');
                    applyMachineValues(scope);
                }

                // detail is rendered via textContent so a server-supplied string can never inject markup.
                function showMessage(html, cssClass, detail) {
                    xmlLoading.classList.add('d-none');
                    xmlTableWrap.classList.add('d-none');
                    xmlMessage.className = 'p-4 text-center small ' + (cssClass || 'text-muted');
                    xmlMessage.innerHTML = html;

                    if (detail) {
                        var d = document.createElement('div');
                        d.className = 'text-muted mt-2';
                        d.style.fontSize = '.72rem';
                        d.textContent = detail;
                        xmlMessage.appendChild(d);
                    }

                    xmlMessage.classList.remove('d-none');
                    xmlApplyBtn.disabled = true;
                    xmlSelSummary.textContent = '';
                }

                function updateSelectionSummary() {
                    var checked = xmlRows.querySelectorAll('input[type="checkbox"]:checked');
                    var pieces = 0, value = 0;

                    checked.forEach(function (cb) {
                        var f = JSON.parse(cb.dataset.file);
                        pieces += f.totalPieces || 0;
                        value  += f.totalValue || 0;
                    });

                    xmlSelSummary.innerHTML = checked.length
                        ? checked.length + ' selected · ' + money(pieces) + ' pieces · <strong>UGX ' + money(value) + '</strong>'
                        : 'No files selected — the machine fields stay as keyed in.';
                }

                function renderRows(files) {
                    xmlRows.innerHTML = '';
                    var attached = xmlState[xmlScope].map(function (f) { return f.fileName; });

                    files.forEach(function (f, i) {
                        var tr = document.createElement('tr');
                        var id = 'xmlFile_' + i;
                        var isChecked = attached.indexOf(f.fileName) !== -1 || f.isAlreadyLinked;

                        tr.innerHTML =
                            '<td class="text-center">' +
                                '<input class="form-check-input" type="checkbox" id="' + id + '"' +
                                    (isChecked ? ' checked' : '') + '>' +
                            '</td>' +
                            '<td>' +
                                '<label class="form-check-label d-block" for="' + id + '" style="cursor:pointer;">' +
                                    '<span class="fw-semibold small d-block">' + f.displayName + '</span>' +
                                    '<span class="text-muted" style="font-size:.68rem;word-break:break-all;">' + f.fileName + '</span>' +
                                    (f.isMissingOnDisk
                                        ? '<span class="badge text-bg-warning ms-1" style="font-size:.6rem;">no longer on disk</span>'
                                        : '') +
                                    (f.rejectPieces
                                        ? '<span class="badge text-bg-light border ms-1" style="font-size:.6rem;">' +
                                          money(f.rejectPieces) + ' rejects excluded</span>'
                                        : '') +
                                '</label>' +
                            '</td>' +
                            '<td class="text-end small">' + money(f.fitValue) + '</td>' +
                            '<td class="text-end small">' + money(f.unFitShredValue) + '</td>' +
                            '<td class="text-end small">' + money(f.fitShredValue) + '</td>' +
                            '<td class="text-end small fw-semibold">' + money(f.totalPieces) + '</td>';

                        var cb = tr.querySelector('input[type="checkbox"]');
                        cb.dataset.file = JSON.stringify(f);
                        cb.addEventListener('change', updateSelectionSummary);

                        xmlRows.appendChild(tr);
                    });

                    xmlLoading.classList.add('d-none');
                    xmlMessage.classList.add('d-none');
                    xmlTableWrap.classList.remove('d-none');
                    xmlApplyBtn.disabled = false;
                    updateSelectionSummary();
                }

                function openPicker(scope) {
                    xmlScope = scope;

                    xmlLoading.classList.remove('d-none');
                    xmlMessage.classList.add('d-none');
                    xmlTableWrap.classList.add('d-none');
                    xmlApplyBtn.disabled = true;
                    xmlSelSummary.textContent = '';
                    xmlModal.show();

                    var url = FILES_URL + '?sessionId=' + SESSION_ID;
                    if (scope === 'edit') {
                        var resultIdEl = document.getElementById('editResultId');
                        if (resultIdEl && resultIdEl.value) url += '&resultId=' + resultIdEl.value;
                    }

                    fetch(url, { headers: { 'Accept': 'application/json' } })
                        .then(function (r) {
                            if (r.ok) return r.json();

                            // Surface why it failed rather than always blaming the folder — a signed-out
                            // session, a missing permission and a server fault each need a different fix.
                            if (r.status === 401 || r.status === 403) {
                                throw new Error('You are not permitted to import machine results for this session, ' +
                                                'or your sign-in has expired.');
                            }
                            return r.text().then(function (body) {
                                console.error('AvailableMachineFiles responded', r.status, body);
                                var parsed = null;
                                try { parsed = JSON.parse(body); } catch (ignored) { }
                                throw new Error((parsed && parsed.error)
                                    ? parsed.error
                                    : 'The server returned ' + r.status + (r.statusText ? ' ' + r.statusText : '') + '.');
                            });
                        })
                        .then(function (data) {
                            if (data.error) throw new Error(data.error);

                            if (!data.files || !data.files.length) {
                                showMessage(
                                    '<i class="ti ti-folder-off d-block mb-2" style="font-size:1.5rem;"></i>' +
                                    'No unimported result files were found for machine <strong>' +
                                    (data.machineName || '—') + '</strong> at this denomination.');
                                return;
                            }
                            renderRows(data.files);
                        })
                        .catch(function (err) {
                            console.error('Could not load machine result files', err);
                            showMessage(
                                '<i class="ti ti-alert-triangle d-block mb-2" style="font-size:1.5rem;"></i>' +
                                '<span class="d-block">Could not load the machine result files.</span>' +
                                '<span class="d-block text-muted mt-1" style="font-size:.72rem;">' +
                                'You can still key the values in by hand.</span>',
                                'text-danger',
                                err && err.message ? err.message : '');
                        });
                }

                document.querySelectorAll('[data-role="xml-open"]').forEach(function (btn) {
                    btn.addEventListener('click', function () { openPicker(btn.dataset.scope); });
                });

                document.querySelectorAll('[data-role="xml-clear"]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        xmlState[btn.dataset.scope] = [];
                        renderPanel(btn.dataset.scope);
                    });
                });

                xmlApplyBtn.addEventListener('click', function () {
                    xmlState[xmlScope] = Array.prototype.map.call(
                        xmlRows.querySelectorAll('input[type="checkbox"]:checked'),
                        function (cb) { return JSON.parse(cb.dataset.file); });

                    renderPanel(xmlScope);
                    xmlModal.hide();
                });

                // Editing starts from whatever the result was saved with, so its files come back
                // attached rather than the operator having to re-pick them.
                if (editModal) {
                    editModal.addEventListener('show.bs.modal', function (e) {
                        var btn = e.relatedTarget;
                        if (!btn) return;

                        xmlState.edit = [];
                        renderPanel('edit');

                        fetch(FILES_URL + '?sessionId=' + SESSION_ID + '&resultId=' + btn.dataset.id,
                              { headers: { 'Accept': 'application/json' } })
                            .then(function (r) { return r.ok ? r.json() : null; })
                            .then(function (data) {
                                if (!data || !data.files) return;
                                xmlState.edit = data.files.filter(function (f) { return f.isAlreadyLinked; });
                                renderPanel('edit');
                            })
                            .catch(function (err) {
                                console.error('Could not load imported machine files for this result', err);
                            });
                    });
                }

                renderPanel('save');
            }
        })();
    </script>
}
