@model VMSService.Data.Entities.PackingListRange

@{
    ViewData["Title"] = "Delete Packing List Range";
    int exStockId = (int)ViewData["ExStockId"];
}

<div class="row">
    <div class="col-md-8">
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <h2 class="fs-5 fw-bold mb-0">Delete Packing List Range</h2>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="ti ti-alert-circle me-2"></i>
                    <strong>Warning!</strong> Are you sure you want to delete this packing list range? This action cannot be undone.
                </div>

                <div class="mb-4 p-3 bg-light rounded">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Case Number Prefix:</strong>
                            <p>@Model.CaseNumberPrefix</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Case Number Range:</strong>
                            <p>@Model.StartCaseNumber - @Model.EndCaseNumber</p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <strong>SN Prefix:</strong>
                            <p>@Model.SNPrefix</p>
                        </div>
                        <div class="col-md-6">
                            <strong>SN Range:</strong>
                            <p>@Model.SNRangeStart - @Model.SNRangeEnd</p>
                        </div>
                    </div>
                </div>

                <form asp-action="Delete" asp-route-id="@Model.Id" asp-route-exStockId="@exStockId" method="post">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="ti ti-trash me-1"></i>Delete
                        </button>
                        <a asp-action="Index" asp-route-exStockId="@exStockId" class="btn btn-secondary">
                            <i class="ti ti-x me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
