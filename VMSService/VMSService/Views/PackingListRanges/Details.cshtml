@model ICollection<VMSService.Data.Entities.PackingListDetails>

@{
    ViewData["Title"] = "Serial Numbers";
    int exStockId = (int)ViewData["ExStockId"];
    var packingListRange = ViewData["PackingListRange"] as VMSService.Data.Entities.PackingListRange;
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h2 class="fs-5 fw-bold mb-0">Serial Numbers - @packingListRange.CaseNumberPrefix Cases</h2>
                    </div>
                    <div class="col text-end">
                        <a asp-action="Index" asp-route-exStockId="@exStockId" class="btn btn-sm btn-secondary">
                            <i class="ti ti-arrow-left me-1"></i>Back
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                @if (Model.Count == 0)
                {
                    <div class="alert alert-info">
                        <i class="ti ti-info-circle me-2"></i>
                        No serial numbers found.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead style="background-color: #f8fafc; border-bottom: 2px solid #e9ecef;">
                                <tr>
                                    <th style="color: #495057; font-weight: 600; border: none; padding: 0.75rem;">#</th>
                                    <th style="color: #495057; font-weight: 600; border: none; padding: 0.75rem;">Case Number</th>
                                    <th style="color: #495057; font-weight: 600; border: none; padding: 0.75rem;">Serial Number Range</th>
                                    <th style="color: #495057; font-weight: 600; border: none; padding: 0.75rem;">Total Serials</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int rowNumber = 1;
                                }
                                @foreach (var item in Model)
                                {
                                    var fullCaseNumber = $"{packingListRange.CaseNumberPrefix}{item.CaseNumber}";
                                    var serialRangeStart = $"{packingListRange.SNPrefix}{item.SerialNoteStartNumber:D7}";
                                    var serialRangeEnd = $"{packingListRange.SNPrefix}{item.SerialNoteEndNumber:D7}";
                                    var totalSerials = item.SerialNoteEndNumber - item.SerialNoteStartNumber + 1;

                                    <tr style="border-bottom: 1px solid #f0f2f5;">
                                        <td style="border: none; padding: 0.75rem;"><span class="text-primary fw-bold">@rowNumber</span></td>
                                        <td style="border: none; padding: 0.75rem;" class="fw-bold">@fullCaseNumber</td>
                                        <td style="border: none; padding: 0.75rem;">@serialRangeStart - @serialRangeEnd</td>
                                        <td style="border: none; padding: 0.75rem;">@totalSerials.ToString("N0")</td>
                                    </tr>

                                    rowNumber++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
