@model VMSService.Models.PackingListRangeBatchCreateViewModel

@{
    ViewData["Title"] = "Add Packing List Ranges";
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h2 class="fs-5 fw-bold mb-0">Add Packing List Ranges</h2>
                    </div>
                    <div class="col text-end">
                        <a asp-action="Index" asp-route-exStockId="@Model.ExStockId" class="btn btn-sm btn-secondary">
                            <i class="ti ti-list me-1"></i>View Existing Ranges
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="alert alert-info mb-4">
                    <i class="ti ti-info-circle me-2"></i>
                    Add multiple rows here, then save them together.
                </div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <form asp-action="Create" method="post">
                    <input asp-for="ExStockId" type="hidden" />

                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="packing-range-table" style="border: none;">
                            <thead style="background-color: #f8fafc; border-bottom: 2px solid #e9ecef;">
                                <tr>
                                    <th style="color: #495057; font-weight: 600; border: none; padding: 0.75rem;">Denomination</th>
                                    <th style="color: #495057; font-weight: 600; border: none; padding: 0.75rem;">Case Prefix</th>
                                    <th style="color: #495057; font-weight: 600; border: none; padding: 0.75rem;">Start Case No.</th>
                                    <th style="color: #495057; font-weight: 600; border: none; padding: 0.75rem;">End Case No.</th>
                                    <th style="color: #495057; font-weight: 600; border: none; padding: 0.75rem;">SN Prefix</th>
                                    <th style="color: #495057; font-weight: 600; border: none; padding: 0.75rem;">SN Start</th>
                                    <th style="color: #495057; font-weight: 600; border: none; padding: 0.75rem;">SN End</th>
                                    <th class="text-center" style="width: 80px; color: #495057; font-weight: 600; border: none; padding: 0.75rem;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var index = 0; index < Model.Rows.Count; index++)
                                {
                                    <tr style="border-bottom: 1px solid #f0f2f5; transition: background-color 0.2s;">
                                        <td style="border: none; padding: 0.75rem;">
                                            <select class="form-select form-select-sm" name="Rows[@index].ExPrintMintDetailId" style="border: 1px solid #dee2e6; border-radius: 0.375rem;">
                                                <option value="">-- Select Denomination --</option>
                                                @foreach (var denom in (List<(int, string)>)ViewBag.Denominations)
                                                {
                                                    <option value="@denom.Item1">@denom.Item2</option>
                                                }
                                            </select>
                                        </td>
                                        <td style="border: none; padding: 0.75rem;"><input asp-for="Rows[index].CaseNumberPrefix" class="form-control form-control-sm" style="border: 1px solid #dee2e6;" /></td>
                                        <td style="border: none; padding: 0.75rem;"><input asp-for="Rows[index].StartCaseNumber" class="form-control form-control-sm" type="number" style="border: 1px solid #dee2e6;" /></td>
                                        <td style="border: none; padding: 0.75rem;"><input asp-for="Rows[index].EndCaseNumber" class="form-control form-control-sm" type="number" style="border: 1px solid #dee2e6;" /></td>
                                        <td style="border: none; padding: 0.75rem;"><input asp-for="Rows[index].SNPrefix" class="form-control form-control-sm" style="border: 1px solid #dee2e6;" /></td>
                                        <td style="border: none; padding: 0.75rem;"><input asp-for="Rows[index].SNRangeStart" class="form-control form-control-sm" type="number" style="border: 1px solid #dee2e6;" /></td>
                                        <td style="border: none; padding: 0.75rem;"><input asp-for="Rows[index].SNRangeEnd" class="form-control form-control-sm" type="number" style="border: 1px solid #dee2e6;" /></td>
                                        <td class="text-center" style="border: none; padding: 0.75rem;">
                                            <button type="button" class="btn btn-sm btn-outline-danger remove-row" title="Remove row">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between flex-wrap gap-2 mt-3">
                        <button type="button" id="add-row" class="btn btn-outline-primary">
                            <i class="ti ti-plus me-1"></i>Add Row
                        </button>

                        <div class="d-flex gap-2">
                            <a asp-action="Index" asp-route-exStockId="@Model.ExStockId" class="btn btn-secondary">
                                <i class="ti ti-arrow-left me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i>Save All Rows
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<template id="packing-range-row-template">
    <tr style="border-bottom: 1px solid #f0f2f5; transition: background-color 0.2s;">
        <td style="border: none; padding: 0.75rem;">
            <select class="form-select form-select-sm denomination-select" name="Rows[__index__].ExPrintMintDetailId" style="border: 1px solid #dee2e6; border-radius: 0.375rem;">
                <option value="">-- Select Denomination --</option>
                @foreach (var denom in (List<(int, string)>)ViewBag.Denominations)
                {
                    <option value="@denom.Item1">@denom.Item2</option>
                }
            </select>
        </td>
        <td style="border: none; padding: 0.75rem;"><input name="Rows[__index__].CaseNumberPrefix" class="form-control form-control-sm" style="border: 1px solid #dee2e6;" /></td>
        <td style="border: none; padding: 0.75rem;"><input name="Rows[__index__].StartCaseNumber" class="form-control form-control-sm" type="number" style="border: 1px solid #dee2e6;" /></td>
        <td style="border: none; padding: 0.75rem;"><input name="Rows[__index__].EndCaseNumber" class="form-control form-control-sm" type="number" style="border: 1px solid #dee2e6;" /></td>
        <td style="border: none; padding: 0.75rem;"><input name="Rows[__index__].SNPrefix" class="form-control form-control-sm" style="border: 1px solid #dee2e6;" /></td>
        <td style="border: none; padding: 0.75rem;"><input name="Rows[__index__].SNRangeStart" class="form-control form-control-sm" type="number" style="border: 1px solid #dee2e6;" /></td>
        <td style="border: none; padding: 0.75rem;"><input name="Rows[__index__].SNRangeEnd" class="form-control form-control-sm" type="number" style="border: 1px solid #dee2e6;" /></td>
        <td class="text-center" style="border: none; padding: 0.75rem;">
            <button type="button" class="btn btn-sm btn-outline-danger remove-row" title="Remove row">
                <i class="ti ti-trash"></i>
            </button>
        </td>
    </tr>
</template>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        (() => {
            const tableBody = document.querySelector('#packing-range-table tbody');
            const addRowButton = document.getElementById('add-row');
            const rowTemplate = document.getElementById('packing-range-row-template');

            const reindexRows = () => {
                const rows = tableBody.querySelectorAll('tr');

                rows.forEach((row, index) => {
                    row.querySelectorAll('input, select').forEach(element => {
                        const currentName = element.getAttribute('name');
                        if (currentName) {
                            element.setAttribute('name', currentName.replace(/Rows\[\d+\]/, `Rows[${index}]`));
                        }
                    });
                });
            };

            addRowButton.addEventListener('click', () => {
                const rowCount = tableBody.querySelectorAll('tr').length;
                const html = rowTemplate.innerHTML.replaceAll('__index__', rowCount.toString());
                tableBody.insertAdjacentHTML('beforeend', html);
            });

            tableBody.addEventListener('click', event => {
                const removeButton = event.target.closest('.remove-row');
                if (!removeButton) {
                    return;
                }

                const rows = tableBody.querySelectorAll('tr');
                if (rows.length === 1) {
                    rows[0].querySelectorAll('input, select').forEach(element => element.value = '');
                    return;
                }

                removeButton.closest('tr')?.remove();
                reindexRows();
            });
        })();
    </script>
}

