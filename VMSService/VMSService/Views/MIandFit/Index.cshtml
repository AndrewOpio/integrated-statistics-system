@model List<VMSService.Core.Models.MIandFits.MIandFitPlanSummaryViewModel>

@{
    ViewData["Title"] = "MI & Fit";
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h2 class="fs-5 fw-bold mb-0">MI &amp; Fit</h2>
                        <p class="text-muted small mb-0 mt-1">Denominations assigned to you for reporting Returned Re-Issue / Canceled values</p>
                    </div>
                </div>
            </div>
            <div class="card-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <i class="ti ti-scale d-block mb-3 text-secondary" style="font-size:2.5rem;opacity:.4;"></i>
                        <p class="fw-semibold text-muted mb-1">No MI &amp; Fit assignments yet</p>
                        <p class="text-muted small">Denominations will appear here once a plan assigns you as Board Supervisor and is issued to boards.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-centered table-nowrap mb-0 rounded" id="miFitPlansTable">
                            <thead class="thead-light">
                                <tr>
                                    <th class="border-0 rounded-start">#</th>
                                    <th class="border-0">Plan Reference</th>
                                    <th class="border-0">Processing Date</th>
                                    <th class="border-0">Status</th>
                                    <th class="border-0">Denominations Assigned</th>
                                    <th class="border-0">Pending</th>
                                    <th class="border-0 rounded-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int rowNumber = 1;
                                }
                                @foreach (var row in Model)
                                {
                                    <tr>
                                        <td><span class="text-primary fw-bold">@rowNumber</span></td>
                                        <td class="fw-bold">@row.PlanReferenceNumber</td>
                                        <td>@row.ProcessingDate.ToString("dd MMM yyyy")</td>
                                        <td><span class="badge bg-info"><i class="ti ti-badge me-1"></i>@row.StatusName</span></td>
                                        <td>@row.DenominationCount</td>
                                        <td>
                                            @if (row.PendingCount > 0)
                                            {
                                                <span class="badge bg-warning text-dark">@row.PendingCount pending</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">All declared</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-action="Declare" asp-route-id="@row.StockProcessingPlanId"
                                               class="btn btn-sm btn-primary" title="Declare">
                                                <i class="ti ti-edit me-1"></i>Declare
                                            </a>
                                        </td>
                                        @{ rowNumber++; }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#miFitPlansTable').DataTable({ order: [[2, 'desc']] });
        });
    </script>
}
