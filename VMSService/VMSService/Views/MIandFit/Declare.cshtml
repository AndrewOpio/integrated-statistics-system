@model VMSService.Core.Models.MIandFits.MIandFitDeclareViewModel

@{
    ViewData["Title"] = "Declare MI & Fit";
}

@* Page Header *@
<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i>Back
        </a>
        <div>
            <p class="text-muted small mb-0">Declare MI &amp; Fit</p>
            <h4 class="fw-bold mb-0" style="color:#31316A;">@Model.PlanReferenceNumber</h4>
        </div>
        <span class="badge bg-primary p-2 more-rounded">
            <i class="ti ti-calendar me-1"></i>@Model.ProcessingDate.ToString("dd MMMM yyyy")
        </span>
    </div>
    <button type="button" class="btn btn-primary" onclick="submitDeclare()">
        <i class="ti ti-device-floppy me-1"></i>Submit
    </button>
</div>

@* Hidden save form *@
<form id="declareForm" asp-action="Declare" asp-route-id="@Model.StockProcessingPlanId" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" id="returnsJson" name="returnsJson" value="[]" />
</form>

<div class="card border-0 shadow">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2"
         style="background:#fff;border-top:3px solid #31316A;border-radius:.5rem .5rem 0 0;">
        <h6 class="fw-bold mb-0" style="color:#31316A;">
            <i class="ti ti-scale me-2"></i>My Denominations
        </h6>
    </div>
    <div class="card-body p-3">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0" id="declareTable">
                <thead>
                    <tr>
                        <th style="min-width:160px;">Denomination</th>
                        <th style="min-width:150px;">Issued Re-Issue</th>
                        <th style="min-width:150px;">Issued Canceled</th>
                        <th style="min-width:160px;">Returned Re-Issue</th>
                        <th style="min-width:160px;">Returned Canceled</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr data-id="@row.Id">
                            <td class="fw-semibold">
                                @row.DenominationName <span class="text-muted small">(UGX @row.DenominationValue.ToString("N0"))</span>
                            </td>
                            <td class="text-muted">UGX @row.IssuedReIssueValue.ToString("N0")</td>
                            <td class="text-muted">UGX @row.IssuedCanceledValue.ToString("N0")</td>
                            <td>
                                <input type="text" class="form-control form-control-sm returned-reissue"
                                       value="@row.ReturnedReIssueValue.ToString("0")" inputmode="decimal"
                                       oninput="declareFormatValue(this)" />
                            </td>
                            <td>
                                <input type="text" class="form-control form-control-sm returned-canceled"
                                       value="@row.ReturnedCanceledValue.ToString("0")" inputmode="decimal"
                                       oninput="declareFormatValue(this)" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function declareFormatValue(input) {
            const caret = input.selectionStart;
            const before = (input.value.slice(0, caret).match(/,/g) || []).length;
            const raw = input.value.replace(/[^0-9.]/g, '');
            const parts = raw.split('.');
            parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
            input.value = parts.length > 1 ? parts[0] + '.' + parts[1] : parts[0];
            const after = (input.value.slice(0, caret).match(/,/g) || []).length;
            input.setSelectionRange(caret + after - before, caret + after - before);
        }

        function submitDeclare() {
            const entries = [];
            document.querySelectorAll('#declareTable tbody tr').forEach(function (row) {
                const id = +row.dataset.id;
                const reissue = parseFloat(row.querySelector('.returned-reissue').value.replace(/,/g, '')) || 0;
                const canceled = parseFloat(row.querySelector('.returned-canceled').value.replace(/,/g, '')) || 0;
                entries.push({ id: id, returnedReIssueValue: reissue, returnedCanceledValue: canceled });
            });
            document.getElementById('returnsJson').value = JSON.stringify(entries);
            document.getElementById('declareForm').submit();
        }
    </script>
}
