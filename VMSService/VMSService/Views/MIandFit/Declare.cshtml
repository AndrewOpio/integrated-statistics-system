@model VMSService.Core.Models.MIandFits.MIandFitDeclareViewModel

@{
    ViewData["Title"] = "Declare MI & Fit";
}

@* Page Header *@
<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i>Back
        </a>
        <div>
            <p class="text-muted small mb-0">Declare MI &amp; Fit</p>
            <h4 class="fw-bold mb-0" style="color:#31316A;">@Model.PlanReferenceNumber</h4>
        </div>
        <span class="badge bg-primary p-2 more-rounded">
            <i class="ti ti-calendar me-1"></i>@Model.ProcessingDate.ToString("dd MMMM yyyy")
        </span>
    </div>
    <button type="button" class="btn btn-primary" onclick="submitDeclare()">
        <i class="ti ti-device-floppy me-1"></i>Submit
    </button>
</div>

@* Hidden save form *@
<form id="declareForm" asp-action="Declare" asp-route-id="@Model.StockProcessingPlanId" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" id="returnsJson" name="returnsJson" value="[]" />
</form>

<div class="card border-0 shadow">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2"
         style="background:#fff;border-top:3px solid #31316A;border-radius:.5rem .5rem 0 0;">
        <h6 class="fw-bold mb-0" style="color:#31316A;">
            <i class="ti ti-scale me-2"></i>My Denominations
        </h6>
    </div>
    <div class="card-body p-3">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0" id="declareTable">
                <thead>
                    <tr>
                        <th style="min-width:160px;">Denomination</th>
                        <th style="min-width:150px;">Issued Fit</th>
                        <th style="min-width:150px;">Issued MI</th>
                        <th style="min-width:160px;">Returned Fit</th>
                        <th style="min-width:160px;">Returned MI</th>
                        <th style="min-width:190px;">Vs. 1 Bundle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        // A bundle's value is the denomination value x 1,000 pieces — the same
                        // factor used elsewhere (e.g. StockProcessingSessionController) when
                        // converting a monetary amount to bundle-equivalent units.
                        var bundleValue = row.DenominationValue * 1000;
                        <tr data-id="@row.Id" data-bundle-value="@bundleValue.ToString("0.####")">
                            <td class="fw-semibold">
                                @row.DenominationName <span class="text-muted small">(UGX @row.DenominationValue.ToString("N0"))</span>
                            </td>
                            <td class="text-muted">UGX @row.IssuedFitValue.ToString("N0")</td>
                            <td class="text-muted">UGX @row.IssuedUnFitValue.ToString("N0")</td>
                            <td>
                                <input type="text" class="form-control form-control-sm returned-fit"
                                       value="@row.ReturnedFitValue.ToString("0")" inputmode="decimal"
                                       oninput="declareFormatValue(this); refreshVariance(this.closest('tr'));" />
                            </td>
                            <td>
                                <input type="text" class="form-control form-control-sm returned-unfit"
                                       value="@row.ReturnedUnFitValue.ToString("0")" inputmode="decimal"
                                       oninput="declareFormatValue(this); refreshVariance(this.closest('tr'));" />
                            </td>
                            <td class="variance-cell"></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function declareFormatValue(input) {
            const caret = input.selectionStart;
            const before = (input.value.slice(0, caret).match(/,/g) || []).length;
            const raw = input.value.replace(/[^0-9.]/g, '');
            const parts = raw.split('.');
            parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
            input.value = parts.length > 1 ? parts[0] + '.' + parts[1] : parts[0];
            const after = (input.value.slice(0, caret).match(/,/g) || []).length;
            input.setSelectionRange(caret + after - before, caret + after - before);
        }

        // Flags whether Returned Fit + Returned Un-Fit for a row matches the value of 1 bundle of
        // that denomination (denomination value x 1,000 pieces) — above, below, or balanced.
        function refreshVariance(tr) {
            const bundleValue = parseFloat(tr.dataset.bundleValue) || 0;
            const fit = parseFloat(tr.querySelector('.returned-fit').value.replace(/,/g, '')) || 0;
            const unfit = parseFloat(tr.querySelector('.returned-unfit').value.replace(/,/g, '')) || 0;
            const total = fit + unfit;
            const diff = total - bundleValue;
            const cell = tr.querySelector('.variance-cell');

            if (diff === 0) {
                cell.innerHTML = '<span class="badge bg-success text-white border border-success">' +
                    '<i class="ti ti-check me-1"></i>Matches bundle</span>';
            } else if (diff > 0) {
                cell.innerHTML = '<span class="badge bg-danger text-white border border-danger">' +
                    '<i class="ti ti-arrow-up me-1"></i>Above by UGX ' + diff.toLocaleString('en-US') + '</span>';
            } else {
                cell.innerHTML = '<span class="badge bg-warning text-white border border-warning">' +
                    '<i class="ti ti-arrow-down me-1"></i>Below by UGX ' + Math.abs(diff).toLocaleString('en-US') + '</span>';
            }
        }

        function submitDeclare() {
            const entries = [];
            document.querySelectorAll('#declareTable tbody tr').forEach(function (row) {
                const id = +row.dataset.id;
                const fit = parseFloat(row.querySelector('.returned-fit').value.replace(/,/g, '')) || 0;
                const unfit = parseFloat(row.querySelector('.returned-unfit').value.replace(/,/g, '')) || 0;
                entries.push({ id: id, returnedFitValue: fit, returnedUnFitValue: unfit });
            });
            document.getElementById('returnsJson').value = JSON.stringify(entries);
            document.getElementById('declareForm').submit();
        }

        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('#declareTable tbody tr').forEach(refreshVariance);
        });
    </script>
}
