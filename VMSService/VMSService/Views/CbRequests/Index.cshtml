@using System.Security.Claims
@using static VMSService.Core.Static.WithdrawConstants
@model VMSService.Core.Models.CbRequests.CbRequestsIndexViewModel

@{
    Layout = "_CbLayout";
    ViewData["Title"] = "Dashboard";

    var recentRequests = Model.RecentRequests;

    string BadgeCss(string s) => s switch
    {
        WithdrawalStatusNames.Draft => "text-bg-secondary",
        WithdrawalStatusNames.PendingVerification => "text-bg-primary",
        WithdrawalStatusNames.PendingExceptionalApproval => "text-bg-info",
        WithdrawalStatusNames.PendingApproval => "text-bg-warning",
        WithdrawalStatusNames.Approved => "text-bg-success",
        WithdrawalStatusNames.RejectExceptionalApproval => "text-bg-danger",
        WithdrawalStatusNames.ReturnedForRevision => "text-bg-secondary",
        _ => "text-bg-secondary"
    };
    string BadgeLbl(string s) => s switch
    {
        "pending_supervisor" => "Pending Supervisor",
        "with_bank" => "With Bank",
        "bank_review" => "Bank Review",
        "pending_manager" => "Pending Manager",
        "completed" => "Completed",
        "rejected" => "Rejected",
        _ => s
    };
    string BadgeIcon(string s) => s switch
    {
        "pending_supervisor" => "bi-hourglass-split",
        "with_bank" => "bi-bank",
        "bank_review" => "bi-search",
        "pending_manager" => "bi-shield-check",
        "completed" => "bi-check-circle-fill",
        "rejected" => "bi-x-circle-fill",
        _ => "bi-circle"
    };

    // A request that has already ended (approved, rejected, cancelled, recalled, expired)
    // having a past date is normal, not overdue — only flag requests still in one of the
    // four active buckets (StatusBucket is "" for anything closed).
    var today = DateOnly.FromDateTime(DateTime.Today);
    bool IsOverdue(VMSService.Core.Models.CbRequests.RecentRequestRowViewModel r) =>
        !string.IsNullOrEmpty(r.StatusBucket) && r.CollectionDate < today;
}

<div class="dash-hero mb-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h4>Welcome @User.FindFirst(ClaimTypes.Name)?.Value👋</h4>
            <p>@User.FindFirst("cbName")?.Value</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="CbWithdrawRequests" asp-action="Create"
               class="btn btn-light btn-sm fw-semibold d-flex align-items-center gap-1">
                <i class="ti ti-circle-arrow-up-right-filled text-danger"></i>Withdraw
            </a>
            <a asp-controller="CbDepositRequests" asp-action="Create"
               class="btn btn-light btn-sm fw-semibold d-flex align-items-center gap-1">
                <i class="ti ti-circle-arrow-down-left-filled text-success"></i> Deposit
            </a>
            <a asp-controller="AgentDetails" asp-action="Index"
               class="btn btn-light btn-sm fw-semibold d-flex align-items-center gap-1">
                <i class="ti ti-user-square-rounded text-purple"></i>Agent Details
            </a>
        </div>
    </div>
</div>

<!-- ── STATS ROW ── -->
<div class="row g- mb-4" id="statCardRow">
    @foreach (var (bucket, icon, color, label, val, sub) in new[] {
        ("awaiting-action",   "ti-user-exclamation", "warning",  "Awaiting Your Action",       Model.AwaitingActionCount.ToString(),           "needs a maker/approver step"),
        ("pending-exceptional","ti-star",             "info",     "Pending Exceptional Approval", Model.PendingExceptionalApprovalCount.ToString(), "same-day requests with BOU"),
        ("with-bou",           "ti-building-bank",    "primary",  "With Bank of Uganda",        Model.WithBouCount.ToString(),                  "out of your hands for now"),
        ("unsuccessful",       "ti-xbox-x",            "danger",   "Unsuccessful",               Model.UnsuccessfulCount.ToString(),             "rejected, cancelled or expired"),
        })
    {
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 stat-card" role="button" data-bucket="@bucket" onclick="filterByBucket('@bucket', this)">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small">@label</span>
                        <div class="rounded-circle d-flex align-items-center justify-content-center text-@color bg-@color bg-opacity-10"
                             style="width:32px;height:32px">
                            <i class="ti @icon"></i>
                        </div>
                    </div>
                    <div class="fw-bold fs-4 text-@color">@val</div>
                    <div class="text-muted" style="font-size:11px">@sub</div>
                </div>
            </div>
        </div>
    }
</div>


<!-- ── QUICK ACTIONS + RECENT REQUESTS ── -->
<div class="row g-4">

    <!-- Quick actions -->
    <div class="col-12 col-lg-4">
        <h6 class="fw-semibold mb-3 text-muted text-uppercase"
            style="font-size:11px;letter-spacing:.5px">
            Quick Actions
        </h6>
        <div class="row g-3">
            <div class="col-6 col-lg-12">
                <a asp-controller="CbWithdrawRequests" asp-action="Create" class="quick-card qc-withdraw">
                    <div class="qc-icon"><i class="ti ti-arrow-up-right-circle"></i></div>
                    <div>
                        <div class="qc-title">New Withdraw</div>
                        <div class="qc-sub">Submit a withdrawal request to Bank of Uganda</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-lg-12">
                <a href="/CashDeposit/Workflow" class="quick-card qc-deposit">
                    <div class="qc-icon"><i class="ti ti-arrow-down-left-circle"></i></div>
                    <div>
                        <div class="qc-title">New Deposit</div>
                        <div class="qc-sub">Submit a deposit request to Bank of Uganda</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-lg-12">
                <a asp-controller="AgentDetails" asp-action="Index" class="quick-card qc-history">
                    <div class="qc-icon"><i class="ti ti-user-square-rounded"></i></div>
                    <div>
                        <div class="qc-title">Our Agents</div>
                        <div class="qc-sub">Register agents as representatives for transacting</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-lg-12">
                <a asp-controller="CbRequests" asp-action="History" class="quick-card qc-track">
                    <div class="qc-icon"><i class="ti ti-history"></i></div>
                    <div>
                        <div class="qc-title">History</div>
                        <div class="qc-sub">Closed-out requests from the last 12 months</div>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <!-- Recent requests -->
    <div class="col-12 col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h6 class="fw-semibold mb-0 text-muted text-uppercase"
                style="font-size:11px;letter-spacing:.5px">
                Recent Requests
            </h6>
            <a asp-controller="CbRequests" asp-action="History" class="text-primary small text-decoration-none">
                History <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div id="noFilterResults" class="text-muted small d-none mb-2">
            <i class="ti ti-inbox me-1"></i>No recent requests in this bucket.
        </div>

        <div class="d-flex flex-column gap-2">
            @foreach (var r in recentRequests)
            {
                <a href="@($"/Cb{(r.Type == "Withdrawal" ? "Withdraw" : "Deposit")}Requests/Details/{r.Id}")" class="req-row-link" data-bucket="@r.StatusBucket">
                    <div class="card border shadow-sm mb-2 request-card @(IsOverdue(r) ? "border-warning bg-warning bg-opacity-10" : "")">
                        <div class="card-body py-3">
                            <div class="d-flex align-items-center gap-3">

                                @* ── Type icon ── *@
                                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0
                                @(r.Type == "Withdrawal" ? "bg-danger" : "bg-success") bg-opacity-10"
                                     style="width:44px;height:44px">
                                    <i class="ti @(r.Type == "Withdrawal" ? "ti-circle-arrow-up-right-filled text-danger" : "ti-circle-arrow-down-left-filled text-success") fs-5"></i>
                                </div>

                                @* ── Info ── *@
                                <div class="flex-grow-1 overflow-hidden">

                                    @* Top row — ref + badges *@
                                    <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                        <span class="fw-bold small">
                                            @(string.IsNullOrEmpty(r.TransactionRefNumber) ? "-" : r.TransactionRefNumber)
                                        </span>
                                        <span class="tx-pill @(r.Type == "Withdrawal" ? "tx-wd" : "tx-dep")" >
                                            <i class="ti @(r.Type == "Withdrawal" ? "ti-arrow-up-right-circle" : "ti-arrow-down-left-circle") me-1"></i>
                                            @r.Type
                                        </span>
                                        @if (r.RequiresSpecialApproval)
                                        {
                                            <span class="badge rounded-pill bg-warning text-brown bg-opacity-10">
                                                <i class="ti ti-star me-1"></i>Exceptional Approval Required
                                            </span>
                                        }
                                        @if (r.IsStalePreSubmission)
                                        {
                                            <span class="badge rounded-pill bg-danger-subtle text-danger">
                                                <i class="ti ti-calendar-exclamation me-1"></i>Collection date has passed
                                            </span>
                                        }
                                        @* @if (r.CollectionDate == DateOnly.FromDateTime(r.CreationDate))
                                        {
                                            <span class="badge rounded-pill bg-danger-subtle text-warning bg-warning bg-opacity-10">
                                                <i class="ti ti-calendar-exclamation me-1"></i>Same Day
                                            </span>
                                        } *@
                                    </div>

                                    @* Dates + bank *@
                                    <div class="text-muted small d-flex flex-wrap gap-2">
                                        <span>
                                            <i class="ti ti-building me-1"></i>
                                            @User.FindFirst("cbName")?.Value
                                        </span>
                                        <span>
                                            <i class="ti ti-calendar me-1"></i>
                                            <span class="text-muted">Created:</span>
                                            @r.CreationDate.ToString("dd MMM yyyy")
                                            <span class="text-muted mx-1"> | </span>
                                            <span class="text-muted">@(r.Type == "Withdrawal" ? "Collection Date:" : "Deposit Date:")</span>
                                            <span class="@(r.CollectionDate == DateOnly.FromDateTime(r.CreationDate) ? "text-dark fw-semibold" : "")">
                                                @r.CollectionDate.ToString("dd MMM yyyy")
                                            </span>
                                            <span class="text-muted mx-1"> | </span>
                                            <span class="text-muted">Approved:</span>
                                            ---
                                        </span>
                                    </div>
                                </div>

                                @* ── Amount + status ── *@
                                <div class="text-end flex-shrink-0">
                                    <div class="fw-bold mb-1 @(r.Type == "Withdrawal" ? "text-danger" : "text-success")">
                                        UGX @r.Amount.ToString("N0")
                                    </div>
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill">
                                        <i class="ti @BadgeIcon(r.StatusTypeName) me-1"></i>@BadgeLbl(r.StatusTypeName)
                                    </span>
                                </div>

                            </div>

                            @* ── Special approval warning strip ── *@
                            @* @if (r.RequiresSpecialApproval)
                            {
                                <div class="d-flex align-items-center gap-2 mt-2 pt-2 border-top border-warning">
                                    <i class="ti ti-alert-triangle text-warning flex-shrink-0"></i>
                                    <small class="text-warning fw-semibold">
                                        This request will require special approval before processing.
                                    </small>
                                </div>
                            } *@
                    </div>
                </div>
            </a>
            }
        </div>
    </div>

</div>

@section Scripts {
    <style>
        .stat-card { cursor: pointer; transition: box-shadow .15s ease, transform .15s ease; }
        .stat-card.active { box-shadow: 0 0 0 2px var(--bs-primary) inset; }
    </style>
    <script>
        // Clicking a stat card filters the Recent Requests feed below to that bucket.
        // Clicking the already-active card clears the filter and shows everything again.
        function filterByBucket(bucket, cardEl) {
            const isActive = cardEl.classList.contains('active');

            document.querySelectorAll('#statCardRow .stat-card').forEach(c => c.classList.remove('active'));

            const rows = document.querySelectorAll('.req-row-link');
            let visibleCount = 0;

            if (isActive) {
                rows.forEach(r => r.classList.remove('d-none'));
                visibleCount = rows.length;
            } else {
                cardEl.classList.add('active');
                rows.forEach(r => {
                    const match = r.dataset.bucket === bucket;
                    r.classList.toggle('d-none', !match);
                    if (match) visibleCount++;
                });
            }

            document.getElementById('noFilterResults').classList.toggle('d-none', visibleCount > 0);
        }
    </script>
}