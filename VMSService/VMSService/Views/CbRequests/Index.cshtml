@using System.Security.Claims

@{
    Layout = "_CbLayout";
    ViewData["Title"] = "Dashboard";

    var recentRequests = new[] {
        new { Id="WR-009", Type="Withdrawal", Amount=300000,  Status="with_bank",           Date="14 Mar 2026", Purpose="Audit team refreshments" },
        new { Id="WR-002", Type="Withdrawal", Amount=320000,  Status="pending_supervisor",  Date="11 Mar 2026", Purpose="Workshop supplies" },
        new { Id="DEP-003", Type="Deposit",   Amount=1500000, Status="completed",           Date="09 Mar 2026", Purpose="Sales collections – week 10" },
        new { Id="WR-001", Type="Withdrawal", Amount=850000,  Status="completed",           Date="10 Mar 2026", Purpose="Staff field allowances" },
        new { Id="DEP-001", Type="Deposit",   Amount=2200000, Status="rejected",            Date="05 Mar 2026", Purpose="Market collections" },
    };

    string BadgeCss(string s) => s switch
    {
        "pending_supervisor" => "text-bg-warning",
        "with_bank" => "text-bg-primary",
        "bank_review" => "text-bg-info",
        "pending_manager" => "text-bg-secondary",
        "completed" => "text-bg-success",
        "rejected" => "text-bg-danger",
        _ => "text-bg-secondary"
    };
    string BadgeLbl(string s) => s switch
    {
        "pending_supervisor" => "Pending Supervisor",
        "with_bank" => "With Bank",
        "bank_review" => "Bank Review",
        "pending_manager" => "Pending Manager",
        "completed" => "Completed",
        "rejected" => "Rejected",
        _ => s
    };
    string BadgeIcon(string s) => s switch
    {
        "pending_supervisor" => "bi-hourglass-split",
        "with_bank" => "bi-bank",
        "bank_review" => "bi-search",
        "pending_manager" => "bi-shield-check",
        "completed" => "bi-check-circle-fill",
        "rejected" => "bi-x-circle-fill",
        _ => "bi-circle"
    };

}

<div class="dash-hero mb-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h4>Welcome @User.FindFirst(ClaimTypes.Name)?.Value👋</h4>
            <p>@User.FindFirst("cbName")?.Value</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="CbWithdrawRequests" asp-action="Create"
               class="btn btn-light btn-sm fw-semibold d-flex align-items-center gap-1">
                <i class="ti ti-circle-arrow-up-right-filled text-danger"></i>Withdraw
            </a>
            <a href="/CashDeposit/Workflow"
               class="btn btn-light btn-sm fw-semibold d-flex align-items-center gap-1">
                <i class="ti ti-circle-arrow-down-left-filled text-success"></i> Deposit
            </a>
            <a asp-controller="AgentDetails" asp-action="Index"
               class="btn btn-light btn-sm fw-semibold d-flex align-items-center gap-1">
                <i class="ti ti-user-square-rounded text-info"></i>Agent Details
            </a>
        </div>
    </div>
</div>

<!-- ── STATS ROW ── -->
<div class="row g- mb-4">
    @foreach (var (icon, color, label, val, sub) in new[] {
        ("bi-file-earmark-text", "primary",  "Total Requests",  "9",  "all time"),
        ("bi-hourglass-split",   "warning",  "Pending",         "2",  "awaiting action"),
        ("bi-x-circle",          "danger",   "Rejected",        "1",  "requires resubmission"),
        })
    {
        <div class="col-6 col-md-4">
            <div class="card border-0 shadow h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small">@label</span>
                        <div class="rounded-circle d-flex align-items-center justify-content-center text-@color bg-@color bg-opacity-10"
                             style="width:32px;height:32px">
                            <i class="bi @icon"></i>
                        </div>
                    </div>
                    <div class="fw-bold fs-4 text-@color">@val</div>
                    <div class="text-muted" style="font-size:11px">@sub</div>
                </div>
            </div>
        </div>
    }
</div>


<!-- ── QUICK ACTIONS + RECENT REQUESTS ── -->
<div class="row g-4">

    <!-- Quick actions -->
    <div class="col-12 col-lg-4">
        <h6 class="fw-semibold mb-3 text-muted text-uppercase"
            style="font-size:11px;letter-spacing:.5px">
            Quick Actions
        </h6>
        <div class="row g-3">
            <div class="col-6 col-lg-12">
                <a asp-controller="CbWithdrawRequests" asp-action="Create" class="quick-card qc-withdraw">
                    <div class="qc-icon"><i class="ti ti-arrow-up-right-circle"></i></div>
                    <div>
                        <div class="qc-title">New Withdraw</div>
                        <div class="qc-sub">Submit a withdrawal request to Bank of Uganda</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-lg-12">
                <a href="/CashDeposit/Workflow" class="quick-card qc-deposit">
                    <div class="qc-icon"><i class="ti ti-arrow-down-left-circle"></i></div>
                    <div>
                        <div class="qc-title">New Deposit</div>
                        <div class="qc-sub">Submit a deposit request to Bank of Uganda</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-lg-12">
                <a href="/Company/Track" class="quick-card qc-history">
                    <div class="qc-icon"><i class="ti ti-user-square-rounded"></i></div>
                    <div>
                        <div class="qc-title">Our Agents</div>
                        <div class="qc-sub">Register agents as representatives for transacting</div>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <!-- Recent requests -->
    <div class="col-12 col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h6 class="fw-semibold mb-0 text-muted text-uppercase"
                style="font-size:11px;letter-spacing:.5px">
                Recent Requests
            </h6>
            <a href="/Company/MyRequests" class="text-primary small text-decoration-none">
                View all <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="d-flex flex-column gap-2">
            @foreach (var r in recentRequests)
            {
                <a href="/CashWithdrawal?highlight=@r.Id" class="req-row-link">
                    <div class="card border shadow-sm">
                        <div class="card-body py-3 d-flex align-items-center gap-3">

                            <!-- Type icon -->
                            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0
                                                @(r.Type == "Withdrawal" ? "bg-danger" : "bg-success") bg-opacity-10"
                                 style="width:40px;height:40px">
                                <i class="ti @(r.Type == "Withdrawal" ? "ti-circle-arrow-up-right-filled text-danger" : "ti ti-circle-arrow-down-left-filled text-success") fs-5"></i>
                            </div>

                            <!-- Info -->
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                    <span class="fw-semibold" style="font-size:14px">@r.Purpose</span>
                                    <span class="tx-pill @(r.Type == "Withdrawal" ? "tx-wd" : "tx-dep")">
                                        <i class="ti @(r.Type == "Withdrawal" ? "ti ti ti-arrow-up-right-circle" : "ti ti ti-arrow-down-left-circle")"></i>
                                        @r.Type
                                    </span>
                                </div>
                                <div class="text-muted d-flex gap-3 flex-wrap" style="font-size:12px">
                                    <span><i class="bi bi-hash"></i> @r.Id</span>
                                    <span><i class="bi bi-calendar3"></i> @r.Date</span>
                                </div>
                            </div>

                            <!-- Amount + status -->
                            <div class="text-end flex-shrink-0">
                                <div class="fw-bold mb-1">UGX @r.Amount.ToString("N0")</div>
                                <span class="badge @BadgeCss(r.Status) rounded-pill">
                                    <i class="ti @BadgeIcon(r.Status) me-1"></i>@BadgeLbl(r.Status)
                                </span>
                            </div>

                        </div>
                    </div>
                </a>
            }
        </div>
    </div>

</div>