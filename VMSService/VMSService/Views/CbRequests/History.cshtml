@model List<VMSService.Core.Models.CbRequests.RecentRequestRowViewModel>

@{
    Layout = "_CbLayout";
    ViewData["Title"] = "History";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h5 class="mb-1">Request History</h5>
        <p class="text-muted small mb-0">
            Closed-out withdrawal requests from the last 12 months. Older than that? Ask BOU directly.
        </p>
    </div>
    <a asp-controller="CbRequests" asp-action="Index" class="text-primary small text-decoration-none">
        <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-muted small">
        <i class="ti ti-inbox me-1"></i>No closed-out requests in the last 12 months.
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="historyTable" class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="font-size:11px;">Transaction Ref no.</th>
                            <th style="font-size:11px;">Collection date</th>
                            <th style="font-size:11px;">Amount (UGX)</th>
                            <th style="font-size:11px;">Status</th>
                            <th style="font-size:11px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td>@(string.IsNullOrEmpty(r.TransactionRefNumber) ? "-" : r.TransactionRefNumber)</td>
                                <td class="small">@r.CollectionDate.ToString("dd MMM yyyy")</td>
                                <td class="fw-semibold small">@r.Amount.ToString("N0")</td>
                                <td>
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill">
                                        @r.StatusTypeName
                                    </span>
                                </td>
                                <td>
                                    <a href="@($"/CbWithdrawRequests/Details/{r.Id}")"
                                       class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
                                        <i class="ti ti-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
    @* _CbLayout doesn't load DataTables (unlike the BOU-side _Layout) — pulled in here only,
       scoped to this page, rather than adding it to every CB page via the shared layout. *@
    <link rel="stylesheet" href="~/css/dataTables.dataTables.css" asp-append-version="true" />
    <script src="~/js/dataTables.js"></script>
    <script>
        if ($('#historyTable tbody tr').length > 0) {
            $('#historyTable').DataTable({
                order: [[1, 'desc']],
                pageLength: 25,
                columnDefs: [
                    { orderable: false, targets: [3, 4] }
                ]
            });
        }
    </script>
}
