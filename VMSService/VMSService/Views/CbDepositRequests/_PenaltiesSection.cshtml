@model VMSService.Core.Models.CbDepositRequest.DepositRequestDetailsViewModel

@* Read-only view of penalties applied by BOU against this request. Management (checking/unchecking
   penalties) is a BOU-side action and is not available here. *@
@if (Model.AppliedPenalties.Any())
{
    <div class="card mb-3 border-top-0 border-end-0 border-bottom-0 border-4 border-danger shadow-sm">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <p class="text-uppercase text-muted fw-bold mb-0">
                    <i class="ti ti-gavel text-muted"></i>
                    Penalties
                </p>
                <span class="badge bg-danger rounded-pill px-3 py-2">
                    Total Applied: UGX @Model.TotalAppliedPenalties.ToString("N0")
                </span>
            </div>
            <hr />

            <div>
                <p class="text-uppercase text-muted small fw-semibold mb-2">Applied Penalties</p>
                <div class="table-responsive">
                    <table class="table table-sm table-nowrap mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th class="border-0">Penalty</th>
                                <th class="border-0">Charge (UGX)</th>
                                <th class="border-0">Applied By</th>
                                <th class="border-0">RTGS Settlement</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var applied in Model.AppliedPenalties)
                            {
                                <tr>
                                    <td>@applied.PenaltyName</td>
                                    <td class="fw-semibold">@applied.ChargeValue.ToString("N0")</td>
                                    <td class="small text-muted">
                                        @applied.AppliedBy
                                    </td>
                                    <td>
                                        @if (applied.IsSettledOnRtgs)
                                        {
                                            <span class="badge bg-success">Settled @(!string.IsNullOrEmpty(applied.RtgsCode) ? $"— {applied.RtgsCode}" : "")</span>
                                        }
                                        else if (!string.IsNullOrEmpty(applied.RtgsSettlingMessage))
                                        {
                                            <span class="badge bg-danger" title="@applied.RtgsSettlingMessage">Failed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Pending</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* Combined figure across both mechanisms *@
            <hr />
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="small text-muted">
                    <div>Deposit Fees: <span class="fw-semibold">UGX @Model.TotalFees.ToString("N0")</span></div>
                    <div>Applied Penalties: <span class="fw-semibold">UGX @Model.TotalAppliedPenalties.ToString("N0")</span></div>
                </div>
                <div class="text-end">
                    <p class="text-uppercase text-muted small fw-semibold mb-0">Total Fees &amp; Penalties</p>
                    <span class="fw-bold fs-5 text-danger">UGX @Model.TotalFeesAndPenalties.ToString("N0")</span>
                </div>
            </div>
        </div>
    </div>
}
