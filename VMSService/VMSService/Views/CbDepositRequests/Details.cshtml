<div class="row">
    <div class="col-12">
        <!-- Status History Section -->
        <div class="card border-0 shadow-sm mb-3">
            @* <div class="card-header bg-white border-bottom no-after">
                <h6 class="card-title mb-0">
                    <i class="ti ti-message me-2 text-secondary"></i>Comments
                </h6>
            </div> *@
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 fw-bolder mb-3">
                    <i class="ti ti-message"></i>
                    <span class="text-uppercase">Comments</span>
                </div>
                @if (Model.StatusHistory != null && Model.StatusHistory.Any())
                {
                    <div class="timeline">
                        @foreach (var history in Model.StatusHistory.OrderBy(x => x.ChangedAt))
                        {
                            <div class="timeline-item mb-4">
                                <div class="d-flex gap-3">
                                    <div class="timeline-marker">
                                        <i class="ti ti-circle-check text-success"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h6 class="mb-1 small">
                                                    <strong>@history.OldStatusName</strong>
                                                    <i class="ti ti-arrow-right text-muted"></i>
                                                    <strong>@history.NewStatusName</strong>
                                                </h6>
                                                <small class="text-muted">
                                                    By: <strong>@history.ChangedBy</strong>
                                                </small>
                                            </div>
                                            <small class="text-muted">
                                                @history.ChangedAt.ToString("dd/MMM/yyyy HH:mm:ss")
                                            </small>
                                        </div>
                                        @if (!string.IsNullOrEmpty(history.Remarks))
                                        {
                                            <div class="mt-2 p-2 bg-white rounded border">
                                                <span class="d-block">@history.Remarks</span>
                                            </div>
                                        }

                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted text-center">
                        <i class="ti ti-inbox me-2"></i>No comments yet.
                    </p>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <!-- Workflow Actions Section -->
        @if (Model.AvailableTransitions.Any())
        {
            <div class="card border-0 bg-white mb-1 shadow-sm">
                @* <div class="card-header bg-white border-bottom no-after">
                    <h6 class="card-title mb-0">
                        <i class="ti ti-checkbox me-2 text-primary"></i>Available Actions
                    </h6>
                </div> *@
                <div class="card-body">
                    <div class="d-flex align-items-center gap-2 fw-bolder mb-3">
                        <i class="ti ti-bolt"></i>
                        <span class="text-uppercase">Actions</span>
                    </div>
                    <form method="post" asp-action="ExecuteAction" asp-route-id="@Model.Id" id="workflowForm">
                        <div class="mb-3">
                            <label class="form-label">
                                Action <span class="text-danger">*</span>
                            </label>
                            <select id="actionSelect" name="actionName" class="form-select" required>
                                <option value="">-- Select an action --</option>
                                @foreach (var transition in Model.AvailableTransitions)
                                {
                                    <option value="@transition.ActionName" data-requires-comments="@transition.RequiresComments.ToString().ToLower()" data-button-class="@transition.ButtonClass" data-display-label="@transition.DisplayLabel">
                                        @transition.DisplayLabel
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Comments
                                <span id="commentRequired" class="text-danger" style="display: none;">*</span>
                            </label>
                            <textarea id="remarksTextarea"
                                  class="form-control"
                                  name="remarks"
                                  rows="3"
                                  placeholder="Enter your comments..."></textarea>
                            <small id="commentHint" class="text-muted d-block mt-1"></small>
                        </div>

                        <button type="submit" id="submitBtn" class="text-white btn btn-brown" disabled>
                            <i class="ti ti-check me-1"></i><span id="submitBtnLabel">Submit</span>
                        </button>
                        @Html.AntiForgeryToken()
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const actionSelect = document.getElementById('actionSelect');
        const remarksTextarea = document.getElementById('remarksTextarea');
        const commentRequired = document.getElementById('commentRequired');
        const commentHint = document.getElementById('commentHint');
        const submitBtn = document.getElementById('submitBtn');
        const submitBtnLabel = document.getElementById('submitBtnLabel');
        const workflowForm = document.getElementById('workflowForm');

        // Only wire up workflow actions when the form is present
        if (actionSelect && workflowForm) {
            // Define hint messages for each action
            const hintMessages = {
                'Verify': 'Provide your verification comments.',
                'Reject': 'Explain why you are rejecting this procurement.',
                'Resubmit': 'Explain what changes were made.'
            };

            // Handle action selection change
            actionSelect.addEventListener('change', function () {
                const selectedOption = this.options[this.selectedIndex];
                const requiresComments = selectedOption.dataset.requiresComments === 'true';
                const actionName = selectedOption.value;
                const displayLabel = selectedOption.dataset.displayLabel;
                const buttonClass = selectedOption.dataset.buttonClass;

                if (actionName) {
                    // Update comment requirement
                    if (requiresComments) {
                        commentRequired.style.display = 'inline';
                        remarksTextarea.required = true;
                    } else {
                        commentRequired.style.display = 'none';
                        remarksTextarea.required = false;
                    }

                    // Update hint message
                    commentHint.textContent = hintMessages[actionName] || '';

                    // Update button
                    submitBtn.disabled = false;
                    submitBtnLabel.textContent = displayLabel;
                    submitBtn.className = `text-white btn ${buttonClass}`;
                } else {
                    // Reset to default state
                    commentRequired.style.display = 'none';
                    remarksTextarea.required = false;
                    remarksTextarea.value = '';
                    commentHint.textContent = '';
                    submitBtn.disabled = true;
                    submitBtnLabel.textContent = 'Submit';
                    submitBtn.className = 'text-white btn btn-primary';
                }
            });

            // Form submission validation
            workflowForm.addEventListener('submit', function (e) {
                const selectedOption = actionSelect.options[actionSelect.selectedIndex];
                const requiresComments = selectedOption.dataset.requiresComments === 'true';
                const remarksValue = remarksTextarea.value.trim();

                if (requiresComments && !remarksValue) {
                    e.preventDefault();
                    alert('Comments are required for this action.');
                    remarksTextarea.focus();
                    return false;
                }
            });
        }

        // Amount in words
        const ONES = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine',
            'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen',
            'Seventeen', 'Eighteen', 'Nineteen'];
        const TENS = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];

        function wordsUnder1000(n) {
            if (n === 0) return '';
            if (n < 20) return ONES[n];
            if (n < 100) return TENS[Math.floor(n / 10)] + (n % 10 ? ' ' + ONES[n % 10] : '');
            return ONES[Math.floor(n / 100)] + ' Hundred' + (n % 100 ? ' ' + wordsUnder1000(n % 100) : '');
        }

        function toWords(n) {
            if (n === 0) return 'Zero shillings';
            const scales = [[1e12, 'Trillion'], [1e9, 'Billion'], [1e6, 'Million'], [1e3, 'Thousand'], [1, '']];
            let res = '', rem = n;
            scales.forEach(([s, name]) => {
                if (rem >= s) {
                    const chunk = Math.floor(rem / s);
                    res += wordsUnder1000(chunk) + (name ? ' ' + name + ' ' : ' ');
                    rem %= s;
                }
            });
            return res.trim() + ' Shillings';
        }

        document.getElementById('total-in-words').textContent = toWords(@Html.Raw(Model.TotalAmount)) + ' only';
    
    });

    

</script>