@model VMSService.Core.Models.CbDepositRequest.DepositRequestDetailsViewModel
@{
    Layout = "_CbLayout";
    ViewData["Title"] = "Deposit Request Details";
}

@await Html.PartialAsync("~/Views/Shared/_Deposit/_DepositNavSteps.cshtml", Model.Steps)


<div class="card mb-4 border-top-0 border-end-0 border-bottom-0 border-4 border-light shadow-sm">
    <div class="card-header bg-white">
        <div class="mb-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <h4 class="fw-bold mb-1 text-success">Deposit Request - @(Model.ReferenceNumber ?? "—")</h4>
                    <p class="text-muted mb-0">@Model.CbName</p>
                </div>
                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 fs-6">
                    @Model.StatusName
                </span>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="d-flex align-items-center mb-3 justify-content-between">
            <div class="d-flex align-items-center gap-2 fw-bolder">
                <i class="ti ti-replace"></i>
                <span class="text-uppercase mb-0">Sender & Receiver Branch Details</span>
            </div>
        </div>
        <div class="row g-4 align-items-end">

            @* CB Branch (Sender) *@
            <div class="col-md-6">
                <div class="text-uppercase text-muted small mb-1">
                    FROM — SENDER (DEPOSITOR)
                </div>
                <div class="d-flex align-items-stretch rounded-3 overflow-hidden border border-success">
                    <div class="d-flex align-items-center justify-content-center px-3 bg-success bg-opacity-10">
                        <i class="ti ti-circle-arrow-down-left-filled text-success fs-4"></i>
                    </div>
                    <div class="flex-grow-1 px-3 py-2">
                        <p class="text-muted mb-0" style="font-size:9px;">FROM COMMERCIAL BANK</p>
                        <p class="fw-bold mb-0">@Model.CbName</p>
                        <p class="mb-0">@Model.CbBicCode</p>
                        <p class="mb-0" id="cbCode">@Model.CbCode</p>
                        <p class="mb-0">@Model.CbBranchName</p>
                    </div>
                    <div class="d-flex align-items-center pe-3">
                        <span class="badge bg-success">
                            <i class="ti ti-toggle-left"></i>
                            Sender
                        </span>
                    </div>
                </div>
            </div>

            @* BOU Branch (Receiver) *@
            <div class="col-md-6">
                <div class="text-uppercase text-muted small mb-1">
                    TO — RECEIVER
                </div>
                <div class="d-flex align-items-stretch rounded-3 overflow-hidden border border-danger">
                    <div class="d-flex align-items-center justify-content-center px-3 bg-danger bg-opacity-10">
                        <i class="ti ti-building-bank text-danger fs-4"></i>
                    </div>
                    <div class="flex-grow-1 px-3 py-2">
                        <p class="text-muted mb-0" style="font-size:9px;">TO BRANCH</p>
                        <p class="fw-bold mb-0">Bank of Uganda</p>
                        <p class="mb-0">@Model.BouBranchName</p>
                        <p class="text-muted fw-light mb-0">@Model.BouBranchCode</p>
                    </div>
                    <div class="d-flex align-items-center pe-3">
                        <span class="badge bg-danger">
                            <i class="ti ti-toggle-right-filled"></i>
                            Receiver
                        </span>
                    </div>
                </div>
            </div>

        </div>

        <div class="row g-4 my-1 mb-4">
            <div class="col-md-4">
                <p class="text-uppercase text-muted small mb-1">Deposit Date</p>
                <p class="fw-bold mb-0">@Model.DepositDate.ToString("dd MMM yyyy")</p>
            </div>
            @* <div class="col-md-4">
                <p class="text-uppercase text-muted small mb-1">RTGS Date</p>
                <p class="fw-bold mb-0">@(Model.RtgsDate?.ToString("dd MMM yyyy") ?? "—")</p>
            </div>
            <div class="col-md-4">
                <p class="text-uppercase text-muted small mb-1">RTGS Code</p>
                <p class="fw-bold mb-0">@(Model.RtgsCode ?? "—")</p>
            </div> *@
        </div>




        <div class="d-flex align-items-center mb-3 justify-content-between">
            <div class="d-flex align-items-center gap-2 fw-bolder">
                <i class="ti ti-friends"></i>
                <span class="text-uppercase mb-0">Agent Details</span>
            </div>
        </div>
        <div class="row g-4 mb-4">
            @{
                var agentIndex = 0;
            }
            @foreach (var agent in Model.DepositAgents)
            {
                agentIndex++;
                <div class="col-md-6" style="cursor:pointer;" onclick="window.location.href='@Url.Action("Details", "AgentDetails", new { id = agent.Id })'">
                    <div class="border bg-light rounded-3 p-3">

                        @* Header *@
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge rounded-pill bg-secondary text-white justify-content-center"
                                      style="width:24px;height:24px;display:inline-flex;align-items:center;font-size:11px;">
                                    @agentIndex
                                </span>
                                <span class="text-uppercase text-muted small fw-semibold">
                                    Agent @agentIndex
                                </span>
                            </div>
                        </div>

                        @* Photo + Details side by side *@
                        <div class="d-flex gap-3 mb-3">
                            @* Photo *@
                            <div class="flex-shrink-0">
                                @if (!string.IsNullOrEmpty(agent.PassportPhoto))
                                {
                                    <img src="@agent.PassportPhoto" alt="Photo"
                                         class="rounded-2 border"
                                         style="width:100px;height:120px;object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="border rounded-2 bg-white d-flex align-items-center justify-content-center"
                                         style="width:100px;height:120px;">
                                        <i class="ti ti-user text-muted fs-1"></i>
                                    </div>
                                }
                            </div>

                            @* Name + details *@
                            <div class="flex-grow-1">
                                <p class="fw-bold mb-1">@agent.AgentNames</p>
                                <div class="mb-1">
                                    <p class="text-muted mb-0" style="font-size:9px;">NIN</p>
                                    <p class="fw-semibold small mb-0">@agent.NIN</p>
                                </div>
                                <div>
                                    <p class="text-muted mb-0" style="font-size:9px;">PHONE</p>
                                    <p class="fw-semibold small mb-0 text-primary">@(agent.PhoneNumber ?? "—")</p>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            @* Work ID Scan — full width *@
                            @if (!string.IsNullOrEmpty(agent.WorkIdScan))
                            {
                                <div class="col-md-6">
                                    <p class="text-muted mb-1" style="font-size:9px;">WORK ID SCAN</p>
                                    <img src="@agent.WorkIdScan" alt="Work ID Scan"
                                         class="rounded-2 border w-100"
                                         style="max-height:150px;object-fit:contain;" />
                                </div>
                            }

                            @* Signature — full width *@
                            @if (!string.IsNullOrEmpty(agent.SignatureScan))
                            {
                                <div class="col-md-6">
                                    <p class="text-muted mb-1" style="font-size:9px;">SIGNATURE</p>
                                    <img src="@agent.SignatureScan" alt="Signature"
                                         class="rounded-2 border w-100"
                                         style="max-height:70px;object-fit:contain;" />
                                </div>
                            }
                        </div>

                    </div>
                </div>
            }
        </div>







        @* Card Header *@
        <div class="d-flex align-items-center mb-3 justify-content-between">
            <div class="d-flex align-items-center gap-2 fw-bolder">
                <i class="ti ti-cash"></i>
                <span class="text-uppercase mb-0">Deposit Denomination Details</span>
            </div>
        </div>

        @* Subcategory Legend *@
       @*  <div class="d-flex gap-3 mb-3 flex-wrap">
            <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-3 py-2">
                <i class="ti ti-check me-1"></i> Fit — Good condition banknotes
            </span>
            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-3 py-2">
                <i class="ti ti-x me-1"></i> Unfit — Worn/damaged banknotes
            </span>
            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle px-3 py-2">
                <i class="ti ti-minus me-1"></i> N/A — Not applicable (coins)
            </span>
        </div> *@

        @* Fit Notes *@
        @if (Model.FitNotes.Any())
        {
            <div class="denom-sec">
                <div class="d-flex align-items-center justify-content-between px-4 py-2 bg-success bg-opacity-10 rounded">
                    <div class="d-flex align-items-center gap-2 text-uppercase fw-bold">
                        <i class="ti ti-check text-success"></i>
                        <span class="text-success">Fit Banknotes</span>
                    </div>
                    <span class="fw-bold small text-success">UGX @Model.FitNotes.Sum(d => d.Amount).ToString("N0")</span>
                </div>
                <div class="table-responsive">
                    <table class="table mb-0">
                        <colgroup>
                            <col style="width:35%">
                            <col style="width:25%">
                            <col style="width:40%">
                        </colgroup>
                        <thead class="small text-muted">
                            <tr>
                                <th class="px-4 py-2">DENOMINATION</th>
                                <th class="px-4 py-2 text-end">NO. OF BUNDLES</th>
                                <th class="px-4 py-2 text-end">AMOUNT</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.FitNotes)
                            {
                                <tr>
                                    <td class="px-4">@d.DenominationLabel</td>
                                    <td class="px-4 text-end">@d.Bundles</td>
                                    <td class="px-4 text-end fw-bold">UGX @d.Amount.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* Unfit Notes *@
        @if (Model.UnfitNotes.Any())
        {
            <div class="denom-sec mt-3">
                <div class="d-flex align-items-center justify-content-between px-4 py-2 bg-danger bg-opacity-10 rounded">
                    <div class="d-flex align-items-center gap-2 text-uppercase fw-bold">
                        <i class="ti ti-x text-danger"></i>
                        <span class="text-danger">Unfit Banknotes</span>
                    </div>
                    <span class="fw-bold small text-danger">UGX @Model.UnfitNotes.Sum(d => d.Amount).ToString("N0")</span>
                </div>
                <div class="table-responsive">
                    <table class="table mb-0">
                        <colgroup>
                            <col style="width:35%">
                            <col style="width:25%">
                            <col style="width:40%">
                        </colgroup>
                        <thead class="small text-muted">
                            <tr>
                                <th class="px-4 py-2">DENOMINATION</th>
                                <th class="px-4 py-2 text-end">NO. OF BUNDLES</th>
                                <th class="px-4 py-2 text-end">AMOUNT</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.UnfitNotes)
                            {
                                <tr>
                                    <td class="px-4">@d.DenominationLabel</td>
                                    <td class="px-4 text-end">@d.Bundles</td>
                                    <td class="px-4 text-end fw-bold">UGX @d.Amount.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* N/A Notes *@
        @if (Model.NANotes.Any())
        {
            <div class="denom-sec mt-3">
                <div class="d-flex align-items-center justify-content-between px-4 py-2 bg-secondary bg-opacity-10 rounded">
                    <div class="d-flex align-items-center gap-2 text-uppercase fw-bold">
                        <i class="ti ti-minus text-secondary"></i>
                        <span class="text-secondary">N/A Banknotes</span>
                    </div>
                    <span class="fw-bold small text-secondary">UGX @Model.NANotes.Sum(d => d.Amount).ToString("N0")</span>
                </div>
                <div class="table-responsive">
                    <table class="table mb-0">
                        <colgroup>
                            <col style="width:35%">
                            <col style="width:25%">
                            <col style="width:40%">
                        </colgroup>
                        <thead class="small text-muted">
                            <tr>
                                <th class="px-4 py-2">DENOMINATION</th>
                                <th class="px-4 py-2 text-end">NO. OF BUNDLES</th>
                                <th class="px-4 py-2 text-end">AMOUNT</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.NANotes)
                            {
                                <tr>
                                    <td class="px-4">@d.DenominationLabel</td>
                                    <td class="px-4 text-end">@d.Bundles</td>
                                    <td class="px-4 text-end fw-bold">UGX @d.Amount.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* Coins *@
        @if (Model.Coins.Any())
        {
            <div class="denom-sec mt-3">
                <div class="d-flex align-items-center justify-content-between px-4 py-2 bg-warning bg-opacity-10 rounded">
                    <div class="d-flex align-items-center gap-2 text-uppercase fw-bold">
                        <i class="ti ti-circle-letter-c-filled text-warning"></i>
                        <span class="text-warning">Coins</span>
                        <span class="badge bg-secondary bg-opacity-10 text-secondary small ms-2">Always N/A</span>
                    </div>
                    <span class="fw-bold small text-warning">UGX @Model.Coins.Sum(d => d.Amount).ToString("N0")</span>
                </div>
                <div class="table-responsive">
                    <table class="table mb-0">
                        <colgroup>
                            <col style="width:35%">
                            <col style="width:25%">
                            <col style="width:40%">
                        </colgroup>
                        <thead class="small text-secondary">
                            <tr>
                                <th class="px-4 py-2">DENOMINATION</th>
                                <th class="px-4 py-2 text-end">NO. OF BOXES</th>
                                <th class="px-4 py-2 text-end">AMOUNT</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Coins)
                            {
                                <tr>
                                    <td class="px-4">@d.DenominationLabel</td>
                                    <td class="px-4 text-end">@d.Boxes</td>
                                    <td class="px-4 text-end fw-bold">UGX @d.Amount.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* Sub-Totals by Category *@
        <div class="mt-4">
            @* <div class="d-flex justify-content-between align-items-center px-4 py-2 border-bottom">
                <span class="d-flex align-items-center gap-2 small fw-semibold text-success">
                    <i class="ti ti-check"></i> Fit Banknotes
                </span>
                <span class="fw-bold text-success">UGX @Model.FitNotes.Sum(d => d.Amount).ToString("N0")</span>
            </div>
            <div class="d-flex justify-content-between align-items-center px-4 py-2 border-bottom">
                <span class="d-flex align-items-center gap-2 small fw-semibold text-danger">
                    <i class="ti ti-x"></i> Unfit Banknotes
                </span>
                <span class="fw-bold text-danger">UGX @Model.UnfitNotes.Sum(d => d.Amount).ToString("N0")</span>
            </div> *@
            <div class="d-flex justify-content-between align-items-center px-4 py-2 border-bottom">
                <span class="d-flex align-items-center gap-2 small fw-semibold text-primary">
                    <i class="ti ti-circle-letter-n-filled"></i> Total Banknotes
                </span>
                <span class="fw-bold text-primary">UGX @Model.TotalNotesAmount.ToString("N0")</span>
            </div>
            <div class="d-flex justify-content-between align-items-center px-4 py-2">
                <span class="d-flex align-items-center gap-2 small fw-semibold text-warning">
                    <i class="ti ti-circle-letter-c-filled"></i> Total Coins
                </span>
                <span class="fw-bold text-warning">UGX @Model.TotalCoinsAmount.ToString("N0")</span>
            </div>
        </div>

        @* Grand Total *@
        <div class="denom-grand rounded px-4 py-3">
            <div class="d-flex justify-content-between align-items-baseline mb-2">
                <span class="text-uppercase fw-bold text-white fs-6 opacity-75"
                      style="letter-spacing:.07em;">Grand Total</span>
