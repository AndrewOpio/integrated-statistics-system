@model VMSService.Core.Models.CbDepositRequest.DepositRequestDetailsViewModel
@{
    Layout = "_CbLayout";
    ViewData["Title"] = "Deposit Request Details";
}

@await Html.PartialAsync("~/Views/Shared/_Withdrawal/_WithdrawNavSteps.cshtml", Model.Steps)

<div class="mb-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-1">Deposit Request</h4>
            <p class="text-muted mb-0">Ref: @(Model.ReferenceNumber ?? "—")</p>
        </div>
        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 fs-6">
            @Model.StatusName
        </span>
    </div>
</div>

@* ?? Branch Info ?? *@
<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <div class="d-flex align-items-center gap-2 fw-bolder mb-3">
            <i class="ti ti-building-bank"></i>
            <span class="text-uppercase">Branch & Date Details</span>
        </div>
        <div class="row g-3">
            <div class="col-md-4">
                <p class="text-muted mb-0" style="font-size:9px;">COMMERCIAL BANK</p>
                <p class="fw-bold mb-0">@Model.CbName</p>
            </div>
            <div class="col-md-4">
                <p class="text-muted mb-0" style="font-size:9px;">BOU BRANCH</p>
                <p class="fw-bold mb-0">@Model.BouBranchName (@Model.BouBranchCode)</p>
            </div>
            <div class="col-md-2">
                <p class="text-muted mb-0" style="font-size:9px;">DEPOSIT DATE</p>
                <p class="fw-bold mb-0">@Model.DepositDate.ToString("dd MMM yyyy")</p>
            </div>
            <div class="col-md-2">
                <p class="text-muted mb-0" style="font-size:9px;">RTGS</p>
                <p class="fw-bold mb-0">@(Model.RtgsDate?.ToString("dd MMM yyyy") ?? "—") @(Model.RtgsCode ?? "")</p>
            </div>
        </div>
    </div>
</div>

@* ?? Agents ?? *@
<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <div class="d-flex align-items-center gap-2 fw-bolder mb-3">
            <i class="ti ti-friends"></i>
            <span class="text-uppercase">Agent Details</span>
        </div>
        <div class="row g-3">
            @foreach (var agent in Model.DepositAgents)
            {
                <div class="col-md-6">
                    <div class="border rounded-3 p-3 bg-light">
                        <p class="fw-bold mb-1">@agent.AgentNames</p>
                        <p class="text-muted small mb-0">NIN: @agent.NIN</p>
                        <p class="text-muted small mb-0">Phone: @agent.PhoneNumber</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@* ?? Denominations ?? *@
<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <div class="d-flex align-items-center gap-2 fw-bolder mb-3">
            <i class="ti ti-cash"></i>
            <span class="text-uppercase">Denomination Details</span>
        </div>

        @* Fit Notes *@
        @if (Model.FitNotes.Any())
        {
            <div class="mb-3">
                <div class="d-flex align-items-center gap-2 mb-2 px-3 py-2 bg-success bg-opacity-10 rounded">
                    <i class="ti ti-check text-success"></i>
                    <span class="fw-semibold text-success text-uppercase small">Fit Banknotes</span>
                </div>
                <table class="table table-sm mb-0">
                    <thead class="small text-muted">
                        <tr><th>Denomination</th><th class="text-end">Bundles</th><th class="text-end">Amount</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.FitNotes)
                        {
                            <tr><td>@d.DenominationLabel</td><td class="text-end">@d.Bundles</td><td class="text-end fw-bold">UGX @d.Amount.ToString("N0")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @* Unfit Notes *@
        @if (Model.UnfitNotes.Any())
        {
            <div class="mb-3">
                <div class="d-flex align-items-center gap-2 mb-2 px-3 py-2 bg-danger bg-opacity-10 rounded">
                    <i class="ti ti-x text-danger"></i>
                    <span class="fw-semibold text-danger text-uppercase small">Unfit Banknotes</span>
                </div>
                <table class="table table-sm mb-0">
                    <thead class="small text-muted">
                        <tr><th>Denomination</th><th class="text-end">Bundles</th><th class="text-end">Amount</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.UnfitNotes)
                        {
                            <tr><td>@d.DenominationLabel</td><td class="text-end">@d.Bundles</td><td class="text-end fw-bold">UGX @d.Amount.ToString("N0")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @* N/A Notes *@
        @if (Model.NANotes.Any())
        {
            <div class="mb-3">
                <div class="d-flex align-items-center gap-2 mb-2 px-3 py-2 bg-secondary bg-opacity-10 rounded">
                    <i class="ti ti-minus text-secondary"></i>
                    <span class="fw-semibold text-secondary text-uppercase small">N/A Banknotes</span>
                </div>
                <table class="table table-sm mb-0">
                    <thead class="small text-muted">
                        <tr><th>Denomination</th><th class="text-end">Bundles</th><th class="text-end">Amount</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.NANotes)
                        {
                            <tr><td>@d.DenominationLabel</td><td class="text-end">@d.Bundles</td><td class="text-end fw-bold">UGX @d.Amount.ToString("N0")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @* Coins *@
        @if (Model.Coins.Any())
        {
            <div class="mb-3">
                <div class="d-flex align-items-center gap-2 mb-2 px-3 py-2 bg-warning bg-opacity-10 rounded">
                    <i class="ti ti-circle-letter-c-filled text-warning"></i>
                    <span class="fw-semibold text-warning text-uppercase small">Coins</span>
                </div>
                <table class="table table-sm mb-0">
                    <thead class="small text-muted">
                        <tr><th>Denomination</th><th class="text-end">Boxes</th><th class="text-end">Amount</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Coins)
                        {
                            <tr><td>@d.DenominationLabel</td><td class="text-end">@d.Boxes</td><td class="text-end fw-bold">UGX @d.Amount.ToString("N0")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @* Totals *@
        <div class="border-top pt-3">
            <div class="d-flex justify-content-between mb-1">
                <span class="fw-semibold">Total Banknotes</span>
                <span class="fw-bold text-primary">UGX @Model.TotalNotesAmount.ToString("N0")</span>
            </div>
            <div class="d-flex justify-content-between mb-1">
                <span class="fw-semibold">Total Coins</span>
                <span class="fw-bold text-warning">UGX @Model.TotalCoinsAmount.ToString("N0")</span>
            </div>
            <div class="d-flex justify-content-between pt-2 border-top">
                <span class="fw-bold fs-5">Grand Total</span>
                <span class="fw-bold fs-5">UGX @Model.TotalAmount.ToString("N0")</span>
            </div>
        </div>
    </div>
</div>

@* ?? Actions ?? *@
@if (Model.AvailableTransitions.Any())
{
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <div class="d-flex align-items-center gap-2 fw-bolder mb-3">
                <i class="ti ti-bolt"></i>
                <span class="text-uppercase">Actions</span>
            </div>
            <form asp-action="ExecuteAction" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="mb-3">
                    <label class="form-label">Remarks</label>
                    <textarea name="remarks" class="form-control" rows="2" placeholder="Optional remarks..."></textarea>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    @foreach (var t in Model.AvailableTransitions)
                    {
                        <button type="submit" name="actionName" value="@t.ActionName"
                                class="btn btn-outline-primary">
                            @t.ActionName
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
}

@* ?? Status History ?? *@
@if (Model.StatusHistory.Any())
{
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <div class="d-flex align-items-center gap-2 fw-bolder mb-3">
                <i class="ti ti-history"></i>
                <span class="text-uppercase">Status History</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead class="small text-muted">
                        <tr>
                            <th>Date</th>
                            <th>Changed By</th>
                            <th>Status</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.StatusHistory.OrderByDescending(h => h.ChangedAt))
                        {
                            <tr>
                                <td>@h.ChangedAt.ToString("dd MMM yyyy HH:mm")</td>
                                <td>@h.ChangedBy</td>
                                <td><span class="badge bg-primary bg-opacity-10 text-primary">Status @h.NewStatusId</span></td>
                                <td>@(h.Remarks ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}