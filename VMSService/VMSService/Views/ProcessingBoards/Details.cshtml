@model VMSService.Core.Models.ProcessingBoards.ProcessingBoardViewModel

@{
    ViewData["Title"] = "Processing Board Details";
}

<div class="row">
    <div class="col-12 col-lg-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header pb-4">
                <div class="d-flex flex-column">
                    <span class="text-muted small mb-2">Processing Board Profile</span>
                    <h2 class="fs-4 fw-bold mb-3">@Model.Name</h2>
                    @if (!string.IsNullOrEmpty(Model.BranchName))
                    {
                        <div class="d-inline-flex align-items-center gap-2" style="width: fit-content;">
                            <span class="badge bg-primary">
                                <i class="ti ti-building me-1"></i>@Model.BranchName
                            </span>
                        </div>
                    }
                </div>
            </div>

            <div class="card-body">
                <div class="field mb-4">
                    <span class="d-block text-muted small mb-2 text-uppercase">Board Name</span>
                    <span class="d-block fw-normal">@Model.Name</span>
                </div>

                <div class="field mb-4">
                    <span class="d-block text-muted small mb-2 text-uppercase">Branch</span>
                    <span class="d-block fw-normal">@(Model.BranchName ?? "-")</span>
                </div>

                <div class="field mb-4">
                    <span class="d-block text-muted small mb-2 text-uppercase">BPS Machine</span>
                    <span class="d-block fw-normal">
                        @if (!string.IsNullOrEmpty(Model.BPSMachineName))
                        {
                            @Model.BPSMachineName
                        }
                        else
                        {
                            <span class="text-muted">Not assigned</span>
                        }
                    </span>
                </div>

                <div class="field">
                    <span class="d-block text-muted small mb-2 text-uppercase">Counting Room</span>
                    <span class="d-block fw-normal">
                        @if (!string.IsNullOrEmpty(Model.CountingRoomName))
                        {
                            @Model.CountingRoomName
                        }
                        else
                        {
                            <span class="text-muted">Not assigned</span>
                        }
                    </span>
                </div>
            </div>

            <div class="card-footer bg-transparent border-top pt-3">
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="ti ti-pencil me-1"></i>Edit
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="ti ti-arrow-left me-1"></i>Back
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
