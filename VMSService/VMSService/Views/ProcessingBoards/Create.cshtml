@model VMSService.Core.Models.ProcessingBoards.ProcessingBoardViewModel

@{
    ViewData["Title"] = "Create Processing Board";
}

<div class="row">
    <div class="col-12 col-lg-12">
        <div class="card border-0 shadow mb-4">
            <div class="card-header">
                <h2 class="fs-5 fw-bold mb-0">Create New Processing Board</h2>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert">
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label class="form-label" asp-for="Name">Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" asp-for="Name" required placeholder="Enter board name">
                        <span asp-validation-for="Name" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="BranchId">Branch <span class="text-danger">*</span></label>
                        <select class="form-select" asp-for="BranchId" asp-items="@Model.BranchList" required>
                            <option value="">-- Select Branch --</option>
                        </select>
                        <span asp-validation-for="BranchId" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="BPSMachineId">BPS Machine</label>
                        <select class="form-select" asp-for="BPSMachineId" asp-items="@Model.BPSMachineList">
                            <option value="">-- None --</option>
                        </select>
                        <span asp-validation-for="BPSMachineId" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="CountingRoomId">Counting Room <span class="text-danger">*</span></label>
                        <select class="form-select" asp-for="CountingRoomId" required>
                            <option value="">-- Select Branch First --</option>
                            @foreach (var room in Model.CountingRooms)
                            {
                                <option value="@room.Id" data-branch-id="@room.BranchId">@room.Name</option>
                            }
                        </select>
                        <span asp-validation-for="CountingRoomId" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-check me-1"></i>Save
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="ti ti-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            const branchSelect = document.getElementById('BranchId');
            const roomSelect = document.getElementById('CountingRoomId');

            function filterCountingRoomsByBranch() {
                const branchId = branchSelect.value;

                Array.from(roomSelect.options).forEach(function (opt) {
                    if (!opt.value) return;
                    const matches = opt.dataset.branchId === branchId;
                    opt.hidden = !matches;
                    opt.disabled = !matches;
                });

                const selected = roomSelect.options[roomSelect.selectedIndex];
                if (selected && selected.value && selected.disabled) {
                    roomSelect.value = '';
                }

                roomSelect.disabled = !branchId;
            }

            branchSelect.addEventListener('change', filterCountingRoomsByBranch);
            filterCountingRoomsByBranch();
        })();
    </script>
}
